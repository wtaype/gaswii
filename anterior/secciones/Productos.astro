---
// src/feature/inicio/secciones/Productos.astro
// 3. PRODUCTOS: VENTA DE BALONES A DOMICILIO CON PESO EXACTO (100% Cero CSS Inline)
import { datosNegocio } from '../../../negocio.js';
import { getI18n, type Idioma } from '../../../core/idioma/idioma';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = getI18n(idioma).catalogo;
const lang = idioma || 'es';

const catalogo: any[] = datosNegocio.productos as any[];
---

<section id="productos" class="section-py-body">
  <div class="page-container">
    
    <div class="section-header-box">
      <span class="badge-fire mb-3 inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs">
        <i class="fa-solid fa-boxes-stacked"></i> <span>{t.badge}</span>
      </span>
      <h2 class="section-header-title">
        {t.titulo}
      </h2>
      <p class="section-header-desc">
        {t.desc}
      </p>
    </div>

    <div class="catalog-grid">
      {catalogo.map((prod: any) => {
        const prodNombre = typeof prod.nombre === 'object' ? (prod.nombre[lang] || prod.nombre['es']) : (lang === 'en' ? prod.nombreEn : prod.nombre);
        const prodBadge = typeof prod.tipo === 'object' ? (prod.tipo[lang] || prod.tipo['es']) : (typeof prod.badge === 'object' ? (prod.badge[lang] || prod.badge['es']) : (lang === 'en' ? prod.badgeEn : prod.badge));
        const prodTipo = typeof prod.tipoUso === 'object' ? (prod.tipoUso[lang] || prod.tipoUso['es']) : (lang === 'en' ? prod.tipoUsoEn : prod.tipoUso);
        const prodCapacidad = typeof prod.peso === 'object' ? (prod.peso[lang] || prod.peso['es']) : (typeof prod.capacidad === 'object' ? (prod.capacidad[lang] || prod.capacidad['es']) : (lang === 'en' ? prod.capacidadEn : prod.capacidad));
        const prodValvula = typeof prod.valvula === 'object' ? (prod.valvula[lang] || prod.valvula['es']) : (lang === 'en' ? prod.valvulaEn : prod.valvula);
        const prodPeso = typeof prod.pesoFull === 'object' ? (prod.pesoFull[lang] || prod.pesoFull['es']) : (typeof prod.pesoTotal === 'object' ? (prod.pesoTotal[lang] || prod.pesoTotal['es']) : (lang === 'en' ? prod.pesoTotalEn : prod.pesoTotal));
        const prodAhorro = typeof prod.delivery === 'object' ? (prod.delivery[lang] || prod.delivery['es']) : (typeof prod.ahorro === 'object' ? (prod.ahorro[lang] || prod.ahorro['es']) : (lang === 'en' ? prod.ahorroEn : prod.ahorro));
        
        let caracteristicas: string[] = [];
        if (prod.garantias && typeof prod.garantias === 'object') {
          caracteristicas = prod.garantias[lang] || prod.garantias['es'] || [];
        } else if (prod.caracteristicas && typeof prod.caracteristicas === 'object' && !Array.isArray(prod.caracteristicas)) {
          caracteristicas = prod.caracteristicas[lang] || prod.caracteristicas['es'] || [];
        } else if (Array.isArray(prod.caracteristicas)) {
          caracteristicas = prod.caracteristicas;
        }

        const precio = typeof prod.precio === 'number' ? prod.precio : (typeof prod.precioPEN === 'number' ? prod.precioPEN : (prod.price || 65));
        const imagenUrl = prod.imagen || prod.img;
        const tagClase = prod.tagClase || 'badge-fire';
        const badgeIcon = prod.badgeIcon || prod.icon || 'fa-solid fa-star';

        return (
          <div class="clean-card producto-card-box">
            
            <div>
              <div class="producto-top-bar mb-3">
                <span class={`producto-badge ${tagClase}`}>
                  <i class={badgeIcon}></i> <span>{prodBadge}</span>
                </span>
                <span class="producto-tipo-badge">{prodTipo}</span>
              </div>

              <div class="producto-media-frame">
                <img 
                  src={imagenUrl} 
                  alt={prodNombre} 
                  width="220"
                  height="220"
                  loading="lazy"
                  class="producto-img-tag"
                />
                <div class="producto-capacidad-tag">
                  <i class="fa-solid fa-circle-check color-emerald"></i> <span>{prodCapacidad}</span>
                </div>
              </div>

              <h3 class="text-base font-bold text-bright mb-2">
                {prodNombre}
              </h3>

              <ul class="flex flex-col gap-1.5 mb-4 list-none p-0 text-xs text-muted">
                <li class="flex items-center gap-2"><i class="fa-solid fa-tag color-primary"></i> <strong>{t.valvula_label}</strong> <span>{prodValvula}</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-weight-scale color-emerald"></i> <strong>{t.peso_label}</strong> <span>{prodPeso}</span></li>
                <li class="flex items-center gap-2"><i class="fa-solid fa-shield-halved color-brand-blue"></i> <strong>{t.seguridad_label}</strong> <span>{t.precinto_verificado}</span></li>
              </ul>

              <div class="mb-4 pt-3 border-t border-card">
                <span class="text-xxs uppercase font-bold text-muted block mb-1">
                  {t.garantia_gaswii}
                </span>
                <ul class="flex flex-col gap-1 list-none p-0 text-xs text-muted">
                  {caracteristicas.map((c: any) => (
                    <li class="flex items-start gap-1.5">
                      <i class="fa-solid fa-circle-check color-emerald text-xs mt-0.5"></i>
                      <span>{c}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div>
              <div class="flex justify-between items-end mb-3 pt-3 border-t border-card">
                <div>
                  <span class="text-xxs text-emerald-400 font-bold block">{prodAhorro}</span>
                  <div class="producto-price-val">
                    <span class="text-sm font-bold text-muted">S/</span> {precio.toFixed(2)}
                  </div>
                </div>
                <div class="text-right">
                  <span class="text-xxs text-muted block">{t.envio_puerta}</span>
                  <span class="text-xs color-emerald font-bold">{t.incluido}</span>
                </div>
              </div>

              <div class="flex gap-2">
                <button 
                  onclick={`window.abrirModalPedido && window.abrirModalPedido('${prodNombre}')`} 
                  class="btn-whatsapp flex-1 justify-center py-2.5 text-xs font-bold"
                  title={`Pedir ${prodNombre} por WhatsApp`}
                >
                  <i class="fa-brands fa-whatsapp"></i> <span>{t.btn_pedir}</span>
                </button>
                <a 
                  href={`tel:${datosNegocio.telefonoLimpio}`} 
                  class="btn-call py-2.5 px-3 text-xs"
                  title="Llamar para pedir"
                >
                  <i class="fa-solid fa-phone"></i>
                </a>
              </div>
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>