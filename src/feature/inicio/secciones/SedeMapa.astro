---
// src/feature/inicio/secciones/SedeMapa.astro
// 7. CENTRAL DE OPERACIONES Y MONITOREO DELIVERY (100% Cero CSS Inline)
import { getI18n, type Idioma } from '../../../core/idioma/idioma';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = getI18n(idioma);
---

<section id="mapa-sede" class="seccion-mapa section-py-body">
  <div class="page-container">
    
    <!-- Encabezado con Palabras Positivas y Seguridad -->
    <div class="section-header-box mb-6 text-center">
      <span class="badge-blue mb-3 inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs">
        <i class="fa-solid fa-shield-halved"></i> <span>{t.mapa.badge}</span>
      </span>
      <h2 class="section-header-title">
        {t.mapa.titulo}
      </h2>
      <p class="section-header-desc max-w-2xl mx-auto">
        {t.mapa.desc}
      </p>
    </div>

    <!-- Contenedor Unificado de Mapa y Seguridad -->
    <div class="clean-card mapa-box-wrapper">
      
      <!-- Fila de Palabras Positivas y Seguridad (Atención Exclusiva Delivery) -->
      <div class="mapa-safety-strip">
        <div class="mapa-safety-item">
          <i class="fa-solid fa-motorcycle color-orange"></i>
          <span>{t.mapa.seguridad_1}</span>
        </div>
        <div class="mapa-safety-item">
          <i class="fa-solid fa-tower-broadcast color-cyan"></i>
          <span>{t.mapa.seguridad_2}</span>
        </div>
        <div class="mapa-safety-item">
          <i class="fa-solid fa-scale-balanced color-emerald"></i>
          <span>{t.mapa.seguridad_3}</span>
        </div>
        <div class="mapa-safety-item">
          <i class="fa-solid fa-bolt color-gold"></i>
          <span>{t.mapa.seguridad_4}</span>
        </div>
      </div>

      <!-- Mapa Embebido Oficial con Cobertura y Operaciones -->
      <div class="mapa-frame-box">
        <iframe 
          src="https://maps.google.com/maps?q=-12.1177408,-77.0226796&hl=es&z=16&output=embed" 
          width="100%" 
          height="100%" 
          class="mapa-iframe-embed"
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa de Operaciones y Cobertura Delivery Solgas Surquillo"
        ></iframe>
      </div>

    </div>

  </div>
</section>
