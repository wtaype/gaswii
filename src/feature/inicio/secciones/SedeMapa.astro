---
// src/feature/inicio/secciones/SedeMapa.astro
// 7. CENTRAL DE OPERACIONES Y MONITOREO DELIVERY (100% Cero CSS Inline)
import { datosNegocio } from '../../../negocio.js';
import { getI18n, type Idioma } from '../../../core/idioma/idioma';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = getI18n(idioma);
---

<section id="mapa-sede" class="seccion-mapa section-py-body">
  <div class="page-container">
    
    <!-- Encabezado con Palabras Positivas y Seguridad -->
    <div class="section-header-box mb-6 text-center">
      <span class="badge-blue mb-3 inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs">
        <i class="fa-solid fa-shield-halved"></i> <span>{t.mapa.badge}</span>
      </span>
      <h2 class="section-header-title">
        {t.mapa.titulo}
      </h2>
      <p class="section-header-desc max-w-2xl mx-auto">
        {t.mapa.desc}
      </p>
    </div>

    <!-- Contenedor Unificado de Mapa y Seguridad -->
    <div class="clean-card mapa-box-wrapper">
      
      <!-- Fila de Información Central Ejecutiva (Dirección, Horario, Teléfono, Google Maps) -->
      <div class="mapa-info-grid">
        <div class="mapa-info-col">
          <div class="mapa-icon-box icon-orange">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <div>
            <div class="mapa-info-label">{t.mapa.direccion_label}</div>
            <div class="mapa-info-val">{datosNegocio.direccionSede}</div>
          </div>
        </div>

        <div class="mapa-info-col">
          <div class="mapa-icon-box icon-blue">
            <i class="fa-solid fa-clock"></i>
          </div>
          <div>
            <div class="mapa-info-label">{t.mapa.horario_label}</div>
            <div class="mapa-info-val">{idioma === 'en' ? datosNegocio.horarioEn : datosNegocio.horario}</div>
          </div>
        </div>

        <div class="mapa-info-col">
          <div class="mapa-icon-box icon-green">
            <i class="fa-solid fa-phone"></i>
          </div>
          <div>
            <div class="mapa-info-label">{t.mapa.telefono_label}</div>
            <div class="mapa-info-val">
              <span>{datosNegocio.telefonoMostrado}</span>
              {datosNegocio.telefonoFijo && <span class="text-xs text-muted block font-normal">Fijo: {datosNegocio.telefonoFijo}</span>}
            </div>
          </div>
        </div>

        <div class="mapa-btn-col">
          <a href={datosNegocio.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-fire mapa-btn-action">
            <i class="fa-solid fa-arrow-up-right-from-square"></i> <span>{t.mapa.btn_maps}</span>
          </a>
        </div>
      </div>

      <!-- Mapa Embebido Oficial con Cobertura y Operaciones -->
      <div class="mapa-frame-box">
        <iframe 
          src={`https://maps.google.com/maps?q=${datosNegocio.coordenadas?.lat || -12.1177408},${datosNegocio.coordenadas?.lng || -77.0226796}&hl=${idioma}&z=16&output=embed`} 
          width="100%" 
          height="100%" 
          class="mapa-iframe-embed"
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
          title={`Mapa de Operaciones y Cobertura Delivery ${datosNegocio.nombre}`}
        ></iframe>
      </div>

    </div>

  </div>
</section>
