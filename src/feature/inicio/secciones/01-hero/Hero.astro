---
// src/feature/inicio/secciones/01-hero/Hero.astro
// 1. HERO CRO AUTÓNOMO: NARRATIVA [PROBLEMA REAL] ➔ [SOLUCIÓN INMEDIATA]
import { datosNegocio } from '../../../../negocio.js';
import { resolverIdioma } from '../../idioma/idioma.js';
import es from './idioma/es.json';
import en from './idioma/en.json';
import heroCss from './hero.css?inline';

interface Props {
  idioma?: string;
}

const { idioma = 'es' } = Astro.props;
const t = resolverIdioma({ es, en }, idioma);

const distritos = datosNegocio.distritos || [];
const primerDistrito = distritos[0] || { id: '', nombre: '', tiempo: '' };
const primerProducto = datosNegocio.productos[0];
const precioPrimerBalon = primerProducto ? primerProducto.precioPEN.toFixed(2) : '';
const direccionSede = datosNegocio.direccionSede;
const mapsUrl = datosNegocio.mapsUrl || '#';
---

<style is:global set:html={heroCss}></style>

<section id="hero" class="hero-section">
  <div class="pagewii hero-page-container">
    <div class="hero-layout">
      
      <!-- Columna Izquierda: Problema ➔ Solución -->
      <div class="hero-txt">
        
        <!-- Grupo Superior: Badge Oficial y Ubicación Google Maps -->
        <div class="hero-meta-group">
          <!-- Item 1: Insignia Oficial Solgas Surquillo -->
          <div class="hero-saludo">
            <span class="badge-fire hero-badge">
              <i class="fa-solid fa-face-smile-beam"></i> 
              <span data-negocio-badge data-prefijo={t.badge_prefijo}>{t.badge_prefijo} {datosNegocio.nombre.toUpperCase()}</span>
            </span>
          </div>

          <!-- Item 2: Ubicación Sede Central Google Maps -->
          <a 
            href={mapsUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="hero-maps-line"
            data-negocio-maps
            title={`${t.maps_cta} - ${direccionSede}`}
          >
            <span class="hero-maps-icon"><i class="fa-solid fa-map-location-dot"></i></span>
            <span class="hero-maps-text">
              <span>{t.maps_sede_prefijo}</span> <span data-negocio-direccion-sede>{direccionSede}</span>
            </span>
            <i class="fa-solid fa-arrow-up-right-from-square hero-maps-arrow"></i>
          </a>
        </div>

        <!-- Línea 3: Pregunta Titular -->
        <h1 class="hero-main-heading">
          <span>{t.titulo_1}</span><br />
          <span class="hero-title-highlight">
            {t.titulo_resaltado}
          </span>
        </h1>

        <!-- Línea 4: Subtítulo Explicativo -->
        <p class="hero-main-sub">
          {t.subtitulo}
        </p>

        <!-- Selector Dinámico de Distrito -->
        <div class="hero-district-card">
          <div class="hero-district-title">
            <i class="fa-solid fa-location-dot"></i> <span>{t.selector_titulo}</span>
          </div>
          
          <div class="hero-district-grid" id="districtSelector" data-negocio-distritos>
            {distritos.map((dist: any, idx: number) => (
              <button 
                type="button"
                class={`hero-district-btn ${idx === 0 ? 'active' : ''}`}
                data-district={dist.nombre}
                data-time={dist.tiempo}
              >
                <div class="hero-district-name">{dist.nombre}</div>
                <div class="hero-district-time"><i class="fa-solid fa-bolt"></i> {dist.tiempo}</div>
              </button>
            ))}
          </div>

          <div class="hero-district-footer">
            <span>
              <i class="fa-solid fa-motorcycle color-primary"></i> 
              <span id="distritoActualInfo" data-prefijo={t.selector_eta_prefijo}>
                <span class="eta-prefix">{t.selector_eta_prefijo}</span> <span data-negocio-direccion-origen>{direccionSede}</span>: <strong class="eta-time">{primerDistrito.tiempo}</strong>
              </span>
            </span>
            <span class="color-emerald font-bold">
              <i class="fa-solid fa-check"></i> <span>{t.envio_gratis}</span>
            </span>
          </div>
        </div>

        <!-- Botones Principales CTAs -->
        <div class="hero-ctas-group">
          <button type="button" onclick="window.abrirModalPedido && window.abrirModalPedido()" class="btn-fire hero-btn-cta">
            <i class="fa-solid fa-cart-shopping text-xl"></i>
            <div class="hero-btn-text">
              <span class="hero-btn-sub">{t.btn_modal_sub}</span>
              <span class="hero-btn-main">{t.btn_modal_main}</span>
            </div>
          </button>

          <a href={`tel:${datosNegocio.telefonoLimpio}`} class="btn-call hero-btn-cta" data-negocio-tel-link>
            <i class="fa-solid fa-phone-volume text-xl"></i>
            <div class="hero-btn-text">
              <span class="hero-btn-sub">{t.btn_call_sub}</span>
              <span class="hero-btn-main" data-negocio-tel-text>{datosNegocio.telefonoMostrado}</span>
            </div>
          </a>
        </div>

        <!-- Métricas de Trayectoria -->
        <div class="stats-grid hero-stats-box">
          <div>
            <div class="hero-stat-val color-primary" data-negocio-metrica-clientes>{datosNegocio.metricas.clientes}</div>
            <div class="hero-stat-label">{t.stat_clientes}</div>
          </div>
          <div>
            <div class="hero-stat-val color-emerald" data-negocio-metrica-balanza>{datosNegocio.metricas.balanza}</div>
            <div class="hero-stat-label">{t.stat_balanza}</div>
          </div>
          <div>
            <div class="hero-stat-val color-brand-blue" data-negocio-metrica-years>{datosNegocio.metricas.years}</div>
            <div class="hero-stat-label">{t.stat_anos}</div>
          </div>
          <div>
            <div class="hero-stat-val color-gold" data-negocio-metrica-dias>{datosNegocio.metricas.dias}</div>
            <div class="hero-stat-label">{t.stat_dias}</div>
          </div>
        </div>

      </div>

      <!-- Columna Derecha: Fotografía y Garantía -->
      <div class="hero-visual">
        <div class="hero-right-card">
          
          <div class="hero-img-box">
            <img 
              src={datosNegocio.imagenSede} 
              alt={datosNegocio.nombre} 
              width="600"
              height="450"
              loading="eager"
              fetchpriority="high"
              class="hero-img"
              data-negocio-imagen-sede
            />
          </div>

          <div class="hero-guarantee-box">
            <div class="hero-guarantee-left">
              <div class="hero-guarantee-icon">
                <i class="fa-solid fa-scale-balanced"></i>
              </div>
              <div>
                <div class="hero-guarantee-title">
                  {t.driver_card_titulo}
                </div>
                <div class="hero-guarantee-sub">
                  {t.driver_card_desc}
                </div>
              </div>
            </div>
            <div class="hero-guarantee-price">
              <div class="hero-price-sub">{t.precio_desde}</div>
              <div class="hero-price-val" data-negocio-precio-primer-balon>
                S/ {precioPrimerBalon}
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  function iniciarSelectorDistritos() {
    const grid = document.getElementById('districtSelector');
    const info = document.getElementById('distritoActualInfo');
    if (!grid) return;

    const botones = grid.querySelectorAll('.hero-district-btn');
    botones.forEach((btn) => {
      btn.addEventListener('click', () => {
        botones.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const time = btn.getAttribute('data-time') || '';
        if (info) {
          const timeEl = info.querySelector('.eta-time');
          if (timeEl) {
            timeEl.textContent = time;
          } else {
            const origenEl = info.querySelector('[data-negocio-direccion-origen]');
            const dir = origenEl ? origenEl.textContent : '';
            const prefijo = info.getAttribute('data-prefijo') || 'Despachando desde';
            info.innerHTML = `<span class="eta-prefix">${prefijo}</span> <span data-negocio-direccion-origen>${dir}</span>: <strong class="eta-time">${time}</strong>`;
          }
        }
      });
    });
  }

  function hidratarHeroDesdeNegocio(datos: any) {
    if (!datos || typeof datos !== 'object') return;

    const dir = datos.ubicacion?.direccion || '';
    const maps = datos.ubicacion?.mapsUrl || '';
    const tel = datos.contacto?.telefono || '';
    const telLimpio = datos.contacto?.telefonoLimpio || tel.replace(/\D/g, '');

    if (dir) {
      document.querySelectorAll('[data-negocio-direccion], [data-negocio-direccion-sede], [data-negocio-direccion-origen]').forEach(el => {
        el.textContent = dir;
      });
    }

    if (maps) {
      document.querySelectorAll('[data-negocio-maps]').forEach(a => {
        a.setAttribute('href', maps);
      });
    }

    if (tel) {
      document.querySelectorAll('[data-negocio-tel-text]').forEach(el => el.textContent = tel);
    }
    if (telLimpio) {
      document.querySelectorAll('[data-negocio-tel-link]').forEach(a => a.setAttribute('href', `tel:${telLimpio}`));
    }

    const horario = datos.contacto?.horario || '';
    if (horario) {
      document.querySelectorAll('[data-negocio-horario]').forEach(el => el.textContent = horario);
    }

    const whatsapp = datos.contacto?.whatsapp || '';
    if (whatsapp) {
      document.querySelectorAll('[data-negocio-ws-link]').forEach(a => {
        const cur = a.getAttribute('href') || '';
        if (cur.includes('wa.me/')) {
          const parts = cur.split('?');
          a.setAttribute('href', `https://wa.me/${whatsapp}${parts[1] ? '?' + parts[1] : ''}`);
        }
      });
    }

    if (datos.identidad?.registroOsinergmin) {
      document.querySelectorAll('[data-negocio-registro-osinergmin]').forEach(el => {
        el.textContent = `OSINERGMIN ${datos.identidad.registroOsinergmin}`;
      });
    }

    if (datos.identidad?.nombre) {
      document.querySelectorAll('[data-negocio-badge]').forEach(el => {
        const prefijo = el.getAttribute('data-prefijo') || 'DELIVERY OFICIAL';
        el.textContent = `${prefijo} ${datos.identidad.nombre.toUpperCase()}`;
      });
    }

    if (datos.identidad?.imagenSede) {
      document.querySelectorAll('[data-negocio-imagen-sede]').forEach(img => {
        img.setAttribute('src', datos.identidad.imagenSede);
      });
    }

    if (datos.metricas) {
      if (datos.metricas.clientes) {
        document.querySelectorAll('[data-negocio-metrica-clientes]').forEach(el => el.textContent = datos.metricas.clientes);
      }
      if (datos.metricas.balanza) {
        document.querySelectorAll('[data-negocio-metrica-balanza]').forEach(el => el.textContent = datos.metricas.balanza);
      }
      if (datos.metricas.years) {
        document.querySelectorAll('[data-negocio-metrica-years]').forEach(el => el.textContent = datos.metricas.years);
      }
      if (datos.metricas.dias) {
        document.querySelectorAll('[data-negocio-metrica-dias]').forEach(el => el.textContent = datos.metricas.dias);
      }
    }
  }

  function iniciarHero() {
    iniciarSelectorDistritos();

    // 1. Hidratar desde localStorage si el usuario/admin ya guardó cambios
    try {
      const raw = localStorage.getItem('minegocio') || localStorage.getItem('gaswii_negocio_config');
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed) hidratarHeroDesdeNegocio(parsed);
      }
    } catch (e) {}
  }

  // 2. Escuchar evento en vivo emitido al pulsar Guardar Cambios en /personal/negocio/
  window.addEventListener('gaswii:negocio-actualizado', (e: Event) => {
    const customEvt = e as CustomEvent;
    if (customEvt.detail) hidratarHeroDesdeNegocio(customEvt.detail);
  });

  // 3. Sincronizar cambios entre pestañas abiertas
  window.addEventListener('storage', (e) => {
    if (e.key === 'minegocio' && e.newValue) {
      try {
        hidratarHeroDesdeNegocio(JSON.parse(e.newValue));
      } catch (err) {}
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciarHero);
  } else {
    iniciarHero();
  }
  document.addEventListener('astro:page-load', iniciarHero);
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) iniciarHero();
  });
</script>
