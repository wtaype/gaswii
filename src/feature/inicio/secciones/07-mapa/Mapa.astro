---
// src/feature/inicio/secciones/07-mapa/Mapa.astro
// 7. SECCIÓN CENTRAL DE OPERACIONES Y MAPA EMBEBIDO OFICIAL
// Tarjeta Unificada de Cobertura y Despacho en .pagewii (85vw)
import { datosNegocio } from '../../../../negocio.js';
import { resolverIdioma } from '../../idioma/idioma.js';
import es from './idioma/es.json';
import en from './idioma/en.json';
import mapaCss from './mapa.css?inline';

interface Props {
  idioma?: string;
}

const { idioma = 'es' } = Astro.props;
const t = resolverIdioma({ es, en }, idioma);

const direccionSede = datosNegocio.direccionSede;
const telefonoLimpio = datosNegocio.telefonoLimpio;
const telefonoMostrado = datosNegocio.telefonoMostrado || datosNegocio.telefono;
const horarioDespacho = datosNegocio.horario;
const mapsUrl = datosNegocio.mapsUrl;
const coords = datosNegocio.coordenadas || { lat: -12.1177408, lng: -77.0226796 };
const mapEmbedUrl = `https://maps.google.com/maps?q=${coords.lat},${coords.lng}&hl=${idioma}&z=16&output=embed`;
---

<style is:global set:html={mapaCss}></style>

<section id="mapa-sede" class="seccion-mapa section-py-body">
  <div class="pagewii">
    
    <!-- Encabezado de Sección -->
    <header class="mapa-header-box">
      <span class="mapa-top-badge">
        <i class="fa-solid fa-location-dot"></i> 
        <span>{t.top_badge.toUpperCase()}</span>
      </span>
      <h2 class="mapa-main-title">{t.titulo}</h2>
      <p class="mapa-main-desc">{t.subtitulo}</p>
    </header>

    <!-- Contenedor Unificado de Mapa y Seguridad -->
    <div class="clean-card mapa-box-wrapper">
      
      <!-- Fila de Información Central Ejecutiva -->
      <div class="mapa-info-grid">
        
        <!-- Columna 1: Dirección -->
        <div class="mapa-info-col">
          <div class="mapa-icon-box icon-orange">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <div>
            <div class="mapa-info-label">{t.dir_label}</div>
            <div class="mapa-info-val" data-negocio-direccion-sede>{direccionSede}</div>
          </div>
        </div>

        <!-- Columna 2: Horario -->
        <div class="mapa-info-col">
          <div class="mapa-icon-box icon-blue">
            <i class="fa-solid fa-clock"></i>
          </div>
          <div>
            <div class="mapa-info-label">{t.horario_label}</div>
            <div class="mapa-info-val" data-negocio-horario>{horarioDespacho}</div>
          </div>
        </div>

        <!-- Columna 3: Teléfono -->
        <div class="mapa-info-col">
          <div class="mapa-icon-box icon-green">
            <i class="fa-solid fa-phone"></i>
          </div>
          <div>
            <div class="mapa-info-label">{t.tel_label}</div>
            <div class="mapa-info-val" data-negocio-tel-text>{telefonoMostrado}</div>
          </div>
        </div>

        <!-- Columna 4: Botón Abrir Maps -->
        <div class="mapa-btn-col">
          <a 
            href={mapsUrl} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="mapa-btn-action"
            title={t.btn_maps}
            data-negocio-maps
          >
            <i class="fa-solid fa-arrow-up-right-from-square"></i> 
            <span>{t.btn_maps}</span>
          </a>
        </div>

      </div>

      <!-- Mapa Embebido Oficial con Cobertura -->
      <div class="mapa-frame-box">
        <iframe 
          src={mapEmbedUrl} 
          width="100%" 
          height="100%" 
          class="mapa-iframe-embed" 
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade" 
          title="Mapa de Operaciones y Cobertura Delivery Solgas Surquillo"
        ></iframe>
      </div>

    </div>

  </div>
</section>
