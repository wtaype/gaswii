---
import { getI18n, type Idioma } from '../../../core/idioma/idioma';
import negocio from '../../../negocio';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = getI18n(idioma);
---

<div class="modal-overlay" id="modalPedido" onclick="if(event.target===this) cerrarModalPedido()">
  <div class="modal-pedido-box">
    
    <!-- Cabecera del Modal -->
    <div class="modal-header-row">
      <div class="modal-header-brand">
        <i class="fa-solid fa-truck-ramp-box modal-header-icon"></i>
        <div>
          <h3 class="modal-header-title">{t.modales.pedido_titulo}</h3>
          <span class="modal-header-subtitle">
            <i class="fa-solid fa-bolt"></i> {t.modales.pedido_sub}
          </span>
        </div>
      </div>
      <button onclick="cerrarModalPedido()" class="modal-close-btn" aria-label={t.modales.cerrar}>
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Banner VIP Dinámico (Para Clientes Registrados: Cero Digitación) -->
    <div id="modalPedidoVipBanner" class="modal-vip-banner">
      <div class="modal-vip-banner-content">
        <span class="modal-vip-banner-icon"><i class="fa-solid fa-star color-gold"></i></span>
        <span class="modal-vip-banner-text">
          <strong id="modalPedidoVipNombre">¡Hola!</strong> Tus datos habituales se han <strong>autocompletado</strong>. Solo confirma tu pedido.
        </span>
      </div>
      <span class="modal-vip-badge"><i class="fa-solid fa-bolt"></i> VIP</span>
    </div>

    <!-- Banner Visitante (Para Nuevos Clientes: Cero Digitación en Próximas Recargas) -->
    <div id="modalPedidoGuestBanner" class="modal-guest-banner">
      <span class="modal-guest-text">
        <i class="fa-solid fa-bolt color-primary mr-1"></i> <strong class="modal-guest-strong">Guarda tus datos</strong> para pedir en 1 solo clic en tus próximas recargas.
      </span>
      <button type="button" onclick="cerrarModalPedido(); abrirModalLogin();" class="modal-guest-action">
        Crear cuenta
      </button>
    </div>

    <form id="formPedidoExpress" onsubmit="event.preventDefault(); enviarPedidoModalWhatsApp();">
      
      <!-- FILA 1: 3 COLUMNAS (DATOS PERSONALES Y DISTRITO) -->
      <div class="modal-grid-3">
        <div class="form-group">
          <label for="pedNombre"><i class="fa-solid fa-user"></i> {t.modales.nombre_label}</label>
          <input type="text" id="pedNombre" class="form-input" placeholder={t.modales.nombre_ph} required />
        </div>

        <div class="form-group">
          <label for="pedTelefono"><i class="fa-solid fa-phone"></i> {t.modales.tel_label}</label>
          <input type="tel" id="pedTelefono" class="form-input" placeholder={t.modales.tel_ph} required />
        </div>

        <div class="form-group">
          <label for="pedDistrito"><i class="fa-solid fa-location-dot"></i> {t.modales.distrito_label}</label>
          <select id="pedDistrito" class="form-select" required>
            {negocio.distritos.map((d: any) => (
              <option value={d.nombre}>{d.nombre} ({d.tiempo})</option>
            ))}
          </select>
        </div>
      </div>

      <!-- FILA 2: 2 COLUMNAS (DIRECCIÓN Y PRODUCTO) -->
      <div class="modal-grid-2">
        <div class="form-group">
          <label for="pedDireccion" class="modal-label-dir">
            <i class="fa-solid fa-house modal-label-icon"></i> {t.modales.dir_label}
          </label>
          <input 
            type="text" 
            id="pedDireccion" 
            class="form-input" 
            placeholder={t.modales.dir_ph} 
            required 
          />
        </div>

        <div class="form-group">
          <label for="pedProducto"><i class="fa-solid fa-fire"></i> {t.modales.prod_label}</label>
          <select id="pedProducto" class="form-select" required>
            {negocio.productos.map(p => (
              <option value={`${p.nombre} - ${p.precioPEN}`}>
                {p.nombre} - {p.precioPEN}
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- FILA 3: 2 COLUMNAS (MÉTODO DE PAGO E INDICACIONES) -->
      <div class="modal-grid-2">
        <div class="form-group">
          <label for="pedPago"><i class="fa-solid fa-money-bill-wave"></i> {t.modales.pago_label}</label>
          <select id="pedPago" class="form-select" required>
            <option value="Yape">Yape</option>
            <option value="Plin">Plin</option>
            <option value="Transferencia Bancaria">Transferencia Bancaria</option>
            <option value="Efectivo (Monto Exacto)">Efectivo (Monto Exacto)</option>
            <option value="Efectivo (Vuelto de S/ 100)">Efectivo (Vuelto de S/ 100)</option>
            <option value="Efectivo (Vuelto de S/ 50)">Efectivo (Vuelto de S/ 50)</option>
          </select>
        </div>

        <div class="form-group">
          <label for="pedComentarios"><i class="fa-solid fa-comment-dots"></i> {t.modales.notas_label}</label>
          <input type="text" id="pedComentarios" class="form-input" placeholder={t.modales.notas_ph} />
        </div>
      </div>

      <!-- FILA 4: BOTÓN DE ENVÍO DIRECTO A WHATSAPP -->
      <div class="modal-submit-container">
        <button type="submit" class="btn-whatsapp modal-btn-whatsapp-submit">
          <i class="fa-brands fa-whatsapp modal-btn-whatsapp-icon"></i> {t.modales.btn_enviar} ({negocio.telefonoMostrado || '+51 936 369 384'})
        </button>
        <div class="modal-footer-notice">
          <i class="fa-solid fa-shield-halved"></i> {idioma === 'en' ? 'Guaranteed exact weight from Solgas plant and central hub with free leak test.' : 'Peso exacto garantizado de planta Solgas y base central con prueba de fugas gratuita.'}
        </div>
      </div>

    </form>
  </div>
</div>
