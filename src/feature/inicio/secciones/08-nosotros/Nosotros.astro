---
// src/feature/inicio/secciones/08-nosotros/Nosotros.astro
// 8. SECCIÓN NOSOTROS · AUTORIDAD HISTÓRICA Y ACREDITACIÓN OFICIAL
// 2 Tarjetas Fotográficas + Autoridad CRO en .pagewii (85vw)
import { datosNegocio } from '../../../../negocio.js';
import { crearEnlaceWhatsApp } from '../../lib/whatsapp.js';
import { imgwii } from '@widev';
import { resolverIdioma } from '../../idioma/idioma.js';
import es from './idioma/es.json';
import en from './idioma/en.json';
import nosotrosCss from './nosotros.css?inline';

interface Props {
  idioma?: string;
}

const { idioma = Astro.props.idioma || Astro.currentLocale || 'es' } = Astro.props;
const t = resolverIdioma({ es, en }, idioma);

const telefonoLimpio = datosNegocio.telefonoLimpio;
const telefonoMostrado = datosNegocio.telefonoMostrado || datosNegocio.telefono;
const anosExp = String(datosNegocio.experienciaAnos || 26);
const distritoNombre = (datosNegocio.distritoSede || 'Surquillo').toUpperCase();

const anosBadgeTemplate = t.anos_badge || '{anos} AÑOS DE EXPERIENCIA EN {distrito}';
const anosBadgeTexto = anosBadgeTemplate.replace('{anos}', anosExp).replace('{distrito}', distritoNombre);

const wsLink = crearEnlaceWhatsApp({
  origen: 'Web Inicio - Distribuidor Autorizado',
  detalle: 'Deseo pedir un balón con su garantía de distribuidor oficial autorizado'
});
---

<style is:global set:html={nosotrosCss}></style>

<section id="nosotros" class="seccion-nosotros section-py-surface">
  <div class="pagewii">
    <div class="nosotros-split items-center">
      
      <!-- Columna Izquierda: 2 Tarjetas Fotográficas (Flota Oficial + Medalla Rendidor) -->
      <div class="nosotros-media-grid">
        
        <!-- Tarjeta 1: Balones Oficiales -->
        <div class="nosotros-card-photo">
          <div class="nosotros-img-box">
            <img 
              src={imgwii.svg} 
              data-src="/imgwii/01-solgas-surquillo.webp" 
              alt="Flota de balones oficiales Solgas" 
              class="nosotros-card-img wi_skeleton" 
              decoding="async" 
              width="300" 
              height="220"
            />
          </div>
          <div class="nosotros-img-caption">{t.pie_foto_1}</div>
        </div>

        <!-- Tarjeta 2: Medalla El Balón Más Rendidor -->
        <div class="nosotros-card-photo">
          <div class="nosotros-img-box">
            <img 
              src={imgwii.svg} 
              data-src="/imgwii/07-solgas-surquillo-rendidor.webp" 
              alt="Garantía Solgas S.A. El balón más rendidor" 
              class="nosotros-card-img wi_skeleton" 
              decoding="async" 
              width="300" 
              height="220"
            />
          </div>
          <div class="nosotros-img-caption">{t.pie_foto_2}</div>
        </div>

      </div>

      <!-- Columna Derecha: Autoridad, Años de Trayectoria y Botones -->
      <div>
        <span class="nosotros-badge">
          <i class="fa-solid fa-award"></i> 
          <span data-negocio-metrica-years>{anosBadgeTexto}</span>
        </span>

        <h2 class="nosotros-title">{t.titulo}</h2>
        <p class="nosotros-text">{t.parrafo_1}</p>
        <p class="nosotros-text">{t.parrafo_2}</p>

        <div class="nosotros-actions">
          <a 
            href={`tel:${telefonoLimpio}`} 
            class="btn-nosotros-call"
            title={`${t.btn_llamar} ${telefonoMostrado}`}
            data-negocio-tel-link
          >
            <i class="fa-solid fa-phone"></i> 
            <span>{t.btn_llamar} <span data-negocio-tel-text>{telefonoMostrado}</span></span>
          </a>

          <a 
            href={wsLink} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-nosotros-wa"
            title={t.btn_ws}
            data-negocio-ws-link
          >
            <i class="fa-brands fa-whatsapp"></i> 
            <span>{t.btn_ws}</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
