---
// src/feature/inicio/secciones/02-productos/Productos.astro
// 2. SECCIÓN PRODUCTOS CRO AUTÓNOMA · CATÁLOGO OFICIAL SOLGAS
// Diseño Oficial CRO: 4 Columnas sobre .pagewii (85vw), Marco Blanco y Dual CTA
// Consumo 100% Real de Firestore + Caché Local-First (0 semillas ficticias)
import { datosNegocio, consultarProductosFirestoreFresco } from '../../../../negocio.js';
import { crearEnlaceWhatsApp } from '../../lib/whatsapp.js';
import { imgwii } from '@widev';
import { resolverIdioma } from '../../idioma/idioma.js';
import es from './idioma/es.json';
import en from './idioma/en.json';
import prodsCss from './productos.css?inline';

interface Props {
  idioma?: string;
}

const { idioma = Astro.props.idioma || Astro.currentLocale || 'es' } = Astro.props;
const t = resolverIdioma({ es, en }, idioma);

// Consulta fresca directa de Firestore
const prodsActivos = await consultarProductosFirestoreFresco();
const telefonoLimpio = datosNegocio.telefonoLimpio;
const whatsappNumero = datosNegocio.whatsapp;
---

<style is:global set:html={prodsCss}></style>

<section id="productos" class="sec-productos section-py-body">
  <div class="pagewii sec-prods-container">
    
    <!-- Encabezado Oficial de la Sección -->
    <header class="sec-prods-header">
      <span class="sec-prods-badge">
        <i class="fa-solid fa-boxes-stacked"></i> <span>{t.badge.toUpperCase()}</span>
      </span>
      <h2 class="sec-prods-title">{t.titulo}</h2>
      <p class="sec-prods-sub">{t.subtitulo}</p>
    </header>

    <!-- Grid de Balones (4 Columnas en Desktop sobre .pagewii 85vw) -->
    {prodsActivos.length > 0 ? (
      <div 
        class="catalog-grid sec-prods-grid" 
        id="publicProdsGrid"
        data-idioma={idioma}
        data-ws-num={whatsappNumero}
        data-tel-limpio={telefonoLimpio}
        data-labels={JSON.stringify(t)}
      >
        {prodsActivos.map((p: any) => {
          const langSuffix = idioma.charAt(0).toUpperCase() + idioma.slice(1);
          const nombre = (idioma !== 'es' && p[`nombre${langSuffix}`]) || (typeof p.nombre === 'object' ? (p.nombre[idioma] || p.nombre.es) : p.nombre) || '';
          const peso = (idioma !== 'es' && p[`peso${langSuffix}`]) || (typeof p.peso === 'object' ? (p.peso[idioma] || p.peso.es) : p.peso) || '10 kg';
          const pesoFull = (idioma !== 'es' && p[`pesoFull${langSuffix}`]) || (typeof p.pesoFull === 'object' ? (p.pesoFull[idioma] || p.pesoFull.es) : p.pesoFull);
          const valvula = (idioma !== 'es' && p[`valvula${langSuffix}`]) || (typeof p.valvula === 'object' ? (p.valvula[idioma] || p.valvula.es) : p.valvula) || 'Click-On';
          const seguridad = (idioma !== 'es' && p[`seguridad${langSuffix}`]) || (typeof p.seguridad === 'object' ? (p.seguridad[idioma] || p.seguridad.es) : p.seguridad) || 'Precinto verificado';
          
          let garantias: string[] = [];
          if (p.garantias) {
            if (typeof p.garantias === 'object' && !Array.isArray(p.garantias)) {
              garantias = p.garantias[idioma] || p.garantias['es'] || [];
            } else if (Array.isArray(p.garantias)) {
              garantias = p.garantias;
            }
          } else if (Array.isArray(p.caracteristicas)) {
            const carLang = idioma !== 'es' ? p[`caracteristicas${langSuffix}`] : null;
            garantias = Array.isArray(carLang) && carLang.length > 0 ? carLang : p.caracteristicas;
          }
          
          // Clasificación visual de tarjetas
          const es45 = p.id.includes('45') || nombre.includes('45');
          const esMasgas = p.id.includes('masgas') || nombre.toLowerCase().includes('masgas');
          const esRegulador = p.tipoCategoria === 'accesorio' || nombre.toLowerCase().includes('regulador');

          let pillHighlightTexto = t.pill_popular || 'Más Pedido';
          let pillHighlightClase = 'badge-fire';
          let pillHighlightIcon = 'fa-solid fa-star';
          let pillContexto = t.pill_hogar || 'Hogar';
          let capacidadTexto = t.capacidad_10kg || '10 kg Neto';
          let precioCaption = t.precio_exacto_label;

          if (es45) {
            pillHighlightTexto = t.pill_comercial || 'Comercial';
            pillHighlightClase = 'badge-blue';
            pillHighlightIcon = 'fa-solid fa-store';
            pillContexto = t.pill_negocio || 'Negocio';
            capacidadTexto = t.capacidad_45kg || '45 kg Neto';
            precioCaption = t.precio_comercial_label;
          } else if (esMasgas) {
            pillHighlightTexto = t.pill_economico || 'Económico';
            pillHighlightClase = 'badge-emerald';
            pillHighlightIcon = 'fa-solid fa-wallet';
            pillContexto = t.pill_ahorro || 'Ahorro';
            capacidadTexto = t.capacidad_10kg || '10 kg Neto';
            precioCaption = t.precio_ahorro_label;
          } else if (esRegulador) {
            pillHighlightTexto = t.pill_antifugas || 'Antifugas';
            pillHighlightClase = 'badge-gold';
            pillHighlightIcon = 'fa-solid fa-shield-halved';
            pillContexto = t.pill_seguridad || 'Seguridad';
            capacidadTexto = 'Click-On';
            precioCaption = t.precio_seguridad_label;
          }

          // Marca para encabezado de garantías
          const nombreMarca = esMasgas ? 'MASGAS' : 'SOLGAS';
          const guaranteeHeader = `${nombreMarca} ${t.garantia_titulo.toUpperCase()}`;

          // Mensaje de WhatsApp con atribución inteligente
          const precioActual = p.precioPEN || p.precio || null;
          const wsLink = crearEnlaceWhatsApp({
            origen: `Web Inicio - Card ${nombre}`,
            producto: nombre,
            precio: precioActual
          });

          return (
            <article class="clean-card producto-card-box card-balon" data-prod-id={p.id}>
              <!-- Contenido Superior de la Tarjeta -->
              <div class="card-main-content">
                <!-- Cabecera: Badges Superior Izquierdo y Derecho -->
                <div class="producto-top-bar card-header-pills">
                  <span class={`producto-badge ${pillHighlightClase}`}>
                    <i class={pillHighlightIcon}></i>
                    <span>{pillHighlightTexto}</span>
                  </span>
                  <span class="producto-tipo-badge">{pillContexto}</span>
                </div>

                <!-- Imagen en Caja Blanca con Pastilla Flotante de Capacidad -->
                <div class="producto-media-frame card-img-box">
                  <img 
                    src={imgwii.svg} 
                    data-src={p.imagen} 
                    alt={nombre} 
                    class="producto-img-tag card-img wi_skeleton" 
                    decoding="async" 
                    width="220"
                    height="220"
                  />
                  <div class="producto-capacidad-tag card-weight-pill">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>{capacidadTexto}</span>
                  </div>
                </div>

                <!-- Título Oficial -->
                <h3 class="card-title">{nombre}</h3>

                <!-- 3 Filas de Especificaciones Clave con Iconos de Color -->
                <ul class="card-specs-list">
                  <li class="card-spec-row">
                    <i class="fa-solid fa-tag card-spec-icon valve"></i>
                    <span><strong class="card-spec-label">{t.valvula_label}</strong>{valvula}</span>
                  </li>
                  <li class="card-spec-row">
                    <i class="fa-solid fa-scale-balanced card-spec-icon weight"></i>
                    <span><strong class="card-spec-label">{t.peso_label}</strong>{pesoFull || peso}</span>
                  </li>
                  <li class="card-spec-row">
                    <i class="fa-solid fa-shield-halved card-spec-icon safety"></i>
                    <span><strong class="card-spec-label">{t.seguridad_label}</strong>{seguridad}</span>
                  </li>
                </ul>

                <!-- Checklist de Garantías Oficiales -->
                <div class="card-guarantee-box">
                  <span class="card-guarantee-heading">{guaranteeHeader}</span>
                  <ul class="card-guarantee-list">
                    {garantias.slice(0, 4).map((g: string) => (
                      <li class="card-guarantee-item">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>{g}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Contenido Inferior de la Tarjeta (Alineado Abajo) -->
              <div class="card-footer-content">
                <!-- Bloque de Precio + Delivery -->
                <div class="card-price-row">
                  <div class="card-price-col-left">
                    <span class="card-price-caption">{precioCaption}</span>
                    <div class="producto-price-val card-price-value">
                      <span class="card-price-curr">S/</span>
                      <span data-price-id={p.id}>{p.precioPEN ? p.precioPEN.toFixed(2) : (p.precio ? Number(p.precio).toFixed(2) : '0.00')}</span>
                    </div>
                  </div>

                  <div class="card-price-col-right">
                    <span class="card-delivery-caption">{t.delivery_label}</span>
                    <span class="card-delivery-badge">{t.delivery_incluido}</span>
                  </div>
                </div>

                <!-- Botones de Acción Dual: WhatsApp (80%) + Teléfono (20%) -->
                <div class="card-actions">
                  <a 
                    href={wsLink} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn-whatsapp btn-card-ws"
                    title={t.btn_ws}
                  >
                    <i class="fa-brands fa-whatsapp"></i>
                    <span>{t.btn_ws}</span>
                  </a>

                  <a 
                    href={`tel:${telefonoLimpio}`} 
                    class="btn-call btn-card-call"
                    title={t.btn_llamar}
                  >
                    <i class="fa-solid fa-phone"></i>
                  </a>
                </div>
              </div>

            </article>
          );
        })}
      </div>
    ) : (
      <div style="text-align: center; padding: 40px; color: var(--muted, #94a3b8);">
        <p>{t.sin_productos}</p>
      </div>
    )}

  </div>
</section>

<!-- Reactividad Local-First: Reconciliación en tiempo real con la caché -->
<script>
  import { imgwii } from '@widev';

  function renderCardClient(p: any, lang: string, labels: any, wsNum: string, telLimpio: string) {
    const id = String(p.id || p.slug || '');
    const langSuffix = lang.charAt(0).toUpperCase() + lang.slice(1);
    
    const getLangVal = (field: any, altKey?: string) => {
      if (typeof field === 'object' && field !== null) {
        return field[lang] || field['es'] || Object.values(field)[0] || '';
      }
      if (altKey && lang !== 'es' && p[altKey]) {
        return String(p[altKey]);
      }
      return String(field || '');
    };

    const nombre = getLangVal(p.nombre, `nombre${langSuffix}`) || p.nombre || '';
    const peso = getLangVal(p.peso, `peso${langSuffix}`) || p.peso || '10 kg';
    const pesoFull = getLangVal(p.pesoFull, `pesoFull${langSuffix}`) || p.pesoFull;
    const valvula = getLangVal(p.valvula, `valvula${langSuffix}`) || p.valvula || 'Click-On';
    const seguridad = getLangVal(p.seguridad, `seguridad${langSuffix}`) || p.seguridad || 'Precinto verificado';

    let garantias: string[] = [];
    if (p.garantias) {
      if (typeof p.garantias === 'object' && !Array.isArray(p.garantias)) {
        garantias = p.garantias[lang] || p.garantias['es'] || [];
      } else if (Array.isArray(p.garantias)) {
        garantias = p.garantias;
      }
    } else if (Array.isArray(p.caracteristicas)) {
      const carLang = lang !== 'es' ? p[`caracteristicas${langSuffix}`] : null;
      garantias = Array.isArray(carLang) && carLang.length > 0 ? carLang : p.caracteristicas;
    }

    const es45 = id.includes('45') || nombre.includes('45');
    const esMasgas = id.includes('masgas') || nombre.toLowerCase().includes('masgas');
    const esRegulador = p.tipoCategoria === 'accesorio' || nombre.toLowerCase().includes('regulador');

    let pillHighlightTexto = labels.pill_popular || 'Más Pedido';
    let pillHighlightClase = 'badge-fire';
    let pillHighlightIcon = 'fa-solid fa-star';
    let pillContexto = labels.pill_hogar || 'Hogar';
    let capacidadTexto = labels.capacidad_10kg || '10 kg Neto';
    let precioCaption = labels.precio_exacto_label || 'Garantía de peso exacto';

    if (es45) {
      pillHighlightTexto = labels.pill_comercial || 'Comercial';
      pillHighlightClase = 'badge-blue';
      pillHighlightIcon = 'fa-solid fa-store';
      pillContexto = labels.pill_negocio || 'Negocio';
      capacidadTexto = labels.capacidad_45kg || '45 kg Neto';
      precioCaption = labels.precio_comercial_label || 'Tarifa especial negocios';
    } else if (esMasgas) {
      pillHighlightTexto = labels.pill_economico || 'Económico';
      pillHighlightClase = 'badge-emerald';
      pillHighlightIcon = 'fa-solid fa-wallet';
      pillContexto = labels.pill_ahorro || 'Ahorro';
      capacidadTexto = labels.capacidad_10kg || '10 kg Neto';
      precioCaption = labels.precio_ahorro_label || 'Opción más económica';
    } else if (esRegulador) {
      pillHighlightTexto = labels.pill_antifugas || 'Antifugas';
      pillHighlightClase = 'badge-gold';
      pillHighlightIcon = 'fa-solid fa-shield-halved';
      pillContexto = labels.pill_seguridad || 'Seguridad';
      capacidadTexto = 'Click-On';
      precioCaption = labels.precio_seguridad_label || 'Instalación y prueba GRATIS';
    }

    const nombreMarca = esMasgas ? 'MASGAS' : 'SOLGAS';
    const guaranteeHeader = `${nombreMarca} ${(labels.garantia_titulo || 'Garantía Solgas').toUpperCase()}`;
    const precioNum = Number(p.precio ?? p.precioPEN ?? 0).toFixed(2);

    const wsMsg = `¡Hola Solgas Surquillo! 👋\nHe visto en su página web y deseo consultar / pedir:\n\n🏷️ Origen: [Web Inicio - Card ${nombre}]\n📦 Producto: ${nombre} (S/ ${precioNum})\n\n¿Podrían confirmarme la atención, por favor? ¡Muchas gracias!`;
    const wsLink = `https://wa.me/${wsNum}?text=${encodeURIComponent(wsMsg)}`;

    const garantiasHtml = garantias.slice(0, 4).map(g => `
      <li class="card-guarantee-item">
        <i class="fa-solid fa-circle-check"></i>
        <span>${g}</span>
      </li>
    `).join('');

    return `
      <article class="clean-card producto-card-box card-balon" data-prod-id="${id}">
        <div class="card-main-content">
          <div class="producto-top-bar card-header-pills">
            <span class="producto-badge ${pillHighlightClase}">
              <i class="${pillHighlightIcon}"></i>
              <span>${pillHighlightTexto}</span>
            </span>
            <span class="producto-tipo-badge">${pillContexto}</span>
          </div>

          <div class="producto-media-frame card-img-box">
            <img 
              src="/wpuntos.svg" 
              data-src="${p.imagen || '/imgwii/productos/BALON-10KG.webp'}" 
              alt="${nombre}" 
              class="producto-img-tag card-img wi_skeleton" 
              decoding="async" 
              width="220"
              height="220"
            />
            <div class="producto-capacidad-tag card-weight-pill">
              <i class="fa-solid fa-circle-check"></i>
              <span>${capacidadTexto}</span>
            </div>
          </div>

          <h3 class="card-title">${nombre}</h3>

          <ul class="card-specs-list">
            <li class="card-spec-row">
              <i class="fa-solid fa-tag card-spec-icon valve"></i>
              <span><strong class="card-spec-label">${labels.valvula_label || 'Válvula:'}</strong>${valvula}</span>
            </li>
            <li class="card-spec-row">
              <i class="fa-solid fa-scale-balanced card-spec-icon weight"></i>
              <span><strong class="card-spec-label">${labels.peso_label || 'Peso:'}</strong>${pesoFull || peso}</span>
            </li>
            <li class="card-spec-row">
              <i class="fa-solid fa-shield-halved card-spec-icon safety"></i>
              <span><strong class="card-spec-label">${labels.seguridad_label || 'Seguridad:'}</strong>${seguridad}</span>
            </li>
          </ul>

          <div class="card-guarantee-box">
            <span class="card-guarantee-heading">${guaranteeHeader}</span>
            <ul class="card-guarantee-list">
              ${garantiasHtml}
            </ul>
          </div>
        </div>

        <div class="card-footer-content">
          <div class="card-price-row">
            <div class="card-price-col-left">
              <span class="card-price-caption">${precioCaption}</span>
              <div class="producto-price-val card-price-value">
                <span class="card-price-curr">S/</span>
                <span data-price-id="${id}">${precioNum}</span>
              </div>
            </div>

            <div class="card-price-col-right">
              <span class="card-delivery-caption">${labels.delivery_label || 'Despacho en puerta'}</span>
              <span class="card-delivery-badge">${labels.delivery_incluido || 'Incluido'}</span>
            </div>
          </div>

          <div class="card-actions">
            <a 
              href="${wsLink}" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn-whatsapp btn-card-ws"
              title="${labels.btn_ws || 'Pedir por WhatsApp'}"
            >
              <i class="fa-brands fa-whatsapp"></i>
              <span>${labels.btn_ws || 'Pedir por WhatsApp'}</span>
            </a>

            <a 
              href="tel:${telLimpio}" 
              class="btn-call btn-card-call"
              title="${labels.btn_llamar || 'Llamar para pedir'}"
            >
              <i class="fa-solid fa-phone"></i>
            </a>
          </div>
        </div>
      </article>
    `;
  }

  function sincronizarCatalogoLocalFirst() {
    try {
      const grid = document.getElementById('publicProdsGrid');
      if (!grid) return;

      const raw = localStorage.getItem('gaswii_productos');
      if (!raw) return;
      const prods = JSON.parse(raw);
      if (!Array.isArray(prods) || prods.length === 0) return;

      const activos = prods
        .filter((p: any) => p.estado !== 'pausado' && p.estado !== 'inactivo')
        .sort((a: any, b: any) => (Number(a.orden ?? 999)) - (Number(b.orden ?? 999)));

      const domCards = Array.from(grid.querySelectorAll('.card-balon'));
      const domIds = domCards.map(c => c.getAttribute('data-prod-id'));
      const cacheIds = activos.map((p: any) => String(p.id || p.slug));

      const sonIguales = domIds.length === cacheIds.length && 
        domIds.every((id, idx) => id === cacheIds[idx]);

      if (sonIguales) {
        activos.forEach((p: any) => {
          const id = String(p.id || p.slug);
          const el = grid.querySelector(`[data-price-id="${id}"]`);
          if (el && p.precio !== undefined) {
            el.textContent = Number(p.precio).toFixed(2);
          }
        });
        return;
      }

      // Reconstruir si la cantidad o los IDs difieren
      const lang = grid.getAttribute('data-idioma') || 'es';
      const wsNum = grid.getAttribute('data-ws-num') || '';
      const telLimpio = grid.getAttribute('data-tel-limpio') || '';
      let labels = {};
      try {
        labels = JSON.parse(grid.getAttribute('data-labels') || '{}');
      } catch (e) {}

      grid.innerHTML = activos.map((p: any) => renderCardClient(p, lang, labels, wsNum, telLimpio)).join('');
      imgwii.ver('#publicProdsGrid');
    } catch (e) {
      console.warn('[catalogo] Sincronización Local-First:', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', sincronizarCatalogoLocalFirst);
  } else {
    sincronizarCatalogoLocalFirst();
  }

  window.addEventListener('gaswii:productos-actualizados', sincronizarCatalogoLocalFirst);
  window.addEventListener('storage', (e) => {
    if (e.key === 'gaswii_productos') sincronizarCatalogoLocalFirst();
  });
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) sincronizarCatalogoLocalFirst();
  });

  // Revalidación Inteligente en Segundo Plano (SWR): 0ms bloqueo en FCP/LCP inicial
  async function revalidarCatalogoEnBackground() {
    try {
      const res = await fetch('https://firestore.googleapis.com/v1/projects/gaswii/databases/(default)/documents/productos');
      if (!res.ok) return;
      const data = await res.json();
      if (!Array.isArray(data.documents) || data.documents.length === 0) return;

      const prodsFrescos = data.documents.map((d: any) => {
        const f = d.fields || {};
        const id = (d.name || '').split('/').pop() || '';
        return {
          id,
          slug: f.slug?.stringValue || id,
          nombre: f.nombre?.mapValue ? {
            es: f.nombre.mapValue.fields?.es?.stringValue || '',
            en: f.nombre.mapValue.fields?.en?.stringValue || ''
          } : (f.nombre?.stringValue || ''),
          precio: Number(f.precio?.doubleValue ?? f.precio?.integerValue ?? f.precioPEN?.doubleValue ?? f.precioPEN?.integerValue ?? 0),
          stock: Number(f.stock?.integerValue ?? f.stock?.doubleValue ?? 0),
          estado: f.estado?.stringValue || 'activo',
          tipoCategoria: f.tipoCategoria?.stringValue || 'gas',
          tipoUso: f.tipoUso?.mapValue ? {
            es: f.tipoUso.mapValue.fields?.es?.stringValue || '',
            en: f.tipoUso.mapValue.fields?.en?.stringValue || ''
          } : (f.tipoUso?.stringValue || ''),
          valvula: f.valvula?.mapValue ? {
            es: f.valvula.mapValue.fields?.es?.stringValue || '',
            en: f.valvula.mapValue.fields?.en?.stringValue || ''
          } : (f.valvula?.stringValue || ''),
          peso: f.peso?.mapValue ? {
            es: f.peso.mapValue.fields?.es?.stringValue || '',
            en: f.peso.mapValue.fields?.en?.stringValue || ''
          } : (f.peso?.stringValue || ''),
          pesoFull: f.pesoFull?.mapValue ? {
            es: f.pesoFull.mapValue.fields?.es?.stringValue || '',
            en: f.pesoFull.mapValue.fields?.en?.stringValue || ''
          } : (f.pesoFull?.stringValue || ''),
          seguridad: f.seguridad?.mapValue ? {
            es: f.seguridad.mapValue.fields?.es?.stringValue || '',
            en: f.seguridad.mapValue.fields?.en?.stringValue || ''
          } : (f.seguridad?.stringValue || ''),
          imagen: f.imagen?.stringValue || '/imgwii/productos/BALON-10KG.webp',
          orden: Number(f.orden?.integerValue ?? 1)
        };
      });

      localStorage.setItem('gaswii_productos', JSON.stringify(prodsFrescos));
      sincronizarCatalogoLocalFirst();
    } catch (e) {}
  }

  if (typeof window !== 'undefined') {
    if ('requestIdleCallback' in window) {
      (window as any).requestIdleCallback(() => revalidarCatalogoEnBackground(), { timeout: 2000 });
    } else {
      setTimeout(revalidarCatalogoEnBackground, 1200);
    }
  }
</script>
