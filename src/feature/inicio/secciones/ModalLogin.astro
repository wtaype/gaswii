---
// src/feature/inicio/secciones/ModalLogin.astro
// Modal de Autenticación Solgas Surquillo (100% Cero CSS Inline)
import authEs from '../../auth/idioma/es.json';
import authEn from '../../auth/idioma/en.json';
import type { Idioma } from '../../../core/idioma/idioma';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = idioma === 'en' ? authEn : authEs;
---

<div class="modal-overlay" id="modalLogin" onclick="if(event.target===this) window.cerrarModalLogin && window.cerrarModalLogin()">
  <div class="modal-login-box" id="modalLoginBox">
    
    <div class="auth-header">
      <div class="auth-header-info">
        <i class="fa-solid fa-circle-user auth-header-icon" id="modalAuthIcon"></i>
        <div>
          <h3 id="modalAuthTitulo" class="auth-title">{t.login_titulo}</h3>
          <span id="modalAuthSub" class="auth-sub">{t.login_sub}</span>
        </div>
      </div>
      <button type="button" onclick="window.cerrarModalLogin && window.cerrarModalLogin()" class="auth-close-btn" aria-label="Cerrar">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Mensaje de Feedback / Error -->
    <div id="authFeedback" class="auth-feedback"></div>

    <form id="formAuth" onsubmit="event.preventDefault(); window.procesarAuth && window.procesarAuth();">
      
      <!-- ================= MODO LOGIN ================= -->
      <div id="seccionLoginCampos">
        <div class="form-group auth-form-group">
          <label for="loginUsuarioOrEmail"><i class="fa-solid fa-user"></i> {t.usuario_o_correo_label}</label>
          <input type="text" id="loginUsuarioOrEmail" class="form-input" placeholder={t.usuario_o_correo_ph} autocomplete="username" />
        </div>

        <div class="form-group auth-form-group mb-2">
          <label for="loginPass"><i class="fa-solid fa-lock"></i> {t.pass_label}</label>
          <input type="password" id="loginPass" class="form-input" placeholder="••••••••" autocomplete="current-password" />
        </div>
      </div>

      <!-- ================= MODO REGISTRO (DOS COLUMNAS) ================= -->
      <div id="seccionRegistroCampos" class="auth-register-container is-oculto">
        <div class="auth-grid-2col">
          <!-- Fila 1 -->
          <div class="form-group auth-form-group">
            <label for="regNombre"><i class="fa-solid fa-user"></i> {t.nombre_label}</label>
            <input type="text" id="regNombre" class="form-input" placeholder={t.nombre_ph} />
          </div>

          <div class="form-group auth-form-group">
            <label for="regCelular"><i class="fa-solid fa-mobile-screen"></i> {t.celular_label}</label>
            <input type="tel" id="regCelular" class="form-input" placeholder={t.celular_ph} />
          </div>

          <!-- Fila 2 -->
          <div class="form-group auth-form-group">
            <label for="regUsuario"><i class="fa-solid fa-at"></i> {t.usuario_label}</label>
            <input type="text" id="regUsuario" class="form-input" placeholder={t.usuario_ph} autocomplete="off" />
          </div>

          <div class="form-group auth-form-group">
            <label for="regEmail"><i class="fa-solid fa-envelope"></i> {t.correo_label}</label>
            <input type="email" id="regEmail" class="form-input" placeholder={t.correo_ph} autocomplete="off" />
          </div>

          <!-- Fila 3 -->
          <div class="form-group auth-form-group">
            <label for="regPassword"><i class="fa-solid fa-lock"></i> {t.pass_label}</label>
            <input type="password" id="regPassword" class="form-input" placeholder={t.pass_ph} />
          </div>

          <div class="form-group auth-form-group">
            <label for="regPasswordConfirm"><i class="fa-solid fa-shield-halved"></i> {t.pass_confirm_label}</label>
            <input type="password" id="regPasswordConfirm" class="form-input" placeholder={t.pass_confirm_ph} />
          </div>
        </div>
      </div>

      <!-- ================= MODO RECUPERAR ================= -->
      <div id="seccionRecuperarCampos" class="auth-recuperar-container is-oculto">
        <div class="form-group auth-form-group mb-2">
          <label for="recuperarInput"><i class="fa-solid fa-envelope-open-text"></i> {t.usuario_o_correo_label}</label>
          <input type="text" id="recuperarInput" class="form-input" placeholder={t.usuario_o_correo_ph} />
        </div>
      </div>

      <!-- ================= ENLACES EN DOS COLUMNAS CON PALABRAS CORTAS ================= -->
      <div class="auth-links-row">
        <a href="#" id="toggleModoAuth" onclick="event.preventDefault(); window.alternarModoAuth && window.alternarModoAuth();" class="auth-toggle-link">
          <i class="fa-solid fa-user-plus" id="toggleModoAuthIcon"></i> <span id="toggleModoAuthText">{t.link_crear_cuenta}</span>
        </a>
        <a href="#" id="btnOlvidasteClave" onclick="event.preventDefault(); window.alternarModoRecuperar && window.alternarModoRecuperar();" class="auth-forgot-link">
          <i class="fa-solid fa-key" id="btnOlvidasteIcon"></i> <span id="btnOlvidasteText">{t.link_olvidaste}</span>
        </a>
      </div>

      <button type="submit" id="btnSubmitAuth" class="btn-fire auth-btn-submit">
        <i class="fa-solid fa-right-to-bracket" id="btnSubmitAuthIcon"></i> <span id="btnSubmitAuthText">{t.btn_login}</span>
      </button>

      <button type="button" id="btnGoogleLogin" onclick="window.loginConGoogle && window.loginConGoogle();" class="btn-clean auth-btn-google">
        <i class="fa-brands fa-google color-google"></i> <span>{t.btn_google}</span>
      </button>
    </form>

    <div class="auth-direct-order-box">
      {t.sin_cuenta_pregunta} <a href="#" onclick="window.cerrarModalLogin && window.cerrarModalLogin(); window.abrirModalPedido && window.abrirModalPedido();" class="auth-direct-link">{t.sin_cuenta_accion}</a>
    </div>
  </div>
</div>
