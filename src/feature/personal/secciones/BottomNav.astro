---
// src/feature/personal/secciones/BottomNav.astro
// Barra de navegación inferior táctil para smartphones y repartidores en ruta

interface Props {
  tabs: {
    resumen: string;
    productos: string;
    clientes: string;
    personales: string;
    sunat: string;
    whatsapp: string;
  };
}

const { tabs } = Astro.props;
---

<nav class="v51-bottom-nav">
  <div class="v51-bottom-nav-grid">
    <button class="v51-bottom-nav-item active" data-tab="tab-resumen" type="button">
      <i class="fa-solid fa-house"></i>
      <span>{tabs.resumen}</span>
    </button>
    <button class="v51-bottom-nav-item" data-tab="tab-productos" type="button">
      <i class="fa-solid fa-boxes-stacked"></i>
      <span>{tabs.productos}</span>
    </button>
    <button class="v51-bottom-nav-item" data-tab="tab-clientes" type="button">
      <i class="fa-solid fa-users"></i>
      <span>{tabs.clientes}</span>
    </button>
    <button class="v51-bottom-nav-item" data-tab="tab-personales" type="button">
      <i class="fa-solid fa-id-badge"></i>
      <span>{tabs.personales}</span>
    </button>
    <button class="v51-bottom-nav-item" data-tab="tab-sunat" type="button">
      <i class="fa-solid fa-receipt"></i>
      <span>{tabs.sunat}</span>
    </button>
    <button class="v51-bottom-nav-item" data-tab="tab-whatsapp" type="button">
      <i class="fa-brands fa-whatsapp"></i>
      <span>{tabs.whatsapp}</span>
    </button>
  </div>
</nav>
