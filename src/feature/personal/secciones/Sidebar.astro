---
// src/feature/personal/secciones/Sidebar.astro
// Menú lateral desktop con navegación por pestañas y botón CTA

interface Props {
  t: {
    modulos_titulo: string;
    cta_registrar_cliente: string;
    ajustes: string;
    mi_cuenta: string;
    colapsar_menu: string;
  };
  tabs: {
    resumen: string;
    productos: string;
    clientes: string;
    personales: string;
    sunat: string;
    whatsapp: string;
  };
}

const { t, tabs } = Astro.props;
---

<aside class="v51-sidebar" id="v51Sidebar">
  <div>
    <div class="v51-sidebar-section-title">
      <span>{t.modulos_titulo}</span>
    </div>

    <!-- Navegación Principal en Píldora Solgas -->
    <nav class="v51-nav">
      <button class="v51-nav-btn active" data-tab="tab-resumen" type="button">
        <div class="v51-nav-btn-inner">
          <i class="fa-solid fa-house"></i>
          <span>{tabs.resumen}</span>
        </div>
      </button>

      <button class="v51-nav-btn" data-tab="tab-productos" type="button">
        <div class="v51-nav-btn-inner">
          <i class="fa-solid fa-boxes-stacked"></i>
          <span>{tabs.productos}</span>
        </div>
        <span class="v51-badge">4</span>
      </button>

      <button class="v51-nav-btn" data-tab="tab-clientes" type="button">
        <div class="v51-nav-btn-inner">
          <i class="fa-solid fa-users"></i>
          <span>{tabs.clientes}</span>
        </div>
        <span class="v51-badge">5</span>
      </button>

      <button class="v51-nav-btn" data-tab="tab-personales" type="button">
        <div class="v51-nav-btn-inner">
          <i class="fa-solid fa-id-badge"></i>
          <span>{tabs.personales}</span>
        </div>
        <span class="v51-badge">5</span>
      </button>

      <button class="v51-nav-btn" data-tab="tab-sunat" type="button">
        <div class="v51-nav-btn-inner">
          <i class="fa-solid fa-receipt"></i>
          <span>{tabs.sunat}</span>
        </div>
      </button>

      <button class="v51-nav-btn" data-tab="tab-whatsapp" type="button">
        <div class="v51-nav-btn-inner">
          <i class="fa-brands fa-whatsapp"></i>
          <span>{tabs.whatsapp}</span>
        </div>
      </button>
    </nav>

    <!-- Botón de Acción Rápida en Sidebar -->
    <div style="padding: 0 1vw;">
      <button class="v51-sidebar-cta" id="btnSidebarNuevoCliente" type="button">
        <i class="fa-solid fa-user-plus"></i>
        <span>{t.cta_registrar_cliente}</span>
      </button>
    </div>
  </div>

  <!-- Sección Inferior: Ajustes, Cuenta, Colapsar Menú -->
  <div class="v51-sidebar-bottom-utils">
    <button class="v51-util-btn" id="btnAjustesUtil" type="button">
      <i class="fa-solid fa-gear"></i>
      <span>{t.ajustes}</span>
    </button>
    
    <button class="v51-util-btn" id="btnMiCuentaUtil" type="button">
      <i class="fa-solid fa-circle-user"></i>
      <span>{t.mi_cuenta}</span>
    </button>

    <button class="v51-util-btn" id="btnToggleCollapse" type="button">
      <i class="fa-solid fa-angles-left" id="collapseIcon"></i>
      <span>{t.colapsar_menu}</span>
    </button>
  </div>
</aside>
