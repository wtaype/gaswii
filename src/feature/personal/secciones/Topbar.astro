---
// src/feature/personal/secciones/Topbar.astro
// Cabecera superior maestra (100% width, fija) con datos de planta y dropdown de usuario
import { empresa } from '../data/empresa.js';

interface Props {
  t: {
    planta: string;
    estado_operativa: string;
    notificaciones_titulo: string;
    tema_titulo: string;
    en_turno: string;
    ir_tienda: string;
    ir_tienda_sub: string;
    ajustes_operacion: string;
    ajustes_sub: string;
    cerrar_turno: string;
    cerrar_turno_sub: string;
  };
}

const { t } = Astro.props;
---

<header class="v51-topbar" id="v51Topbar">
  <!-- LADO IZQUIERDO: LOGO SOLGAS CON METADATOS DE PLANTA -->
  <div class="v51-topbar-left">
    <a href="/personal" class="v51-header-brand" title="Solgas Surquillo - Portal Oficial">
      <img src="/imgwii/logo.webp" alt="Solgas Surquillo" class="v51-header-logo-img" />
      <div class="v51-brand-divider"></div>
      <div class="v51-brand-meta">
        <span class="v51-brand-meta-title">{t.planta}</span>
        <span class="v51-brand-meta-sub">
          <span class="v51-live-indicator-dot"></span> {t.estado_operativa}
        </span>
      </div>
    </a>
  </div>

  <!-- LADO DERECHO: NOTIFICACIONES, TEMA, USUARIO CON DROPDOWN -->
  <div class="v51-topbar-right">
    <!-- Notificaciones -->
    <button class="v51-icon-btn-round" id="btnNotifications" title={t.notificaciones_titulo} type="button">
      <i class="fa-regular fa-bell"></i>
      <span class="v51-notif-dot"></span>
    </button>

    <!-- Modo Oscuro / Claro -->
    <button class="v51-icon-btn-round" id="btnToggleTheme" title={t.tema_titulo} type="button">
      <i class="fa-solid fa-moon"></i>
    </button>

    <!-- Usuario con Dropdown Interactivo -->
    <div class="v51-user-dropdown-wrapper" id="userDropdownWrapper">
      <button class="v51-header-user-badge" id="btnUserDropdown" aria-haspopup="true" aria-expanded="false" type="button">
        <div class="v51-header-avatar" id="topbarAvatarInitials">WA</div>
        <span class="v51-header-username" id="topbarUserName">{empresa.administrador}</span>
        <i class="fa-solid fa-chevron-down v51-dropdown-arrow"></i>
      </button>

      <!-- MENÚ DROPDOWN DESPLEGABLE -->
      <div class="v51-user-dropdown-menu" id="userDropdownMenu">
        <div class="v51-dropdown-header">
          <div class="v51-dropdown-avatar" id="dropdownAvatarInitials">WA</div>
          <div class="v51-dropdown-user-info">
            <h4 id="dropdownUserName">{empresa.administrador}</h4>
            <p id="dropdownUserRole">{empresa.cargo}</p>
            <span class="v51-dropdown-status">
              <span class="v51-green-dot"></span> {t.en_turno}
            </span>
          </div>
        </div>

        <div class="v51-dropdown-divider"></div>

        <div class="v51-dropdown-body">
          <!-- OPCIÓN 1: IR A TIENDA PRINCIPAL -->
          <a href="/" class="v51-dropdown-item" title={t.ir_tienda}>
            <div class="v51-dropdown-item-icon store-icon">
              <i class="fa-solid fa-store"></i>
            </div>
            <div class="v51-dropdown-item-content">
              <strong>{t.ir_tienda}</strong>
              <small>{t.ir_tienda_sub}</small>
            </div>
            <i class="fa-solid fa-arrow-up-right-from-square v51-external-link-icon"></i>
          </a>

          <!-- OPCIÓN 2: CONFIGURACIÓN DE PLANTA -->
          <a href="#tab-resumen" class="v51-dropdown-item" id="btnAjustesPlanta">
            <div class="v51-dropdown-item-icon settings-icon">
              <i class="fa-solid fa-sliders"></i>
            </div>
            <div class="v51-dropdown-item-content">
              <strong>{t.ajustes_operacion}</strong>
              <small>{t.ajustes_sub}</small>
            </div>
          </a>

          <div class="v51-dropdown-divider"></div>

          <!-- OPCIÓN 3: CERRAR TURNO / SALIR -->
          <button class="v51-dropdown-item logout-btn" id="btnCerrarTurno" type="button">
            <div class="v51-dropdown-item-icon logout-icon">
              <i class="fa-solid fa-right-from-bracket"></i>
            </div>
            <div class="v51-dropdown-item-content">
              <strong>{t.cerrar_turno}</strong>
              <small>{t.cerrar_turno_sub}</small>
            </div>
          </button>
        </div>
      </div>
    </div>
  </div>
</header>
