---
// src/feature/personal/secciones/TabProductos.astro
// Tab 2: Catálogo de cilindros oficiales, stock (llenos/vacíos) y precios
import { productosIniciales } from '../data/productos.js';

interface Props {
  t: {
    titulo: string;
    subtitulo: string;
    btn_pedir_stock: string;
    btn_nuevo_producto: string;
    valvula: string;
    peso: string;
    seguridad: string;
    garantia_solgas: string;
    stock_llenos: string;
    sede_planta: string;
    btn_editar_ficha: string;
    pedir_por_wa: string;
  };
}

const { t } = Astro.props;
---

<section id="tab-productos" class="v51-tab-pane">
  <div class="v51-section-banner">
    <div class="v51-sec-top-row">
      <div class="v51-sec-title">
        <h3><i class="fa-solid fa-boxes-stacked" style="color: var(--v51-primary);"></i> {t.titulo}</h3>
        <p>{t.subtitulo}</p>
      </div>
      <div class="v51-sec-actions">
        <button class="v51-btn-secondary" id="btnReponerStock" type="button">
          <i class="fa-brands fa-whatsapp" style="color: #25d366;"></i> {t.btn_pedir_stock}
        </button>
        <button class="v51-btn-primary-orange" id="btnNuevoProducto" type="button">
          <i class="fa-solid fa-plus"></i> {t.btn_nuevo_producto}
        </button>
      </div>
    </div>
  </div>

  <!-- 4 PRODUCTOS CON EL DISEÑO OFICIAL DE TIENDA -->
  <div class="v51-products-store-grid">
    {productosIniciales.map((p) => (
      <div class="v51-prod-card">
        <div>
          <div class="v51-prod-card-top">
            <span class={p.tagClase}>{p.badge}</span>
            <span class="v51-prod-use-pill">{p.tipoUso}</span>
          </div>

          <div class="v51-prod-img-box">
            <img src={p.imagen} alt={p.nombre} onerror="this.onerror=null;this.src='/imgwii/productos/BALON-10KG.webp';" />
            <span class="v51-prod-weight-pill">{p.capacidad}</span>
          </div>

          <h4 class="v51-prod-title">{p.nombre}</h4>

          <div class="v51-prod-specs">
            <div class="v51-spec-line">
              <i class="fa-solid fa-fire" style="color: #ff6600;"></i>
              <span><strong>{t.valvula}</strong> {p.valvula}</span>
            </div>
            <div class="v51-spec-line">
              <i class="fa-solid fa-scale-balanced" style="color: #0284c7;"></i>
              <span><strong>{t.peso}</strong> {p.pesoTotal}</span>
            </div>
            <div class="v51-spec-line">
              <i class="fa-solid fa-shield-halved" style="color: #10b981;"></i>
              <span><strong>{t.seguridad}</strong> {p.seguridad}</span>
            </div>
          </div>

          <div class="v51-prod-guarantees">
            <span class="v51-guarantee-tag">{t.garantia_solgas}</span>
            {p.garantiasList.map((g) => (
              <div class="v51-guarantee-item">
                <i class="fa-solid fa-circle-check"></i>
                <span>{g}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="v51-prod-bottom">
          <div class="v51-prod-price-box">
            <div>
              <small>{p.garantia}</small>
              <div class="v51-prod-price-val">S/ {p.precioPEN.toFixed(2)}</div>
            </div>
            <div style="text-align: right;">
              <small style="color: var(--v51-emerald); font-weight: 700;">{p.stockLlenos} {t.stock_llenos}</small><br />
              <small style="color: var(--v51-text-muted);">{t.sede_planta}</small>
            </div>
          </div>

          <div class="v51-prod-action-row">
            <button class="v51-btn-edit-prod btn-abrir-editar-prod" 
                    data-id={p.id} 
                    data-nombre={p.nombre} 
                    data-precio={p.precioPEN}
                    data-costo={p.costoPEN}
                    data-stock={p.stockLlenos}
                    data-valvula={p.valvula}
                    type="button">
              <i class="fa-solid fa-pen-to-square"></i> {t.btn_editar_ficha}
            </button>
            <a href={`https://wa.me/51936369384?text=Hola%20deseo%20pedir%20${encodeURIComponent(p.nombre)}`} 
               target="_blank" 
               rel="noopener noreferrer"
               class="v51-btn-wa-pedir"
               title={t.pedir_por_wa}>
              <i class="fa-brands fa-whatsapp"></i>
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
