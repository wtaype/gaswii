---
// src/feature/personal/modales/ModalProducto.astro
// Modal para crear o editar ficha de producto y balón

interface Props {
  t: {
    prod_titulo: string;
    lbl_prod_nombre: string;
    lbl_precio_cliente: string;
    lbl_costo_planta: string;
    lbl_stock_llenos: string;
    lbl_tipo_valvula: string;
    btn_guardar_prod: string;
  };
}

const { t } = Astro.props;
---

<div id="modalProducto" class="v51-modal-backdrop">
  <div class="v51-modal-box">
    <div class="v51-modal-header">
      <h3 id="modalProdTitle">{t.prod_titulo}</h3>
      <button class="v51-modal-close" data-close-modal="modalProducto" type="button">&times;</button>
    </div>
    <div class="v51-modal-body">
      <form id="formProductoV49">
        <input type="hidden" id="modalProdId" />
        <div class="v51-form-group">
          <label for="modalProdNombre">{t.lbl_prod_nombre}</label>
          <input type="text" id="modalProdNombre" required />
        </div>
        <div class="v51-grid-2">
          <div class="v51-form-group">
            <label for="modalProdPrecio">{t.lbl_precio_cliente}</label>
            <input type="number" step="0.5" id="modalProdPrecio" required />
          </div>
          <div class="v51-form-group">
            <label for="modalProdCosto">{t.lbl_costo_planta}</label>
            <input type="number" step="0.5" id="modalProdCosto" required />
          </div>
        </div>
        <div class="v51-grid-2">
          <div class="v51-form-group">
            <label for="modalProdStock">{t.lbl_stock_llenos}</label>
            <input type="number" id="modalProdStock" required />
          </div>
          <div class="v51-form-group">
            <label for="modalProdValvula">{t.lbl_tipo_valvula}</label>
            <input type="text" id="modalProdValvula" />
          </div>
        </div>
        <button type="submit" class="v51-btn-primary-orange" style="width: 100%; justify-content: center; padding: 1.3vh 1vw;">
          {t.btn_guardar_prod}
        </button>
      </form>
    </div>
  </div>
</div>
