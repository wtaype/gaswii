---
// src/feature/personal/modales/ModalReponerStock.astro
// Modal para enviar pedido de reposición a planta central vía WhatsApp

interface Props {
  t: {
    reponer_titulo: string;
    lbl_s10: string;
    lbl_s45: string;
    lbl_m10: string;
    btn_enviar_orden: string;
    [key: string]: any;
  };
}

const { t } = Astro.props;
---

<div id="modalReponerStock" class="v51-modal-backdrop">
  <div class="v51-modal-box">
    <div class="v51-modal-header">
      <h3><i class="fa-brands fa-whatsapp" style="color: #25d366;"></i> {t.reponer_titulo}</h3>
      <button class="v51-modal-close" data-close-modal="modalReponerStock" type="button">&times;</button>
    </div>
    <div class="v51-modal-body">
      <div class="v51-form-group">
        <label for="reponerSolgas10">{t.lbl_s10}</label>
        <input type="number" id="reponerSolgas10" value="40" min="5" />
      </div>
      <div class="v51-form-group">
        <label for="reponerSolgas45">{t.lbl_s45}</label>
        <input type="number" id="reponerSolgas45" value="10" min="1" />
      </div>
      <div class="v51-form-group">
        <label for="reponerMasgas10">{t.lbl_m10}</label>
        <input type="number" id="reponerMasgas10" value="15" min="5" />
      </div>
      <button class="v51-btn-send-wa-link" id="btnEnviarOrdenStockWa" style="margin-top: 1.5vh; background: #25d366;" type="button">
        <i class="fa-brands fa-whatsapp" style="font-size: 1.2rem;"></i> {t.btn_enviar_orden}
      </button>
    </div>
  </div>
</div>
