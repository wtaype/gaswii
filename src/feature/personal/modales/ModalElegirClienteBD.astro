---
// src/feature/personal/modales/ModalElegirClienteBD.astro
// Selector modal de clientes existentes para emisión rápida de comprobantes SUNAT
import { clientesIniciales } from '../data/clientes.js';

interface Props {
  t: {
    bd_titulo: string;
    btn_seleccionar: string;
    [key: string]: any;
  };
}

const { t } = Astro.props;
---

<div id="modalElegirClienteBD" class="v51-modal-backdrop">
  <div class="v51-modal-box" style="max-width: 650px;">
    <div class="v51-modal-header">
      <h3><i class="fa-solid fa-users-viewfinder" style="color: var(--v51-primary);"></i> {t.bd_titulo}</h3>
      <button class="v51-modal-close" data-close-modal="modalElegirClienteBD" type="button">&times;</button>
    </div>
    <div class="v51-modal-body">
      <div style="display: flex; flex-direction: column; gap: 1vh;">
        {clientesIniciales.map((c) => (
          <div style="display: flex; justify-content: space-between; align-items: center; padding: 1.4vh 1vw; border: 1px solid var(--v51-border); border-radius: 0.8rem; background: var(--v51-surface-alt);">
            <div>
              <strong>{c.nombre}</strong><br />
              <small style="color: var(--v51-text-muted);">{c.tipoDoc}: {c.numDoc} · {c.direccion}</small>
            </div>
            <button class="v51-btn-primary-orange btn-seleccionar-cli-bd" 
                    data-nombre={c.nombre} 
                    data-doc={c.numDoc} 
                    data-dir={c.direccion}
                    style="padding: 0.6vh 0.9vw; font-size: 0.78rem;"
                    type="button">
              {t.btn_seleccionar}
            </button>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
