---
// src/feature/personal/modales/ModalLinkPassword.astro
// Modal para generar y enviar enlace de activación / contraseña al cliente

interface Props {
  t: {
    link_titulo: string;
    link_desc: string;
    lbl_enlace_seguro: string;
    btn_copiar_enlace: string;
    btn_enviar_wa: string;
  };
}

const { t } = Astro.props;
---

<div id="modalLinkPassword" class="v51-modal-backdrop">
  <div class="v51-modal-box">
    <div class="v51-modal-header">
      <h3><i class="fa-brands fa-whatsapp" style="color: #25d366;"></i> {t.link_titulo}</h3>
      <button class="v51-modal-close" data-close-modal="modalLinkPassword" type="button">&times;</button>
    </div>
    <div class="v51-modal-body">
      <p style="font-size: 0.85rem; margin-bottom: 1.5vh; color: var(--v51-text-body);">
        {t.link_desc} <strong id="linkNombreCliente">Claudia Romero</strong>
      </p>
      <div class="v51-form-group">
        <label for="inputUrlAcceso">{t.lbl_enlace_seguro}</label>
        <input type="text" id="inputUrlAcceso" readonly value="https://gaswii.com/activar?token=CLI-948271" style="font-weight: 700; color: var(--v51-primary);" />
      </div>
      <div style="display: flex; gap: 0.8vw; margin-top: 2vh;">
        <button class="v51-btn-secondary" id="btnCopiarLink" style="flex: 1; justify-content: center;" type="button">
          <i class="fa-solid fa-copy"></i> {t.btn_copiar_enlace}
        </button>
        <button class="v51-btn-send-wa-link" id="btnEnviarWaLink" style="flex: 1.2; margin-bottom: 0; background: #25d366;" type="button">
          <i class="fa-brands fa-whatsapp"></i> {t.btn_enviar_wa}
        </button>
      </div>
    </div>
  </div>
</div>
