---
// src/feature/personal/personalPage.astro
// Entrada Principal del Feature Personal (Solgas Surquillo)
// Layout: Sonrisa.astro · Módulo Activo Fase 1: Dashboard · Cero CSS inline

import Sonrisa from './layout/Sonrisa.astro';
import Dashboard from './modulos/dashboard/Dashboard.astro';
import dashboardCss from './modulos/dashboard/dashboard.css?inline';
import Notepad from './modulos/notepad/Notepad.astro';
import notepadCss from './modulos/notepad/notepad.css?inline';
import { getModulosActivos } from './modulos.js';

interface Props {
  idioma?: string;
}

const { idioma = 'es' } = Astro.props;

// Módulos que se implementarán progresivamente en fases posteriores
const modulosPendientes = getModulosActivos().filter(m => m.id !== 'dashboard' && m.id !== 'notepad');
---

<Sonrisa titulo="Dashboard del Dueño · Solgas Surquillo" moduloActivo="dashboard" idioma={idioma}>
  <!-- Inyección de CSS de los módulos activos -->
  <style slot="modulo-css" is:global set:html={dashboardCss + '\n' + notepadCss}></style>

  <!-- MÓDULO 1: DASHBOARD -->
  <Dashboard />

  <!-- MÓDULO 2: NOTEPAD (70% Canvas / 30% Lista) -->
  <Notepad />

  <!-- CONTENEDORES LISTOS PARA MÓDULOS EN FASES SIGUIENTES -->
  {modulosPendientes.map((m) => (
    <section class="ps-panel" id={`panel-${m.id}`}>
      <div class="ps-section-header">
        <div class="ps-section-title-wrap">
          <h1 class="ps-section-title">{m.nombre}</h1>
          <p class="ps-section-sub">Módulo preparado para integración en las siguientes fases.</p>
        </div>
      </div>

      <div class="ps-card ps-placeholder-box">
        <i class={`${m.icono} ps-placeholder-icon`}></i>
        <div class="ps-placeholder-title">Módulo {m.nombre}</div>
        <p class="ps-placeholder-sub">
          Este módulo contará con su propio archivo CSS y componente aislado. Próximamente disponible.
        </p>
      </div>
    </section>
  ))}
</Sonrisa>
