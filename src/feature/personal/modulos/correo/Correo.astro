---
// src/feature/personal/modulos/correo/Correo.astro
// Centro de Envíos de Correo con Editor Markdown y Live Preview en Tiempo Real
interface Props {
  esActivo?: boolean;
}

const { esActivo = false } = Astro.props;
---

<section class={`ps-panel ${esActivo ? 'active' : ''}`} id="panel-correo">
  
  <!-- Encabezado del Módulo -->
  <div class="ps-panel-head">
    <div>
      <h1 class="ps-panel-title">
        <i class="fa-solid fa-envelope" style="color: var(--brand-orange); margin-right: 8px;"></i>
        Centro de Envíos de Correo
      </h1>
      <p class="ps-panel-subtitle">
        Redactor profesional con Markdown y previsualización en vivo para pedidos, comprobantes SUNAT y cotizaciones oficiales.
      </p>
    </div>
  </div>

  <!-- LAYOUT PRINCIPAL: 2 COLUMNAS (EDITOR A LA IZQUIERDA, LIVE PREVIEW A LA DERECHA) -->
  <div class="cr-layout-split">
    
    <!-- COLUMNA 1: EDITOR Y FORMULARIO DE DATOS REALES -->
    <div class="cr-card">
      
      <!-- Selector de Categoría / Plantilla -->
      <div class="cr-card-head" style="margin-bottom: 14px; padding-bottom: 12px;">
        <h2 class="cr-card-title">
          <i class="fa-solid fa-pen-to-square"></i> Redactor de Correo
        </h2>
      </div>

      <div class="cr-pills-bar" id="crPillsCategorias">
        <button type="button" class="cr-pill-btn active" data-template="pedido">
          <i class="fa-solid fa-truck-fast"></i> Pedido de Gas
        </button>
        <button type="button" class="cr-pill-btn" data-template="comprobante">
          <i class="fa-solid fa-file-invoice-dollar"></i> Comprobante SUNAT
        </button>
        <button type="button" class="cr-pill-btn" data-template="cotizacion">
          <i class="fa-solid fa-clipboard-list"></i> Cotización GLP
        </button>
        <button type="button" class="cr-pill-btn" data-template="libre">
          <i class="fa-solid fa-envelope-open-text"></i> Mensaje Libre
        </button>
      </div>

      <form id="formEnviarCorreo">
        <!-- Campo oculto para la categoría activa -->
        <input type="hidden" id="crSelectTipo" value="pedido" />

        <!-- Fila 1: Para (con toggle CC a la derecha) + Nombre del Cliente -->
        <div class="cr-form-row">
          <div class="cr-form-group">
            <div class="cr-label-row">
              <label class="cr-label" for="crInputTo" style="margin-bottom:0;">
                Destinatario (Email) <span style="color:var(--brand-orange);">*</span>
              </label>
              <button type="button" id="btnToggleCc" class="cr-link-btn">
                <i class="fa-solid fa-plus"></i> Añadir copia CC
              </button>
            </div>
            <input 
              type="email" 
              id="crInputTo" 
              class="cr-input" 
              placeholder="cliente@correo.com" 
              required 
              autocomplete="email"
            />
          </div>
          <div class="cr-form-group">
            <label class="cr-label" for="crInputNombre">
              Nombre del Cliente <small>(opcional)</small>
            </label>
            <input 
              type="text" 
              id="crInputNombre" 
              class="cr-input" 
              placeholder="Ej. Valeria Mendoza" 
              autocomplete="name"
            />
          </div>
        </div>

        <!-- Campo CC Desplegable (oculto por defecto) -->
        <div id="crWrapCc" style="display: none; margin-bottom: 14px;">
          <label class="cr-label" for="crInputCc">
            Con Copia (CC) <small>(separar con comas si son varios correos)</small>
          </label>
          <input 
            type="text" 
            id="crInputCc" 
            class="cr-input" 
            placeholder="administracion@empresa.com, ventas@empresa.com" 
          />
        </div>

        <!-- ── BLOQUE DINÁMICO 1: CAMPOS REALES DE PEDIDO DE GAS ── -->
        <div id="crFieldsPedido" class="cr-cat-box">
          <div class="cr-cat-box-title">
            <i class="fa-solid fa-fire" style="color:var(--brand-orange);"></i> Datos del Pedido Real
          </div>
          <div class="cr-form-row">
            <div class="cr-form-group">
              <label class="cr-label" for="crPedNumero">N° de Pedido</label>
              <input type="text" id="crPedNumero" class="cr-input cr-live-input" value="GW-1029" />
            </div>
            <div class="cr-form-group">
              <label class="cr-label" for="crPedPrecio">Total a Pagar (S/)</label>
              <input type="text" id="crPedPrecio" class="cr-input cr-live-input" value="65.00" />
            </div>
          </div>
          <div class="cr-form-row">
            <div class="cr-form-group">
              <label class="cr-label" for="crPedProducto">Producto / Balón</label>
              <input type="text" id="crPedProducto" class="cr-input cr-live-input" value="Balón SOLGAS Premium 10 kg" />
            </div>
            <div class="cr-form-group">
              <label class="cr-label" for="crPedPago">Método de Pago</label>
              <input type="text" id="crPedPago" class="cr-input cr-live-input" value="Yape / Plin / Efectivo" />
            </div>
          </div>
          <div class="cr-form-group" style="margin-bottom:0;">
            <label class="cr-label" for="crPedDireccion">Dirección de Entrega</label>
            <input type="text" id="crPedDireccion" class="cr-input cr-live-input" value="Surquillo, Lima" />
          </div>
        </div>

        <!-- ── BLOQUE DINÁMICO 2: CAMPOS REALES DE COMPROBANTE SUNAT ── -->
        <div id="crFieldsComprobante" class="cr-cat-box" style="display:none;">
          <div class="cr-cat-box-title">
            <i class="fa-solid fa-file-invoice" style="color:var(--brand-orange);"></i> Datos del Comprobante SUNAT
          </div>
          <div class="cr-form-row">
            <div class="cr-form-group">
              <label class="cr-label" for="crCompTipo">Tipo de Comprobante</label>
              <select id="crCompTipo" class="cr-input cr-live-input">
                <option value="Boleta de Venta Electrónica">Boleta de Venta Electrónica</option>
                <option value="Factura Electrónica">Factura Electrónica</option>
              </select>
            </div>
            <div class="cr-form-group">
              <label class="cr-label" for="crCompSerie">Serie y Número</label>
              <input type="text" id="crCompSerie" class="cr-input cr-live-input" value="B001-000482" />
            </div>
          </div>
          <div class="cr-form-row">
            <div class="cr-form-group">
              <label class="cr-label" for="crCompMonto">Monto Total (S/)</label>
              <input type="text" id="crCompMonto" class="cr-input cr-live-input" value="65.00" />
            </div>
            <div class="cr-form-group">
              <label class="cr-label" for="crCompDoc">DNI / RUC del Cliente</label>
              <input type="text" id="crCompDoc" class="cr-input cr-live-input" placeholder="Ej. 72819201" />
            </div>
          </div>
        </div>

        <!-- ── BLOQUE DINÁMICO 3: CAMPOS REALES DE COTIZACIÓN ── -->
        <div id="crFieldsCotizacion" class="cr-cat-box" style="display:none;">
          <div class="cr-cat-box-title">
            <i class="fa-solid fa-building" style="color:var(--brand-orange);"></i> Datos de la Cotización
          </div>
          <div class="cr-form-row">
            <div class="cr-form-group">
              <label class="cr-label" for="crCotNumero">N° de Cotización</label>
              <input type="text" id="crCotNumero" class="cr-input cr-live-input" value="COT-2026-08" />
            </div>
            <div class="cr-form-group">
              <label class="cr-label" for="crCotEmpresa">Empresa / Razón Social</label>
              <input type="text" id="crCotEmpresa" class="cr-input cr-live-input" value="Restaurante El Buen Sabor" />
            </div>
          </div>
          <div class="cr-form-group" style="margin-bottom:0;">
            <label class="cr-label" for="crCotValidez">Validez de la Oferta</label>
            <input type="text" id="crCotValidez" class="cr-input cr-live-input" value="15 días calendario" />
          </div>
        </div>

        <!-- Asunto Oficial -->
        <div class="cr-form-group" style="margin-top: 14px;">
          <label class="cr-label" for="crInputSubject">
            Asunto del Correo <span style="color:var(--brand-orange);">*</span>
          </label>
          <input 
            type="text" 
            id="crInputSubject" 
            class="cr-input cr-live-input" 
            value="🔥 ¡Tu pedido de gas está confirmado! · Solgas Surquillo" 
            required 
          />
        </div>

        <!-- ── EDITOR MARKDOWN CON BARRA DE HERRAMIENTAS ── -->
        <div class="cr-form-group">
          <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 6px;">
            <label class="cr-label" for="crTextMarkdown" style="margin-bottom:0;">
              Mensaje en Markdown / Personalización
            </label>
            <span style="font-size: 11px; color: var(--muted);" id="crLiveWordsCount">
              0 palabras · 1 min
            </span>
          </div>

          <!-- Barra de herramientas tipo wiihope -->
          <div class="cr-md-toolbar" id="crMdToolbar">
            <div class="cr-md-group">
              <button type="button" class="cr-md-btn" data-tag="**texto**" title="Negrita">
                <strong>B</strong>
              </button>
              <button type="button" class="cr-md-btn" data-tag="*texto*" title="Cursiva">
                <em>I</em>
              </button>
              <button type="button" class="cr-md-btn" data-tag="~~texto~~" title="Tachado">
                <s>S</s>
              </button>
            </div>
            <div class="cr-md-group">
              <button type="button" class="cr-md-btn" data-tag="## Título Secundario" title="Subtítulo H2">
                H2
              </button>
              <button type="button" class="cr-md-btn" data-tag="### Sección" title="Sección H3">
                H3
              </button>
            </div>
            <div class="cr-md-group">
              <button type="button" class="cr-md-btn" data-tag="- Elemento de lista" title="Lista">
                <i class="fa-solid fa-list-ul"></i>
              </button>
              <button type="button" class="cr-md-btn" data-tag="- [ ] Tarea pendiente" title="Checklist">
                <i class="fa-solid fa-square-check"></i>
              </button>
              <button type="button" class="cr-md-btn" data-tag="> Mensaje destacado" title="Cita">
                <i class="fa-solid fa-quote-right"></i>
              </button>
              <button type="button" class="cr-md-btn" data-tag="&#10;---&#10;" title="Línea divisoria">
                <i class="fa-solid fa-minus"></i>
              </button>
            </div>
            <div class="cr-md-group">
              <button type="button" class="cr-md-btn cr-md-btn-table" data-tag="table" title="Insertar Tabla de Productos">
                <i class="fa-solid fa-table"></i> Tabla
              </button>
              <button type="button" class="cr-md-btn" data-tag="[Texto del Enlace](https://solgassurquillo.com)" title="Enlace">
                <i class="fa-solid fa-link"></i>
              </button>
            </div>
          </div>

          <!-- Textarea Markdown -->
          <textarea 
            id="crTextMarkdown" 
            class="cr-textarea cr-code-editor cr-live-input" 
            rows="6" 
            placeholder="Escribe el mensaje en Markdown o añade tablas y listas..."
          ></textarea>
        </div>

        <!-- Botones de Acción -->
        <div class="cr-actions">
          <button type="button" class="ps-btn ps-btn-secondary" id="btnResetPlantilla">
            <i class="fa-solid fa-rotate-left"></i> Restablecer
          </button>
          <button type="submit" class="cr-btn-send" id="btnEnviarCorreo">
            <i class="fa-solid fa-paper-plane"></i> Enviar Correo Ahora
          </button>
        </div>
      </form>
    </div>

    <!-- COLUMNA 2: LIVE PREVIEW (CARTA EN TIEMPO REAL) + BANDEJA / AJUSTES -->
    <div class="cr-preview-column">
      
      <!-- CONTENEDOR LIVE PREVIEW -->
      <div class="cr-live-card">
        <div class="cr-live-head">
          <div class="cr-live-badge-status">
            <span class="cr-live-dot"></span> Live Preview (En Vivo)
          </div>
          <!-- Selector de tamaño: Desktop / Móvil -->
          <div class="cr-device-switch">
            <button type="button" class="cr-device-btn active" data-device="desktop" title="Vista Desktop">
              <i class="fa-solid fa-laptop"></i> Desktop
            </button>
            <button type="button" class="cr-device-btn" data-device="mobile" title="Vista Celular">
              <i class="fa-solid fa-mobile-screen"></i> Móvil
            </button>
          </div>
        </div>

        <!-- Iframe donde se renderiza la carta exacta -->
        <div class="cr-live-frame-wrap" id="crFrameWrap">
          <iframe id="crLiveFrame" class="cr-live-frame" title="Live Preview Correo"></iframe>
        </div>
      </div>

      <!-- TARJETA ACORDEÓN: AJUSTES PREDEFINIDOS + HISTORIAL -->
      <div class="cr-card" style="margin-top: 20px;">
        <div class="cr-card-head" style="margin-bottom: 14px; padding-bottom: 10px;">
          <h2 class="cr-card-title" style="font-size: 0.95rem;">
            <i class="fa-solid fa-sliders"></i> Ajustes de Emisor
          </h2>
          <span class="ps-badge ps-badge-success" style="font-size: 11px;">
            <i class="fa-solid fa-shield-check"></i> solgassurquillo.com
          </span>
        </div>

        <form id="formAjustesCorreo">
          <div class="cr-settings-grid">
            <div class="cr-form-group" style="margin-bottom: 0;">
              <label class="cr-label" for="crAjusteNombre">Nombre Remitente</label>
              <input type="text" id="crAjusteNombre" class="cr-input" value="Solgas Surquillo" />
            </div>
            <div class="cr-form-group" style="margin-bottom: 0;">
              <label class="cr-label" for="crAjusteEmail">Correo Emisor</label>
              <input type="email" id="crAjusteEmail" class="cr-input" value="pedidos@solgassurquillo.com" />
            </div>
          </div>
          <div style="margin-top: 10px; text-align: right;">
            <button type="submit" class="ps-btn ps-btn-secondary" style="padding: 5px 12px; font-size: 12px;">
              <i class="fa-solid fa-floppy-disk"></i> Guardar Ajustes
            </button>
          </div>
        </form>
      </div>

      <!-- TARJETA: BANDEJA DE CORREOS ENVIADOS -->
      <div class="cr-card" style="margin-top: 20px;">
        <div class="cr-card-head">
          <h2 class="cr-card-title" style="font-size: 0.95rem;">
            <i class="fa-solid fa-clock-rotate-left"></i> Correos Enviados
          </h2>
          <span class="ps-badge ps-badge-blue" id="crBadgeTotal">0</span>
        </div>

        <div style="margin-bottom: 12px;">
          <input 
            type="text" 
            id="crInputBuscar" 
            class="cr-input" 
            placeholder="Buscar por cliente o asunto..."
            style="font-size: var(--fz_s3);"
          />
        </div>

        <div class="cr-history-list" id="crHistoryList">
          <!-- Renderizado dinámico desde dataCorreo.js -->
        </div>
      </div>

    </div>

  </div>

  <!-- MODAL DE DETALLE / HISTORIAL -->
  <div class="cr-modal-backdrop" id="crModalDetalle" style="display: none;">
    <div class="cr-modal-box">
      <div class="cr-modal-head">
        <div>
          <h3 style="margin:0; font-size:1.1rem; color:var(--ink);" id="crModalAsunto">Detalle del Correo</h3>
          <span style="font-size:12px; color:var(--muted);" id="crModalInfo"></span>
        </div>
        <button type="button" class="ps-btn ps-btn-secondary" id="btnCloseModalDetalle" style="padding:6px 12px;">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="cr-modal-body">
        <iframe id="crModalIframe" class="cr-preview-frame"></iframe>
      </div>
    </div>
  </div>

</section>

<script>
  import { inicializarModuloCorreo } from './correo.js';
  inicializarModuloCorreo();
  document.addEventListener('astro:page-load', inicializarModuloCorreo);
</script>
