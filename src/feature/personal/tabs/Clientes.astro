---
// src/feature/personal/tabs/Clientes.astro
// Tab 3: Cartera de clientes reales consultados desde la colección 'smiles' (rol == 'cliente')

interface Props {
  t: {
    titulo: string;
    subtitulo: string;
    btn_registrar: string;
    search_ph: string;
    th_cliente: string;
    th_documento: string;
    th_telefono: string;
    th_activo: string;
    preview_pill: string;
    lbl_wa: string;
    lbl_dir: string;
    lbl_ref: string;
    lbl_cilindro: string;
    lbl_consumo: string;
    btn_enviar_link_wa: string;
    btn_emitir_cpe: string;
  };
}

const { t } = Astro.props;
---

<section id="tab-clientes" class="v51-tab-pane">
  <!-- HEADER DE SECCIÓN CON BOTÓN REGISTRAR Y BUSCADOR -->
  <div class="v51-section-banner">
    <div class="v51-sec-top-row">
      <div class="v51-sec-title">
        <h3><i class="fa-solid fa-users" style="color: var(--v51-primary);"></i> {t.titulo}</h3>
        <p>{t.subtitulo}</p>
      </div>
      <div>
        <button class="v51-btn-primary-orange" id="btnRegistrarCliente" type="button">
          <i class="fa-solid fa-plus"></i> {t.btn_registrar}
        </button>
      </div>
    </div>

    <!-- BUSCADOR DEBAJO DEL BOTÓN -->
    <div class="v51-search-input-box">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" id="filtroClientesInput" placeholder={t.search_ph} autocomplete="off" />
    </div>
  </div>

  <!-- LAYOUT TABLA LIMPIA + PREVIEW INTEGRAL -->
  <div class="v51-split-layout">
    <div class="v51-table-card">
      <!-- Empty State cuando no hay clientes en la base de datos -->
      <div id="emptyStateClientes" style="display: none; padding: 4vh 2vw; text-align: center; color: var(--v51-text-muted);">
        <i class="fa-solid fa-user-group" style="font-size: 2.5rem; color: var(--v51-primary); opacity: 0.5; margin-bottom: 1vh;"></i>
        <h4 style="color: var(--v51-text-title); font-size: 1rem; margin-bottom: 0.5vh;">No hay clientes registrados</h4>
        <p style="font-size: 0.8rem; max-width: 320px; margin: 0 auto 1.5vh;">Haz clic en el botón naranja superior para registrar al primer cliente en Solgas Surquillo.</p>
      </div>

      <table class="v51-table" id="tablaClientesMain">
        <thead>
          <tr>
            <th>{t.th_cliente}</th>
            <th>{t.th_documento}</th>
            <th>{t.th_telefono}</th>
            <th>{t.th_activo}</th>
          </tr>
        </thead>
        <tbody id="tablaClientesBody">
          <!-- Se inyecta dinámicamente desde Firestore smiles (rol == cliente) en 0ms -->
        </tbody>
      </table>
    </div>

    <!-- PANEL LATERAL DE DETALLE Y ACCIONES DE CLIENTE -->
    <div class="v51-preview-card" id="prevCliCard" data-selected-id="">
      <div class="v51-preview-pill">
        <i class="fa-solid fa-address-card"></i> {t.preview_pill}
      </div>

      <div class="v51-avatar-large-box">
        <div class="v51-avatar-round" id="prevCliAvatar">CL</div>
        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--v51-text-title);" id="prevCliNombre">Selecciona un Cliente</h3>
        <p style="font-size: 0.76rem; color: var(--v51-text-muted);" id="prevCliDoc">Documento: ---</p>
        <span style="font-size: 0.68rem; font-weight: 800; color: #ffd166; background: rgba(255, 209, 102, 0.12); padding: 0.2vh 0.6vw; border-radius: 999px; margin-top: 0.4vh;" id="prevCliEstadoAcceso">
          Activo
        </span>
      </div>

      <div class="v51-detail-list">
        <div class="v51-detail-row">
          <span class="label">{t.lbl_wa}</span>
          <span class="val" id="prevCliTel">---</span>
        </div>
        <div class="v51-detail-row">
          <span class="label">{t.lbl_dir}</span>
          <span class="val" id="prevCliDir">---</span>
        </div>
        <div class="v51-detail-row">
          <span class="label">{t.lbl_ref}</span>
          <span class="val" id="prevCliRef">---</span>
        </div>
        <div class="v51-detail-row">
          <span class="label">{t.lbl_cilindro}</span>
          <span class="val" id="prevCliCil" style="color: var(--v51-primary);">---</span>
        </div>
        <div class="v51-detail-row">
          <span class="label">{t.lbl_consumo}</span>
          <span class="val" id="prevCliConsumo" style="color: var(--v51-primary);">---</span>
        </div>
      </div>

      <!-- BOTÓN NARANJA DESTACADO -->
      <button class="v51-btn-send-wa-link" id="btnPreviewEnviarLink" type="button">
        <i class="fa-solid fa-key"></i> {t.btn_enviar_link_wa}
      </button>

      <div style="display: flex; gap: 0.6vw;">
        <button class="v51-btn-secondary" style="flex: 1; justify-content: center;" id="btnEditarClienteFicha" type="button">
          <i class="fa-solid fa-user-pen"></i> Editar
        </button>
        <button class="v51-btn-cpe-shortcut" style="flex: 1.2;" id="btnCargarClienteEnSunat" type="button">
          <i class="fa-solid fa-file-invoice"></i> {t.btn_emitir_cpe}
        </button>
        <button class="v51-btn-cpe-shortcut" style="width: 44px; justify-content: center;" id="btnAbrirWaDirecto" type="button">
          <i class="fa-brands fa-whatsapp" style="color: #25d366; font-size: 1.1rem;"></i>
        </button>
      </div>
    </div>
  </div>
</section>
