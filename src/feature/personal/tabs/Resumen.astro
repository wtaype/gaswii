---
// src/feature/personal/tabs/Resumen.astro
// Tab 1: Dashboard, KPIs ejecutivos del día y reloj digital de turno en Jr. Dante 260
import { empresa } from '../data/empresa.js';

interface Props {
  t: {
    saludos: {
      manana: string;
      tarde: string;
      noche: string;
    };
    bienvenida_texto: string;
    turno_activo: string;
    kpis: {
      cartera_tag: string;
      cartera_label: string;
      cartera_desc: string;
      cartera_meta: string;
      cartera_link: string;
      catalogo_tag: string;
      catalogo_label: string;
      catalogo_desc: string;
      catalogo_meta: string;
      catalogo_link: string;
      equipo_tag: string;
      equipo_label: string;
      equipo_desc: string;
      equipo_meta: string;
      equipo_link: string;
      tributario_tag: string;
      tributario_label: string;
      tributario_desc: string;
      tributario_meta: string;
      tributario_link: string;
      inventario_tag: string;
      inventario_label: string;
      inventario_desc: string;
      inventario_meta: string;
      inventario_link: string;
    };
  };
}

const { t } = Astro.props;
---

<section id="tab-resumen" class="v51-tab-pane active">
  <!-- BANNER SOLGAS EJECUTIVO CON HORA Y FECHA GRANDES -->
  <div class="v51-solgas-banner">
    <div class="v51-banner-left">
      <div class="v51-banner-flame-icon">
        <i class="fa-solid fa-fire"></i>
      </div>
      <div class="v51-banner-text">
        <h2>
          <span id="saludoDinamico">{t.saludos.tarde}</span>, <span id="bannerAdminNombre" style="color: var(--v51-primary);">Operador</span>
        </h2>
        <p>{t.bienvenida_texto}</p>
      </div>
    </div>

    <div class="v51-banner-right">
      <!-- Reloj Digital Grande en Vivo -->
      <div class="v51-live-clock-box">
        <div class="v51-clock-row">
          <i class="fa-regular fa-clock v51-clock-icon"></i>
          <span id="relojEnVivo" class="v51-time-display">12:00:00 p. m.</span>
        </div>
        <div id="fechaEnVivo" class="v51-date-display">...</div>
        <div class="v51-turn-indicator">
          <i class="fa-solid fa-circle" style="font-size: 6px;"></i> {t.turno_activo}
        </div>
      </div>
    </div>
  </div>

  <!-- 5 CARDS ORGANIZADOS EN 2 LÍNEAS -->
  <div class="v51-kpi-container">
    <!-- LÍNEA 1: 3 CARDS (CLIENTES, PRODUCTOS, PERSONALES) -->
    <div class="v51-kpi-row-1">
      <!-- CARD 1: CLIENTES -->
      <div class="v51-kpi-card" data-goto-tab="tab-clientes">
        <div>
          <div class="v51-kpi-head">
            <span class="v51-kpi-tag">{t.kpis.cartera_tag}</span>
            <div class="v51-kpi-icon"><i class="fa-solid fa-users"></i></div>
          </div>
          <div class="v51-kpi-val" id="kpiClientesVal">0</div>
          <div class="v51-kpi-label">{t.kpis.cartera_label}</div>
          <p class="v51-kpi-desc">{t.kpis.cartera_desc}</p>
        </div>
        <div class="v51-kpi-foot">
          <small style="color: var(--v51-emerald);">{t.kpis.cartera_meta}</small>
          <span>{t.kpis.cartera_link} <i class="fa-solid fa-arrow-right"></i></span>
        </div>
      </div>

      <!-- CARD 2: PRODUCTOS -->
      <div class="v51-kpi-card emerald" data-goto-tab="tab-productos">
        <div>
          <div class="v51-kpi-head">
            <span class="v51-kpi-tag emerald">{t.kpis.catalogo_tag}</span>
            <div class="v51-kpi-icon" style="color: var(--v51-emerald);"><i class="fa-solid fa-boxes-stacked"></i></div>
          </div>
          <div class="v51-kpi-val" id="kpiProductosVal">4</div>
          <div class="v51-kpi-label">{t.kpis.catalogo_label}</div>
          <p class="v51-kpi-desc">{t.kpis.catalogo_desc}</p>
        </div>
        <div class="v51-kpi-foot">
          <small style="color: var(--v51-emerald);">{t.kpis.catalogo_meta}</small>
          <span>{t.kpis.catalogo_link} <i class="fa-solid fa-arrow-right"></i></span>
        </div>
      </div>

      <!-- CARD 3: PERSONALES -->
      <div class="v51-kpi-card blue" data-goto-tab="tab-personales">
        <div>
          <div class="v51-kpi-head">
            <span class="v51-kpi-tag blue">{t.kpis.equipo_tag}</span>
            <div class="v51-kpi-icon" style="color: var(--v51-blue);"><i class="fa-solid fa-id-badge"></i></div>
          </div>
          <div class="v51-kpi-val" id="kpiEquipoVal">4</div>
          <div class="v51-kpi-label">{t.kpis.equipo_label}</div>
          <p class="v51-kpi-desc">{t.kpis.equipo_desc}</p>
        </div>
        <div class="v51-kpi-foot">
          <small style="color: var(--v51-blue);" id="kpiEquipoMeta">{t.kpis.equipo_meta}</small>
          <span>{t.kpis.equipo_link} <i class="fa-solid fa-arrow-right"></i></span>
        </div>
      </div>
    </div>

    <!-- LÍNEA 2: 2 CARDS (COMPROBANTES SUNAT Y STOCK FÍSICO) -->
    <div class="v51-kpi-row-2">
      <!-- CARD 4: COMPROBANTES SUNAT -->
      <div class="v51-kpi-card purple" data-goto-tab="tab-sunat">
        <div>
          <div class="v51-kpi-head">
            <span class="v51-kpi-tag purple">{t.kpis.tributario_tag}</span>
            <div class="v51-kpi-icon" style="color: var(--v51-purple);"><i class="fa-solid fa-file-invoice-dollar"></i></div>
          </div>
          <div class="v51-kpi-val" id="kpiSunatVal">348</div>
          <div class="v51-kpi-label">{t.kpis.tributario_label}</div>
          <p class="v51-kpi-desc">{t.kpis.tributario_desc}</p>
        </div>
        <div class="v51-kpi-foot">
          <small style="color: var(--v51-purple);" id="kpiSunatMeta">{t.kpis.tributario_meta}</small>
          <span>{t.kpis.tributario_link} <i class="fa-solid fa-arrow-right"></i></span>
        </div>
      </div>

      <!-- CARD 5: STOCK FÍSICO -->
      <div class="v51-kpi-card amber" data-goto-tab="tab-productos">
        <div>
          <div class="v51-kpi-head">
            <span class="v51-kpi-tag amber">{t.kpis.inventario_tag}</span>
            <div class="v51-kpi-icon" style="color: var(--v51-amber);"><i class="fa-solid fa-warehouse"></i></div>
          </div>
          <div class="v51-kpi-val" id="kpiInventarioVal">140</div>
          <div class="v51-kpi-label">{t.kpis.inventario_label}</div>
          <p class="v51-kpi-desc">{t.kpis.inventario_desc}</p>
        </div>
        <div class="v51-kpi-foot">
          <small style="color: var(--v51-amber);" id="kpiInventarioMeta">{t.kpis.inventario_meta}</small>
          <span>{t.kpis.inventario_link} <i class="fa-solid fa-arrow-right"></i></span>
        </div>
      </div>
    </div>
  </div>
</section>
