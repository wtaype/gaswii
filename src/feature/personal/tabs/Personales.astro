---
// src/feature/personal/tabs/Personales.astro
// Tab 4: Directorio operativo de colaboradores, choferes, repartidores y turnos
import { equipoPersonal } from '../data/personal.js';

interface Props {
  t: {
    titulo: string;
    subtitulo: string;
    btn_agregar: string;
    search_ph: string;
    th_colaborador: string;
    th_rol: string;
    th_area: string;
    th_telefono: string;
    th_turno: string;
    preview_pill: string;
    lbl_dni: string;
    lbl_tel: string;
    lbl_area: string;
    lbl_turno: string;
    lbl_entregas: string;
    btn_llamar: string;
  };
}

const { t } = Astro.props;
---

<section id="tab-personales" class="v51-tab-pane">
  <div class="v51-section-banner">
    <div class="v51-sec-top-row">
      <div class="v51-sec-title">
        <h3><i class="fa-solid fa-id-badge" style="color: var(--v51-primary);"></i> {t.titulo}</h3>
        <p>{t.subtitulo}</p>
      </div>
      <div>
        <button class="v51-btn-primary-orange" id="btnAgregarPersonal" type="button">
          <i class="fa-solid fa-plus"></i> {t.btn_agregar}
        </button>
      </div>
    </div>

    <!-- BUSCADOR DEBAJO DEL BOTÓN -->
    <div class="v51-search-input-box">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" id="filtroPersonalInput" placeholder={t.search_ph} autocomplete="off" />
    </div>
  </div>

  <!-- LAYOUT TABLA LIMPIA + PREVIEW -->
  <div class="v51-split-layout">
    <div class="v51-table-card">
      <table class="v51-table">
        <thead>
          <tr>
            <th>{t.th_colaborador}</th>
            <th>{t.th_rol}</th>
            <th>{t.th_area}</th>
            <th>{t.th_telefono}</th>
            <th>{t.th_turno}</th>
          </tr>
        </thead>
        <tbody id="tablaPersonalBody">
          {equipoPersonal.map((p, idx) => (
            <tr class={`v51-staff-row ${idx === 0 ? 'selected' : ''}`}
                data-id={p.id}
                data-nombre={p.nombre}
                data-rol={p.rol}
                data-tel={p.telefono}
                data-dni={p.dni}
                data-area={p.area}
                data-turno={p.turno}
                data-entregas={p.entregasMes}>
              <td>
                <strong>{p.nombre}</strong><br />
                <small style="color: var(--v51-text-muted);">DNI: {p.dni}</small>
              </td>
              <td>
                <span class="v51-kpi-tag" style="font-size: 0.68rem;">{p.rol}</span>
              </td>
              <td>
                <span style="font-size: 0.78rem;">{p.area}</span>
              </td>
              <td>
                <span>{p.telefono}</span>
              </td>
              <td>
                <label class="v51-apple-switch">
                  <input type="checkbox" checked={p.activo} class="apple-toggle-staff" data-id={p.id} data-nombre={p.nombre} />
                  <span class="v51-switch-slider"></span>
                </label>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- PANEL LATERAL DE DETALLE DE PERSONAL -->
    <div class="v51-preview-card" id="prevStaffCard" data-selected-id={equipoPersonal[0]?.id || ''}>
      <div class="v51-preview-pill">
        <i class="fa-solid fa-id-card-clip"></i> {t.preview_pill}
      </div>

      <div class="v51-avatar-large-box">
        <div class="v51-avatar-round" style="background: #0284c7;" id="prevStaffAvatar">CM</div>
        <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--v51-text-title);" id="prevStaffNombre">Carlos Mendoza</h3>
        <p style="font-size: 0.76rem; color: var(--v51-primary); font-weight: 700;" id="prevStaffRol">Repartidor Motorizado</p>
      </div>

      <div class="v51-detail-list">
        <div class="v51-detail-row">
          <span class="label">{t.lbl_dni}</span>
          <span class="val" id="prevStaffDni">44556677</span>
        </div>
        <div class="v51-detail-row">
          <span class="label">{t.lbl_tel}</span>
          <span class="val" id="prevStaffTel">987 112 233</span>
        </div>
        <div class="v51-detail-row">
          <span class="label">{t.lbl_area}</span>
          <span class="val" id="prevStaffArea">Moto Torito 02 (4521-3F)</span>
        </div>
        <div class="v51-detail-row">
          <span class="label">{t.lbl_turno}</span>
          <span class="val" id="prevStaffTurno">Mañana (07:30 - 15:30)</span>
        </div>
        <div class="v51-detail-row">
          <span class="label">{t.lbl_entregas}</span>
          <span class="val" id="prevStaffEntregas" style="color: var(--v51-emerald);">412 entregas este mes</span>
        </div>
      </div>

      <div style="display: flex; gap: 0.6rem; margin-top: 1rem;">
        <button class="v51-btn-secondary" id="btnEditarPersonalFicha" type="button" style="flex: 1; justify-content: center;">
          <i class="fa-solid fa-pen-to-square"></i> Editar
        </button>
        <button class="v51-btn-send-wa-link" id="btnStaffLlamar" style="background: #0284c7; flex: 1.2; justify-content: center; margin-top: 0;" type="button">
          <i class="fa-solid fa-phone"></i> {t.btn_llamar}
        </button>
      </div>
    </div>
  </div>
</section>
