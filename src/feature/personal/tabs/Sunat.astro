---
// src/feature/personal/tabs/Sunat.astro
// Tab 5: Emisión y previsualización de Comprobantes Electrónicos SUNAT (Boletas y Facturas)
import { empresa } from '../data/empresa.js';
import { productosIniciales } from '../data/productos.js';

interface Props {
  t: {
    titulo: string;
    subtitulo: string;
    sec1_titulo: string;
    btn_seleccionar_bd: string;
    lbl_tipo_doc: string;
    lbl_serie_correlativo: string;
    lbl_cliente_nombre: string;
    cliente_nombre_ph: string;
    lbl_cliente_doc: string;
    cliente_doc_ph: string;
    lbl_direccion: string;
    direccion_ph: string;
    sec2_titulo: string;
    lbl_seleccionar_balon: string;
    lbl_cantidad: string;
    lbl_metodo_pago: string;
    btn_emitir: string;
    rep_impresa: string;
    gracias: string;
  };
}

const { t } = Astro.props;
---

<section id="tab-sunat" class="v51-tab-pane">
  <div class="v51-section-banner">
    <div class="v51-sec-title">
      <h3><i class="fa-solid fa-file-invoice-dollar" style="color: var(--v51-purple);"></i> {t.titulo}</h3>
      <p>{t.subtitulo}</p>
    </div>
  </div>

  <div class="v51-split-layout">
    <div class="v51-table-card">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.8vh;">
        <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--v51-text-title);">{t.sec1_titulo}</h4>
        <button class="v51-btn-secondary" id="btnElegirClienteBD" style="font-size: 0.78rem;" type="button">
          <i class="fa-solid fa-database" style="color: var(--v51-primary);"></i> {t.btn_seleccionar_bd}
        </button>
      </div>

      <div class="v51-grid-2">
        <div class="v51-form-group">
          <label for="sunatTipoDoc">{t.lbl_tipo_doc}</label>
          <select id="sunatTipoDoc">
            <option value="BOLETA">Boleta de Venta Electrónica (B001)</option>
            <option value="FACTURA">Factura Electrónica (F001)</option>
          </select>
        </div>
        <div class="v51-form-group">
          <label for="sunatSerieDoc">{t.lbl_serie_correlativo}</label>
          <input type="text" id="sunatSerieDoc" value="B001-000454" readonly style="background: var(--v51-surface-alt);" />
        </div>
      </div>

      <div class="v51-form-group">
        <label for="sunatInputClienteNombre">{t.lbl_cliente_nombre}</label>
        <input type="text" id="sunatInputClienteNombre" placeholder={t.cliente_nombre_ph} />
      </div>

      <div class="v51-grid-2">
        <div class="v51-form-group">
          <label for="sunatInputClienteDoc">{t.lbl_cliente_doc}</label>
          <input type="text" id="sunatInputClienteDoc" placeholder={t.cliente_doc_ph} />
        </div>
        <div class="v51-form-group">
          <label for="sunatInputClienteDir">{t.lbl_direccion}</label>
          <input type="text" id="sunatInputClienteDir" placeholder={t.direccion_ph} />
        </div>
      </div>

      <h4 style="font-size: 0.95rem; font-weight: 800; color: var(--v51-text-title); margin: 2vh 0 1.2vh;">{t.sec2_titulo}</h4>
      <div class="v51-grid-2">
        <div class="v51-form-group">
          <label for="sunatSelectProducto">{t.lbl_seleccionar_balon}</label>
          <select id="sunatSelectProducto">
            {productosIniciales.map((p) => {
              const nom = typeof p.nombre === 'object' ? p.nombre.es : p.nombre;
              const precio = Number(p.precio || 65);
              return (
                <option value={precio} data-id={p.id} data-nombre={nom}>{nom} - S/ {precio.toFixed(2)}</option>
              );
            })}
          </select>
        </div>
        <div class="v51-form-group">
          <label for="sunatInputCantidad">{t.lbl_cantidad}</label>
          <input type="number" id="sunatInputCantidad" value="1" min="1" max="50" />
        </div>
      </div>

      <div class="v51-form-group">
        <label for="sunatSelectPago">{t.lbl_metodo_pago}</label>
        <select id="sunatSelectPago">
          <option value="Efectivo contraentrega">Efectivo contraentrega</option>
          <option value="Yape / Plin">Yape / Plin (Billetera Digital)</option>
          <option value="POS Tarjeta Visa/Mastercard">POS Tarjeta Visa / Mastercard en puerta</option>
          <option value="Transferencia BCP/BBVA">Transferencia Bancaria BCP / BBVA</option>
        </select>
      </div>

      <button class="v51-btn-primary-orange" id="btnEmitirCPE" style="width: 100%; justify-content: center; padding: 1.4vh 1vw; font-size: 0.9rem;" type="button">
        <i class="fa-solid fa-receipt"></i> {t.btn_emitir}
      </button>
    </div>

    <!-- PREVISUALIZADOR DE TICKET TÉRMICO SUNAT -->
    <div class="v51-preview-card" style="background: #ffffff; color: #1e293b; border-color: #cbd5e1; box-shadow: 0 1vh 3vh rgba(0,0,0,0.15);">
      <div class="v51-thermal-ticket" id="ticketTermicoBox">
        <div style="text-align: center; border-bottom: 1px dashed #94a3b8; padding-bottom: 1.5vh; margin-bottom: 1.5vh;">
          <h3 style="font-size: 1.05rem; font-weight: 800; margin: 0; color: #0f172a;">{empresa.nombreComercial}</h3>
          <p style="font-size: 0.7rem; color: #64748b; margin: 0.3vh 0;">{empresa.razonSocial}</p>
          <p style="font-size: 0.72rem; font-weight: 700; margin: 0;">RUC: {empresa.ruc}</p>
          <p style="font-size: 0.68rem; color: #64748b; margin: 0.2vh 0;">{empresa.direccionPlanta}</p>
          <p style="font-size: 0.68rem; color: #64748b; margin: 0;">Telf: {empresa.telefonoOficial}</p>
          <p style="font-size: 0.66rem; color: #ea580c; font-weight: 700; margin-top: 0.4vh;">{empresa.autorizadaPor}</p>
        </div>

        <div style="text-align: center; margin-bottom: 1.2vh;">
          <strong id="ticketTipo" style="font-size: 0.82rem; letter-spacing: 0.5px;">BOLETA DE VENTA ELECTRÓNICA</strong><br />
          <span id="ticketSerie" style="font-size: 0.88rem; font-weight: 800; color: #ff6600;">B001-000454</span>
        </div>

        <div style="font-size: 0.7rem; border-bottom: 1px dashed #94a3b8; padding-bottom: 1vh; margin-bottom: 1vh;">
          <div><strong>Cliente:</strong> <span id="ticketCliente">Cliente General</span></div>
          <div><strong>Doc:</strong> <span id="ticketDoc">00000000</span></div>
          <div><strong>Dirección:</strong> <span id="ticketDir">Surquillo</span></div>
          <div><strong>Pago:</strong> <span id="ticketPago">Efectivo contraentrega</span></div>
        </div>

        <table style="width: 100%; font-size: 0.72rem; border-collapse: collapse; margin-bottom: 1.2vh;">
          <thead>
            <tr style="border-bottom: 1px solid #cbd5e1; text-align: left;">
              <th>Cant</th>
              <th>Descripción</th>
              <th style="text-align: right;">Total</th>
            </tr>
          </thead>
          <tbody id="ticketItems">
            <tr>
              <td>1</td>
              <td>Balón SOLGAS Premium 10 kg</td>
              <td style="text-align: right;">S/ 65.00</td>
            </tr>
          </tbody>
        </table>

        <div style="font-size: 0.72rem; border-top: 1px dashed #94a3b8; padding-top: 1vh;">
          <div style="display: flex; justify-content: space-between;">
            <span>Op. Gravada:</span>
            <span id="ticketSubtotal">S/ 55.08</span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span>I.G.V. (18%):</span>
            <span id="ticketIGV">S/ 9.92</span>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.88rem; font-weight: 800; color: #0f172a; margin-top: 0.5vh; border-top: 1px solid #cbd5e1; padding-top: 0.4vh;">
            <span>TOTAL:</span>
            <span id="ticketTotal" style="color: #ff6600;">S/ 65.00</span>
          </div>
        </div>

        <div style="text-align: center; margin-top: 1.8vh; font-size: 0.65rem; color: #64748b;">
          <i class="fa-solid fa-qrcode" style="font-size: 2.2rem; margin-bottom: 0.4vh; color: #0f172a;"></i>
          <p style="margin: 0;">{t.rep_impresa}</p>
          <p style="margin: 0.2vh 0; font-weight: 600;">{t.gracias}</p>
        </div>
      </div>
    </div>
  </div>
</section>
