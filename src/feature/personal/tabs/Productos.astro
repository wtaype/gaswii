---
// src/feature/personal/tabs/Productos.astro
// Tab 2: Catálogo oficial de balones y accesorios, control de precios en Soles S/ y stock
import { productosIniciales } from '../data/productos.js';

interface Props {
  idioma?: string;
  t: {
    titulo: string;
    subtitulo: string;
    btn_pedir_stock: string;
    btn_nuevo_producto: string;
    valvula: string;
    peso: string;
    seguridad: string;
    garantia_solgas: string;
    stock_llenos: string;
    sede_planta: string;
    btn_editar_ficha: string;
    pedir_por_wa: string;
  };
}

const { t, idioma = 'es' } = Astro.props;
const isEn = idioma === 'en';
---

<section id="tab-productos" class="v51-tab-pane">
  <div class="v51-section-banner">
    <div class="v51-sec-top-row">
      <div class="v51-sec-title">
        <h3><i class="fa-solid fa-boxes-stacked" style="color: var(--v51-primary);"></i> {t.titulo}</h3>
        <p>{t.subtitulo}</p>
      </div>
      <div class="v51-sec-actions">
        <button class="v51-btn-secondary" id="btnReponerStock" type="button">
          <i class="fa-brands fa-whatsapp" style="color: #25d366;"></i> {t.btn_pedir_stock}
        </button>
        <button class="v51-btn-primary-orange" id="btnNuevoProducto" type="button">
          <i class="fa-solid fa-plus"></i> {t.btn_nuevo_producto}
        </button>
      </div>
    </div>
  </div>

  <!-- PRODUCTOS CON DISEÑO OFICIAL DE TIENDA Y DATOS EN SOLES S/ -->
  <div class="v51-products-store-grid" id="contenedorProductosGrid">
    {productosIniciales.map((p) => {
      const nombre = isEn ? (p.nombre?.en || p.nombre?.es) : (p.nombre?.es || p.nombre);
      const badge = isEn ? (p.badge?.en || p.badge?.es) : (p.badge?.es || p.badge);
      const tipoUso = isEn ? (p.tipoUso?.en || p.tipoUso?.es) : (p.tipoUso?.es || p.tipoUso);
      const capacidad = isEn ? (p.capacidad?.en || p.capacidad?.es) : (p.capacidad?.es || p.capacidad);
      const valvula = isEn ? (p.valvula?.en || p.valvula?.es) : (p.valvula?.es || p.valvula);
      const peso = isEn ? (p.pesoTotal?.en || p.pesoTotal?.es) : (p.pesoTotal?.es || p.pesoTotal);
      const seguridad = isEn ? (p.seguridad?.en || p.seguridad?.es) : (p.seguridad?.es || p.seguridad);
      const garantia = isEn ? (p.garantia?.en || p.garantia?.es) : (p.garantia?.es || p.garantia);
      const despacho = isEn ? (p.despacho?.en || p.despacho?.es) : (p.despacho?.es || p.despacho);
      const garantias = isEn ? (p.garantiasList?.en || p.garantiasList?.es || []) : (p.garantiasList?.es || []);

      return (
        <div class="v51-prod-card" data-prod-id={p.id}>
          <div>
            <div class="v51-prod-card-top">
              <span class={p.tag}><i class={p.icon || 'fa-solid fa-fire'}></i> {badge}</span>
              <span class="v51-prod-use-pill">{tipoUso}</span>
            </div>

            <div class="v51-prod-img-box">
              <img src={p.imagen} alt={nombre} onerror="this.onerror=null;this.src='/imgwii/productos/BALON-10KG.webp';" />
              <span class="v51-prod-weight-pill">{capacidad}</span>
            </div>

            <h4 class="v51-prod-title">{nombre}</h4>

            <div class="v51-prod-specs">
              <div class="v51-spec-line">
                <i class="fa-solid fa-fire" style="color: #ff6600;"></i>
                <span><strong>{t.valvula}</strong> {valvula}</span>
              </div>
              <div class="v51-spec-line">
                <i class="fa-solid fa-scale-balanced" style="color: #0284c7;"></i>
                <span><strong>{t.peso}</strong> {peso}</span>
              </div>
              <div class="v51-spec-line">
                <i class="fa-solid fa-shield-halved" style="color: #10b981;"></i>
                <span><strong>{t.seguridad}</strong> {seguridad}</span>
              </div>
            </div>

            <div class="v51-prod-guarantees">
              <span class="v51-guarantee-tag">{t.garantia_solgas}</span>
              {garantias.map((g) => (
                <div class="v51-guarantee-item">
                  <i class="fa-solid fa-circle-check"></i>
                  <span>{g}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="v51-prod-bottom">
            <div class="v51-prod-price-box">
              <div>
                <small>{garantia}</small>
                <div class="v51-prod-price-val">S/ {p.precio.toFixed(2)}</div>
              </div>
              <div style="text-align: right;">
                <small style="color: var(--v51-emerald); font-weight: 700;">{p.stockLlenos} {t.stock_llenos}</small><br />
                <small style="color: var(--v51-text-muted);">{p.stockVacios} vacíos</small>
              </div>
            </div>

            <div class="v51-prod-action-row">
              <button class="v51-btn-edit-prod btn-abrir-editar-prod" 
                      data-id={p.id} 
                      data-nombre={p.nombre?.es || nombre} 
                      data-precio={p.precio}
                      data-costo={p.costo}
                      data-stock={p.stockLlenos}
                      data-stock-vacios={p.stockVacios}
                      data-pin={p.pin ? 'true' : 'false'}
                      data-valvula={p.valvula?.es || valvula}
                      type="button">
                <i class="fa-solid fa-pen-to-square"></i> {t.btn_editar_ficha}
              </button>
              <a href={`https://wa.me/51936369384?text=Hola%20deseo%20pedir%20${encodeURIComponent(nombre)}`} 
                 target="_blank" 
                 rel="noopener noreferrer"
                 class="v51-btn-wa-pedir"
                 title={t.pedir_por_wa}>
                <i class="fa-brands fa-whatsapp"></i>
              </a>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>
