---
// src/feature/personal/tabs/Whatsapp.astro
// Tab 6: Plantillas de mensajería express y avisos por WhatsApp
import { productosIniciales } from '../data/productos.js';

interface Props {
  t: {
    titulo: string;
    subtitulo: string;
    lbl_modelo_mensaje: string;
    opt_ruta: string;
    opt_cpe: string;
    opt_confirmacion: string;
    lbl_nombre_cliente: string;
    lbl_eta: string;
    lbl_repartidor: string;
    lbl_monto_cobro: string;
    lbl_wa_destino: string;
    btn_abrir_wa: string;
    canal_oficial: string;
    canal_sub: string;
  };
}

const { t } = Astro.props;
---

<section id="tab-whatsapp" class="v51-tab-pane">
  <div class="v51-section-banner">
    <div class="v51-sec-title">
      <h3><i class="fa-brands fa-whatsapp" style="color: #25d366;"></i> {t.titulo}</h3>
      <p>{t.subtitulo}</p>
    </div>
  </div>

  <div class="v51-split-layout">
    <div class="v51-table-card">
      <div class="v51-form-group">
        <label for="waSelectPlantilla">{t.lbl_modelo_mensaje}</label>
        <select id="waSelectPlantilla">
          <option value="ruta">{t.opt_ruta}</option>
          <option value="cpe">{t.opt_cpe}</option>
          <option value="confirmacion">{t.opt_confirmacion}</option>
        </select>
      </div>

      <div class="v51-form-group">
        <label for="waInputNombre">{t.lbl_nombre_cliente}</label>
        <input type="text" id="waInputNombre" placeholder="Nombre del cliente" />
      </div>

      <div class="v51-grid-2">
        <div class="v51-form-group">
          <label for="waInputEta">{t.lbl_eta}</label>
          <input type="text" id="waInputEta" value="12–15 minutos" />
        </div>
        <div class="v51-form-group">
          <label for="waInputMoto">{t.lbl_repartidor}</label>
          <input type="text" id="waInputMoto" value="Repartidor de Turno" />
        </div>
      </div>

      <div class="v51-form-group">
        <label for="waInputCobro">{t.lbl_monto_cobro}</label>
        <input type="text" id="waInputCobro" value="S/ 65.00 (Efectivo exacto o Yape)" />
      </div>

      <div class="v51-form-group">
        <label for="waInputDestino">{t.lbl_wa_destino}</label>
        <input type="tel" id="waInputDestino" placeholder="Ej. 987654321" />
      </div>

      <button class="v51-btn-send-wa-link" id="btnEnviarWhatsAppOficial" style="background: #25d366;" type="button">
        <i class="fa-brands fa-whatsapp" style="font-size: 1.2rem;"></i> {t.btn_abrir_wa}
      </button>
    </div>

    <!-- PREVIEW BURBUJA WA -->
    <div class="v51-table-card" style="background: #0b141a; border-color: rgba(255, 255, 255, 0.1);">
      <div style="display: flex; align-items: center; gap: 0.8vw; border-bottom: 1px solid rgba(255, 255, 255, 0.1); padding-bottom: 1.2vh; margin-bottom: 1.5vh;">
        <div class="v51-header-avatar" style="background: #25d366;">
          <i class="fa-brands fa-whatsapp"></i>
        </div>
        <div>
          <strong style="color: #e9edef; font-size: 0.88rem;">{t.canal_oficial}</strong><br />
          <small style="color: #8696a0;">{t.canal_sub}</small>
        </div>
      </div>

      <div style="background: #005c4b; color: #e9edef; padding: 1.6vh 1.2vw; border-radius: 0.8rem; font-size: 0.82rem; line-height: 1.5; white-space: pre-line; box-shadow: 0 0.4vh 1.2vh rgba(0, 0, 0, 0.3);" id="waBubblePreview">
        ¡Hola!
        Te saludamos de *Solgas Surquillo (Jr. Dante 260)*.

        🛵 Tu balón de gas ya está *EN CAMINO*.
        ⏱️ Tiempo estimado: *12–15 minutos*.
        👤 Repartidor: *Repartidor de Turno*.
        💵 Cobro: *S/ 65.00 (Efectivo exacto o Yape)*.

        ⚖️ Recuerda que tu balón cuenta con *pesaje digital obligatorio en puerta*. ¡Muchas gracias!
      </div>
    </div>
  </div>
</section>
