---
// src/feature/cliente/secciones/ReordenExpress.astro
// Botonera Maestra de Reorden en 1-Clic (100% Cero CSS Inline)
interface Props {
  balon?: string;
  direccion?: string;
  precioVIP?: number;
  imagen?: string;
}

const {
  balon = 'Balón SOLGAS de 10 kg',
  direccion = '',
  precioVIP = 48.00,
  imagen = '/imgwii/productos/BALON-10KG.webp'
} = Astro.props;
---

<section class="reorden-express-card clean-card">
  <div class="reorden-product-info">
    <img src={imagen} alt={balon} class="reorden-product-thumb" />
    <div>
      <h3 class="reorden-title">
        Balón Habitual: <strong id="reordenBalonNombre">{balon}</strong>
      </h3>
      <p class="reorden-sub">
        Entregar en: <strong id="reordenDireccionDisplay">{direccion || 'Registra tu dirección abajo para 1-clic'}</strong> • Tarifa VIP: <strong>S/ {precioVIP.toFixed(2)}</strong>
      </p>
    </div>
  </div>

  <button 
    type="button" 
    class="reorden-action-btn" 
    id="btnReordenExpress"
    onclick="window.ejecutarReordenExpress && window.ejecutarReordenExpress()"
  >
    <i class="fa-solid fa-bolt"></i>
    <span>Repetir Pedido en 1-Clic</span>
  </button>
</section>
