---
// src/core/componentes/StickyBar.astro
// 11. BARRA FLOTANTE STICKY PARA SMARTPHONES - Solgas Surquillo (100% Cero CSS Inline)
import app from '../../app.js';
import { getI18n, type Idioma } from '../idioma/idioma';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const t = getI18n(idioma).nav;
---

<div class="mobile-sticky-bar">
  <a href={`tel:${app.telefonoLimpio}`} class="btn-call sticky-btn-call" title="Llamar a Central de Despacho">
    <i class="fa-solid fa-phone"></i> <span>{t.sticky_llamar}</span>
  </a>
  <button onclick="window.abrirModalPedido && window.abrirModalPedido()" class="btn-whatsapp sticky-btn-order" title="Pedir Gas Express">
    <i class="fa-brands fa-whatsapp"></i> <span>{t.sticky_pedir}</span>
  </button>
</div>