---
// src/core/componentes/MobileDrawer.astro
// DRAWER MÓVIL INTERACTIVO - Solgas Surquillo (100% Cero CSS Inline)
import app from '../../app.js';
import { datosNegocio } from '../../negocio.js';
import { getI18n, IDIOMAS, buildRuta, type Idioma } from '../idioma/idioma';

interface Props {
  idioma?: Idioma;
  ruta?: string;
}

const { idioma = 'es', ruta = '/' } = Astro.props;
const t = getI18n(idioma).nav;

// Extraer ruta base canónica sin prefijos de idioma existentes
let rutaBase = (ruta || '/').replace(/\/$/, '') || '/';
for (const code of Object.keys(IDIOMAS)) {
  if (rutaBase === `/${code}`) {
    rutaBase = '/';
    break;
  }
  if (rutaBase.startsWith(`/${code}/`)) {
    rutaBase = rutaBase.slice(code.length + 1) || '/';
    break;
  }
}

const baseHash = idioma === 'es' ? (ruta !== '/' ? '/' : '') : `/${idioma}`;
const horarioTexto = idioma === 'en' ? datosNegocio.horarioEn : datosNegocio.horario;
---

<!-- BACKDROP PARA DRAWER MÓVIL -->
<div class="drawer-backdrop" id="drawerBackdrop" onclick="window.cerrarDrawer && window.cerrarDrawer()"></div>

<!-- DRAWER MÓVIL INTERACTIVO -->
<aside class="mobile-drawer" id="mobileDrawer">
  <div class="drawer-brand-header">
    <div class="drawer-brand-box">
      <img src={datosNegocio.logo} alt={datosNegocio.nombre} width="44" height="44" class="drawer-logo-img" />
    </div>
    
    <div class="flex items-center gap-2">
      <!-- Selector Dinámico de Idiomas Móvil -->
      <div class="header-pill-group" title="Idioma / Language">
        {Object.entries(IDIOMAS).map(([code, info]) => (
          <a 
            href={buildRuta(rutaBase, code)} 
            data-lang={code}
            class={`header-pill-btn ${idioma === code ? 'active' : ''}`}
          >
            {code.toUpperCase()}
          </a>
        ))}
      </div>

      <button onclick="window.cerrarDrawer && window.cerrarDrawer()" aria-label="Cerrar Menú" class="drawer-close-btn">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
  </div>

  <!-- Navegación Drawer -->
  <nav class="drawer-nav-list">
    <a href={`${baseHash}#pesaje`} onclick="window.cerrarDrawer && window.cerrarDrawer()" class="drawer-nav-link"><i class="fa-solid fa-scale-balanced drawer-nav-icon color-brand-blue"></i> <span>{t.balanza}</span></a>
    <a href={`${baseHash}#productos`} onclick="window.cerrarDrawer && window.cerrarDrawer()" class="drawer-nav-link"><i class="fa-solid fa-fire drawer-nav-icon color-primary"></i> <span>{t.productos}</span></a>
    <a href={`${baseHash}#seguridad`} onclick="window.cerrarDrawer && window.cerrarDrawer()" class="drawer-nav-link"><i class="fa-solid fa-shield-halved drawer-nav-icon color-emerald"></i> <span>{t.seguridad}</span></a>
    <a href={`${baseHash}#calculadora`} onclick="window.cerrarDrawer && window.cerrarDrawer()" class="drawer-nav-link"><i class="fa-solid fa-calculator drawer-nav-icon color-gold"></i> <span>{t.calculadora}</span></a>
    <a href={`${baseHash}#mapa-sede`} onclick="window.cerrarDrawer && window.cerrarDrawer()" class="drawer-nav-link"><i class="fa-solid fa-location-dot drawer-nav-icon color-brand-blue"></i> <span>{t.ubicacion}</span></a>
    <a href={`${baseHash}#nosotros`} onclick="window.cerrarDrawer && window.cerrarDrawer()" class="drawer-nav-link"><i class="fa-solid fa-building drawer-nav-icon color-primary"></i> <span>{t.nosotros}</span></a>
  </nav>

  <!-- Botones en Drawer Móvil -->
  <div class="drawer-footer-actions">
    <!-- Botón Login Móvil -->
    <button id="drawerBtnLogin" onclick="window.cerrarDrawer && window.cerrarDrawer(); window.abrirModalLogin && window.abrirModalLogin();" class="btn-outline w-full justify-center">
      <i class="fa-solid fa-circle-user"></i> <span>{t.login}</span>
    </button>

    <!-- Card Usuario Móvil (Cuando está autenticado) -->
    <div id="drawerUserPerfil" class="drawer-user-card" data-idioma={idioma}>
      <a id="drawerPerfilLink" href="/cliente" onclick="window.cerrarDrawer && window.cerrarDrawer()" class="drawer-user-link">
        <img id="drawerUserAvatar" src="" alt="Avatar" class="drawer-user-avatar" />
        <div>
          <div id="drawerUserNombre" class="drawer-user-name">Cliente VIP</div>
          <div id="drawerUserBadge" class="drawer-user-badge">@usuario</div>
        </div>
      </a>
      <button type="button" onclick="window.cerrarSesionHeader && window.cerrarSesionHeader()" class="drawer-btn-logout" title="Cerrar Sesión">
        <i class="fa-solid fa-right-from-bracket"></i>
      </button>
    </div>

    <!-- Anti-Flash Inmediato (0ms) para Drawer Móvil Perfil -->
    <script is:inline>
      try {
        const raw = localStorage.getItem('wiSmile');
        if (raw) {
          const u = JSON.parse(raw);
          if (u && (u.uid || u.nombre)) {
            const r = u.rol || 'cliente';
            const isStaff = r === 'personal' || r === 'gestor' || r === 'admin';
            const isEn = window.location.pathname.startsWith('/en');
            const dest = isStaff ? (isEn ? '/en/personal' : '/personal') : (isEn ? '/en/cliente' : '/cliente');
            const link = document.getElementById('drawerPerfilLink');
            if (link) link.href = dest;
          }
        }
      } catch (e) {}
    </script>

    <!-- Botón Pedir Gas Móvil -->
    <button onclick="window.cerrarDrawer && window.cerrarDrawer(); window.abrirModalPedido && window.abrirModalPedido();" class="btn-whatsapp w-full justify-center">
      <i class="fa-brands fa-whatsapp"></i> <span>{t.pedir}</span>
    </button>

    <!-- Enlace Telefónico Rápido -->
    <a href={`tel:${datosNegocio.telefonoLimpio}`} class="btn-outline w-full justify-center" data-negocio-tel-link>
      <i class="fa-solid fa-phone"></i> <span data-negocio-tel-text>{datosNegocio.telefonoMostrado}</span>
    </a>

    <div class="text-center font-bold text-muted text-xs">
      <i class="fa-solid fa-clock"></i> <span data-negocio-horario>{horarioTexto}</span>
    </div>
  </div>
</aside>

<script>
  import { wiAuth, generarAvatarUrl } from '../../feature/auth/sesion.js';
  import { ROL_PATH } from '../rutas.js';
  import type { SmileData } from '../tipos/auth';

  function resolverDestinoDashboard(smile: SmileData | null): string {
    if (!smile) return '/login';
    const isEn = window.location.pathname.startsWith('/en');
    const rol = smile.rol || 'cliente';
    const esStaff = rol === 'personal' || rol === 'gestor' || rol === 'admin';
    const base = ROL_PATH[rol as keyof typeof ROL_PATH] || (esStaff ? '/personal' : '/cliente');
    return isEn ? `/en${base}` : base;
  }

  function actualizarDrawerAuth(smile: SmileData | null) {
    const drawerBtnLogin = document.getElementById('drawerBtnLogin');
    const drawerUserPerfil = document.getElementById('drawerUserPerfil');
    const drawerUserAvatar = document.getElementById('drawerUserAvatar') as HTMLImageElement | null;
    const drawerUserNombre = document.getElementById('drawerUserNombre');
    const drawerUserBadge = document.getElementById('drawerUserBadge');
    const drawerPerfilLink = document.getElementById('drawerPerfilLink') as HTMLAnchorElement | null;

    if (smile && (smile.uid || smile.nombre)) {
      if (drawerBtnLogin) drawerBtnLogin.style.display = 'none';
      if (drawerUserPerfil) drawerUserPerfil.style.display = 'flex';

      const foto = smile.foto || generarAvatarUrl(smile.nombre, smile.usuario);
      if (drawerUserAvatar) drawerUserAvatar.src = foto;
      if (drawerUserNombre) drawerUserNombre.textContent = smile.nombre ? smile.nombre.split(' ')[0] : (smile.usuario || 'VIP');
      
      // Badge inteligente según el rol activo
      const rol = smile.rol || 'cliente';
      let rolBadge = smile.usuario ? `@${smile.usuario.replace('@', '')}` : 'VIP';
      if (rol === 'gestor') rolBadge = 'Gestor';
      else if (rol === 'admin') rolBadge = 'Admin';
      else if (rol === 'personal') rolBadge = 'Personal';
      if (drawerUserBadge) drawerUserBadge.textContent = rolBadge;

      const rutaDestino = resolverDestinoDashboard(smile);
      if (drawerPerfilLink) drawerPerfilLink.href = rutaDestino;
    } else {
      if (drawerBtnLogin) drawerBtnLogin.style.display = 'flex';
      if (drawerUserPerfil) drawerUserPerfil.style.display = 'none';
    }
  }

  // Reactividad Local-First (0ms de latencia)
  wiAuth.on((smile: any) => {
    actualizarDrawerAuth(smile);
  });

  // Accesibilidad: Cerrar Drawer con tecla Escape
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const win = window as any;
      win.cerrarDrawer?.();
    }
  });
</script>