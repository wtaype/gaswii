---
// src/core/componentes/Footer.astro
// 🌐 Pie de Página 100% Dinámico desde app.js y wii.js (100% Centrado en Móvil)
import app from '../../app.js';
import esJson from '../idioma/es.json';
import enJson from '../idioma/en.json';

interface Props {
  idioma?: 'es' | 'en';
}

const { idioma = 'es' } = Astro.props;
const t = idioma === 'en' ? enJson.footer : esJson.footer;
const navT = idioma === 'en' ? enJson.nav : esJson.nav;
const slogan = idioma === 'en' ? app.sloganEn : app.slogan;
const horario = idioma === 'en' ? app.horarioEn : app.horario;
const cert = idioma === 'en' ? app.certificacionEn : app.certificacion;

// Separar título dinámico
const titleWords = (app.app || 'Kevin Tours Evolution').split(' ');
const mainTitle = titleWords.length > 1 ? titleWords.slice(0, -1).join(' ') : titleWords[0];
const accentTitle = titleWords.length > 1 ? titleWords[titleWords.length - 1] : '';
---

<footer class="footer-container">
  <div class="container-wide">
    <div class="footer-grid">
      
      <!-- Col 1: Marca Dinámica y Redes (Centrado en Móvil) -->
      <div class="footer-brand-box">
        <div class="header-logo">
          <div class="header-logo-icon">
            <i class="fa-solid fa-person-skiing"></i>
          </div>
          <div class="header-logo-text">
            <strong class="header-logo-title">
              {mainTitle} {accentTitle && <span class="text-gradient">{accentTitle}</span>}
            </strong>
            <span class="header-logo-slogan">{slogan}</span>
          </div>
        </div>
        <p class="footer-desc">
          {t.descripcion}
        </p>
        <div class="footer-social-links">
          <a href={app.whatsappUrl} target="_blank" rel="noopener noreferrer" class="footer-social-btn" title="WhatsApp Oficial">
            <i class="fa-brands fa-whatsapp"></i>
          </a>
          <a href={app.instagram} target="_blank" rel="noopener noreferrer" class="footer-social-btn" title="Instagram">
            <i class="fa-brands fa-instagram"></i>
          </a>
          <a href={app.tiktok} target="_blank" rel="noopener noreferrer" class="footer-social-btn" title="TikTok">
            <i class="fa-brands fa-tiktok"></i>
          </a>
        </div>
      </div>

      <!-- Col 2: 4 Disciplinas -->
      <div>
        <h4 class="footer-col-title">{t.col_disciplinas}</h4>
        <ul class="footer-col-list">
          {t.disciplinas_lista.map(item => (
            <li><a href={item.href}>{item.nombre}</a></li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Enlaces Rápidos -->
      <div>
        <h4 class="footer-col-title">{t.col_navegacion}</h4>
        <ul class="footer-col-list">
          <li><a href="#inicio">{navT.inicio}</a></li>
          <li><a href="#tours">{navT.disciplinas}</a></li>
          <li><a href="#galeria">{navT.galeria}</a></li>
          <li><a href="#ubicacion">{navT.ubicacion}</a></li>
          <li><a href="#confianza">{navT.confianza}</a></li>
          <li><a href="#faq">{navT.faq}</a></li>
          <li><a href="/cliente">👤 {t.portal_vip}</a></li>
          <li><a href="/personal">🛠️ {t.panel_staff}</a></li>
        </ul>
      </div>

      <!-- Col 4: Base Física Hawka Dinámica con Botón Prominente -->
      <div class="footer-base-col">
        <h4 class="footer-col-title">{t.col_base}</h4>
        <p class="footer-desc">
          <i class="fa-solid fa-location-dot"></i> {app.base.direccion}
        </p>
        <p class="footer-desc">
          <i class="fa-solid fa-clock"></i> {horario}
        </p>
        <p class="footer-desc">
          <i class="fa-solid fa-certificate"></i> {cert}
        </p>
        <a href={app.base.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-speed footer-maps-btn">
          <i class="fa-solid fa-location-arrow"></i>
          <span>{t.btn_maps}</span>
        </a>
      </div>

    </div>

    <!-- Barra Inferior de Copyright, RUC y Autoría Dinámica -->
    <div class="footer-bottom-bar">
      <div>
        <span>© 2026 {app.nombreComercial}. RUC: {app.ruc}. {t.derechos}</span>
      </div>
      <div>
        <span>{cert} · {app.by}</span>
      </div>
    </div>
  </div>
</footer>
