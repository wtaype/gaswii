---
// src/core/componentes/Header.astro
// 2. HEADER CON BOTONES LOGIN Y PEDIR GAS - Solgas Surquillo (100% Cero CSS Inline)
import app from '../../app.js';
import { datosNegocio } from '../../negocio.js';
import { getI18n, IDIOMAS, buildRuta, type Idioma } from '../idioma/idioma';

interface Props {
  idioma?: Idioma;
  ruta?: string;
}

const { idioma = 'es', ruta = '/' } = Astro.props;
const t = getI18n(idioma).nav;
const esPersonal = ruta === '/personal';
const esCliente = ruta === '/cliente';

// Extraer ruta base canónica sin prefijos de idioma existentes
let rutaBase = (ruta || '/').replace(/\/$/, '') || '/';
for (const code of Object.keys(IDIOMAS)) {
  if (rutaBase === `/${code}`) {
    rutaBase = '/';
    break;
  }
  if (rutaBase.startsWith(`/${code}/`)) {
    rutaBase = rutaBase.slice(code.length + 1) || '/';
    break;
  }
}

const baseHash = idioma === 'es' ? '' : `/${idioma}`;
const urlInicio = esPersonal || esCliente ? '/' : `${baseHash}#hero`;
---

<header class="header-main">
  <div class="page-container header-container">
    
    <!-- Logo y Título -->
    <a href={urlInicio} title={esPersonal || esCliente ? (t.ir_tienda_publica || 'Ir a la Tienda Pública GasWii') : (t.inicio_titulo || 'GasWii Inicio')} class="header-brand-link">
      <img 
        src={datosNegocio.logo} 
        alt={datosNegocio.nombre} 
        width="44"
        height="44"
        class="header-logo-img"
      />
      <div>
        <span class="desktop-only header-brand-title">
          {datosNegocio.nombre.split(' ')[0]} <span>{datosNegocio.nombre.split(' ').slice(1).join(' ')}</span>
        </span>
        <span class="desktop-only header-brand-sub">
          {esPersonal ? (
            <span class="inline-flex items-center gap-1"><i class="fa-solid fa-building"></i> Consola Staff & Despachos</span>
          ) : esCliente ? (
            <span class="inline-flex items-center gap-1"><i class="fa-solid fa-star"></i> Portal Cliente VIP</span>
          ) : (
            <span>{t.slogan_brand}</span>
          )}
        </span>
      </div>
    </a>

    <!-- Navegación Desktop: Adaptativa según el Rol y la Ruta -->
    {esPersonal ? (
      <div class="desktop-only header-group-desktop">
        <span class="header-badge-status personal">
          <i class="fa-solid fa-tower-broadcast"></i> Consola Operativa Base <span data-negocio-direccion>{datosNegocio.direccionSede}</span>
        </span>
        <a href="/" class="btn-outline btn-compact" title="Ver Tienda Pública">
          <i class="fa-solid fa-store icon-brand-orange"></i> <span>Ver Tienda Pública</span>
        </a>
      </div>
    ) : esCliente ? (
      <div class="desktop-only header-group-desktop">
        <span class="header-badge-status cliente">
          <i class="fa-solid fa-gem"></i> Área Exclusiva Cliente VIP
        </span>
        <a href="/" class="btn-outline btn-compact" title="Ver Catálogo Completo">
          <i class="fa-solid fa-fire icon-brand-orange"></i> <span>Catálogo y Precios</span>
        </a>
      </div>
    ) : (
      <nav class="desktop-only header-nav-desktop">
        <a href="#pesaje" class="header-nav-item">{t.balanza}</a>
        <a href="#productos" class="header-nav-item">{t.productos}</a>
        <a href="#seguridad" class="header-nav-item">{t.seguridad}</a>
        <a href="#calculadora" class="header-nav-item">{t.calculadora}</a>
        <a href="#mapa-sede" class="header-nav-item">{t.ubicacion}</a>
        <a href="#nosotros" class="header-nav-item">{t.nosotros}</a>
      </nav>
    )}

    <!-- Controles: Idioma, Tema, Botón Login y Botón Pedir -->
    <div class="header-actions-row">
      
      <!-- Switcher Dinámico de Idiomas (Escalable para N idiomas) -->
      <div class="header-pill-group" title="Idioma / Language">
        {Object.entries(IDIOMAS).map(([code, info]) => (
          <a 
            href={buildRuta(rutaBase, code)} 
            data-lang={code}
            class={`header-pill-btn ${idioma === code ? 'active' : ''}`}
          >
            {code.toUpperCase()}
          </a>
        ))}
      </div>

      <!-- Switcher Tema (Luz / Futuro) -->
      <button 
        id="themeToggleBtn" 
        onclick="window.toggleTema && window.toggleTema()"
        aria-label="Cambiar tema" 
        class="header-theme-toggle"
        title="Cambiar Tema"
      >
        <i class="fa-solid fa-moon" id="themeIcon"></i>
      </button>

      <!-- Contenedor Auth Desktop -->
      <div id="headerAuthContainer" class="desktop-only header-auth-box">
        <!-- Botón LOGIN -->
        <button id="headerBtnLogin" onclick="window.abrirModalLogin && window.abrirModalLogin()" class="header-btn-login" title="Iniciar Sesión o Registrarse">
          <i class="fa-solid fa-circle-user"></i> <span>{t.login}</span>
        </button>

        <!-- Card Perfil Usuario -->
        <div id="headerUserPerfil" class="header-user-card" data-idioma={idioma}>
          <a href="/cliente" id="headerPerfilLink" class="header-user-link">
            <img id="headerUserAvatar" src="" alt="Foto de perfil" class="header-user-avatar" />
            <div class="header-user-info">
              <span id="headerUserNombre" class="header-user-name">Cliente</span>
              <div class="header-user-meta">
                <span id="headerUserBadge" class="header-user-badge">@usuario</span>
              </div>
            </div>
          </a>
          <button type="button" onclick="window.cerrarSesionHeader && window.cerrarSesionHeader()" title="Cerrar Sesión" class="header-btn-logout">
            <i class="fa-solid fa-right-from-bracket"></i>
          </button>
        </div>
      </div>

      <!-- Anti-Flash Inmediato (0ms) para Header Perfil -->
      <script is:inline>
        try {
          const raw = localStorage.getItem('wiSmile');
          if (raw) {
            const u = JSON.parse(raw);
            if (u && (u.uid || u.nombre)) {
              const r = u.rol || 'cliente';
              const isStaff = r === 'personal' || r === 'gestor' || r === 'admin';
              const isEn = window.location.pathname.startsWith('/en');
              const dest = isStaff ? (isEn ? '/en/personal' : '/personal') : (isEn ? '/en/cliente' : '/cliente');
              const link = document.getElementById('headerPerfilLink');
              if (link) link.href = dest;
            }
          }
        } catch (e) {}
      </script>

      <!-- Botón PEDIR GAS -->
      {!esPersonal && (
        <button onclick="window.abrirModalPedido && window.abrirModalPedido()" class="header-btn-order desktop-only" title="Hacer Pedido Express">
          <i class="fa-brands fa-whatsapp"></i> <span>{t.pedir}</span>
        </button>
      )}

      <!-- Botón Hamburguesa Móvil -->
      <button class="mobile-only header-btn-mobile-toggle" onclick="window.abrirDrawer && window.abrirDrawer()" aria-label="Abrir Menú">
        <i class="fa-solid fa-bars"></i>
      </button>

    </div>

  </div>
</header>

<script>
  import { ROL_PATH } from '../rutas.js';

  declare global {
    interface Window {
      cerrarSesionHeader?: () => Promise<void>;
      abrirDrawer?: () => void;
    }
  }

  function resolverDestinoDashboard(smile: any): string {
    if (!smile) return '/login';
    const isEn = window.location.pathname.startsWith('/en');
    const rol = smile.rol || 'cliente';
    const esStaff = rol === 'personal' || rol === 'gestor' || rol === 'admin';
    const base = ROL_PATH[rol as keyof typeof ROL_PATH] || (esStaff ? '/personal' : '/cliente');
    return isEn ? `/en${base}` : base;
  }

  function actualizarHeaderAuth(smile: any) {
    const btnLogin = document.getElementById('headerBtnLogin');
    const userPerfil = document.getElementById('headerUserPerfil');
    const userAvatar = document.getElementById('headerUserAvatar') as HTMLImageElement | null;
    const userNombre = document.getElementById('headerUserNombre');
    const userBadge = document.getElementById('headerUserBadge');
    const perfilLink = document.getElementById('headerPerfilLink') as HTMLAnchorElement | null;

    if (smile && (smile.uid || smile.nombre)) {
      if (btnLogin) btnLogin.style.display = 'none';
      if (userPerfil) userPerfil.style.display = 'flex';
      
      const foto = smile.foto || `https://ui-avatars.com/api/?name=${encodeURIComponent(smile.nombre || smile.usuario || 'VIP')}&background=ff6a00&color=fff&rounded=true`;
      if (userAvatar) userAvatar.src = foto;
      if (userNombre) userNombre.textContent = smile.nombre ? smile.nombre.split(' ')[0] : (smile.usuario || 'VIP');
      
      // Badge inteligente según el rol activo
      const rol = smile.rol || 'cliente';
      let rolBadge = smile.usuario ? `@${smile.usuario.replace('@', '')}` : 'VIP';
      if (rol === 'gestor') rolBadge = 'Gestor';
      else if (rol === 'admin') rolBadge = 'Admin';
      else if (rol === 'personal') rolBadge = 'Personal';
      if (userBadge) userBadge.textContent = rolBadge;

      const rutaDestino = resolverDestinoDashboard(smile);
      if (perfilLink) perfilLink.href = rutaDestino;
    } else {
      if (btnLogin) btnLogin.style.display = 'inline-flex';
      if (userPerfil) userPerfil.style.display = 'none';
    }
  }

  // Lectura Local-First inmediata sin importar dependencias pesadas
  try {
    const raw = localStorage.getItem('wiSmile');
    if (raw) actualizarHeaderAuth(JSON.parse(raw));
  } catch (e) {}

  window.addEventListener('gaswii:auth-change', (e: any) => {
    actualizarHeaderAuth(e.detail);
  });

  window.cerrarSesionHeader = async () => {
    const { salir } = await import('../../feature/auth/sesion.js');
    await salir();
    actualizarHeaderAuth(null);
  };

  // Switcher de idiomas inteligente: preserva la ruta actual exacta en tiempo de ejecución
  document.querySelectorAll('.header-pill-group a[data-lang]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const targetLang = btn.getAttribute('data-lang');
      if (!targetLang) return;
      e.preventDefault();
      const pathActual = window.location.pathname.replace(/\/$/, '') || '/';
      let limpia = pathActual;
      if (limpia === '/en') limpia = '/';
      else if (limpia.startsWith('/en/')) limpia = limpia.slice(3) || '/';
      const hash = window.location.hash || '';

      let dest = '';
      if (targetLang === 'es') {
        dest = limpia;
      } else {
        dest = limpia === '/' ? `/${targetLang}` : `/${targetLang}${limpia}`;
      }
      window.location.href = dest + hash;
    });
  });
</script>