---
// src/pages/view62.astro
// Vista de validación directa en tiempo real de la colección 'productos' de Firestore
// Consulta en vivo los 4 documentos y valida su estructura bilingüe { es, en } (Imagen 2)
---

<!doctype html>
<html lang="es" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>View 62 · Validador de Colección Productos (Firestore en Vivo)</title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />
  <style is:global>
    :root {
      --bg: #050a14;
      --card-bg: #08111e;
      --surface: #0e1a2f;
      --line: #18263e;
      --text: #ffffff;
      --text-muted: #8c9eb9;
      --text-soft: #cbd5e1;
      --primary: #ff6600;
      --emerald: #10b981;
      --sky: #38bdf8;
      --amber: #f59e0b;
      --teal: #14b8a6;
      --border-card: rgba(255, 255, 255, 0.08);
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Poppins', sans-serif;
      min-height: 100vh;
      padding: 30px 24px 60px;
    }
    .container {
      max-width: 1400px;
      margin: 0 auto;
    }
    
    /* Barra Superior de Control */
    .view-header {
      background: var(--card-bg);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 20px 26px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 30px;
    }
    .header-brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .header-brand img {
      height: 38px;
      object-fit: contain;
    }
    .header-brand h1 {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: -0.3px;
    }
    .header-brand p {
      font-size: 11px;
      color: var(--text-muted);
      margin-top: 2px;
    }
    .live-status {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(16, 185, 129, 0.12);
      color: var(--emerald);
      border: 1px solid rgba(16, 185, 129, 0.3);
      border-radius: 20px;
      padding: 6px 14px;
      font-size: 12px;
      font-weight: 600;
    }
    .live-status .pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--emerald);
      box-shadow: 0 0 10px var(--emerald);
    }

    /* Switch de Idioma Interactivo */
    .controls-group {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .lang-switcher {
      display: flex;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 4px;
      gap: 4px;
    }
    .lang-btn {
      background: none;
      border: 0;
      color: var(--text-muted);
      font-family: inherit;
      font-size: 12px;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 6px;
      cursor: pointer;
      transition: .2s;
    }
    .lang-btn.active {
      background: var(--primary);
      color: #ffffff;
      box-shadow: 0 2px 10px rgba(255, 102, 0, 0.3);
    }
    .reload-btn {
      background: var(--surface);
      border: 1px solid var(--line);
      color: var(--text);
      font-family: inherit;
      font-size: 12px;
      font-weight: 600;
      padding: 10px 16px;
      border-radius: 10px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: .2s;
    }
    .reload-btn:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    /* Grilla de Catálogo (Imagen 2) */
    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
    }
    @media (max-width: 1280px) {
      .catalog-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (max-width: 680px) {
      .catalog-grid {
        grid-template-columns: 1fr;
      }
    }

    /* Tarjeta Idéntica a Imagen 2 */
    .producto-card-box {
      background: var(--card-bg);
      border: 1px solid var(--border-card);
      border-radius: 18px;
      padding: 18px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      min-width: 0;
      transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
    }
    .producto-card-box:hover {
      transform: translateY(-4px);
      border-color: var(--primary);
      box-shadow: 0 12px 32px rgba(255, 102, 0, 0.16);
    }

    .producto-top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 8px;
      margin-bottom: 14px;
    }
    .producto-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 11px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 700;
      line-height: 1;
    }
    .producto-badge.badge-fire {
      background: rgba(255, 102, 0, 0.14);
      color: #ff7518;
      border: 1px solid rgba(255, 102, 0, 0.35);
    }
    .producto-badge.badge-blue {
      background: rgba(14, 165, 233, 0.14);
      color: #0ea5e9;
      border: 1px solid rgba(14, 165, 233, 0.35);
    }
    .producto-badge.badge-emerald {
      background: rgba(16, 185, 129, 0.14);
      color: #10b981;
      border: 1px solid rgba(16, 185, 129, 0.35);
    }
    .producto-badge.badge-gold {
      background: rgba(245, 158, 11, 0.14);
      color: #f59e0b;
      border: 1px solid rgba(245, 158, 11, 0.35);
    }
    .producto-tipo-badge {
      font-size: 11px;
      color: #94a3b8;
      font-weight: 600;
      background: rgba(255, 255, 255, 0.04);
      padding: 4px 11px;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      line-height: 1;
    }

    /* Vitrina de Exhibición Blanca (Imagen 2) */
    .producto-media-frame {
      position: relative;
      height: 180px;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      background: #ffffff;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      overflow: hidden;
      padding: 14px;
    }
    .producto-img-tag {
      max-height: 152px !important;
      max-width: 90% !important;
      width: auto !important;
      height: auto !important;
      object-fit: contain !important;
      display: block !important;
      margin: 0 auto !important;
      transition: transform 0.3s ease;
    }
    .producto-card-box:hover .producto-img-tag {
      transform: scale(1.05);
    }
    .producto-capacidad-tag {
      position: absolute;
      bottom: 8px;
      right: 8px;
      background: #0b1528;
      color: #ffffff;
      font-size: 10.5px;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
      pointer-events: none;
    }
    .producto-capacidad-tag .cap-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--emerald);
      display: inline-block;
    }

    /* Textos y Especificaciones */
    .producto-title {
      font-size: 15px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 12px;
      line-height: 1.35;
      min-height: 42px;
    }
    .producto-specs {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 14px;
      font-size: 11.5px;
      color: var(--text-muted);
    }
    .producto-specs li {
      display: flex;
      align-items: flex-start;
      gap: 7px;
      line-height: 1.4;
    }
    .producto-specs li i {
      font-size: 10px;
      margin-top: 3px;
      flex-shrink: 0;
    }
    .producto-specs li strong {
      color: #e2e8f0;
      white-space: nowrap;
    }
    .producto-specs li span {
      color: var(--text-soft);
    }

    /* Caja de Garantía Solgas */
    .producto-garantia-box {
      margin-bottom: 14px;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.07);
    }
    .garantia-title {
      font-size: 10px;
      text-transform: uppercase;
      font-weight: 800;
      color: #64748b;
      display: block;
      margin-bottom: 8px;
      letter-spacing: 0.8px;
    }
    .garantia-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 6px;
      font-size: 11px;
    }
    .garantia-list li {
      display: flex;
      align-items: flex-start;
      gap: 7px;
      line-height: 1.35;
      color: var(--text-soft);
    }
    .garantia-list li i {
      color: var(--teal);
      margin-top: 2px;
      font-size: 11px;
      flex-shrink: 0;
    }

    /* Precios y Envío */
    .producto-price-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 14px;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.07);
    }
    .ahorro-tag {
      font-size: 11px;
      color: #94a3b8;
      font-weight: 600;
      display: block;
      margin-bottom: 3px;
    }
    .producto-price-val {
      font-size: 28px;
      font-weight: 900;
      color: var(--primary);
      line-height: 1;
      letter-spacing: -0.5px;
    }
    .producto-price-val span {
      font-size: 16px;
      font-weight: 800;
      color: var(--primary);
      margin-right: 2px;
    }
    .envio-info {
      text-align: right;
    }
    .envio-info small {
      font-size: 10px;
      color: var(--text-muted);
      display: block;
      margin-bottom: 2px;
    }
    .envio-info strong {
      font-size: 12px;
      color: var(--emerald);
      font-weight: 700;
    }

    /* Botones CRO */
    .producto-actions {
      display: flex;
      gap: 8px;
    }
    .btn-whatsapp {
      flex: 1;
      background: #10b981;
      color: #ffffff !important;
      border: 0;
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 12.5px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      transition: background .2s, transform .2s;
    }
    .btn-whatsapp:hover {
      background: #059669;
      transform: translateY(-2px);
    }
    .btn-call {
      background: #0284c7;
      color: #ffffff !important;
      border: 0;
      border-radius: 10px;
      width: 44px;
      height: 40px;
      cursor: pointer;
      display: grid;
      place-items: center;
      text-decoration: none;
      font-size: 14px;
      flex-shrink: 0;
      transition: background .2s, transform .2s;
    }
    .btn-call:hover {
      background: #0369a1;
      transform: translateY(-2px);
    }

    /* Inspector JSON */
    .json-details {
      margin-top: 12px;
      background: rgba(0, 0, 0, 0.35);
      border-radius: 8px;
      border: 1px solid var(--border-card);
      font-size: 10px;
      overflow: hidden;
    }
    .json-details summary {
      padding: 8px 10px;
      cursor: pointer;
      color: var(--text-muted);
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .json-details summary:hover {
      color: var(--primary);
    }
    .json-details pre {
      padding: 10px;
      overflow-x: auto;
      max-height: 220px;
      color: #38bdf8;
      font-family: monospace;
      font-size: 10px;
      line-height: 1.4;
      background: rgba(0, 0, 0, 0.6);
      border-top: 1px solid var(--border-card);
    }

    /* Estado de Carga */
    .loading-box {
      grid-column: 1 / -1;
      text-align: center;
      padding: 60px 20px;
      color: var(--text-muted);
      font-size: 14px;
    }
    .loading-box i {
      font-size: 28px;
      color: var(--primary);
      margin-bottom: 12px;
      display: block;
    }

    /* Colores Utilitarios */
    .color-primary { color: var(--primary); }
    .color-emerald { color: var(--emerald); }
    .color-brand-blue { color: var(--sky); }
    .color-teal { color: var(--teal); }
  </style>
</head>
<body>
  <div class="container">
    
    <!-- Barra Superior de Control y Switch de Idioma -->
    <header class="view-header">
      <div class="header-brand">
        <img src="/imgwii/logo.webp" alt="Solgas Logo" />
        <div>
          <h1>SOLGAS SURQUILLO · Validador de Colección Firestore</h1>
          <p>Consulta directa a la colección <code>productos</code> en tiempo real</p>
        </div>
      </div>

      <div class="controls-group">
        <div class="live-status">
          <span class="pulse-dot"></span>
          <span id="statusLabel">Conectando a Firestore...</span>
        </div>

        <!-- Switcher Bilingüe Dinámico -->
        <div class="lang-switcher">
          <button type="button" class="lang-btn active" data-lang="es">ES · Español</button>
          <button type="button" class="lang-btn" data-lang="en">EN · English</button>
        </div>

        <button type="button" class="reload-btn" id="btnReload">
          <i class="fa-solid fa-rotate-right"></i> Recargar
        </button>
      </div>
    </header>

    <!-- Grilla del Catálogo en Vivo -->
    <main id="catalogContainer" class="catalog-grid">
      <div class="loading-box">
        <i class="fa-solid fa-circle-notch fa-spin"></i>
        <p>Consultando documentos en Firebase Firestore...</p>
      </div>
    </main>

  </div>

  <script>
    import { collection, getDocs, query, orderBy } from 'firebase/firestore';
    import { db } from '../core/servicios/firebase';

    let idiomaActual = 'es';
    let listaProductos = [];

    const container = document.getElementById('catalogContainer');
    const statusLabel = document.getElementById('statusLabel');

    async function cargarProductosFirestore() {
      try {
        statusLabel.textContent = 'Leyendo Firestore...';
        const colRef = collection(db, 'productos');
        const snap = await getDocs(colRef);

        if (snap.empty) {
          statusLabel.textContent = 'Colección vacía';
          container.innerHTML = '<div class="loading-box"><p>No hay documentos en la colección <code>productos</code>.</p></div>';
          return;
        }

        listaProductos = [];
        snap.forEach(doc => {
          listaProductos.push({ id: doc.id, ...doc.data() });
        });

        // Ordenamiento: primero pin, luego orden
        listaProductos.sort((a, b) => {
          if (a.pin && !b.pin) return -1;
          if (!a.pin && b.pin) return 1;
          return (Number(a.orden) || 99) - (Number(b.orden) || 99);
        });

        statusLabel.textContent = `Firestore: ${listaProductos.length} productos en vivo`;
        renderizarTarjetas();
      } catch (err) {
        console.error('Error al consultar Firestore:', err);
        statusLabel.textContent = 'Error al conectar Firestore';
        container.innerHTML = `<div class="loading-box"><p style="color:#ef4444;">Error: ${err.message}</p></div>`;
      }
    }

    function renderizarTarjetas() {
      if (!listaProductos.length) return;

      const lang = idiomaActual;
      const t = {
        valvula: lang === 'en' ? 'Valve:' : 'Válvula:',
        peso: lang === 'en' ? 'Weight:' : 'Peso:',
        seguridad: lang === 'en' ? 'Security:' : 'Seguridad:',
        garantia: lang === 'en' ? 'SOLGAS GUARANTEE' : 'GARANTÍA SOLGAS',
        despacho: lang === 'en' ? 'Doorstep delivery' : 'Despacho en puerta',
        incluido: lang === 'en' ? 'Included' : 'Incluido',
        btnPedir: lang === 'en' ? 'Order via WhatsApp' : 'Pedir por WhatsApp',
        verJson: lang === 'en' ? 'Inspect Raw Firestore JSON' : 'Ver JSON Firestore'
      };

      container.innerHTML = listaProductos.map(prod => {
        const nombre = (prod.nombre && prod.nombre[lang]) || prod.nombre?.es || prod.nombre || 'Sin nombre';
        const tipoBadge = (prod.tipo && prod.tipo[lang]) || prod.tipo?.es || (prod.badge && prod.badge[lang]) || prod.badge?.es || prod.badge || '';
        const tipoUso = (prod.tipoUso && prod.tipoUso[lang]) || prod.tipoUso?.es || prod.tipoUso || '';
        const peso = (prod.peso && prod.peso[lang]) || prod.peso?.es || (prod.capacidad && prod.capacidad[lang]) || prod.capacidad?.es || '';
        const valvula = (prod.valvula && prod.valvula[lang]) || prod.valvula?.es || prod.valvula || '';
        const pesoFull = (prod.pesoFull && prod.pesoFull[lang]) || prod.pesoFull?.es || (prod.pesoTotal && prod.pesoTotal[lang]) || prod.pesoTotal?.es || '';
        const seguridad = (prod.seguridad && prod.seguridad[lang]) || prod.seguridad?.es || prod.seguridad || 'Garantía desde planta de Solgas';
        const deliveryInfo = (prod.delivery && prod.delivery[lang]) || prod.delivery?.es || (prod.ahorro && prod.ahorro[lang]) || prod.ahorro?.es || 'Todo Incluido, despacho en puerta';
        const descripcion = (prod.descripcion && prod.descripcion[lang]) || prod.descripcion?.es || '';
        const garantiaTitulo = t.garantia;
        
        let garantiasList = [];
        if (prod.garantias && Array.isArray(prod.garantias[lang])) {
          garantiasList = prod.garantias[lang];
        } else if (Array.isArray(prod.garantias?.es)) {
          garantiasList = prod.garantias.es;
        } else if (prod.caracteristicas && Array.isArray(prod.caracteristicas[lang])) {
          garantiasList = prod.caracteristicas[lang];
        } else if (Array.isArray(prod.caracteristicas?.es)) {
          garantiasList = prod.caracteristicas.es;
        }

        const tagClase = prod.tagClase || 'badge-fire';
        const badgeIcon = prod.badgeIcon || 'fa-solid fa-star';
        const precio = Number(prod.precio ?? prod.precioPEN ?? prod.price ?? 0).toFixed(2);
        const imagenUrl = prod.imagen || prod.img || '/imgwii/productos/BALON-10KG.webp';

        return `
          <div class="producto-card-box">
            <div>
              <!-- Barra de Badges Superiores -->
              <div class="producto-top-bar">
                <span class="producto-badge ${tagClase}">
                  <i class="${badgeIcon}"></i> <span>${tipoBadge}</span>
                </span>
                <span class="producto-tipo-badge">${tipoUso}</span>
              </div>

              <!-- Vitrina Blanca -->
              <div class="producto-media-frame">
                <img 
                  src="${imagenUrl}" 
                  alt="${nombre}" 
                  class="producto-img-tag"
                  loading="lazy"
                />
                <div class="producto-capacidad-tag">
                  <span class="cap-dot"></span> <span>${peso}</span>
                </div>
              </div>

              <!-- Título -->
              <h3 class="producto-title">${nombre}</h3>

              <!-- Descripción Breve (si existe) -->
              ${descripcion ? `<p class="producto-desc-lead" style="font-size:11px; color:#94a3b8; margin-bottom:12px; line-height:1.4;">${descripcion}</p>` : ''}

              <!-- Especificaciones Técnicas con Iconos -->
              <ul class="producto-specs">
                <li>
                  <i class="fa-solid fa-tag color-primary"></i>
                  <strong>${t.valvula}</strong> <span>${valvula}</span>
                </li>
                <li>
                  <i class="fa-solid fa-box-open color-emerald"></i>
                  <strong>${t.peso}</strong> <span>${pesoFull}</span>
                </li>
                <li>
                  <i class="fa-solid fa-shield-halved color-brand-blue"></i>
                  <strong>${t.seguridad}</strong> <span>${seguridad}</span>
                </li>
              </ul>

              <!-- Bloque de Garantías Solgas (Array de Firestore) -->
              <div class="producto-garantia-box">
                <span class="garantia-title">${garantiaTitulo}</span>
                <ul class="garantia-list">
                  ${garantiasList.map(c => `
                    <li>
                      <i class="fa-solid fa-circle-check"></i>
                      <span>${c}</span>
                    </li>
                  `).join('')}
                </ul>
              </div>
            </div>

            <div>
              <!-- Fila de Precio y Despacho -->
              <div class="producto-price-row">
                <div>
                  <span class="ahorro-tag">${deliveryInfo}</span>
                  <div class="producto-price-val">
                    <span>S/</span> ${precio}
                  </div>
                </div>
                <div class="envio-info">
                  <small>${t.despacho}</small>
                  <strong>${t.incluido}</strong>
                </div>
              </div>

              <!-- Botones de Acción -->
              <div class="producto-actions">
                <a 
                  href="https://wa.me/51955030248?text=${encodeURIComponent(lang === 'en' ? `Hello Solgas Surquillo, I would like to order: ${nombre}` : `Hola Solgas Surquillo, deseo pedir: ${nombre}`)}"
                  target="_blank"
                  rel="noopener noreferrer" 
                  class="btn-whatsapp"
                >
                  <i class="fa-brands fa-whatsapp"></i> <span>${t.btnPedir}</span>
                </a>
                <a 
                  href="tel:+51955030248" 
                  class="btn-call" 
                  title="${lang === 'en' ? 'Call now' : 'Llamar ahora'}"
                >
                  <i class="fa-solid fa-phone"></i>
                </a>
              </div>

              <!-- Inspector JSON del Documento Real en Firestore -->
              <details class="json-details">
                <summary><i class="fa-solid fa-code"></i> ${t.verJson}</summary>
                <pre>${JSON.stringify(prod, null, 2)}</pre>
              </details>
            </div>
          </div>
        `;
      }).join('');
    }

    // Manejador del Switch de Idioma
    document.querySelectorAll('.lang-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        idiomaActual = btn.getAttribute('data-lang') || 'es';
        renderizarTarjetas();
      });
    });

    document.getElementById('btnReload')?.addEventListener('click', () => {
      cargarProductosFirestore();
    });

    // Cargar al inicializar
    cargarProductosFirestore();
  </script>
</body>
</html>
