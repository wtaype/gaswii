<!DOCTYPE html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Dashboard del Dueño · Solgas Surquillo (View 68)</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Anti-FOUC Inmediato -->
  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('gaswii-theme') || 'futuro';
      document.documentElement.dataset.theme = savedTheme;
      if (localStorage.getItem('gaswii_sidebar_collapsed') === 'true') {
        document.documentElement.classList.add('is-collapsed');
      }
    } catch (e) {}
  </script>

  <!-- Tipografías e Iconos -->
  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />

  <!-- Estilos WiTema V2.0 Inlined -->
  <style is:global set:html={witemaCss}></style>

  <!-- Estilos de View68 con Sidebar Mejorado (max-width: 12vw) -->
  <style is:global>
    :root {
      --side-w: 12vw;
      --side-collapsed-w: 64px;
      --topbar-h: 62px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: var(--fz_m);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    h1, h2, h3, h4, p { margin: 0; }
    button, input, select, textarea { font-family: inherit; font-size: inherit; }

    /* Topbar */
    .v68-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--topbar-h);
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      gap: 16px;
      backdrop-filter: blur(16px);
    }
    .v68-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }
    .v68-logo {
      height: 32px;
      width: auto;
      object-fit: contain;
    }
    .v68-brand-text {
      display: flex;
      flex-direction: column;
    }
    .v68-brand-title {
      font-size: var(--fz_m1);
      font-weight: 700;
      letter-spacing: -0.2px;
      color: var(--ink);
      line-height: 1.2;
    }
    .v68-brand-sub {
      font-size: var(--fz_s3);
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .v68-badge-online {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 8px var(--green);
    }

    .v68-top-actions {
      display: flex;
      align-items: center;
      gap: 12px;
      position: relative;
    }
    .v68-search-box {
      position: relative;
      width: 300px;
    }
    .v68-search-box input {
      width: 100%;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 7px 12px 7px 34px;
      color: var(--ink);
      font-size: var(--fz_s4);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .v68-search-box input:focus {
      border-color: var(--brand-orange);
      box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.15);
    }
    .v68-search-icon {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      font-size: var(--fz_s3);
      pointer-events: none;
    }

    .v68-btn-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: var(--raised);
      color: var(--ink);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, transform 0.15s;
    }
    .v68-btn-icon:hover {
      border-color: var(--brand-orange);
      color: var(--brand-orange);
      transform: translateY(-1px);
    }

    /* Badge del Usuario Limpio (Solo Nombre + Dropdown) */
    .v68-user-container { position: relative; }
    .v68-user-badge {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 4px 12px 4px 4px;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 20px;
      cursor: pointer;
      transition: border-color 0.15s, background 0.15s;
      user-select: none;
    }
    .v68-user-badge:hover, .v68-user-badge.open {
      border-color: var(--brand-orange);
      background: var(--surface);
    }
    .v68-user-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--brand-orange), #ff9900);
      color: #fff;
      font-weight: 700;
      font-size: var(--fz_s3);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .v68-user-name {
      font-size: var(--fz_s4);
      font-weight: 600;
      color: var(--ink);
    }
    .v68-user-chevron {
      font-size: 11px;
      color: var(--muted);
      transition: transform 0.2s;
    }
    .v68-user-badge.open .v68-user-chevron { transform: rotate(180deg); }

    /* Dropdown Flotante */
    .v68-dropdown-menu {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      width: 230px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
      padding: 6px;
      display: none;
      flex-direction: column;
      z-index: 60;
      animation: v68DropFade 0.18s ease-out;
    }
    .v68-dropdown-menu.active { display: flex; }
    @keyframes v68DropFade {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .v68-dropdown-header {
      padding: 10px 12px 8px;
      border-bottom: 1px solid var(--line);
      margin-bottom: 4px;
    }
    .v68-dropdown-email {
      font-size: var(--fz_s3);
      color: var(--muted);
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .v68-dropdown-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      border-radius: 7px;
      color: var(--ink);
      text-decoration: none;
      font-size: var(--fz_m);
      font-weight: 500;
      border: none;
      background: none;
      cursor: pointer;
      text-align: left;
      width: 100%;
      transition: background 0.15s, color 0.15s;
    }
    .v68-dropdown-item:hover {
      background: var(--raised);
      color: var(--brand-orange);
    }
    .v68-dropdown-item i {
      width: 16px;
      text-align: center;
      font-size: 13px;
      color: var(--muted);
    }
    .v68-dropdown-item:hover i { color: var(--brand-orange); }
    .v68-dropdown-divider { height: 1px; background: var(--line); margin: 4px 0; }
    .v68-dropdown-item.danger { color: var(--red); }
    .v68-dropdown-item.danger i { color: var(--red); }
    .v68-dropdown-item.danger:hover { background: rgba(251, 124, 133, 0.12); }

    /* ============================================================
       SIDEBAR REFINADO Y ESTILIZADO (max-width: 12vw)
       ============================================================ */
    .v68-sidebar {
      position: fixed;
      top: var(--topbar-h);
      bottom: 0;
      left: 0;
      width: var(--side-w);
      max-width: 12vw;
      min-width: 180px;
      background: var(--surface);
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      z-index: 40;
      transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      overflow-y: auto;
      overflow-x: hidden;
      scrollbar-width: thin;
      scrollbar-color: var(--line) transparent;
    }
    .v68-sidebar::-webkit-scrollbar {
      width: 4px;
    }
    .v68-sidebar::-webkit-scrollbar-thumb {
      background: var(--line);
      border-radius: 4px;
    }
    html.is-collapsed .v68-sidebar {
      width: var(--side-collapsed-w);
      min-width: unset;
      max-width: unset;
    }

    .v68-nav {
      padding: 10px 8px;
      display: flex;
      flex-direction: column;
      gap: 3px;
      flex: 1;
    }
    .v68-nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      border-radius: 8px;
      color: var(--muted);
      border: none;
      background: none;
      cursor: pointer;
      text-align: left;
      font-size: var(--fz_s4);
      font-weight: 500;
      transition: all 0.16s ease;
      white-space: nowrap;
      position: relative;
      user-select: none;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .v68-nav-item:hover {
      background: var(--raised);
      color: var(--ink);
      transform: translateX(2px);
    }
    .v68-nav-item.active {
      background: linear-gradient(90deg, rgba(255, 102, 0, 0.14) 0%, rgba(255, 102, 0, 0.02) 100%);
      color: var(--brand-orange);
      font-weight: 600;
    }
    .v68-nav-item.active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 3.5px;
      border-radius: 0 4px 4px 0;
      background: var(--brand-orange);
      box-shadow: 0 0 10px rgba(255, 102, 0, 0.6);
    }
    .v68-nav-item i {
      font-size: 14px;
      width: 18px;
      text-align: center;
      flex-shrink: 0;
      color: var(--muted);
      transition: color 0.16s ease, transform 0.16s ease;
    }
    .v68-nav-item:hover i {
      color: var(--brand-orange);
      transform: scale(1.1);
    }
    .v68-nav-item.active i {
      color: var(--brand-orange);
    }
    .v68-nav-text {
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .v68-nav-badge {
      font-size: 10px;
      font-weight: 700;
      background: var(--brand-orange);
      color: #fff;
      padding: 1px 6px;
      border-radius: 10px;
      margin-left: auto;
      box-shadow: 0 0 6px rgba(255, 102, 0, 0.4);
    }

    html.is-collapsed .v68-nav-item {
      justify-content: center;
      padding: 9px 0;
      gap: 0;
    }
    html.is-collapsed .v68-nav-item:hover {
      transform: none;
    }
    html.is-collapsed .v68-nav-text,
    html.is-collapsed .v68-nav-badge {
      display: none;
    }

    /* Pie con Botón Colapsar */
    .v68-sidebar-footer {
      padding: 10px 8px;
      border-top: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      gap: 6px;
      background: var(--surface);
    }
    .v68-btn-collapse {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 7px 10px;
      border-radius: 8px;
      background: var(--raised);
      border: 1px solid var(--line);
      color: var(--muted);
      cursor: pointer;
      font-size: var(--fz_s4);
      font-weight: 500;
      white-space: nowrap;
      transition: all 0.15s ease;
    }
    .v68-btn-collapse:hover {
      background: var(--surface);
      color: var(--brand-orange);
      border-color: var(--brand-orange);
    }
    .v68-btn-collapse i {
      font-size: 13px;
      width: 18px;
      text-align: center;
      flex-shrink: 0;
      transition: transform 0.2s ease;
    }
    html.is-collapsed .v68-btn-collapse {
      justify-content: center;
      padding: 8px 0;
    }
    html.is-collapsed .v68-btn-collapse span {
      display: none;
    }

    /* Shell Principal */
    .v68-main-shell {
      margin-left: var(--side-w);
      margin-top: var(--topbar-h);
      padding: 24px 28px 60px;
      min-height: calc(100vh - var(--topbar-h));
      transition: margin-left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    html.is-collapsed .v68-main-shell {
      margin-left: var(--side-collapsed-w);
    }

    @media (max-width: 1450px) {
      :root {
        --side-w: 185px;
      }
      .v68-sidebar {
        max-width: 185px;
      }
    }

    /* Section Headers */
    .v68-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .v68-section-title-wrap { display: flex; flex-direction: column; gap: 2px; }
    .v68-section-title {
      font-size: var(--fz_m3);
      font-weight: 700;
      color: var(--ink);
      letter-spacing: -0.3px;
    }
    .v68-section-sub {
      font-size: var(--fz_s4);
      color: var(--muted);
    }
    .v68-header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* Botones y Badges */
    .v68-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 8px 16px;
      border-radius: 8px;
      font-size: var(--fz_s4);
      font-weight: 600;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.15s ease;
      text-decoration: none;
    }
    .v68-btn-primary {
      background: var(--brand-orange);
      color: #fff;
    }
    .v68-btn-primary:hover {
      background: #e65c00;
      box-shadow: 0 4px 14px rgba(255, 102, 0, 0.3);
      transform: translateY(-1px);
    }
    .v68-btn-secondary {
      background: var(--raised);
      border-color: var(--line);
      color: var(--ink);
    }
    .v68-btn-secondary:hover {
      border-color: var(--brand-orange);
      color: var(--brand-orange);
    }
    .v68-btn-danger {
      background: rgba(251, 124, 133, 0.12);
      border-color: rgba(251, 124, 133, 0.25);
      color: var(--red);
    }
    .v68-btn-danger:hover {
      background: var(--red);
      color: #fff;
    }

    .v68-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: var(--fz_s3);
      font-weight: 600;
    }
    .v68-badge-success { background: rgba(52, 211, 153, 0.12); color: var(--green); }
    .v68-badge-warning { background: rgba(251, 191, 36, 0.12); color: var(--yellow); }
    .v68-badge-blue    { background: rgba(96, 165, 250, 0.12); color: #60a5fa; }
    .v68-badge-purple  { background: rgba(167, 139, 250, 0.12); color: #a78bfa; }

    /* Paneles de Contenido */
    .v68-panel {
      display: none;
      animation: v68FadeIn 0.22s ease-out;
    }
    .v68-panel.active { display: block; }
    @keyframes v68FadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Grid de Métricas (Dashboard) */
    .v68-stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .v68-stat-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      gap: 16px;
      transition: transform 0.15s, border-color 0.15s;
    }
    .v68-stat-card:hover {
      transform: translateY(-2px);
      border-color: var(--brand-orange);
    }
    .v68-stat-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }
    .v68-stat-icon.orange { background: rgba(255, 102, 0, 0.15); color: var(--brand-orange); }
    .v68-stat-icon.green  { background: rgba(52, 211, 153, 0.15); color: var(--green); }
    .v68-stat-icon.blue   { background: rgba(96, 165, 250, 0.15); color: #60a5fa; }
    .v68-stat-icon.purple { background: rgba(167, 139, 250, 0.15); color: #a78bfa; }
    .v68-stat-info { display: flex; flex-direction: column; }
    .v68-stat-val { font-size: var(--fz_m3); font-weight: 700; color: var(--ink); line-height: 1.2; }
    .v68-stat-lbl { font-size: var(--fz_s3); color: var(--muted); }

    /* Tablas */
    .v68-table-wrap {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      overflow-x: auto;
      margin-bottom: 24px;
    }
    .v68-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: var(--fz_s4);
    }
    .v68-table th {
      background: var(--raised);
      padding: 10px 14px;
      font-weight: 600;
      color: var(--muted);
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
    }
    .v68-table td {
      padding: 12px 14px;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
      vertical-align: middle;
    }
    .v68-table tr:last-child td { border-bottom: none; }
    .v68-table tr:hover td { background: rgba(255, 102, 0, 0.03); }

    /* ============================================================
       LAYOUT NOTEPAD 70% CANVAS / 30% LISTA RESUMIDA
       ============================================================ */
    .v68-notepad-layout {
      display: grid;
      grid-template-columns: 7fr 3fr;
      gap: 20px;
      align-items: start;
    }
    @media (max-width: 980px) {
      .v68-notepad-layout { grid-template-columns: 1fr; }
    }

    .v68-notepad-canvas-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .v68-notepad-title-input {
      width: 100%;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: var(--fz_m2);
      font-weight: 600;
      color: var(--ink);
      outline: none;
      transition: border-color 0.2s;
    }
    .v68-notepad-title-input:focus {
      border-color: var(--brand-orange);
    }

    .v68-notepad-textarea {
      width: 100%;
      min-height: 380px;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 14px;
      color: var(--ink);
      font-size: var(--fz_m);
      line-height: 1.6;
      resize: vertical;
      outline: none;
      transition: border-color 0.2s;
    }
    .v68-notepad-textarea:focus {
      border-color: var(--brand-orange);
    }

    .v68-notepad-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .v68-tag-pill-group {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .v68-tag-pill {
      font-size: var(--fz_s3);
      padding: 4px 10px;
      border-radius: 20px;
      cursor: pointer;
      background: var(--raised);
      border: 1px solid var(--line);
      color: var(--muted);
      user-select: none;
      transition: all 0.15s;
    }
    .v68-tag-pill:hover, .v68-tag-pill.active {
      border-color: var(--brand-orange);
      color: var(--brand-orange);
      background: rgba(255, 102, 0, 0.08);
      font-weight: 600;
    }

    .v68-notepad-list-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-height: 520px;
    }
    .v68-notepad-list-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--line);
      padding-bottom: 10px;
    }
    .v68-notepad-scroll-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      overflow-y: auto;
      max-height: 440px;
      padding-right: 4px;
    }

    .v68-note-summary-card {
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px 12px;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 5px;
      transition: border-color 0.15s, transform 0.12s;
    }
    .v68-note-summary-card:hover {
      border-color: var(--brand-orange);
      transform: translateX(2px);
    }
    .v68-note-summary-card.active {
      border-color: var(--brand-orange);
      background: rgba(255, 102, 0, 0.06);
    }
    .v68-note-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
    }
    .v68-note-card-title {
      font-size: var(--fz_s4);
      font-weight: 600;
      color: var(--ink);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .v68-note-card-snippet {
      font-size: var(--fz_s3);
      color: var(--muted);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .v68-note-card-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 11px;
      color: var(--muted);
      margin-top: 2px;
    }

    /* Galeria Grid */
    .v68-gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .v68-media-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 10px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: transform 0.15s, border-color 0.15s;
    }
    .v68-media-card:hover {
      border-color: var(--brand-orange);
      transform: translateY(-2px);
    }
    .v68-media-thumb {
      height: 140px;
      background: var(--raised);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      padding: 12px;
    }
    .v68-media-thumb img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }
    .v68-media-body {
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .v68-media-name {
      font-size: var(--fz_s3);
      font-weight: 600;
      color: var(--ink);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .v68-media-meta {
      font-size: 11px;
      color: var(--muted);
      display: flex;
      justify-content: space-between;
    }

    /* Formularios */
    .v68-form-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 24px;
    }
    .v68-form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
    }
    .v68-field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .v68-field label {
      font-size: var(--fz_s3);
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .v68-field input, .v68-field select, .v68-field textarea {
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 9px 12px;
      color: var(--ink);
      font-size: var(--fz_s4);
      outline: none;
      transition: border-color 0.15s;
    }
    .v68-field input:focus, .v68-field select:focus, .v68-field textarea:focus {
      border-color: var(--brand-orange);
    }

    /* Modal */
    .v68-modal {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
      z-index: 100;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .v68-modal.active { display: flex; }
    .v68-modal-box {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 14px;
      width: 100%;
      max-width: 520px;
      overflow: hidden;
      animation: v68DropFade 0.2s ease-out;
    }
    .v68-modal-head {
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .v68-modal-body { padding: 18px; }
  </style>
</head>
<body>

  <!-- Topbar Unificada con Dropdown del Usuario -->
  <header class="v68-topbar">
    <div class="v68-brand">
      <img src="/imgwii/logo.webp" alt="Solgas Surquillo" class="v68-logo" />
      <div class="v68-brand-text">
        <span class="v68-brand-title">SOLGAS SURQUILLO</span>
        <span class="v68-brand-sub">
          <span class="v68-badge-online"></span>
          Sede Jr. Dante 260 · Centro de Operaciones
        </span>
      </div>
    </div>

    <!-- Buscador Global con Autocompletado Desactivado -->
    <div class="v68-search-box">
      <i class="fa-solid fa-magnifying-glass v68-search-icon"></i>
      <input 
        type="search" 
        id="v68GlobalSearch" 
        name="q_search_dashboard_now" 
        placeholder="Buscar pedidos, facturas, clientes, notas…" 
        autocomplete="off" 
        autocorrect="off" 
        autocapitalize="off" 
        spellcheck="false" 
        role="searchbox"
      />
    </div>

    <!-- Acciones Rápidas del Dueño -->
    <div class="v68-top-actions">
      <!-- Alternar Tema -->
      <button class="v68-btn-icon" id="btnThemeToggle" aria-label="Cambiar tema">
        <i class="fa-solid fa-circle-half-stroke"></i>
      </button>

      <!-- Ir al sitio público -->
      <a href="/" target="_blank" class="v68-btn-icon" aria-label="Sitio web público" title="Ver Tienda Pública">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
      </a>

      <!-- Contenedor del Usuario (Solo Nombre + Dropdown) -->
      <div class="v68-user-container">
        <div class="v68-user-badge" id="btnUserDropdownTrigger" aria-expanded="false" aria-haspopup="true">
          <div class="v68-user-avatar">WT</div>
          <span class="v68-user-name">Wilder Taype</span>
          <i class="fa-solid fa-chevron-down v68-user-chevron"></i>
        </div>

        <!-- Dropdown Flotante del Usuario -->
        <div class="v68-dropdown-menu" id="userDropdownMenu">
          <div class="v68-dropdown-header">
            <strong style="font-size:var(--fz_s4); color:var(--ink); display:block;">Wilder Taype</strong>
            <span class="v68-dropdown-email">wilder.taype@gaswii.com</span>
          </div>
          <a href="/" target="_blank" class="v68-dropdown-item">
            <i class="fa-solid fa-store"></i> Ver Tienda Pública
          </a>
          <button type="button" class="v68-dropdown-item" data-jump-to="profile">
            <i class="fa-solid fa-user-gear"></i> Mi Perfil
          </button>
          <button type="button" class="v68-dropdown-item" data-jump-to="business">
            <i class="fa-solid fa-building"></i> Ficha Mi Negocio
          </button>
          <button type="button" class="v68-dropdown-item" data-jump-to="settings">
            <i class="fa-solid fa-gear"></i> Ajustes de Sistema
          </button>
          <div class="v68-dropdown-divider"></div>
          <button type="button" class="v68-dropdown-item danger" id="btnLogoutSession">
            <i class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Sidebar Refinado y Estilizado (max-width: 12vw) -->
  <aside class="v68-sidebar" id="sidebarMenu">
    <nav class="v68-nav" aria-label="Menú del dueño">
      {modulos.map((m, idx) => (
        <button 
          class={`v68-nav-item ${idx === 0 ? 'active' : ''}`} 
          data-panel-target={m.id}
          title={m.nombre}
        >
          <i class={m.icono}></i>
          <span class="v68-nav-text">{m.nombre}</span>
          {m.badge && <span class="v68-nav-badge">{m.badge}</span>}
        </button>
      ))}
    </nav>

    <!-- Pie con Botón Colapsar Renombrado -->
    <div class="v68-sidebar-footer">
      <button class="v68-btn-collapse" id="btnCollapseSidebar" title="Colapsar menú lateral">
        <i class="fa-solid fa-arrow-left-long" id="iconCollapse"></i>
        <span id="labelCollapse">Colapsar</span>
      </button>
    </div>
  </aside>

  <!-- Shell de Trabajo -->
  <main class="v68-main-shell">

    <!-- 1. MÓDULO: DASHBOARD -->
    <section class="v68-panel active" id="panel-dashboard">
      <div class="v68-section-header">
        <div class="v68-section-title-wrap">
          <h1 class="v68-section-title">Panel General</h1>
          <p class="v68-section-sub">Resumen de operaciones en planta Surquillo y entregas de gas en Lima.</p>
        </div>
        <div class="v68-header-actions">
          <button class="v68-btn v68-btn-primary" id="btnNuevoDespachoDash">
            <i class="fa-solid fa-bolt"></i> Nuevo Despacho
          </button>
        </div>
      </div>

      <!-- Métricas Principales -->
      <div class="v68-stats-grid">
        <div class="v68-stat-card">
          <div class="v68-stat-icon orange"><i class="fa-solid fa-fire-burner"></i></div>
          <div class="v68-stat-info">
            <span class="v68-stat-val">38 balones</span>
            <span class="v68-stat-lbl">Entregados hoy</span>
          </div>
        </div>
        <div class="v68-stat-card">
          <div class="v68-stat-icon green"><i class="fa-solid fa-file-invoice-dollar"></i></div>
          <div class="v68-stat-info">
            <span class="v68-stat-val">S/ 2,840.00</span>
            <span class="v68-stat-lbl">Facturado SUNAT</span>
          </div>
        </div>
        <div class="v68-stat-card">
          <div class="v68-stat-icon blue"><i class="fa-solid fa-truck-fast"></i></div>
          <div class="v68-stat-info">
            <span class="v68-stat-val">3 motorizados</span>
            <span class="v68-stat-lbl">En ruta activa</span>
          </div>
        </div>
        <div class="v68-stat-card">
          <div class="v68-stat-icon purple"><i class="fa-solid fa-note-sticky"></i></div>
          <div class="v68-stat-info">
            <span class="v68-stat-val" id="dashNotesCount">3 Notas</span>
            <span class="v68-stat-lbl">En tu Notepad</span>
          </div>
        </div>
      </div>

      <!-- Grilla Dashboard: Pedidos Recientes + Notepad Resumen -->
      <div style="display:grid; grid-template-columns: 2fr 1fr; gap:20px; align-items:start;">
        
        <!-- Pedidos Recientes -->
        <div class="v68-table-wrap">
          <div style="padding:14px 18px; border-bottom:1px solid var(--line); display:flex; justify-content:space-between; align-items:center;">
            <strong style="font-size:var(--fz_m2); color:var(--ink);">Últimos Despachos Registrados</strong>
            <button class="v68-btn v68-btn-secondary" style="padding:4px 10px; font-size:var(--fz_s3);" data-jump-to="orders">
              Ver todos los pedidos
            </button>
          </div>
          <table class="v68-table">
            <thead>
              <tr>
                <th>Código</th>
                <th>Cliente / Destino</th>
                <th>Producto</th>
                <th>Total</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {pedidosDemo.map(p => (
                <tr>
                  <td><strong>{p.id}</strong></td>
                  <td>
                    <div style="font-weight:600; color:var(--ink);">{p.cliente}</div>
                    <div style="font-size:var(--fz_s3); color:var(--muted);">{p.direccion}</div>
                  </td>
                  <td>{p.producto}</td>
                  <td><strong>S/ {p.total}</strong></td>
                  <td>
                    <span class={`v68-badge ${p.estado === 'Entregado' ? 'v68-badge-success' : p.estado === 'En camino' ? 'v68-badge-blue' : 'v68-badge-warning'}`}>
                      {p.estado}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Widget Notepad en Dashboard -->
        <div class="v68-form-card" style="padding:18px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
            <strong style="font-size:var(--fz_m2); color:var(--ink);">Notepad Rápido</strong>
            <button class="v68-btn v68-btn-secondary" style="padding:4px 8px; font-size:var(--fz_s3);" data-jump-to="notepad">
              Abrir Notepad
            </button>
          </div>
          <div id="dashNotesList" style="display:flex; flex-direction:column; gap:8px;">
            <!-- Renderizado dinámico -->
          </div>
          <form id="formDashQuickNote" style="margin-top:14px; display:flex; flex-direction:column; gap:8px;">
            <input type="text" id="inputDashQuickTitle" placeholder="Título de apunte…" style="background:var(--raised); border:1px solid var(--line); border-radius:6px; padding:7px 10px; color:var(--ink); font-size:var(--fz_s4);" />
            <textarea id="inputDashQuickText" rows="2" placeholder="Nota o pendiente de planta…" style="background:var(--raised); border:1px solid var(--line); border-radius:6px; padding:7px 10px; color:var(--ink); font-size:var(--fz_s4); resize:none;"></textarea>
            <button type="submit" class="v68-btn v68-btn-primary" style="padding:6px 12px; font-size:var(--fz_s4); width:100%;">
              <i class="fa-solid fa-plus"></i> Guardar en Notepad
            </button>
          </form>
        </div>

      </div>
    </section>

    <!-- 2. MÓDULO: NOTEPAD (70% Canvas / 30% Lista con 10 palabras + ...) -->
    <section class="v68-panel" id="panel-notepad">
      <div class="v68-section-header">
        <div class="v68-section-title-wrap">
          <h1 class="v68-section-title">Notepad de Gestión</h1>
          <p class="v68-section-sub">Espacio amplio de anotaciones, ideas, bitácora de planta y acuerdos comerciales.</p>
        </div>
        <div class="v68-header-actions">
          <button class="v68-btn v68-btn-secondary" id="btnNewNoteCanvas">
            <i class="fa-solid fa-file-circle-plus"></i> Nueva Nota
          </button>
          <button class="v68-btn v68-btn-primary" id="btnSaveNotepadFull">
            <i class="fa-solid fa-floppy-disk"></i> Guardar Nota
          </button>
        </div>
      </div>

      <div class="v68-notepad-layout">
        
        <!-- 70% CANVAS DE ESCRITURA Y EDICIÓN -->
        <div class="v68-notepad-canvas-card">
          <input type="hidden" id="notepadCurrentId" value="" />
          
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <div class="v68-tag-pill-group" id="tagPillGroup">
