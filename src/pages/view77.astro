---
// src/pages/view77.astro
// VIEW 77: Bento Grid Glassmorphism & App Nativa Móvil con Floating Nav Pill
// 100vh Desktop sin scroll · Cards centradas con imágenes grandes · Cero build pesado
import { avatar } from '../core/widev/nombre.js';
import witemaCss from '../core/wicss/witema.css?inline';

const cliente = {
  nombre: 'Valeria',
  nombreCompleto: 'Valeria Mendoza',
  telefono: '+51 987 654 321',
  direcciones: [
    { id: 'dir-1', alias: 'Casa Principal', calle: 'Jr. Dante 260, Dpto 301', distrito: 'Surquillo', eta: '12–15 min', esPrincipal: true },
    { id: 'dir-2', alias: 'Oficina / Estudio', calle: 'Av. República de Panamá 3565', distrito: 'San Isidro', eta: '18–25 min', esPrincipal: false }
  ]
};

const productos = [
  {
    id: 'bal-n-solgas-premium-10-kg',
    nombre: 'Balón SOLGAS Premium 10 kg',
    badge: 'MÁS PEDIDO',
    tagClase: 'badge-fire',
    precioPEN: 65.00,
    imagen: '/imgwii/productos/BALON-10KG.webp',
    checks: ['Click-On o Rosca estándar', 'Balanza digital Inacal en puerta']
  },
  {
    id: 'balon-solgas-45-kg',
    nombre: 'Balón SOLGAS 45 kg',
    badge: 'COMERCIAL',
    tagClase: 'badge-blue',
    precioPEN: 230.00,
    imagen: '/imgwii/productos/BALON-45KG.webp',
    checks: ['Rosca industrial alta presión', 'Caudal continuo para negocios']
  },
  {
    id: 'balon-masgas-de-10-kg',
    nombre: 'Balón MASGAS de 10 kg',
    badge: 'ECONÓMICO',
    tagClase: 'badge-emerald',
    precioPEN: 55.00,
    imagen: '/imgwii/productos/MASGAS-10KG.webp',
    checks: ['Universal estándar para hogar', 'Rendimiento diario garantizado']
  },
  {
    id: 'kit-regulador-solgas',
    nombre: 'Kit Regulador SOLGAS',
    badge: 'SEGURIDAD',
    tagClase: 'badge-gold',
    precioPEN: 70.00,
    imagen: '/imgwii/productos/REGULADOR.webp',
    checks: ['Traba automática antifugas', 'Homologado por Osinergmin']
  }
];
---

<!doctype html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Portal Cliente Bento Glass · Solgas Surquillo | View 77</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('gaswii_theme_cliente') || localStorage.getItem('wiTema') || 'futuro';
      document.documentElement.dataset.theme = savedTheme;
      if (localStorage.getItem('gaswii_sidebar_v77') === 'true') {
        document.documentElement.classList.add('is-collapsed');
      }
    } catch (e) {}
  </script>

  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />
  <style is:global set:html={witemaCss}></style>

  <style>
    :root {
      --side-w: 230px;
      --side-collapsed-w: 68px;
      --topbar-h: clamp(52px, 6.5vh, 60px);
      --cl-orange: #ff6600;
      --cl-orange-hover: #ff771a;
      --cl-wa: #25d366;
      --cl-emerald: #10b981;
      --cl-card-bg: rgba(13, 20, 36, 0.75);
      --cl-card-border: rgba(255, 255, 255, 0.1);
      --cl-input-bg: rgba(7, 12, 24, 0.7);
    }

    html[data-theme="luz"] {
      --cl-card-bg: rgba(255, 255, 255, 0.85);
      --cl-card-border: #e2e8f0;
      --cl-input-bg: #f8fafc;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      height: 100vh;
      overflow: hidden;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      -webkit-font-smoothing: antialiased;
    }

    @media (max-width: 960px) {
      html, body {
        height: auto;
        overflow-y: auto;
        padding-bottom: 80px;
      }
    }

    /* HEADER */
    .v77-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--topbar-h);
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      z-index: 60;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 2vw;
      backdrop-filter: blur(16px);
    }

    .v77-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: inherit;
    }
    .v77-logo { height: clamp(28px, 3.8vh, 34px); width: auto; }
    .v77-brand-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: clamp(0.9rem, 1.1vw, 1.05rem);
      font-weight: 800;
      color: var(--ink);
    }
    .v77-brand-title span { color: var(--cl-orange); }

    /* SIDEBAR */
    .v77-sidebar {
      position: fixed;
      top: var(--topbar-h);
      left: 0;
      bottom: 0;
      width: var(--side-w);
      background: var(--surface);
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 1.4vh 0.8vw;
      z-index: 50;
      transition: width 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .v77-sidebar { width: var(--side-collapsed-w); }

    @media (max-width: 960px) {
      .v77-sidebar { display: none; }
    }

    .v77-nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: clamp(7px, 1.1vh, 10px) 12px;
      border-radius: 8px;
      border: none;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-weight: 600;
      font-size: clamp(0.78rem, 0.85vw, 0.86rem);
      text-align: left;
      transition: all 0.16s;
      width: 100%;
      margin-bottom: 4px;
    }
    .v77-nav-item.active { background: rgba(255, 102, 0, 0.12); color: var(--cl-orange); font-weight: 700; }

    html.is-collapsed .v77-nav-text,
    html.is-collapsed #lblCollapse77 { display: none; }

    /* MAIN CONTAINER 100VH */
    .v77-main {
      margin-top: var(--topbar-h);
      margin-left: var(--side-w);
      height: calc(100vh - var(--topbar-h));
      padding: 1.5vh 1.8vw;
      box-sizing: border-box;
      overflow: hidden;
      transition: margin-left 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .v77-main { margin-left: var(--side-collapsed-w); }

    @media (max-width: 960px) {
      .v77-main {
        margin-left: 0 !important;
        height: auto;
        overflow: visible;
        padding: 14px;
      }
    }

    .v77-bento-grid {
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      gap: 1.5vw;
      height: 100%;
    }

    @media (max-width: 1120px) {
      .v77-bento-grid { grid-template-columns: 1fr; height: auto; }
    }

    /* CARDS 2X2 CON GLASSMORPHISM */
    .v77-cards-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.1vw;
      height: 100%;
    }

    @media (max-width: 620px) {
      .v77-cards-grid { grid-template-columns: 1fr; }
    }

    .v77-bento-card {
      background: var(--cl-card-bg);
      border: 1.5px solid var(--cl-card-border);
      border-radius: 1.6vh;
      padding: 1.2vh 1.1vw;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      text-align: center;
      cursor: pointer;
      backdrop-filter: blur(12px);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }

    .v77-bento-card:hover {
      border-color: rgba(255, 102, 0, 0.6);
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(255, 102, 0, 0.15);
    }

    .v77-bento-card.active {
      border-color: var(--cl-orange);
      background: rgba(255, 102, 0, 0.06);
      box-shadow: 0 6px 22px rgba(255, 102, 0, 0.2);
    }

    .v77-bento-img-box {
      height: clamp(80px, 12.5vh, 110px);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0.5vh 0;
    }

    .v77-bento-img {
      max-height: 100%;
      max-width: 100%;
      object-fit: contain;
      filter: drop-shadow(0 6px 12px rgba(0,0,0,0.3));
    }

    .v77-bento-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: clamp(0.9rem, 1.05vw, 1.1rem);
      font-weight: 800;
      color: var(--ink);
      margin-bottom: 0.4vh;
      text-align: center;
    }

    .v77-bento-checks {
      border-top: 1px dashed var(--line);
      padding-top: 0.6vh;
      display: flex;
      flex-direction: column;
      gap: 0.3vh;
      font-size: clamp(0.66rem, 0.72vw, 0.75rem);
      color: var(--muted);
      text-align: left;
    }
    .v77-bento-checks span i { color: var(--cl-emerald); margin-right: 4px; }

    .v77-bento-price-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-top: 1px solid var(--line);
      padding-top: 0.6vh;
      margin-top: 0.4vh;
    }

    .v77-bento-price {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: clamp(1.15rem, 1.4vw, 1.45rem);
      font-weight: 800;
      color: var(--cl-orange);
    }

    /* RIGHT COLUMN */
    .v77-col-right {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 100%;
      gap: 1vh;
    }

    .v77-card-glass {
      background: var(--cl-card-bg);
      border: 1px solid var(--cl-card-border);
      border-radius: 1.6vh;
      backdrop-filter: blur(12px);
      padding: 1.2vh 1vw;
    }

    .v77-wa-preview-box {
      background: var(--cl-card-bg);
      border: 1px solid var(--cl-card-border);
      border-radius: 1.6vh;
      overflow: hidden;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .v77-bubble {
      background: #d9fdd3;
      color: #111b21;
      border-radius: 8px 8px 2px 8px;
      padding: 0.8vh 0.8vw;
      font-size: clamp(0.72rem, 0.78vw, 0.82rem);
      white-space: pre-line;
      line-height: 1.35;
      margin-left: auto;
      max-width: 94%;
    }
    html[data-theme="futuro"] .v77-bubble { background: #005c4b; color: #e9edef; }

    .v77-btn-cta {
      background: var(--cl-wa);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 1vh 1vw;
      font-family: var(--ff_O, sans-serif);
      font-size: clamp(0.9rem, 1.05vw, 1.1rem);
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35);
      transition: all 0.2s;
    }
    .v77-btn-cta:hover { transform: translateY(-1px); }

    /* FLOATING PILL BOTTOM BAR (MÓVIL NATIVO ESTILO IOS / MATERIAL 3) */
    .v77-floating-nav { display: none; }

    @media (max-width: 960px) {
      .v77-floating-nav {
        display: flex;
        position: fixed;
        bottom: 16px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(13, 20, 36, 0.92);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 35px;
        padding: 6px 14px;
        z-index: 100;
        gap: 16px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      }

      .v77-nav-pill {
        background: transparent;
        border: none;
        color: #94a3b8;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        font-size: 0.68rem;
        font-weight: 700;
        cursor: pointer;
        padding: 4px 8px;
      }
      .v77-nav-pill.active { color: var(--cl-orange); }
      .v77-nav-pill i { font-size: 1.1rem; }
    }
  </style>
</head>
<body>

  <header class="v77-topbar">
    <a href="/view77" class="v77-brand">
      <img src="/imgwii/logo.webp" alt="Solgas" class="v77-logo" />
      <div class="v77-brand-title">SOLGAS <span>SURQUILLO</span> · Bento Glass</div>
    </a>
    <div style="display:flex; align-items:center; gap:10px;">
      <button id="btnTheme77" style="width:34px; height:34px; background:transparent; border:1px solid var(--line); border-radius:8px; color:var(--ink); cursor:pointer;"><i class="fa-solid fa-moon"></i></button>
      <span style="font-size:0.82rem; font-weight:700;">{cliente.nombre} · VIP</span>
    </div>
  </header>

  <aside class="v77-sidebar">
    <nav>
      <button class="v77-nav-item active"><i class="fa-solid fa-bolt"></i><span class="v77-nav-text">Pedir gas</span></button>
      <button class="v77-nav-item"><i class="fa-solid fa-map-location-dot"></i><span class="v77-nav-text">Direcciones</span></button>
      <button class="v77-nav-item"><i class="fa-solid fa-headset"></i><span class="v77-nav-text">Soporte</span></button>
      <button class="v77-nav-item"><i class="fa-solid fa-user-gear"></i><span class="v77-nav-text">Mi cuenta</span></button>
    </nav>
    <div>
      <button class="v77-nav-item" id="btnCollapse77"><i class="fa-solid fa-arrow-left-long"></i><span id="lblCollapse77">Colapsar</span></button>
    </div>
  </aside>

  <main class="v77-main">
    <div class="v77-bento-grid">
      
      <!-- 4 CARDS BENTO GLASS 2X2 -->
      <div class="v77-cards-grid">
        {productos.map((prod, idx) => (
          <div class={`v77-bento-card ${idx === 0 ? 'active' : ''}`} data-nombre={prod.nombre} data-precio={prod.precioPEN}>
            <div style="display:flex; justify-content:space-between; font-size:0.7rem;">
              <span style="background:rgba(255,102,0,0.18); color:var(--cl-orange); font-weight:800; padding:2px 6px; border-radius:5px;">{prod.badge}</span>
              <span style="color:var(--muted); font-weight:600;">Garantizado</span>
            </div>

            <div class="v77-bento-img-box">
              <img src={prod.imagen} alt={prod.nombre} class="v77-bento-img" />
            </div>

            <div class="v77-bento-title">{prod.nombre}</div>

            <div class="v77-bento-checks">
              {prod.checks.map(c => (
                <span><i class="fa-solid fa-circle-check"></i> {c}</span>
              ))}
            </div>

            <div class="v77-bento-price-row">
              <span class="v77-bento-price">S/ {prod.precioPEN.toFixed(2)}</span>
              <span style="color:var(--cl-emerald); font-size:0.74rem; font-weight:700;">Entrega Gratis</span>
            </div>
          </div>
        ))}
      </div>

      <!-- COLUMNA DERECHA: CONFIGURACIÓN PAGO + LIVE WHATSAPP -->
      <div class="v77-col-right">
        <div class="v77-card-glass">
          <div style="font-family:var(--ff_O); font-weight:800; font-size:0.85rem; color:var(--cl-orange); margin-bottom:8px;">
            <i class="fa-solid fa-wallet"></i> FORMA DE PAGO & ENTREGA
          </div>

          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; font-size:0.76rem;">
            <span style="color:var(--muted); font-weight:700;">Destino:</span>
            <select style="background:var(--cl-input-bg); border:1px solid var(--line); border-radius:6px; color:var(--ink); padding:4px 8px; font-weight:700;">
              {cliente.direcciones.map(d => (
                <option>{d.alias} ({d.eta})</option>
              ))}
            </select>
          </div>

          <div style="display:flex; gap:6px; margin-bottom:6px;">
            <button type="button" style="flex:1; padding:5px; border-radius:6px; background:rgba(255,102,0,0.12); border:1px solid var(--cl-orange); color:var(--cl-orange); font-size:0.76rem; font-weight:700; cursor:pointer;">Efectivo</button>
            <button type="button" style="flex:1; padding:5px; border-radius:6px; background:var(--cl-input-bg); border:1px solid var(--line); color:var(--muted); font-size:0.76rem; font-weight:700; cursor:pointer;">Yape / Plin</button>
          </div>

          <div style="display:flex; justify-content:space-between; background:rgba(16,185,129,0.08); border-radius:6px; padding:4px 8px; font-size:0.74rem; font-weight:700; color:var(--cl-emerald);">
            <span>Vuelto estimado:</span>
            <span>S/ 35.00</span>
          </div>
        </div>

        <div class="v77-wa-preview-box">
          <div style="background:#008069; color:#fff; padding:0.8vh 1vw; display:flex; align-items:center; justify-content:space-between;">
            <strong style="font-size:0.82rem;">Solgas Surquillo Oficial</strong>
            <small style="font-size:0.68rem;">en línea</small>
          </div>

          <div style="background:#efeae2; padding:1vh; flex:1; display:flex; flex-direction:column; justify-content:center;">
            <div class="v77-bubble" id="bubble77">
¡Hola Solgas Surquillo! Deseo pedir mi recarga:
👤 Valeria
📦 Balón SOLGAS Premium 10 kg (S/ 65.00)
📍 Jr. Dante 260, Dpto 301, Surquillo
💳 Efectivo (Vuelto de S/ 100.00)
⏱️ Llegada: 12–15 min
            </div>
          </div>

          <div style="padding:0.8vh 1vw; border-top:1px solid var(--line); background:var(--surface); display:flex; justify-content:space-between; align-items:center;">
            <div id="nom77" style="font-weight:800; font-size:0.95rem;">Solgas 10 kg</div>
            <div id="pr77" style="font-family:var(--ff_O); font-size:1.35rem; font-weight:800; color:var(--cl-orange);">S/ 65.00</div>
          </div>

          <div style="padding:0.8vh 1vw; border-top:1px solid var(--line); background:var(--surface);">
            <a href="https://wa.me/51936369384" target="_blank" class="v77-btn-cta" id="btnWa77">
              <i class="fa-brands fa-whatsapp"></i> <span id="lblWa77">Pedir por WhatsApp (S/ 65.00)</span>
            </a>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- FLOATING PILL BOTTOM NAVIGATION (APP NATIVA) -->
  <nav class="v77-floating-nav">
    <button class="v77-nav-pill active"><i class="fa-solid fa-bolt"></i><span>Pedir</span></button>
    <button class="v77-nav-pill"><i class="fa-solid fa-map-location-dot"></i><span>Sedes</span></button>
    <button class="v77-nav-pill"><i class="fa-solid fa-headset"></i><span>Soporte</span></button>
    <button class="v77-nav-pill"><i class="fa-solid fa-user"></i><span>Cuenta</span></button>
  </nav>

  <script is:inline>
    (function() {
      let state = { prod: 'Balón SOLGAS Premium 10 kg', precio: 65 };
      const bubble = document.getElementById('bubble77');
      const nom = document.getElementById('nom77');
      const pr = document.getElementById('pr77');
      const lbl = document.getElementById('lblWa77');
      const btn = document.getElementById('btnWa77');

      function update() {
        const msg = `¡Hola Solgas Surquillo! Deseo pedir mi recarga:\n👤 Valeria\n📦 ${state.prod} (S/ ${state.precio.toFixed(2)})\n📍 Jr. Dante 260, Dpto 301, Surquillo\n💳 Efectivo (Vuelto de S/ 100.00)\n⏱️ Llegada: 12–15 min`;
        if (bubble) bubble.innerHTML = msg.replace(/\n/g, '<br>');
        if (nom) nom.textContent = state.prod;
        if (pr) pr.textContent = `S/ ${state.precio.toFixed(2)}`;
        if (lbl) lbl.textContent = `Pedir por WhatsApp (S/ ${state.precio.toFixed(2)})`;
        if (btn) btn.href = `https://wa.me/51936369384?text=${encodeURIComponent(msg)}`;
      }

      document.querySelectorAll('.v77-bento-card').forEach(c => {
        c.addEventListener('click', () => {
          document.querySelectorAll('.v77-bento-card').forEach(x => x.classList.remove('active'));
          c.classList.add('active');
          state.prod = c.dataset.nombre;
          state.precio = parseFloat(c.dataset.precio);
          update();
        });
      });

      document.getElementById('btnTheme77')?.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme;
        const next = cur === 'luz' ? 'futuro' : 'luz';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('gaswii_theme_cliente', next);
      });

      document.getElementById('btnCollapse77')?.addEventListener('click', () => {
        const isCollapsed = document.documentElement.classList.toggle('is-collapsed');
        localStorage.setItem('gaswii_sidebar_v77', isCollapsed ? 'true' : 'false');
      });

      update();
    })();
  </script>
</body>
</html>
