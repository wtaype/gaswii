  <!-- Scripts Nativos de View67 -->
  <script is:inline>
    (function () {
      // 1. Selector de Pestañas
      const navItems = document.querySelectorAll('.v67-nav-item');
      const panels = document.querySelectorAll('.v67-panel');

      function switchPanel(targetId) {
        navItems.forEach(item => {
          const isTarget = item.getAttribute('data-panel-target') === targetId;
          item.classList.toggle('active', isTarget);
        });

        panels.forEach(p => {
          p.classList.toggle('active', p.id === `panel-${targetId}`);
        });

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      navItems.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-panel-target');
          if (target) switchPanel(target);
        });
      });

      document.querySelectorAll('[data-jump-to]').forEach(btn => {
        btn.addEventListener('click', () => {
          const dest = btn.getAttribute('data-jump-to');
          if (dest) {
            closeDropdown();
            switchPanel(dest);
          }
        });
      });

      // 2. Colapsar Sidebar
      const btnCollapse = document.getElementById('btnCollapseSidebar');
      const iconCollapse = document.getElementById('iconCollapse');
      const labelCollapse = document.getElementById('labelCollapse');

      function toggleSidebar() {
        const isCollapsed = document.documentElement.classList.toggle('is-collapsed');
        localStorage.setItem('gaswii_sidebar_collapsed', isCollapsed ? 'true' : 'false');
        if (iconCollapse && labelCollapse) {
          if (isCollapsed) {
            iconCollapse.className = 'fa-solid fa-arrow-right-long';
            labelCollapse.textContent = 'Expandir';
          } else {
            iconCollapse.className = 'fa-solid fa-arrow-left-long';
            labelCollapse.textContent = 'Plegar menú';
          }
        }
      }

      btnCollapse?.addEventListener('click', toggleSidebar);

      // 3. Conmutador de Temas (Futuro / Luz)
      const btnTheme = document.getElementById('btnThemeToggle');
      btnTheme?.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme || 'futuro';
        const next = current === 'futuro' ? 'luz' : 'futuro';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('gaswii-theme', next);
        
        if (window.Notificacion) {
          window.Notificacion(`Tema cambiado a ${next === 'futuro' ? 'Modo Futuro (Oscuro)' : 'Modo Luz (Claro)'}`, 'info', 2000);
        }
      });

      // 4. Dropdown Interactivo del Usuario en Topbar
      const btnUserDropdownTrigger = document.getElementById('btnUserDropdownTrigger');
      const userDropdownMenu = document.getElementById('userDropdownMenu');
      const btnLogoutSession = document.getElementById('btnLogoutSession');

      function toggleDropdown(e) {
        e?.stopPropagation();
        const isOpen = userDropdownMenu?.classList.toggle('active');
        btnUserDropdownTrigger?.classList.toggle('open', isOpen);
      }

      function closeDropdown() {
        userDropdownMenu?.classList.remove('active');
        btnUserDropdownTrigger?.classList.remove('open');
      }

      btnUserDropdownTrigger?.addEventListener('click', toggleDropdown);
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.v67-user-container')) {
          closeDropdown();
        }
      });

      btnLogoutSession?.addEventListener('click', async () => {
        closeDropdown();
        if (window.wiConfirmar) {
          const conf = await window.wiConfirmar('¿Estás seguro de que deseas cerrar tu sesión administrativa?', {
            titulo: 'Cerrar Sesión',
            tipo: 'danger',
            siTexto: 'Sí, Salir',
            noTexto: 'Cancelar'
          });
          if (conf) {
            if (window.Notificacion) window.Notificacion('Sesión cerrada correctamente', 'info', 2500);
            setTimeout(() => { window.location.href = '/login'; }, 1000);
          }
        } else {
          window.location.href = '/login';
        }
      });

      // ============================================================
      // 5. GESTOR DE NOTEPAD UNIFICADO (DASHBOARD + MODULO NOTEPAD 70/30)
      // ============================================================
      const STORAGE_KEY_NOTES = 'gaswii_owner_notes';
      let notas = [
        { 
          id: 'n1', 
          tag: 'Urgente', 
          titulo: 'Coordinación fin de semana con planta', 
          texto: 'Coordinar con planta Solgas el ingreso de 50 balones de 10kg para el fin de semana por alta demanda proyectada en Surquillo y Miraflores.', 
          fecha: '20 Sep, 10:30 am', 
          done: false 
        },
        { 
          id: 'n2', 
          tag: 'Planta', 
          titulo: 'Calibración balanza Inacal', 
          texto: 'Calibración semanal de la balanza digital Inacal programada para el jueves a primera hora con técnico certificado.', 
          fecha: '19 Sep, 04:15 pm', 
          done: false 
        },
        { 
          id: 'n3', 
          tag: 'Pedidos', 
          titulo: 'Cliente frecuente pollería Angamos', 
          texto: 'Cliente frecuente Sr. Méndez solicita 2 balones de 45kg para pollería en Angamos con factura a nombre de su empresa.', 
          fecha: '18 Sep, 02:00 pm', 
          done: true 
        }
      ];

      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY_NOTES));
        if (Array.isArray(saved) && saved.length > 0) notas = saved;
      } catch (e) {}

      const notepadCompactList = document.getElementById('notepadCompactList');
      const notepadBadgeCount = document.getElementById('notepadBadgeCount');
      const notepadTitle = document.getElementById('notepadTitle');
      const notepadContent = document.getElementById('notepadContent');
      const notepadCurrentId = document.getElementById('notepadCurrentId');
      const noteEditorStatus = document.getElementById('noteEditorStatus');
      const noteCharCount = document.getElementById('noteCharCount');
      const noteWordCount = document.getElementById('noteWordCount');
      const tagPillGroup = document.getElementById('tagPillGroup');
      const btnSaveNotepadFull = document.getElementById('btnSaveNotepadFull');
      const btnClearNote = document.getElementById('btnClearNote');
      const btnNewNoteCanvas = document.getElementById('btnNewNoteCanvas');

      const dashNotesCount = document.getElementById('dashNotesCount');
      const dashNotesList = document.getElementById('dashNotesList');
      const formDashQuickNote = document.getElementById('formDashQuickNote');

      let currentActiveTag = 'Urgente';

      tagPillGroup?.querySelectorAll('.v67-tag-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          tagPillGroup.querySelectorAll('.v67-tag-pill').forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          currentActiveTag = pill.getAttribute('data-tag') || 'Urgente';
        });
      });

      function setTagPill(tag) {
        currentActiveTag = tag;
        tagPillGroup?.querySelectorAll('.v67-tag-pill').forEach(p => {
          p.classList.toggle('active', p.getAttribute('data-tag') === tag);
        });
      }

      function updateCounts() {
        const chars = notepadContent?.value?.length || 0;
        const words = (notepadContent?.value?.trim() || '').split(/\s+/).filter(Boolean).length;
        if (noteCharCount) noteCharCount.textContent = `${chars} caracteres`;
        if (noteWordCount) noteWordCount.textContent = `${words} palabras`;
      }

      notepadContent?.addEventListener('input', updateCounts);

      function recortarDiezPalabras(str) {
        if (!str) return '';
        const palabras = str.trim().split(/\s+/);
        if (palabras.length <= 10) return str;
        return palabras.slice(0, 10).join(' ') + '...';
      }

      function renderAllNotes() {
        if (notepadBadgeCount) notepadBadgeCount.textContent = `${notas.length} notas`;
        if (dashNotesCount) dashNotesCount.textContent = `${notas.length} Notas`;

        if (notepadCompactList) {
          if (notas.length === 0) {
            notepadCompactList.innerHTML = '<p style="color:var(--muted); font-size:var(--fz_s3); text-align:center; padding:16px;">Sin notas guardadas.</p>';
          } else {
            notepadCompactList.innerHTML = notas.map(n => {
              const resumen10 = recortarDiezPalabras(n.texto || n.titulo);
              const isActive = notepadCurrentId?.value === n.id;
              return `
                <div class="v67-note-summary-card ${isActive ? 'active' : ''}" data-note-id="${n.id}">
                  <div class="v67-note-summary-top">
                    <span class="v67-note-summary-tag ${n.tag === 'Urgente' ? 'v67-badge-warning' : 'v67-badge-blue'}">${n.tag}</span>
                    <span class="v67-note-summary-date">${n.fecha}</span>
                  </div>
                  <strong style="font-size:var(--fz_s4); color:var(--ink); line-height:1.3;">${n.titulo || 'Nota sin título'}</strong>
                  <p class="v67-note-summary-snippet ${n.done ? 'done' : ''}">${resumen10}</p>
                  <div class="v67-note-summary-bottom">
                    <button class="v67-btn v67-btn-secondary btn-toggle-done" style="padding:2px 8px; font-size:11px;">
                      <i class="fa-solid ${n.done ? 'fa-rotate-left' : 'fa-check'}"></i> ${n.done ? 'Hecha' : 'Completar'}
                    </button>
                    <button class="v67-btn v67-btn-danger btn-delete-note" style="padding:2px 6px; font-size:11px;">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </div>
                </div>
              `;
            }).join('');
          }
        }

        if (dashNotesList) {
          const ultimas = notas.slice(0, 3);
          if (ultimas.length === 0) {
            dashNotesList.innerHTML = '<p style="color:var(--muted); font-size:var(--fz_s4);">No tienes notas hoy. Puedes anotar arriba.</p>';
          } else {
            dashNotesList.innerHTML = ultimas.map(n => `
              <div class="v67-dash-note-item">
                <span class="v67-badge ${n.tag === 'Urgente' ? 'v67-badge-warning' : 'v67-badge-blue'}" style="font-size:10px;">${n.tag}</span>
                <span class="v67-dash-note-text ${n.done ? 'done' : ''}">${n.titulo || recortarDiezPalabras(n.texto)}</span>
                <button class="v67-btn v67-btn-secondary btn-dash-toggle" data-id="${n.id}" style="padding:2px 6px; font-size:11px;">
                  <i class="fa-solid ${n.done ? 'fa-rotate-left' : 'fa-check'}"></i>
                </button>
              </div>
            `).join('');
          }
        }

        notepadCompactList?.querySelectorAll('.v67-note-summary-card').forEach(card => {
          card.addEventListener('click', (e) => {
            if (e.target.closest('.btn-toggle-done') || e.target.closest('.btn-delete-note')) return;
            const id = card.getAttribute('data-note-id');
            const targetNote = notas.find(item => item.id === id);
            if (targetNote) loadNoteIntoEditor(targetNote);
          });
        });

        notepadCompactList?.querySelectorAll('.btn-toggle-done').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const card = btn.closest('.v67-note-summary-card');
            const id = card?.getAttribute('data-note-id');
            const note = notas.find(item => item.id === id);
            if (note) {
              note.done = !note.done;
              saveNotesToStorage();
              renderAllNotes();
            }
          });
        });

        notepadCompactList?.querySelectorAll('.btn-delete-note').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const card = btn.closest('.v67-note-summary-card');
            const id = card?.getAttribute('data-note-id');
            notas = notas.filter(item => item.id !== id);
            if (notepadCurrentId?.value === id) clearEditor();
            saveNotesToStorage();
            renderAllNotes();
            if (window.Notificacion) window.Notificacion('Nota eliminada', 'warning', 2000);
          });
        });

        dashNotesList?.querySelectorAll('.btn-dash-toggle').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const note = notas.find(item => item.id === id);
            if (note) {
              note.done = !note.done;
              saveNotesToStorage();
              renderAllNotes();
            }
          });
        });
      }

      function saveNotesToStorage() {
        localStorage.setItem(STORAGE_KEY_NOTES, JSON.stringify(notas));
      }

      function loadNoteIntoEditor(note) {
        if (!notepadTitle || !notepadContent) return;
        notepadCurrentId.value = note.id;
        notepadTitle.value = note.titulo || '';
        notepadContent.value = note.texto || '';
        setTagPill(note.tag || 'Urgente');
        if (noteEditorStatus) noteEditorStatus.textContent = `Editando nota de ${note.fecha}`;
        updateCounts();
        renderAllNotes();
      }

      function clearEditor() {
        if (!notepadTitle || !notepadContent) return;
        notepadCurrentId.value = '';
        notepadTitle.value = '';
        notepadContent.value = '';
        setTagPill('Urgente');
        if (noteEditorStatus) noteEditorStatus.textContent = 'Nueva nota en blanco';
        updateCounts();
        renderAllNotes();
      }

      btnClearNote?.addEventListener('click', clearEditor);
      btnNewNoteCanvas?.addEventListener('click', () => {
        clearEditor();
        notepadTitle?.focus();
      });

      btnSaveNotepadFull?.addEventListener('click', () => {
        const titulo = notepadTitle?.value?.trim();
        const texto = notepadContent?.value?.trim();
        if (!texto && !titulo) {
          if (window.Notificacion) window.Notificacion('Escribe al menos un título o texto en la nota', 'warning', 2500);
          return;
        }

        const now = new Date();
        const fechaStr = `${now.getDate()} ${now.toLocaleString('es-ES', { month: 'short' })}, ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
        const existingId = notepadCurrentId?.value;

        if (existingId) {
          const idx = notas.findIndex(n => n.id === existingId);
          if (idx >= 0) {
            notas[idx].titulo = titulo || 'Nota';
            notas[idx].texto = texto;
            notas[idx].tag = currentActiveTag;
            notas[idx].fecha = fechaStr;
          }
        } else {
          notas.unshift({
            id: 'n_' + Date.now(),
            tag: currentActiveTag,
            titulo: titulo || 'Nota',
            texto: texto,
            fecha: fechaStr,
            done: false
          });
        }

        saveNotesToStorage();
        renderAllNotes();
        if (window.Notificacion) {
          window.Notificacion('Nota guardada correctamente en el bloc', 'success', 2500);
        }
      });

      formDashQuickNote?.addEventListener('submit', (e) => {
        e.preventDefault();
        const tag = document.getElementById('dashQuickNoteTag')?.value || 'Urgente';
        const texto = document.getElementById('dashQuickNoteText')?.value?.trim();
        if (!texto) return;

        const now = new Date();
        const fechaStr = `${now.getDate()} ${now.toLocaleString('es-ES', { month: 'short' })}, ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;

        notas.unshift({
          id: 'n_' + Date.now(),
          tag,
          titulo: texto.length > 35 ? texto.substring(0, 35) + '...' : texto,
          texto,
          fecha: fechaStr,
          done: false
        });

        saveNotesToStorage();
        renderAllNotes();
        formDashQuickNote.reset();

        if (window.Notificacion) {
          window.Notificacion('Apunte rápido registrado en Notepad', 'success', 2500);
        }
      });

      renderAllNotes();
      if (notas.length > 0) loadNoteIntoEditor(notas[0]);

      // 6. Centro de Envíos de Correo
      const formSendEmail = document.getElementById('formSendEmail');
      const emailTemplateSelect = document.getElementById('emailTemplateSelect');
      const emailSubject = document.getElementById('emailSubject');
      const emailMessage = document.getElementById('emailMessage');

      const templatesMap = {
        comprobante: {
          asunto: 'Envío de Factura Electrónica F001-00094 · Solgas Surquillo',
          mensaje: 'Estimados clientes,\n\nAdjuntamos su comprobante de pago electrónico emitido ante SUNAT correspondiente a su pedido de balones de gas GLP Solgas despachado a su local.\n\nCualquier coordinación adicional pueden escribirnos a nuestro WhatsApp oficial: +51 940 200 400.\n\nAtentamente,\nAdministración · Solgas Surquillo (Jr. Dante 260)'
        },
        cotizacion: {
          asunto: 'Cotización Oficial de Balones Solgas 45kg y 10kg · Tarifa Planta Surquillo',
          mensaje: 'Estimados señores,\n\nUn gusto saludarles de parte de Distribuidora Gaswii Solgas Surquillo. Les enviamos la cotización solicitada con precios especiales por volumen:\n\n• Balón Solgas 45kg: S/ 220.00\n• Balón Solgas 10kg Premium: S/ 65.00\n• Despacho prioritario programado incluido.\n\nQuedamos a su disposición para coordinar el abastecimiento de su negocio.\n\nAtentamente,\nWilder Taype · Solgas Surquillo'
        },
        pedido: {
          asunto: 'Confirmación de Pedido en Camino · Solgas Surquillo',
          mensaje: '¡Hola! Tu pedido de gas Solgas ha salido de nuestra planta de Jr. Dante 260 y se encuentra en camino con nuestro repartidor motorizado.\n\nRecuerda que todas nuestras unidades cuentan con precinto de seguridad de fábrica y garantía de pesaje digital verificado.\n\n¡Gracias por tu confianza!\nSolgas Surquillo'
        },
        bienvenida: {
          asunto: 'Bienvenido como Cliente Preferencial · Solgas Surquillo',
          mensaje: 'Estimado cliente,\n\nLe damos la más cordial bienvenida a nuestra red de clientes preferenciales. Desde hoy cuenta con atención prioritaria para sus requerimientos de gas GLP doméstico o comercial.\n\nPuede comunicarse directamente a nuestra central (01) 241-5555 o al WhatsApp 940 200 400.\n\nAtentamente,\nEquipo Solgas Surquillo'
        }
      };

      emailTemplateSelect?.addEventListener('change', (e) => {
        const val = e.target.value;
        if (templatesMap[val]) {
          emailSubject.value = templatesMap[val].asunto;
          emailMessage.value = templatesMap[val].mensaje;
          if (window.Notificacion) window.Notificacion('Plantilla cargada en el formulario', 'info', 1800);
        }
      });

      formSendEmail?.addEventListener('submit', (e) => {
        e.preventDefault();
        const to = document.getElementById('emailTo')?.value;
        if (window.Notificacion) {
          window.Notificacion(`Correo enviado exitosamente a <strong>${to}</strong> con sus comprobantes adjuntos`, 'success', 3500);
        }
      });

      // 7. Acciones SUNAT
      document.getElementById('btnEmitirComprobante')?.addEventListener('click', () => {
        if (window.Notificacion) window.Notificacion('Apertura de formulario de emisión rápida SUNAT', 'info', 2000);
      });
      document.querySelectorAll('.btn-descargar-pdf').forEach(btn => {
        btn.addEventListener('click', () => {
          if (window.Notificacion) window.Notificacion('Descargando comprobante oficial en formato PDF...', 'success', 2500);
        });
      });

      // 8. Botón Guardar Mi Negocio
      document.getElementById('btnSaveBusiness')?.addEventListener('click', () => {
        if (window.Notificacion) window.Notificacion('Datos de Mi Negocio guardados con éxito', 'success', 3000);
      });

      // 9. Guardar Perfil y Clave
      document.getElementById('btnSaveProfile')?.addEventListener('click', () => {
        if (window.Notificacion) window.Notificacion('Información de perfil actualizada', 'success', 2500);
      });
      document.getElementById('btnUpdatePassword')?.addEventListener('click', () => {
        if (window.Notificacion) window.Notificacion('Contraseña de acceso renovada exitosamente', 'success', 2500);
      });

      // 10. Copiar URL de Medios y Preview
      document.querySelectorAll('.btn-copy-url').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const url = btn.getAttribute('data-url');
          if (url && navigator.clipboard) {
            navigator.clipboard.writeText(window.location.origin + url);
            if (window.Notificacion) window.Notificacion('Enlace directo copiado al portapapeles', 'success', 2500);
          }
        });
      });

      const modalPreview = document.getElementById('modalImgPreview');
      const previewImg = document.getElementById('modalPreviewImg');
      const previewTitle = document.getElementById('modalPreviewTitle');
      const previewUrl = document.getElementById('modalPreviewUrl');
      const btnClosePreview = document.getElementById('btnClosePreview');
      const btnModalCopy = document.getElementById('btnModalCopyUrl');

      document.querySelectorAll('.v67-media-item').forEach(card => {
        card.addEventListener('click', () => {
          const url = card.getAttribute('data-media-url');
          const name = card.getAttribute('data-media-name');
          if (previewImg && url) previewImg.src = url;
          if (previewTitle) previewTitle.textContent = name || 'Foto';
          if (previewUrl) previewUrl.textContent = window.location.origin + url;
          if (modalPreview) modalPreview.classList.add('active');
        });
      });

      btnClosePreview?.addEventListener('click', () => modalPreview?.classList.remove('active'));
      modalPreview?.addEventListener('click', (e) => {
        if (e.target === modalPreview) modalPreview.classList.remove('active');
      });

      btnModalCopy?.addEventListener('click', () => {
        if (previewUrl && navigator.clipboard) {
          navigator.clipboard.writeText(previewUrl.textContent);
          if (window.Notificacion) window.Notificacion('URL de Cloudflare R2 copiada', 'success', 2000);
          modalPreview?.classList.remove('active');
        }
      });

      // 11. Buscador Global
      const globalSearch = document.getElementById('v67GlobalSearch');
      globalSearch?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        if (!query) return;

        if (query.includes('pedid') || query.includes('repart')) switchPanel('orders');
        else if (query.includes('sunat') || query.includes('bolet') || query.includes('factur')) switchPanel('sunat');
        else if (query.includes('mail') || query.includes('correo') || query.includes('cotiz')) switchPanel('email');
        else if (query.includes('perfil') || query.includes('clave')) switchPanel('profile');
        else if (query.includes('nota') || query.includes('pad')) switchPanel('notepad');
        else if (query.includes('negocio')) switchPanel('business');
        else if (query.includes('prod') || query.includes('balon')) switchPanel('products');
        else if (query.includes('pers') || query.includes('staff')) switchPanel('staff');
        else if (query.includes('clie')) switchPanel('customers');
        else if (query.includes('foto') || query.includes('gal')) switchPanel('gallery');
        else if (query.includes('blog') || query.includes('entrad')) switchPanel('posts');
        else if (query.includes('pag')) switchPanel('pages');
        else if (query.includes('ajuste')) switchPanel('settings');
      });

    })();
  </script>

  <!-- Importador dinámico de Notificacion y wiConfirmar de widev.js -->
  <script type="module">
    import { Notificacion, wiConfirmar } from '../core/widev/widev.js';
    window.Notificacion = Notificacion;
    window.wiConfirmar = wiConfirmar;
  </script>
</body>
</html>
