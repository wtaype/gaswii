<!DOCTYPE html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Dashboard del Dueño · Solgas Surquillo (View 67)</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Anti-FOUC Inmediato -->
  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('gaswii-theme') || 'futuro';
      document.documentElement.dataset.theme = savedTheme;
      if (localStorage.getItem('gaswii_sidebar_collapsed') === 'true') {
        document.documentElement.classList.add('is-collapsed');
      }
    } catch (e) {}
  </script>

  <!-- Tipografías e Iconos -->
  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />

  <!-- Estilos WiTema V2.0 Inlined -->
  <style is:global set:html={witemaCss}></style>

  <!-- Estilos de View67 -->
  <style is:global>
    :root {
      --side-w: 240px;
      --side-collapsed-w: 72px;
      --topbar-h: 62px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: var(--fz_m);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    h1, h2, h3, h4, p { margin: 0; }
    button, input, select, textarea { font-family: inherit; font-size: inherit; }

    /* Topbar */
    .v67-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--topbar-h);
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      gap: 16px;
      backdrop-filter: blur(16px);
    }
    .v67-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }
    .v67-logo {
      height: 32px;
      width: auto;
      object-fit: contain;
    }
    .v67-brand-text {
      display: flex;
      flex-direction: column;
    }
    .v67-brand-title {
      font-size: var(--fz_m1);
      font-weight: 700;
      letter-spacing: -0.2px;
      color: var(--ink);
      line-height: 1.2;
    }
    .v67-brand-sub {
      font-size: var(--fz_s3);
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .v67-badge-online {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 8px var(--green);
    }

    .v67-top-actions {
      display: flex;
      align-items: center;
      gap: 12px;
      position: relative;
    }
    .v67-search-box {
      position: relative;
      width: 280px;
    }
    .v67-search-box input {
      width: 100%;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 7px 12px 7px 34px;
      color: var(--ink);
      font-size: var(--fz_s4);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .v67-search-box input:focus {
      border-color: var(--brand-orange);
      box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.15);
    }
    .v67-search-icon {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      font-size: var(--fz_s3);
      pointer-events: none;
    }

    .v67-btn-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: var(--raised);
      color: var(--ink);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, transform 0.15s;
    }
    .v67-btn-icon:hover {
      border-color: var(--brand-orange);
      color: var(--brand-orange);
      transform: translateY(-1px);
    }

    /* Badge del Usuario Limpio (Solo Nombre) */
    .v67-user-container { position: relative; }
    .v67-user-badge {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 4px 12px 4px 4px;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 20px;
      cursor: pointer;
      transition: border-color 0.15s, background 0.15s;
      user-select: none;
    }
    .v67-user-badge:hover, .v67-user-badge.open {
      border-color: var(--brand-orange);
      background: var(--surface);
    }
    .v67-user-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--brand-orange), #ff9900);
      color: #fff;
      font-weight: 700;
      font-size: var(--fz_s3);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .v67-user-name {
      font-size: var(--fz_s4);
      font-weight: 600;
      color: var(--ink);
    }
    .v67-user-chevron {
      font-size: 11px;
      color: var(--muted);
      transition: transform 0.2s;
    }
    .v67-user-badge.open .v67-user-chevron { transform: rotate(180deg); }

    /* Dropdown Flotante */
    .v67-dropdown-menu {
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      width: 230px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
      padding: 6px;
      display: none;
      flex-direction: column;
      z-index: 60;
      animation: v67DropFade 0.18s ease-out;
    }
    .v67-dropdown-menu.active { display: flex; }
    @keyframes v67DropFade {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .v67-dropdown-header {
      padding: 10px 12px 8px;
      border-bottom: 1px solid var(--line);
      margin-bottom: 4px;
    }
    .v67-dropdown-email {
      font-size: var(--fz_s3);
      color: var(--muted);
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .v67-dropdown-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      border-radius: 7px;
      color: var(--ink);
      text-decoration: none;
      font-size: var(--fz_m);
      font-weight: 500;
      border: none;
      background: none;
      cursor: pointer;
      text-align: left;
      width: 100%;
      transition: background 0.15s, color 0.15s;
    }
    .v67-dropdown-item:hover {
      background: var(--raised);
      color: var(--brand-orange);
    }
    .v67-dropdown-item i {
      width: 16px;
      text-align: center;
      font-size: 13px;
      color: var(--muted);
    }
    .v67-dropdown-item:hover i { color: var(--brand-orange); }
    .v67-dropdown-divider { height: 1px; background: var(--line); margin: 4px 0; }
    .v67-dropdown-item.danger { color: var(--red); }
    .v67-dropdown-item.danger i { color: var(--red); }
    .v67-dropdown-item.danger:hover { background: rgba(251, 124, 133, 0.12); }

    /* Sidebar */
    .v67-sidebar {
      position: fixed;
      top: var(--topbar-h);
      bottom: 0;
      left: 0;
      width: var(--side-w);
      background: var(--surface);
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      z-index: 40;
      transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      overflow-y: auto;
      overflow-x: hidden;
    }
    html.is-collapsed .v67-sidebar { width: var(--side-collapsed-w); }

    .v67-nav {
      padding: 14px 10px;
      display: flex;
      flex-direction: column;
      gap: 3px;
      flex: 1;
    }
    .v67-nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 7px 12px;
      border-radius: 8px;
      color: var(--muted);
      border: none;
      background: none;
      cursor: pointer;
      text-align: left;
      font-size: var(--fz_m);
      font-weight: 500;
      transition: background 0.15s, color 0.15s;
      white-space: nowrap;
      position: relative;
    }
    .v67-nav-item:hover {
      background: var(--raised);
      color: var(--ink);
    }
    .v67-nav-item.active {
      background: var(--raised);
      color: var(--brand-orange);
      font-weight: 600;
    }
    .v67-nav-item.active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 3px;
      border-radius: 0 3px 3px 0;
      background: var(--brand-orange);
    }
    .v67-nav-item i {
      font-size: 14px;
      width: 20px;
      text-align: center;
      flex-shrink: 0;
    }
    html.is-collapsed .v67-nav-item {
      justify-content: center;
      padding: 9px 0;
    }
    html.is-collapsed .v67-nav-item span { display: none; }

    .v67-sidebar-footer {
      padding: 10px;
      border-top: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .v67-btn-collapse {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 8px 12px;
      border-radius: 8px;
      background: none;
      border: 1px solid transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: var(--fz_s4);
      white-space: nowrap;
    }
    .v67-btn-collapse:hover {
      background: var(--raised);
      color: var(--ink);
      border-color: var(--line);
    }
    html.is-collapsed .v67-btn-collapse { justify-content: center; padding: 8px 0; }
    html.is-collapsed .v67-btn-collapse span { display: none; }

    /* Shell */
    .v67-main-shell {
      margin-left: var(--side-w);
      margin-top: var(--topbar-h);
      padding: 24px 28px 60px;
      min-height: calc(100vh - var(--topbar-h));
      transition: margin-left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    html.is-collapsed .v67-main-shell { margin-left: var(--side-collapsed-w); }

    /* Section Headers */
    .v67-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .v67-section-title-wrap { display: flex; flex-direction: column; gap: 2px; }
    .v67-section-title {
      font-size: var(--fz_m3);
      font-weight: 700;
      letter-spacing: -0.3px;
      color: var(--ink);
    }
    .v67-section-sub { font-size: var(--fz_s4); color: var(--muted); }

    /* Botones */
    .v67-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: var(--fz_s4);
      font-weight: 600;
      cursor: pointer;
      border: 1px solid transparent;
      transition: background 0.15s, transform 0.15s, border-color 0.15s;
      white-space: nowrap;
    }
    .v67-btn:hover { transform: translateY(-1px); }
    .v67-btn-primary {
      background: var(--brand-orange);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(255, 102, 0, 0.25);
    }
    .v67-btn-primary:hover { background: var(--brand-orange-hover); }
    .v67-btn-secondary {
      background: var(--raised);
      border-color: var(--line);
      color: var(--ink);
    }
    .v67-btn-secondary:hover {
      border-color: var(--brand-orange);
      color: var(--brand-orange);
    }
    .v67-btn-danger {
      background: rgba(251, 124, 133, 0.12);
      border-color: rgba(251, 124, 133, 0.3);
      color: var(--red);
    }

    /* Paneles */
    .v67-panel { display: none; animation: v67FadeIn 0.2s ease-out; }
    .v67-panel.active { display: block; }
    @keyframes v67FadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* KPI Cards */
    .v67-kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 22px;
    }
    .v67-kpi-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
    }
    .v67-kpi-info { display: flex; flex-direction: column; gap: 2px; }
    .v67-kpi-label { font-size: var(--fz_s3); color: var(--muted); font-weight: 500; text-transform: uppercase; }
    .v67-kpi-val { font-size: var(--fz_m3); font-weight: 700; color: var(--ink); }
    .v67-kpi-note { font-size: var(--fz_s2); color: var(--green); display: flex; align-items: center; gap: 4px; }
    .v67-kpi-icon-wrap {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: var(--raised);
      color: var(--brand-orange);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    .v67-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      overflow: hidden;
    }
    .v67-card-head {
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .v67-card-head h3 {
      font-size: var(--fz_m2);
      font-weight: 600;
      color: var(--ink);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .v67-card-body { padding: 18px; }

    /* Form Fields */
    .v67-field-group { display: flex; flex-direction: column; gap: 6px; }
    .v67-label { font-size: var(--fz_s3); font-weight: 600; color: var(--muted); text-transform: uppercase; }
    .v67-input, .v67-textarea, .v67-select {
      width: 100%;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 8px 12px;
      color: var(--ink);
      font-size: var(--fz_m);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .v67-input:focus, .v67-textarea:focus, .v67-select:focus {
      border-color: var(--brand-orange);
      box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.15);
    }
    .v67-textarea { resize: vertical; min-height: 85px; }

    /* Dashboard Split Grid */
    .v67-split-grid {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 20px;
      margin-bottom: 22px;
    }
    @media (max-width: 980px) {
      .v67-split-grid { grid-template-columns: 1fr; }
    }
    .v67-dash-note-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 8px 10px;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      font-size: var(--fz_m);
    }
    .v67-dash-note-text { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .v67-dash-note-text.done { text-decoration: line-through; color: var(--muted); }

    /* Notepad 70/30 */
    .v67-notepad-layout {
      display: grid;
      grid-template-columns: minmax(0, 2.2fr) minmax(290px, 1fr);
      gap: 20px;
      align-items: start;
    }
    @media (max-width: 1020px) {
      .v67-notepad-layout { grid-template-columns: 1fr; }
    }
    .v67-note-editor-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .v67-note-editor-toolbar {
      padding: 12px 18px;
      border-bottom: 1px solid var(--line);
      background: var(--surface);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .v67-tag-selector { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
    .v67-tag-pill {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: var(--fz_s3);
      font-weight: 600;
      border: 1px solid var(--line);
      background: var(--raised);
      color: var(--muted);
      cursor: pointer;
      transition: all 0.15s;
    }
    .v67-tag-pill:hover { border-color: var(--brand-orange); color: var(--ink); }
    .v67-tag-pill.active {
      background: var(--brand-orange);
      border-color: var(--brand-orange);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(255, 102, 0, 0.3);
    }
    .v67-note-canvas { padding: 20px; display: flex; flex-direction: column; gap: 14px; }
    .v67-note-title-input {
      font-size: var(--fz_m2);
      font-weight: 600;
      color: var(--ink);
      border: none;
      background: none;
      outline: none;
      padding: 4px 0;
      border-bottom: 1px solid transparent;
    }
    .v67-note-title-input:focus { border-bottom-color: var(--brand-orange); }
    .v67-note-body-textarea {
      width: 100%;
      min-height: 280px;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 16px;
      color: var(--ink);
      font-size: var(--fz_m);
      line-height: 1.6;
      resize: vertical;
      outline: none;
    }
    .v67-note-body-textarea:focus {
      border-color: var(--brand-orange);
      box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.15);
    }
    .v67-note-editor-footer {
      padding: 14px 20px;
      border-top: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .v67-note-stats { font-size: var(--fz_s3); color: var(--muted); display: flex; gap: 12px; }

    .v67-note-list-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      max-height: 600px;
      overflow: hidden;
    }
    .v67-note-list-head {
      padding: 14px 16px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .v67-note-items-scroll { padding: 12px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; }
    .v67-note-summary-card {
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      cursor: pointer;
      transition: all 0.15s;
    }
    .v67-note-summary-card:hover { border-color: var(--brand-orange); transform: translateY(-1px); }
    .v67-note-summary-card.active { border-color: var(--brand-orange); background: rgba(255, 102, 0, 0.06); }
    .v67-note-summary-top { display: flex; align-items: center; justify-content: space-between; }
    .v67-note-summary-tag { font-size: var(--fz_s2); font-weight: 700; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; }
    .v67-note-summary-date { font-size: var(--fz_s2); color: var(--muted); }
    .v67-note-summary-snippet {
      font-size: var(--fz_m);
      color: var(--ink);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .v67-note-summary-snippet.done { text-decoration: line-through; color: var(--muted); }
    .v67-note-summary-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 2px; }

    /* Tablas Compactas */
    .v67-table-wrap { overflow-x: auto; border-radius: 8px; border: 1px solid var(--line); }
    .v67-table { width: 100%; border-collapse: collapse; text-align: left; font-size: var(--fz_m); }
    .v67-table th {
      background: var(--raised);
      color: var(--muted);
      font-size: var(--fz_s3);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 10px 14px;
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
    }
    .v67-table td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
      vertical-align: middle;
      white-space: nowrap;
    }
    .v67-table tr:last-child td { border-bottom: none; }
    .v67-table tr:hover td { background: var(--raised); }

    /* Badges */
    .v67-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 8px;
      border-radius: 4px;
      font-size: var(--fz_s2);
      font-weight: 600;
      text-transform: uppercase;
    }
    .v67-badge-success { background: rgba(32, 195, 150, 0.15); color: var(--green); }
    .v67-badge-warning { background: rgba(255, 167, 38, 0.15); color: var(--warning); }
    .v67-badge-orange  { background: rgba(255, 102, 0, 0.15); color: var(--brand-orange); }
    .v67-badge-blue    { background: rgba(2, 132, 199, 0.15); color: var(--brand-blue); }

    /* Galería Media */
    .v67-media-strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; }
    .v67-media-item {
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      overflow: hidden;
      cursor: pointer;
      transition: all 0.15s;
    }
    .v67-media-item:hover { transform: translateY(-2px); border-color: var(--brand-orange); }
    .v67-media-thumb-wrap {
      height: 90px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.1);
      padding: 6px;
    }
    .v67-media-thumb { max-height: 100%; max-width: 100%; object-fit: contain; }
    .v67-media-meta { padding: 6px 8px; display: flex; flex-direction: column; }
    .v67-media-name { font-size: var(--fz_s3); font-weight: 600; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .v67-media-sub { font-size: var(--fz_s2); color: var(--muted); }

    /* Modal emergente */
    .v67-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .v67-modal.active { display: flex; }
    .v67-modal-content {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 14px;
      max-width: 540px;
      width: 100%;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    }
    .v67-modal-head {
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .v67-modal-body { padding: 18px; }
  </style>
</head>
<body>

  <!-- Topbar Unificada con Dropdown del Usuario -->
  <header class="v67-topbar">
    <div class="v67-brand">
      <img src="/imgwii/logo.webp" alt="Solgas Surquillo" class="v67-logo" />
      <div class="v67-brand-text">
        <span class="v67-brand-title">SOLGAS SURQUILLO</span>
        <span class="v67-brand-sub">
          <span class="v67-badge-online"></span>
          Sede Jr. Dante 260 · Centro de Operaciones
        </span>
      </div>
    </div>

    <!-- Buscador Global -->
    <div class="v67-search-box">
      <i class="fa-solid fa-magnifying-glass v67-search-icon"></i>
      <input type="text" id="v67GlobalSearch" placeholder="Buscar pedidos, facturas, clientes, notas…" />
    </div>

    <!-- Acciones Rápidas del Dueño -->
    <div class="v67-top-actions">
      <!-- Alternar Tema -->
      <button class="v67-btn-icon" id="btnThemeToggle" aria-label="Cambiar tema">
        <i class="fa-solid fa-circle-half-stroke"></i>
      </button>

      <!-- Ir al sitio público -->
      <a href="/" target="_blank" class="v67-btn-icon" aria-label="Sitio web público" title="Ver Tienda Pública">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
      </a>

      <!-- Contenedor del Usuario (Solo Nombre + Dropdown al hacer clic) -->
      <div class="v67-user-container">
        <div class="v67-user-badge" id="btnUserDropdownTrigger" aria-expanded="false" aria-haspopup="true">
          <div class="v67-user-avatar">WT</div>
          <span class="v67-user-name">Wilder Taype</span>
          <i class="fa-solid fa-chevron-down v67-user-chevron"></i>
        </div>

        <!-- Dropdown Flotante del Usuario -->
        <div class="v67-dropdown-menu" id="userDropdownMenu">
          <div class="v67-dropdown-header">
            <strong style="font-size:var(--fz_s4); color:var(--ink); display:block;">Wilder Taype</strong>
            <span class="v67-dropdown-email">wilder.taype@gaswii.com</span>
          </div>
          <a href="/" target="_blank" class="v67-dropdown-item">
            <i class="fa-solid fa-store"></i> Ver Tienda Pública
          </a>
          <button type="button" class="v67-dropdown-item" data-jump-to="profile">
            <i class="fa-solid fa-user-gear"></i> Mi Perfil
          </button>
          <button type="button" class="v67-dropdown-item" data-jump-to="business">
            <i class="fa-solid fa-building"></i> Ficha Mi Negocio
          </button>
          <button type="button" class="v67-dropdown-item" data-jump-to="settings">
            <i class="fa-solid fa-gear"></i> Ajustes de Sistema
          </button>
          <div class="v67-dropdown-divider"></div>
          <button type="button" class="v67-dropdown-item danger" id="btnLogoutSession">
            <i class="fa-solid fa-right-from-bracket"></i> Cerrar Sesión
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Sidebar con los Módulos Requeridos en Orden Exacto -->
  <aside class="v67-sidebar" id="sidebarMenu">
    <nav class="v67-nav" aria-label="Menú del dueño">
      {modulos.map((m, idx) => (
        <button 
          class={`v67-nav-item ${idx === 0 ? 'active' : ''}`} 
          data-panel-target={m.id}
        >
          <i class={m.icono}></i>
          <span>{m.nombre}</span>
        </button>
      ))}
    </nav>

    <!-- Pie con Botón Plegar Menú -->
    <div class="v67-sidebar-footer">
      <button class="v67-btn-collapse" id="btnCollapseSidebar">
        <i class="fa-solid fa-arrow-left-long" id="iconCollapse"></i>
        <span id="labelCollapse">Plegar menú</span>
      </button>
    </div>
  </aside>

  <!-- Shell de Trabajo -->
  <main class="v67-main-shell">

    <!-- 1. MÓDULO: DASHBOARD -->
    <section class="v67-panel active" id="panel-dashboard">
      <div class="v67-section-header">
        <div class="v67-section-title-wrap">
          <h1 class="v67-section-title">Dashboard del Dueño</h1>
          <p class="v67-section-sub">Resumen integral y control directo de la planta de Surquillo.</p>
        </div>
        <div class="v67-header-actions">
          <button class="v67-btn v67-btn-primary" data-jump-to="orders">
            <i class="fa-solid fa-truck-fast"></i> Ver Pedidos del Día
          </button>
        </div>
      </div>

      <!-- 4 KPIs Ejecutivos Compactos -->
      <div class="v67-kpi-grid">
        <div class="v67-kpi-card">
          <div class="v67-kpi-info">
            <span class="v67-kpi-label">Pedidos de Hoy</span>
            <span class="v67-kpi-val">4 Despachos</span>
            <span class="v67-kpi-note"><i class="fa-solid fa-truck-fast"></i> 2 entregados · 1 en camino</span>
          </div>
          <div class="v67-kpi-icon-wrap"><i class="fa-solid fa-truck"></i></div>
        </div>

        <div class="v67-kpi-card">
          <div class="v67-kpi-info">
            <span class="v67-kpi-label">Facturación SUNAT</span>
            <span class="v67-kpi-val">S/ 1,275.00</span>
            <span class="v67-kpi-note"><i class="fa-solid fa-check"></i> 100% CDR Aceptado</span>
          </div>
          <div class="v67-kpi-icon-wrap"><i class="fa-solid fa-file-invoice-dollar"></i></div>
        </div>

        <div class="v67-kpi-card">
          <div class="v67-kpi-info">
            <span class="v67-kpi-label">Apuntes Notepad</span>
            <span class="v67-kpi-val" id="dashNotesCount">3 Notas</span>
            <span class="v67-kpi-note"><i class="fa-solid fa-pen-nib"></i> Bloc activo</span>
          </div>
          <div class="v67-kpi-icon-wrap"><i class="fa-solid fa-note-sticky"></i></div>
        </div>

        <div class="v67-kpi-card">
          <div class="v67-kpi-info">
            <span class="v67-kpi-label">Balones en Planta</span>
            <span class="v67-kpi-val">45 de 10kg</span>
            <span class="v67-kpi-note"><i class="fa-solid fa-layer-group"></i> 12 de 45kg</span>
          </div>
          <div class="v67-kpi-icon-wrap"><i class="fa-solid fa-fire"></i></div>
        </div>
      </div>

      <!-- Grilla Dividida: Notepad Rápido + Mi Negocio al Día -->
      <div class="v67-split-grid">
        <div class="v67-card">
          <div class="v67-card-head">
            <h3><i class="fa-solid fa-note-sticky" style="color:var(--brand-orange)"></i> Notepad Rápido</h3>
            <button class="v67-btn v67-btn-secondary" data-jump-to="notepad" style="padding:4px 10px; font-size:var(--fz_s3);">
              Ir al Notepad <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>
          <div class="v67-card-body">
            <form id="formDashQuickNote" style="display:flex; flex-direction:column; gap:10px; margin-bottom:14px;">
              <div style="display:flex; gap:10px;">
                <select id="dashQuickNoteTag" class="v67-select" style="max-width:140px;">
                  <option value="Urgente">⚡ Urgente</option>
                  <option value="Planta">🏢 Planta</option>
                  <option value="Pedidos">🛵 Pedidos</option>
                  <option value="Idea">💡 Idea</option>
                </select>
                <input type="text" id="dashQuickNoteText" class="v67-input" placeholder="Anotar pendiente rápido de hoy..." required style="flex:1;" />
                <button type="submit" class="v67-btn v67-btn-primary">
                  <i class="fa-solid fa-plus"></i> Anotar
                </button>
              </div>
            </form>
            <div style="display:flex; flex-direction:column; gap:8px;" id="dashNotesList"></div>
          </div>
        </div>

        <div class="v67-card">
          <div class="v67-card-head">
            <h3><i class="fa-solid fa-store" style="color:var(--brand-blue)"></i> Mi Negocio al Día</h3>
            <button class="v67-btn v67-btn-secondary" data-jump-to="business" style="padding:4px 10px; font-size:var(--fz_s3);">
              Editar Ficha
            </button>
          </div>
          <div class="v67-card-body">
            <div style="display:flex; flex-direction:column; gap:12px;">
              <div style="display:flex; align-items:center; gap:12px;">
                <img src="/imgwii/logo.webp" alt="Logo" style="height:38px; border-radius:6px; background:var(--raised); padding:4px;" />
                <div>
                  <strong style="font-size:var(--fz_m1); color:var(--ink); display:block;">Solgas Surquillo</strong>
                  <span style="font-size:var(--fz_s3); color:var(--muted);">RUC: 20608945123 · Sede Oficial</span>
                </div>
              </div>
              <div style="background:var(--raised); padding:10px 12px; border-radius:8px; border:1px solid var(--line); font-size:var(--fz_s4); display:flex; flex-direction:column; gap:6px;">
                <div><i class="fa-solid fa-location-dot" style="color:var(--brand-orange); width:18px;"></i> Jr. Dante 260, Surquillo, Lima</div>
                <div><i class="fa-solid fa-phone" style="color:var(--green); width:18px;"></i> (01) 241-5555 · 940 200 400</div>
                <div><i class="fa-solid fa-clock" style="color:var(--brand-blue); width:18px;"></i> Lunes a Sábado: 6:00 am - 10:00 pm</div>
                <div><i class="fa-solid fa-map" style="color:var(--warning); width:18px;"></i> Surquillo, Miraflores, San Isidro, San Borja, Surco</div>
              </div>
              <div style="display:flex; gap:8px;">
                <button class="v67-btn v67-btn-secondary" data-jump-to="sunat" style="flex:1; justify-content:center;">
                  <i class="fa-solid fa-file-invoice"></i> Emitir Boleta
                </button>
                <button class="v67-btn v67-btn-secondary" data-jump-to="email" style="flex:1; justify-content:center;">
                  <i class="fa-solid fa-envelope"></i> Centro de Correo
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tira de Galería Reciente -->
      <div class="v67-card">
        <div class="v67-card-head">
          <h3><i class="fa-solid fa-images" style="color:var(--green)"></i> Fotos Recientes en Cloudflare R2</h3>
          <button class="v67-btn v67-btn-secondary" data-jump-to="gallery" style="padding:4px 10px; font-size:var(--fz_s3);">
            Ver Toda la Galería
          </button>
        </div>
        <div class="v67-card-body">
          <div class="v67-media-strip">
            {fotosGaleriaDemo.slice(0, 5).map(f => (
              <div class="v67-media-item" data-media-url={f.url} data-media-name={f.nombre}>
                <div class="v67-media-thumb-wrap">
                  <img src={f.url} alt={f.nombre} class="v67-media-thumb" />
                </div>
                <div class="v67-media-meta">
                  <span class="v67-media-name">{f.nombre}</span>
                  <span class="v67-media-sub">{f.peso} · {f.dim}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. MÓDULO: NOTEPAD -->
    <section class="v67-panel" id="panel-notepad">
      <div class="v67-section-header">
        <div class="v67-section-title-wrap">
          <h1 class="v67-section-title">Notepad del Dueño</h1>
          <p class="v67-section-sub">Espacio amplio para anotaciones diarias, compras a planta y recordatorios.</p>
        </div>
        <div class="v67-header-actions">
          <button class="v67-btn v67-btn-secondary" id="btnNewNoteCanvas">
            <i class="fa-solid fa-file-circle-plus"></i> Nueva Nota en Blanco
          </button>
        </div>
      </div>

      <div class="v67-notepad-layout">
        <!-- 70% Editor -->
        <div class="v67-note-editor-card">
          <div class="v67-note-editor-toolbar">
            <div class="v67-tag-selector" id="tagPillGroup">
              <span class="v67-tag-pill active" data-tag="Urgente">⚡ Urgente</span>
              <span class="v67-tag-pill" data-tag="Planta">🏢 Planta Solgas</span>
              <span class="v67-tag-pill" data-tag="Pedidos">🛵 Pedido Especial</span>
              <span class="v67-tag-pill" data-tag="Idea">💡 Idea / Proyecto</span>
              <span class="v67-tag-pill" data-tag="Cliente">📞 Cliente</span>
            </div>
            <span id="noteEditorStatus" style="font-size:var(--fz_s3); color:var(--muted);">Editando nota</span>
          </div>

