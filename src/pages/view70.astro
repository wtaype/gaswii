---
// src/pages/view70.astro
// DEMO 2: Portal de Cliente con Sidebar - Enfoque Hub Multi-Direcciones & Despacho por Sede
import { avatar } from '../core/widev/nombre.js';
import witemaCss from '../core/wicss/witema.css?inline';

const cliente = {
  nombre: 'Valeria',
  nombreCompleto: 'Valeria Mendoza',
  telefono: '987 654 321',
  direcciones: [
    {
      id: 'dir-1',
      alias: 'Casa Principal Dante',
      tipo: 'Hogar',
      icono: 'fa-house',
      calle: 'Jr. Dante 260, Dpto 301',
      distrito: 'Surquillo',
      referencia: 'Frente al parque, portón marrón',
      etaMin: 12,
      etaMax: 15,
      balonFavorito: 'Balón SOLGAS 10 kg (Click-On)',
      esPrincipal: true,
      ultimaEntrega: 'Hace 24 días'
    },
    {
      id: 'dir-2',
      alias: 'Estudio de Diseño',
      tipo: 'Oficina',
      icono: 'fa-briefcase',
      calle: 'Av. República de Panamá 3565, Piso 4',
      distrito: 'San Isidro',
      referencia: 'Edificio Platino, frente a BBVA',
      etaMin: 18,
      etaMax: 25,
      balonFavorito: 'Balón SOLGAS 10 kg (Rosca)',
      esPrincipal: false,
      ultimaEntrega: 'Hace 45 días'
    },
    {
      id: 'dir-3',
      alias: 'Cafetería & Pastelería',
      tipo: 'Negocio',
      icono: 'fa-shop',
      calle: 'Av. Angamos Este 1540',
      distrito: 'Surquillo',
      referencia: 'Mercado Surquillo N° 1',
      etaMin: 10,
      etaMax: 14,
      balonFavorito: 'Balón SOLGAS 45 kg (Industrial)',
      esPrincipal: false,
      ultimaEntrega: 'Hace 10 días'
    }
  ]
};
---

<!doctype html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Hub de Direcciones & Despacho · Cliente VIP | View 70</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('gaswii_theme_cliente') || localStorage.getItem('wiTema') || 'futuro';
      document.documentElement.dataset.theme = savedTheme;
      if (localStorage.getItem('gaswii_cliente_sidebar_v70') === 'true') {
        document.documentElement.classList.add('is-collapsed');
      }
    } catch (e) {}
  </script>

  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />
  <style is:global set:html={witemaCss}></style>

  <style>
    :root {
      --side-w: 240px;
      --side-collapsed-w: 68px;
      --topbar-h: 62px;
      --cl-orange: #ff6600;
      --cl-orange-hover: #ff771a;
      --cl-wa: #25d366;
    }

    *, *::before, *::after { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: var(--fz_m);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* TOPBAR */
    .v70-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--topbar-h);
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      backdrop-filter: blur(14px);
    }

    .v70-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }

    .v70-logo { height: 32px; width: auto; }

    .v70-brand-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1rem;
      font-weight: 800;
      color: var(--ink);
    }
    .v70-brand-title span { color: var(--cl-orange); }

    .v70-topbar-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .v70-btn-icon {
      background: var(--surface2, rgba(255,255,255,0.06));
      border: 1px solid var(--line);
      color: var(--ink);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      cursor: pointer;
      transition: all 0.2s;
    }
    .v70-btn-icon:hover { border-color: var(--cl-orange); color: var(--cl-orange); }

    .v70-user-chip {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 12px 4px 6px;
      background: var(--surface2, rgba(255,255,255,0.04));
      border: 1px solid var(--line);
      border-radius: 30px;
    }

    .v70-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--cl-orange);
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 0.85rem;
    }

    /* SIDEBAR */
    .v70-sidebar {
      position: fixed;
      top: var(--topbar-h);
      left: 0;
      bottom: 0;
      width: var(--side-w);
      background: var(--surface);
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 16px 12px;
      z-index: 40;
      transition: width 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .v70-sidebar { width: var(--side-collapsed-w); }

    .v70-nav { display: flex; flex-direction: column; gap: 6px; }

    .v70-nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      border-radius: 10px;
      border: none;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.88rem;
      text-align: left;
      transition: all 0.18s;
      width: 100%;
    }

    .v70-nav-item i { font-size: 1.1rem; width: 22px; text-align: center; flex-shrink: 0; }

    .v70-nav-item:hover {
      background: var(--surface2, rgba(255,255,255,0.05));
      color: var(--ink);
    }

    .v70-nav-item.active {
      background: rgba(255, 102, 0, 0.12);
      color: var(--cl-orange);
      border: 1px solid rgba(255, 102, 0, 0.25);
    }

    .v70-badge-num {
      margin-left: auto;
      background: var(--cl-orange);
      color: #fff;
      font-size: 0.72rem;
      padding: 2px 7px;
      border-radius: 12px;
      font-weight: 700;
      font-family: var(--ff_O, sans-serif);
    }

    html.is-collapsed .v70-nav-text,
    html.is-collapsed .v70-badge-num,
    html.is-collapsed #lblCollapse70 { display: none; }

    .v70-sidebar-foot { border-top: 1px solid var(--line); padding-top: 12px; }

    .v70-btn-collapse {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 9px 12px;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--muted);
      cursor: pointer;
      font-size: 0.82rem;
      font-weight: 600;
    }

    /* MAIN */
    .v70-main {
      margin-top: var(--topbar-h);
      margin-left: var(--side-w);
      padding: 24px 28px;
      min-height: calc(100vh - var(--topbar-h));
      transition: margin-left 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .v70-main { margin-left: var(--side-collapsed-w); }

    .v70-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    .v70-header-row h1 {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--ink);
    }

    .v70-btn-add {
      background: var(--cl-orange);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 10px 18px;
      font-family: var(--ff_O, sans-serif);
      font-weight: 700;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .v70-btn-add:hover { background: var(--cl-orange-hover); transform: translateY(-1px); }

    /* GRID DIRECCIONES */
    .v70-addresses-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .v70-addr-card {
      background: var(--surface);
      border: 1.5px solid var(--line);
      border-radius: 18px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      transition: all 0.2s;
    }

    .v70-addr-card:hover {
      border-color: rgba(255, 102, 0, 0.4);
      box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    }

    .v70-addr-card.is-main {
      border-color: var(--cl-orange);
      background: linear-gradient(180deg, rgba(255, 102, 0, 0.05) 0%, transparent 100%), var(--surface);
    }

    .v70-tag-principal {
      position: absolute;
      top: 16px;
      right: 16px;
      background: rgba(255, 102, 0, 0.15);
      color: var(--cl-orange);
      border: 1px solid rgba(255, 102, 0, 0.3);
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 0.7rem;
      font-weight: 700;
      font-family: var(--ff_O, sans-serif);
    }

    .v70-addr-head {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
    }

    .v70-addr-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--surface2, rgba(255,255,255,0.06));
      border: 1px solid var(--line);
      display: grid;
      place-items: center;
      font-size: 1.2rem;
      color: var(--cl-orange);
    }

    .v70-addr-title {
      font-family: var(--ff_O, sans-serif);
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--ink);
    }

    .v70-addr-tipo { font-size: 0.72rem; color: var(--muted); }

    .v70-addr-details {
      margin-bottom: 16px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .v70-addr-street {
      font-size: 0.92rem;
      font-weight: 600;
      color: var(--ink);
    }

    .v70-addr-ref {
      font-size: 0.8rem;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .v70-eta-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(16, 185, 129, 0.1);
      color: #10b981;
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 0.78rem;
      font-weight: 700;
      width: fit-content;
      margin-top: 6px;
    }

    .v70-addr-foot {
      border-top: 1px solid var(--line);
      padding-top: 14px;
      display: flex;
      gap: 10px;
    }

    .v70-btn-dispatch {
      flex: 1;
      background: #25d366;
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 10px;
      font-family: var(--ff_O, sans-serif);
      font-weight: 800;
      font-size: 0.88rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
    }
    .v70-btn-dispatch:hover { background: #1ebd5b; }

    .v70-btn-default {
      background: transparent;
      border: 1px solid var(--line);
      color: var(--ink);
      border-radius: 10px;
      padding: 10px 14px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
    }
    .v70-btn-default:hover { border-color: var(--cl-orange); color: var(--cl-orange); }

    /* FORM DRAWER PARA AGREGAR DIRECCIÓN */
    .v70-drawer-form {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 24px;
      margin-bottom: 24px;
      display: none;
    }
    .v70-drawer-form.open { display: block; animation: v70FadeIn 0.2s ease-out; }

    @keyframes v70FadeIn {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .v70-form-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin-top: 16px;
    }

    @media (max-width: 640px) {
      .v70-form-grid { grid-template-columns: 1fr; }
    }

    .v70-field label {
      display: block;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .v70-field input, .v70-field select {
      width: 100%;
      padding: 10px 12px;
      background: var(--surface2, rgba(255,255,255,0.04));
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--ink);
      font-size: 0.88rem;
      outline: none;
    }
    .v70-field input:focus, .v70-field select:focus { border-color: var(--cl-orange); }

    .v70-form-actions {
      display: flex;
      justify-content: flex-end;
      gap: 12px;
      margin-top: 20px;
    }

    #v70Toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--ink);
      color: var(--bg);
      padding: 10px 18px;
      border-radius: 10px;
      font-weight: 600;
      display: none;
      z-index: 100;
    }
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <header class="v70-topbar">
    <a href="/view70" class="v70-brand">
      <img src="/imgwii/logo.webp" alt="Solgas" class="v70-logo" />
      <div class="v70-brand-title">SOLGAS <span>SURQUILLO</span> · Hub Clientes</div>
    </a>

    <div class="v70-topbar-right">
      <button class="v70-btn-icon" id="btnTheme70" title="Tema luz/futuro">
        <i class="fa-solid fa-moon"></i>
      </button>

      <div class="v70-user-chip">
        <div class="v70-avatar">{avatar(cliente.nombre)}</div>
        <span style="font-size:0.85rem; font-weight:700;">{cliente.nombreCompleto}</span>
      </div>
    </div>
  </header>

  <!-- SIDEBAR -->
  <aside class="v70-sidebar">
    <nav class="v70-nav">
      <button class="v70-nav-item" onclick="window.location.href='/view69'">
        <i class="fa-solid fa-bolt"></i>
        <span class="v70-nav-text">Pedido 1-Clic</span>
      </button>
      <button class="v70-nav-item active">
        <i class="fa-solid fa-map-location-dot"></i>
        <span class="v70-nav-text">Libreta de Sedes</span>
        <span class="v70-badge-num" id="sidebarCount">{cliente.direcciones.length}</span>
      </button>
      <button class="v70-nav-item">
        <i class="fa-solid fa-file-invoice"></i>
        <span class="v70-nav-text">Facturación RUC</span>
      </button>
      <button class="v70-nav-item">
        <i class="fa-solid fa-box-archive"></i>
        <span class="v70-nav-text">Historial de Balones</span>
      </button>
    </nav>

    <div class="v70-sidebar-foot">
      <button class="v70-btn-collapse" id="btnCollapse70">
        <i class="fa-solid fa-arrow-left-long"></i>
        <span id="lblCollapse70">Colapsar</span>
      </button>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="v70-main">
    <div class="v70-header-row">
      <div>
        <h1>Mis Puntos de Despacho ({cliente.direcciones.length})</h1>
        <p style="color:var(--muted); font-size:0.88rem; margin:0;">
          Gestiona tus domicilios y negocios. Las entregas salen de la Sede Jr. Dante 260 con pesaje certificado.
        </p>
      </div>

      <button type="button" class="v70-btn-add" id="btnOpenNewDir">
        <i class="fa-solid fa-plus"></i>
        <span>Nueva Dirección</span>
      </button>
    </div>

    <!-- FORMULARIO DRAWER PARA NUEVA DIRECCIÓN -->
    <div class="v70-drawer-form" id="drawerNewDir">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <h3 style="margin:0; font-size:1.1rem; color:var(--cl-orange); font-family:var(--ff_O, sans-serif);">
          <i class="fa-solid fa-location-dot"></i> Registrar Nueva Sede
        </h3>
        <button type="button" class="v70-btn-icon" id="btnCloseDrawer" style="width:30px; height:30px;">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="v70-form-grid">
        <div class="v70-field">
          <label>Alias (Ej. Casa Playa / Almacén)</label>
          <input type="text" id="newAlias" placeholder="Nombre para identificar la sede" />
        </div>
        <div class="v70-field">
          <label>Distrito</label>
          <select id="newDistrito">
            <option value="Surquillo">Surquillo (10–15 min)</option>
            <option value="Miraflores">Miraflores (15–20 min)</option>
            <option value="San Isidro">San Isidro (18–25 min)</option>
            <option value="San Borja">San Borja (15–22 min)</option>
          </select>
        </div>
        <div class="v70-field">
          <label>Calle, Jr, Av y Número / Dpto</label>
          <input type="text" id="newCalle" placeholder="Ej: Jr. Dante 260, Dpto 402" />
        </div>
        <div class="v70-field">
          <label>Referencia de Entrega</label>
          <input type="text" id="newRef" placeholder="Ej: Frente al parque, portón verde" />
        </div>
      </div>

      <div class="v70-form-actions">
        <button type="button" class="v70-btn-default" id="btnCancelDir">Cancelar</button>
        <button type="button" class="v70-btn-add" id="btnSaveDir">Guardar y Habilitar Despacho</button>
      </div>
    </div>

    <!-- TARJETAS DE DIRECCIONES -->
    <div class="v70-addresses-grid" id="gridAddresses">
      {cliente.direcciones.map(d => (
        <div class={`v70-addr-card ${d.esPrincipal ? 'is-main' : ''}`} data-id={d.id}>
          {d.esPrincipal && <span class="v70-tag-principal"><i class="fa-solid fa-star"></i> Principal</span>}

          <div>
            <div class="v70-addr-head">
              <div class="v70-addr-icon">
                <i class={`fa-solid ${d.icono}`}></i>
              </div>
              <div>
                <div class="v70-addr-title">{d.alias}</div>
                <div class="v70-addr-tipo">{d.tipo} · {d.distrito}</div>
              </div>
            </div>

            <div class="v70-addr-details">
              <div class="v70-addr-street">{d.calle}</div>
              <div class="v70-addr-ref">
                <i class="fa-solid fa-compass" style="color:var(--cl-orange);"></i>
                <span>{d.referencia}</span>
              </div>
              <div class="v70-eta-badge">
                <i class="fa-solid fa-motorcycle"></i>
                <span>Llegada en {d.etaMin}–{d.etaMax} min</span>
              </div>
              <div style="font-size:0.75rem; color:var(--muted); margin-top:4px;">
                Balón habitual: <strong>{d.balonFavorito}</strong>
              </div>
            </div>
          </div>

          <div class="v70-addr-foot">
            <a 
              href={`https://wa.me/51936369384?text=${encodeURIComponent(`Hola Solgas Surquillo, deseo pedir mi recarga a ${d.alias} (${d.calle}, ${d.distrito}). Ref: ${d.referencia}`)}`}
              target="_blank" 
              rel="noopener noreferrer" 
              class="v70-btn-dispatch"
            >
              <i class="fa-brands fa-whatsapp"></i>
              <span>Pedir Aquí</span>
            </a>

            {!d.esPrincipal && (
              <button type="button" class="v70-btn-default btn-set-main" data-id={d.id}>
                Predeterminar
              </button>
            )}
          </div>
        </div>
      ))}
    </div>
  </main>

  <div id="v70Toast">Dirección actualizada</div>

  <script is:inline>
    (function() {
      const toast = document.getElementById('v70Toast');
      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.style.display = 'block';
        setTimeout(() => { toast.style.display = 'none'; }, 1800);
      }

      // TOGGLE FORM DRAWER
      const drawer = document.getElementById('drawerNewDir');
      document.getElementById('btnOpenNewDir')?.addEventListener('click', () => {
        drawer?.classList.add('open');
      });
      document.getElementById('btnCloseDrawer')?.addEventListener('click', () => {
        drawer?.classList.remove('open');
      });
      document.getElementById('btnCancelDir')?.addEventListener('click', () => {
        drawer?.classList.remove('open');
      });

      // GUARDAR NUEVA SEDE
      document.getElementById('btnSaveDir')?.addEventListener('click', () => {
        const alias = document.getElementById('newAlias').value.trim();
        const calle = document.getElementById('newCalle').value.trim();
        const dist = document.getElementById('newDistrito').value;
        const ref = document.getElementById('newRef').value.trim();

        if (!alias || !calle) {
          alert('Por favor ingresa un alias y la calle.');
          return;
        }

        const grid = document.getElementById('gridAddresses');
        const card = document.createElement('div');
        card.className = 'v70-addr-card';
        card.innerHTML = `
          <div>
            <div class="v70-addr-head">
              <div class="v70-addr-icon"><i class="fa-solid fa-map-pin"></i></div>
              <div>
                <div class="v70-addr-title">${alias}</div>
                <div class="v70-addr-tipo">Personal · ${dist}</div>
              </div>
            </div>
            <div class="v70-addr-details">
              <div class="v70-addr-street">${calle}</div>
              <div class="v70-addr-ref"><i class="fa-solid fa-compass" style="color:#ff6600;"></i><span>${ref}</span></div>
              <div class="v70-eta-badge"><i class="fa-solid fa-motorcycle"></i><span>Llegada en 15–20 min</span></div>
            </div>
          </div>
          <div class="v70-addr-foot">
            <a href="https://wa.me/51936369384?text=${encodeURIComponent(`Hola Solgas Surquillo, deseo pedir a ${alias} (${calle}, ${dist})`)}" target="_blank" class="v70-btn-dispatch">
              <i class="fa-brands fa-whatsapp"></i> Pedir Aquí
            </a>
          </div>
        `;
        grid.appendChild(card);
        drawer?.classList.remove('open');
        showToast(`Sede "${alias}" agregada a la libreta`);
      });

      // SIDEBAR COLLAPSE
      document.getElementById('btnCollapse70')?.addEventListener('click', () => {
        const isCollapsed = document.documentElement.classList.toggle('is-collapsed');
        localStorage.setItem('gaswii_cliente_sidebar_v70', isCollapsed ? 'true' : 'false');
      });

      // THEME TOGGLE
      document.getElementById('btnTheme70')?.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme;
        const next = cur === 'luz' ? 'futuro' : 'luz';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('gaswii_theme_cliente', next);
      });
    })();
  </script>
</body>
</html>
