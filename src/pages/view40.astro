    <!-- Script de Estado y Reactividad -->
    <script is:inline>
      (function() {
        const state = {
          nombre: 'Valeria',
          telefono: '987 654 321',
          email: 'valeria.mendoza@gmail.com',
          dni: '74829103',
          productoId: 'solgas-10kg',
          productoNombre: 'Balón SOLGAS 10 kg',
          productoCorto: 'Solgas 10 kg',
          precio: '65.00',
          metodoPago: 'efectivo',
          vueltoModo: '100', // 'exacto' | '20' | '50' | '100' | 'custom'
          montoPagoEfectivo: 100,
          notas: 'Piso 3, timbre no suena fuerte. Dejar con vigilancia si no contesto.',
          tipoComprobante: 'boleta',
          ruc: '',
          calle: 'Jr. Dante 260, Dpto 301',
          distrito: 'Surquillo',
          referencia: 'Frente al parque, portón marrón',
          eta: '12–15 min',
          aliasActual: 'Casa Principal',
          direcciones: [
            { id: 'dir-1', alias: 'Casa Principal', calle: 'Jr. Dante 260, Dpto 301', distrito: 'Surquillo', referencia: 'Frente al parque, portón marrón', eta: '12–15 min', esPrincipal: true },
            { id: 'dir-2', alias: 'Oficina / Estudio', calle: 'Av. República de Panamá 3565', distrito: 'San Isidro', referencia: 'Edificio Platino, Piso 4', eta: '18–25 min', esPrincipal: false }
          ]
        };

        const showToast = (text) => {
          const toast = document.getElementById('toast-box');
          const msg = document.getElementById('toast-msg');
          if (msg) msg.textContent = text;
          if (toast) {
            toast.style.display = 'flex';
            setTimeout(() => { toast.style.display = 'none'; }, 2400);
          }
        };

        const getPaymentDescription = () => {
          if (state.metodoPago === 'yape-plin') return 'Yape / Plin (Al recibir en puerta)';
          if (state.vueltoModo === 'exacto') return 'Efectivo (Monto exacto)';
          const montoNum = parseFloat(state.montoPagoEfectivo) || 0;
          return `Efectivo (Llevar vuelto de S/ ${montoNum.toFixed(2)})`;
        };

        const updateVueltoCalculation = () => {
          const feedback = document.getElementById('vuelto-calc-feedback');
          if (!feedback) return;
          if (state.vueltoModo === 'exacto') {
            feedback.textContent = 'Pago exacto (sin vuelto)';
            feedback.style.color = '#10b981';
            return;
          }
          const precioNum = parseFloat(state.precio) || 0;
          const pagoNum = parseFloat(state.montoPagoEfectivo) || 0;
          if (pagoNum < precioNum) {
            feedback.textContent = `Monto menor al total (S/ ${precioNum.toFixed(2)})`;
            feedback.style.color = '#ef4444';
          } else {
            const vuelto = pagoNum - precioNum;
            feedback.textContent = `Vuelto estimado: S/ ${vuelto.toFixed(2)}`;
            feedback.style.color = '#10b981';
          }
        };

        const updateWhatsAppOutput = () => {
          const pagoTexto = getPaymentDescription();
          const notasTexto = state.notas ? `\n📝 Nota: ${state.notas}` : '';
          const compTexto = state.tipoComprobante === 'factura' && state.ruc ? `\n🧾 Factura RUC: ${state.ruc}` : '';

          const text = `¡Hola Solgas Surquillo! Deseo pedir mi recarga con mis datos guardados:

👤 Nombre: ${state.nombre}
📦 Producto: ${state.productoNombre} (S/ ${state.precio})
📍 Entrega: ${state.calle}, ${state.distrito}
🧭 Ref: ${state.referencia}
💳 Pago: ${pagoTexto}${compTexto}${notasTexto}
⏱️ Llegada estimada: ${state.eta}`;

          const bubble = document.getElementById('wa-outgoing-bubble');
          if (bubble) {
            bubble.childNodes[0].nodeValue = text + '\n';
          }

          // Resumen Desktop
          const bannerName = document.getElementById('banner-prod-name');
          if (bannerName) bannerName.textContent = state.productoCorto;

          const bannerAddr = document.getElementById('banner-addr-text');
          if (bannerAddr) bannerAddr.textContent = `${state.distrito} · ${state.eta}`;

          const bannerPrice = document.getElementById('banner-price');
          if (bannerPrice) bannerPrice.textContent = `S/ ${state.precio}`;

          const btnDesktop = document.getElementById('btn-wa-text-desktop');
          if (btnDesktop) btnDesktop.textContent = `Pedir por WhatsApp (S/ ${state.precio})`;

          // Destino Elegido
          const destAlias = document.getElementById('dest-alias-text');
          if (destAlias) destAlias.textContent = state.aliasActual || 'Casa Principal';

          const destFull = document.getElementById('dest-full-text');
          if (destFull) destFull.textContent = `${state.calle}, ${state.distrito} · ${state.referencia}`;

          const destEta = document.getElementById('dest-eta-text');
          if (destEta) destEta.textContent = state.eta;

          // Botón Móvil
          const mobileTotal = document.getElementById('btn-wa-mobile-total');
          if (mobileTotal) mobileTotal.textContent = `S/ ${state.precio} ➔`;

          // URLs WhatsApp
          const waUrl = `https://wa.me/51936369384?text=${encodeURIComponent(text)}`;
          const linkDesktop = document.getElementById('btn-wa-desktop');
          if (linkDesktop) linkDesktop.href = waUrl;

          const linkMobile = document.getElementById('btn-wa-mobile');
          if (linkMobile) linkMobile.href = waUrl;

          updateVueltoCalculation();
        };

        // GESTOR DE TEMA
        const themeBtn = document.getElementById('btn-theme-toggle');
        const themeIcon = document.getElementById('icon-theme');

        const applyTheme = (themeName) => {
          document.documentElement.dataset.theme = themeName;
          document.body.classList.toggle('dark', themeName === 'futuro');
          if (themeIcon) {
            themeIcon.className = themeName === 'futuro' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
          }
          try {
            localStorage.setItem('wiTema_gaswii', themeName);
            localStorage.setItem('wiTema', themeName);
          } catch(e) {}
        };

        applyTheme(document.documentElement.dataset.theme || 'futuro');

        themeBtn?.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'futuro' ? 'luz' : 'futuro';
          applyTheme(next);
          showToast(`Tema ${next === 'futuro' ? 'oscuro' : 'claro'} activado`);
        });

        // TOGGLE IDIOMA
        const langBtn = document.getElementById('btn-lang-toggle');
        langBtn?.addEventListener('click', () => {
          const current = langBtn.textContent;
          langBtn.textContent = current === 'ES' ? 'EN' : 'ES';
          showToast(`Idioma ${langBtn.textContent} seleccionado`);
        });

        // USER DROPDOWN
        const userTrigger = document.getElementById('user-trigger');
        const userDropdown = document.getElementById('user-dropdown');

        userTrigger?.addEventListener('click', (e) => {
          e.stopPropagation();
          userDropdown?.classList.toggle('open');
        });

        document.addEventListener('click', () => {
          userDropdown?.classList.remove('open');
        });

        document.getElementById('btn-logout')?.addEventListener('click', () => {
          showToast('Sesión cerrada');
          setTimeout(() => { window.location.href = '/'; }, 800);
        });

        // SELECTOR DE PRODUCTOS (4 EN FILA)
        document.querySelectorAll('.v40-prod-card').forEach(card => {
          card.addEventListener('click', () => {
            document.querySelectorAll('.v40-prod-card').forEach(c => c.classList.remove('active'));
            card.classList.add('active');
            state.productoId = card.dataset.id;
            state.productoNombre = card.dataset.name;
            state.productoCorto = card.dataset.shortname;
            state.precio = card.dataset.price;
            updateWhatsAppOutput();
            showToast(`${card.dataset.shortname}: S/ ${state.precio}`);
          });
        });

        // SELECTOR DE MÉTODO DE PAGO (EFECTIVO VS YAPE / PLIN)
        const cashBox = document.getElementById('v40-cash-box');
        const yapeBox = document.getElementById('v40-yape-box');

        document.querySelectorAll('.v40-pay-method-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.v40-pay-method-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            state.metodoPago = btn.dataset.method;
            if (state.metodoPago === 'efectivo') {
              if (cashBox) cashBox.style.display = 'flex';
              if (yapeBox) yapeBox.style.display = 'none';
            } else {
              if (cashBox) cashBox.style.display = 'none';
              if (yapeBox) yapeBox.style.display = 'flex';
            }
            updateWhatsAppOutput();
            showToast(`Pago: ${state.metodoPago === 'efectivo' ? 'Efectivo' : 'Yape / Plin'}`);
          });
        });

        // SELECTOR DE CHIPS DE VUELTO (EXACTO, 20, 50, 100, CUSTOM)
        const customInput = document.getElementById('in-custom-cash');

        document.querySelectorAll('.v40-vuelto-chip').forEach(chip => {
          chip.addEventListener('click', () => {
            document.querySelectorAll('.v40-vuelto-chip').forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            state.vueltoModo = chip.dataset.vuelto;

            if (state.vueltoModo === 'exacto') {
              state.montoPagoEfectivo = parseFloat(state.precio) || 0;
              if (customInput) customInput.value = state.precio;
            } else if (state.vueltoModo === 'custom') {
              if (customInput) {
                customInput.focus();
                state.montoPagoEfectivo = parseFloat(customInput.value) || 0;
              }
            } else {
              state.montoPagoEfectivo = parseFloat(state.vueltoModo) || 0;
              if (customInput) customInput.value = state.vueltoModo;
            }

            updateWhatsAppOutput();
            showToast(state.vueltoModo === 'exacto' ? 'Pago con monto exacto' : `Pagarás con S/ ${state.montoPagoEfectivo}`);
          });
        });

        // INPUT PERSONALIZADO DE MONTO EN EFECTIVO
        customInput?.addEventListener('input', (e) => {
          const val = parseFloat(e.target.value) || 0;
          state.montoPagoEfectivo = val;
          // Activar chip custom
          document.querySelectorAll('.v40-vuelto-chip').forEach(c => c.classList.remove('active'));
          const chipCustom = document.querySelector('.v40-vuelto-chip[data-vuelto="custom"]');
          if (chipCustom) chipCustom.classList.add('active');
          state.vueltoModo = 'custom';
          updateWhatsAppOutput();
        });

        // QUICK TAGS DE INDICACIONES
        const notesInput = document.getElementById('order-notes');
        document.querySelectorAll('.v40-quick-tag').forEach(tag => {
          tag.addEventListener('click', () => {
            const textToAdd = tag.dataset.tag;
            tag.classList.toggle('active');
            let current = notesInput?.value || '';

            if (tag.classList.contains('active')) {
              current = current ? `${current} · ${textToAdd}` : textToAdd;
            } else {
              current = current.replace(` · ${textToAdd}`, '').replace(textToAdd, '').trim();
            }
            if (notesInput) notesInput.value = current;
            state.notas = current;
            updateWhatsAppOutput();
          });
        });

        // CAMPO NOTAS ADICIONALES
        notesInput?.addEventListener('input', (e) => {
          state.notas = e.target.value.trim();
          updateWhatsAppOutput();
        });

        // SELECCIÓN DE DIRECCIÓN DESDE EL SELECTOR PRINCIPAL
        const selectAddressMain = document.getElementById('select-address-main');
        selectAddressMain?.addEventListener('change', (e) => {
          const dir = state.direcciones.find(d => d.id === e.target.value);
          if (dir) {
            state.calle = dir.calle;
            state.distrito = dir.distrito;
            state.referencia = dir.referencia;
            state.eta = dir.eta;
            state.aliasActual = dir.alias;
            updateWhatsAppOutput();
            showToast(`Entrega: ${dir.alias}`);
          }
        });

        // MODAL 90VW X 90VH FICHA & DIRECCIONES
        const modalFicha = document.getElementById('modal-edit-ficha');
        const openFichaModal = () => modalFicha?.showModal();

        document.getElementById('btn-open-edit-ficha')?.addEventListener('click', openFichaModal);
        document.getElementById('drop-open-profile')?.addEventListener('click', openFichaModal);
        document.getElementById('close-ficha-modal')?.addEventListener('click', () => modalFicha?.close());
        document.getElementById('btn-cancel-modal')?.addEventListener('click', () => modalFicha?.close());

        // Cerrar al hacer clic en el backdrop fuera del modal
        modalFicha?.addEventListener('click', (e) => {
          const rect = modalFicha.getBoundingClientRect();
          const isInDialog = (
            rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
            rect.left <= e.clientX && e.clientX <= rect.left + rect.width
          );
          if (!isInDialog) {
            modalFicha.close();
          }
        });

        // FACTURACIÓN TOGGLE
        const rucGroup = document.getElementById('group-ruc');
        document.querySelectorAll('.v40-billing-radio-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.v40-billing-radio-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            state.tipoComprobante = btn.dataset.type;
            if (rucGroup) {
              rucGroup.style.display = state.tipoComprobante === 'factura' ? 'flex' : 'none';
            }
          });
        });

        // AGREGAR NUEVA DIRECCIÓN TOGGLE
        const boxAddDir = document.getElementById('box-add-address');
        document.getElementById('btn-toggle-add-address')?.addEventListener('click', () => {
          boxAddDir?.classList.toggle('open');
        });
        document.getElementById('btn-cancel-add-dir')?.addEventListener('click', () => {
          boxAddDir?.classList.remove('open');
        });

        // GUARDAR NUEVA DIRECCIÓN EN LIBRETA
        document.getElementById('btn-save-new-dir')?.addEventListener('click', () => {
          const alias = document.getElementById('new-dir-alias').value.trim() || 'Nueva Dirección';
          const calle = document.getElementById('new-dir-calle').value.trim();
          const dist = document.getElementById('new-dir-distrito').value;
          const ref = document.getElementById('new-dir-ref').value.trim();

          if (!calle) {
            alert('Por favor ingresa la calle, avenida y número');
            return;
          }

          const newId = `dir-${Date.now()}`;
          const etaMap = {
            'Surquillo': '12–15 min',
            'Miraflores': '15–20 min',
            'San Borja': '15–22 min',
            'San Isidro': '18–25 min'
          };
          const eta = etaMap[dist] || '15–20 min';

          const newDir = { id: newId, alias, calle, distrito: dist, referencia: ref, eta, esPrincipal: false };
          state.direcciones.push(newDir);

          // Crear tarjeta en el modal
          const list = document.getElementById('modal-address-list');
          const cardEl = document.createElement('div');
          cardEl.className = 'v40-address-item-card';
          cardEl.innerHTML = `
            <div class="v40-address-item-head">
              <div class="v40-address-item-title">
                <i class="fa-solid fa-map-pin"></i>
                <strong>${alias}</strong>
              </div>
              <span style="font-size:0.7rem; color:var(--v40-text-muted);">${dist}</span>
            </div>
            <div class="v40-address-fields-grid">
              <div class="v40-form-group">
                <label>Calle y Número / Dpto</label>
                <input type="text" class="v40-form-input" value="${calle}" readonly />
              </div>
              <div class="v40-form-group">
                <label>Distrito</label>
                <input type="text" class="v40-form-input" value="${dist} (${eta})" readonly />
              </div>
              <div class="v40-form-group">
                <label>Referencia</label>
                <input type="text" class="v40-form-input" value="${ref}" readonly />
              </div>
            </div>
          `;
          list.appendChild(cardEl);

          // Agregar al select principal de la vista
          if (selectAddressMain) {
            const opt = document.createElement('option');
            opt.value = newId;
            opt.textContent = `${alias} · ${dist} (${eta})`;
            selectAddressMain.appendChild(opt);
          }

          // Limpiar y cerrar formulario
          document.getElementById('new-dir-alias').value = '';
          document.getElementById('new-dir-calle').value = '';
          document.getElementById('new-dir-ref').value = '';
          boxAddDir.classList.remove('open');
          showToast(`Dirección "${alias}" guardada en libreta`);
        });

        // BOTÓN MARCAR DIRECCIÓN 2 COMO PRINCIPAL
        document.getElementById('btn-make-default-2')?.addEventListener('click', () => {
          if (selectAddressMain) {
            selectAddressMain.value = 'dir-2';
            selectAddressMain.dispatchEvent(new Event('change'));
            showToast('Oficina / Estudio seleccionada como principal');
          }
        });

        // GUARDAR CAMBIOS Y SINCRONIZAR MODAL
        document.getElementById('btn-save-modal')?.addEventListener('click', () => {
          const nuevoNombre = document.getElementById('in-name').value.trim();
          if (nuevoNombre) state.nombre = nuevoNombre;
          state.dni = document.getElementById('in-dni').value.trim();
          state.telefono = document.getElementById('in-phone').value.trim();
          state.email = document.getElementById('in-mail').value.trim();
          state.ruc = document.getElementById('in-ruc')?.value.trim() || '';

          // Actualizar Dirección 1
          const calle1 = document.getElementById('in-calle-1').value.trim();
          const dist1 = document.getElementById('in-distrito-1').value;
          const ref1 = document.getElementById('in-ref-1').value.trim();
          state.direcciones[0].calle = calle1;
          state.direcciones[0].distrito = dist1;
          state.direcciones[0].referencia = ref1;

          // Actualizar Dirección 2
          const calle2 = document.getElementById('in-calle-2')?.value.trim();
          const dist2 = document.getElementById('in-distrito-2')?.value;
          const ref2 = document.getElementById('in-ref-2')?.value.trim();
          if (state.direcciones[1] && calle2) {
            state.direcciones[1].calle = calle2;
            state.direcciones[1].distrito = dist2;
            state.direcciones[1].referencia = ref2;
          }

          // Refrescar selector en la página principal
          if (selectAddressMain) {
            selectAddressMain.options[0].textContent = `Casa Principal · ${dist1} (${state.direcciones[0].eta})`;
            if (selectAddressMain.options[1] && state.direcciones[1]) {
              selectAddressMain.options[1].textContent = `Oficina / Estudio · ${dist2} (${state.direcciones[1].eta})`;
            }
          }

          if (selectAddressMain.value === 'dir-1') {
            state.calle = calle1;
            state.distrito = dist1;
            state.referencia = ref1;
          } else if (selectAddressMain.value === 'dir-2') {
            state.calle = calle2;
            state.distrito = dist2;
            state.referencia = ref2;
          }

          // Actualizar UI reactiva
          const dispName = document.getElementById('disp-name');
          if (dispName) dispName.textContent = state.nombre;
          
          const headerName = document.getElementById('header-user-firstname');
          if (headerName) headerName.textContent = state.nombre;

          const modalDispName = document.getElementById('modal-display-name');
          if (modalDispName) modalDispName.textContent = state.nombre;

          const dispPhone = document.getElementById('disp-phone');
          if (dispPhone) dispPhone.textContent = `+51 ${state.telefono}`;

          updateWhatsAppOutput();
          modalFicha?.close();
          showToast('Ficha de cliente y direcciones sincronizadas con éxito');
        });

        // Hora WhatsApp
        const now = new Date();
        let hours = now.getHours();
        const minutes = now.getMinutes().toString().padStart(2, '0');
        const ampm = hours >= 12 ? 'p. m.' : 'a. m.';
        hours = hours % 12 || 12;
        const timeEl = document.getElementById('wa-time-now');
        if (timeEl) timeEl.textContent = `${hours}:${minutes} ${ampm}`;

        updateWhatsAppOutput();
      })();
    </script>
  </body>
</html>
