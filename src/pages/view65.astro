  { id: 'f4', nombre: 'BALON-SOLGAS-AZUL.webp', url: '/imgwii/productos/BALON-10KG.webp', peso: '44 KB', dim: '640x640', fecha: '17 Sep' },
  { id: 'f5', nombre: 'SEDE-DANTE-FACHADA.webp', url: '/imgwii/logo.webp', peso: '28 KB', dim: '480x280', fecha: '15 Sep' },
  { id: 'f6', nombre: 'BALANZA-INACAL.webp', url: '/imgwii/productos/BALON-10KG.webp', peso: '39 KB', dim: '640x640', fecha: '14 Sep' }
