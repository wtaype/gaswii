---

<!DOCTYPE html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Dashboard del Dueño · Solgas Surquillo (View 65)</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Anti-FOUC Inmediato -->
  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('gaswii-theme') || 'futuro';
      document.documentElement.dataset.theme = savedTheme;
      if (localStorage.getItem('gaswii_sidebar_collapsed') === 'true') {
        document.documentElement.classList.add('is-collapsed');
      }
    } catch (e) {}
  </script>

  <!-- Tipografías e Iconos -->
  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />

  <!-- Estilos WiTema V2.0 Inlined -->
  <style is:global set:html={witemaCss}></style>

  <!-- Estilos Estructurados de View65 -->
  <style is:global>
    :root {
      --side-w: 240px;
      --side-collapsed-w: 72px;
      --topbar-h: 62px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: var(--fz_m);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    h1, h2, h3, h4, p { margin: 0; }
    button, input, select, textarea { font-family: inherit; font-size: inherit; }

    /* Topbar */
    .v65-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--topbar-h);
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      gap: 16px;
      backdrop-filter: blur(16px);
    }
    .v65-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }
    .v65-logo {
      height: 32px;
      width: auto;
      object-fit: contain;
    }
    .v65-brand-text {
      display: flex;
      flex-direction: column;
    }
    .v65-brand-title {
      font-size: var(--fz_m1);
      font-weight: 700;
      letter-spacing: -0.2px;
      color: var(--ink);
      line-height: 1.2;
    }
    .v65-brand-sub {
      font-size: var(--fz_s3);
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .v65-badge-online {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 8px var(--green);
    }

    .v65-top-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .v65-search-box {
      position: relative;
      width: 280px;
    }
    .v65-search-box input {
      width: 100%;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 7px 12px 7px 34px;
      color: var(--ink);
      font-size: var(--fz_s4);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .v65-search-box input:focus {
      border-color: var(--brand-orange);
      box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.15);
    }
    .v65-search-icon {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      font-size: var(--fz_s3);
      pointer-events: none;
    }

    .v65-btn-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: var(--raised);
      color: var(--ink);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, transform 0.15s;
    }
    .v65-btn-icon:hover {
      border-color: var(--brand-orange);
      color: var(--brand-orange);
      transform: translateY(-1px);
    }

    .v65-user-badge {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 10px 4px 4px;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 20px;
      cursor: pointer;
    }
    .v65-user-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--brand-orange), #ff9900);
      color: #fff;
      font-weight: 700;
      font-size: var(--fz_s3);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .v65-user-name {
      font-size: var(--fz_s4);
      font-weight: 600;
      color: var(--ink);
    }
    .v65-user-role {
      font-size: var(--fz_s2);
      color: var(--brand-orange);
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    /* Sidebar */
    .v65-sidebar {
      position: fixed;
      top: var(--topbar-h);
      bottom: 0;
      left: 0;
      width: var(--side-w);
      background: var(--surface);
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      z-index: 40;
      transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      overflow-y: auto;
      overflow-x: hidden;
    }
    html.is-collapsed .v65-sidebar {
      width: var(--side-collapsed-w);
    }

    .v65-nav {
      padding: 14px 10px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
    }

    .v65-nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 9px 12px;
      border-radius: 8px;
      color: var(--muted);
      border: none;
      background: none;
      cursor: pointer;
      text-align: left;
      font-size: var(--fz_m);
      font-weight: 500;
      transition: background 0.15s, color 0.15s;
      white-space: nowrap;
      position: relative;
    }
    .v65-nav-item:hover {
      background: var(--raised);
      color: var(--ink);
    }
    .v65-nav-item.active {
      background: var(--raised);
      color: var(--brand-orange);
      font-weight: 600;
    }
    .v65-nav-item.active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 3px;
      border-radius: 0 3px 3px 0;
      background: var(--brand-orange);
    }
    .v65-nav-item i {
      font-size: 15px;
      width: 20px;
      text-align: center;
      flex-shrink: 0;
    }
    html.is-collapsed .v65-nav-item {
      justify-content: center;
      padding: 10px 0;
    }
    html.is-collapsed .v65-nav-item span {
      display: none;
    }

    .v65-sidebar-footer {
      padding: 12px 10px;
      border-top: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .v65-btn-collapse {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 8px 12px;
      border-radius: 8px;
      background: none;
      border: 1px solid transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: var(--fz_s4);
      transition: background 0.15s, color 0.15s, border-color 0.15s;
      white-space: nowrap;
    }
    .v65-btn-collapse:hover {
      background: var(--raised);
      color: var(--ink);
      border-color: var(--line);
    }
    html.is-collapsed .v65-btn-collapse {
      justify-content: center;
      padding: 8px 0;
    }
    html.is-collapsed .v65-btn-collapse span {
      display: none;
    }

    /* Main Shell */
    .v65-main-shell {
      margin-left: var(--side-w);
      margin-top: var(--topbar-h);
      padding: 24px 28px 60px;
      min-height: calc(100vh - var(--topbar-h));
      transition: margin-left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    html.is-collapsed .v65-main-shell {
      margin-left: var(--side-collapsed-w);
    }

    /* Section Headers */
    .v65-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .v65-section-title-wrap {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .v65-section-title {
      font-size: var(--fz_m3);
      font-weight: 700;
      letter-spacing: -0.3px;
      color: var(--ink);
    }
    .v65-section-sub {
      font-size: var(--fz_s4);
      color: var(--muted);
    }

    /* Buttons */
    .v65-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: var(--fz_s4);
      font-weight: 600;
      cursor: pointer;
      border: 1px solid transparent;
      transition: background 0.15s, transform 0.15s, border-color 0.15s, box-shadow 0.15s;
      white-space: nowrap;
    }
    .v65-btn:hover { transform: translateY(-1px); }
    .v65-btn-primary {
      background: var(--brand-orange);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(255, 102, 0, 0.25);
    }
    .v65-btn-primary:hover {
      background: var(--brand-orange-hover);
    }
    .v65-btn-secondary {
      background: var(--raised);
      border-color: var(--line);
      color: var(--ink);
    }
    .v65-btn-secondary:hover {
      border-color: var(--brand-orange);
      color: var(--brand-orange);
    }
    .v65-btn-danger {
      background: rgba(251, 124, 133, 0.12);
      border-color: rgba(251, 124, 133, 0.3);
      color: var(--red);
    }
    .v65-btn-danger:hover {
      background: var(--red);
      color: #ffffff;
    }

    /* Panels */
    .v65-panel {
      display: none;
      animation: v65FadeIn 0.2s ease-out;
    }
    .v65-panel.active {
      display: block;
    }
    @keyframes v65FadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* KPI Cards */
    .v65-kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 22px;
    }
    .v65-kpi-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .v65-kpi-card:hover {
      border-color: rgba(255, 102, 0, 0.35);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }
    .v65-kpi-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .v65-kpi-label {
      font-size: var(--fz_s3);
      color: var(--muted);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .v65-kpi-val {
      font-size: var(--fz_m3);
      font-weight: 700;
      color: var(--ink);
    }
    .v65-kpi-note {
      font-size: var(--fz_s2);
      color: var(--green);
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .v65-kpi-icon-wrap {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: var(--raised);
      color: var(--brand-orange);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    /* Cards */
    .v65-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      overflow: hidden;
    }
    .v65-card-head {
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .v65-card-head h3 {
      font-size: var(--fz_m2);
      font-weight: 600;
      color: var(--ink);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .v65-card-body {
      padding: 18px;
    }

    /* Form Fields */
    .v65-field-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .v65-label {
      font-size: var(--fz_s3);
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    .v65-input, .v65-textarea, .v65-select {
      width: 100%;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 8px 12px;
      color: var(--ink);
      font-size: var(--fz_m);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .v65-input:focus, .v65-textarea:focus, .v65-select:focus {
      border-color: var(--brand-orange);
      box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.15);
    }
    .v65-textarea {
      resize: vertical;
      min-height: 85px;
    }

    /* Dashboard Split Grid: Notepad Rápido + Mi Negocio */
    .v65-split-grid {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 20px;
      margin-bottom: 22px;
    }
    @media (max-width: 980px) {
      .v65-split-grid { grid-template-columns: 1fr; }
    }

    /* Mini Notas en Dashboard */
    .v65-dash-note-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 8px 10px;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      font-size: var(--fz_m);
    }
    .v65-dash-note-text {
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--ink);
    }
    .v65-dash-note-text.done {
      text-decoration: line-through;
      color: var(--muted);
    }

    /* ============================================================ */
    /* 📝 NOTEPAD DEDICADO: ARQUITECTURA 70% EDITOR / 30% LISTA     */
    /* ============================================================ */
    .v65-notepad-layout {
      display: grid;
      grid-template-columns: minmax(0, 2.2fr) minmax(290px, 1fr);
      gap: 20px;
      align-items: start;
    }
    @media (max-width: 1020px) {
      .v65-notepad-layout { grid-template-columns: 1fr; }
    }

    /* Canvas del Editor (70%) */
    .v65-note-editor-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .v65-note-editor-toolbar {
      padding: 12px 18px;
      border-bottom: 1px solid var(--line);
      background: var(--surface);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }
    .v65-tag-selector {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }
    .v65-tag-pill {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: var(--fz_s3);
      font-weight: 600;
      border: 1px solid var(--line);
      background: var(--raised);
      color: var(--muted);
      cursor: pointer;
      transition: all 0.15s;
    }
    .v65-tag-pill:hover {
      border-color: var(--brand-orange);
      color: var(--ink);
    }
    .v65-tag-pill.active {
      background: var(--brand-orange);
      border-color: var(--brand-orange);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(255, 102, 0, 0.3);
    }

    .v65-note-canvas {
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
      background: var(--surface);
    }
    .v65-note-title-input {
      font-size: var(--fz_m2);
      font-weight: 600;
      color: var(--ink);
      border: none;
      background: none;
      outline: none;
      padding: 4px 0;
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s;
    }
    .v65-note-title-input:focus {
      border-bottom-color: var(--brand-orange);
    }
    .v65-note-body-textarea {
      width: 100%;
      min-height: 280px;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 16px;
      color: var(--ink);
      font-size: var(--fz_m);
      line-height: 1.6;
      resize: vertical;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .v65-note-body-textarea:focus {
      border-color: var(--brand-orange);
      box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.15);
    }

    .v65-note-editor-footer {
      padding: 14px 20px;
      border-top: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--surface);
    }
    .v65-note-stats {
      font-size: var(--fz_s3);
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Lista Compacta de Notas (30%) */
    .v65-note-list-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      max-height: 600px;
      overflow: hidden;
    }
    .v65-note-list-head {
      padding: 14px 16px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .v65-note-items-scroll {
      padding: 12px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .v65-note-summary-card {
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 10px 12px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      cursor: pointer;
      transition: border-color 0.15s, transform 0.15s, background 0.15s;
      position: relative;
    }
    .v65-note-summary-card:hover {
      border-color: var(--brand-orange);
      transform: translateY(-1px);
    }
    .v65-note-summary-card.active {
      border-color: var(--brand-orange);
      background: rgba(255, 102, 0, 0.06);
    }
    .v65-note-summary-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .v65-note-summary-tag {
      font-size: var(--fz_s2);
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      text-transform: uppercase;
    }
    .v65-note-summary-date {
      font-size: var(--fz_s2);
      color: var(--muted);
    }
    .v65-note-summary-snippet {
      font-size: var(--fz_m);
      color: var(--ink);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .v65-note-summary-snippet.done {
      text-decoration: line-through;
      color: var(--muted);
    }
    .v65-note-summary-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 2px;
    }

    /* Tablas Compactas */
    .v65-table-wrap {
      overflow-x: auto;
      border-radius: 8px;
      border: 1px solid var(--line);
    }
    .v65-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: var(--fz_m);
    }
    .v65-table th {
      background: var(--raised);
      color: var(--muted);
      font-size: var(--fz_s3);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 10px 14px;
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
    }
    .v65-table td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
      vertical-align: middle;
      white-space: nowrap;
    }
    .v65-table tr:last-child td { border-bottom: none; }
    .v65-table tr:hover td { background: var(--raised); }

    /* Chips y Badges */
    .v65-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 8px;
      border-radius: 4px;
      font-size: var(--fz_s2);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    .v65-badge-success { background: rgba(32, 195, 150, 0.15); color: var(--green); }
    .v65-badge-warning { background: rgba(255, 167, 38, 0.15); color: var(--warning); }
    .v65-badge-orange  { background: rgba(255, 102, 0, 0.15); color: var(--brand-orange); }
    .v65-badge-blue    { background: rgba(2, 132, 199, 0.15); color: var(--brand-blue); }

    /* Galería Media */
    .v65-media-strip {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 12px;
    }
    .v65-media-item {
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.15s, border-color 0.15s;
    }
    .v65-media-item:hover {
      transform: translateY(-2px);
      border-color: var(--brand-orange);
    }
    .v65-media-thumb-wrap {
      height: 90px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.1);
      padding: 6px;
    }
    .v65-media-thumb {
      max-height: 100%;
      max-width: 100%;
      object-fit: contain;
    }
    .v65-media-meta {
      padding: 6px 8px;
      display: flex;
      flex-direction: column;
    }
    .v65-media-name {
      font-size: var(--fz_s3);
      font-weight: 600;
      color: var(--ink);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .v65-media-sub {
      font-size: var(--fz_s2);
      color: var(--muted);
    }

    /* Modal emergente para previsualización */
    .v65-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .v65-modal.active { display: flex; }
    .v65-modal-content {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 14px;
      max-width: 540px;
      width: 100%;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      animation: v65ModalZoom 0.2s ease-out;
    }
    @keyframes v65ModalZoom {
      from { transform: scale(0.94); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .v65-modal-head {
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .v65-modal-body {
      padding: 18px;
    }
  </style>
</head>
<body>

  <!-- Topbar Unificada (Sin witip) -->
  <header class="v65-topbar">
    <div class="v65-brand">
      <img src="/imgwii/logo.webp" alt="Solgas Surquillo" class="v65-logo" />
      <div class="v65-brand-text">
        <span class="v65-brand-title">SOLGAS SURQUILLO</span>
        <span class="v65-brand-sub">
          <span class="v65-badge-online"></span>
          Sede Jr. Dante 260 · Centro de Operaciones
        </span>
      </div>
    </div>

    <!-- Buscador Global -->
    <div class="v65-search-box">
      <i class="fa-solid fa-magnifying-glass v65-search-icon"></i>
      <input type="text" id="v65GlobalSearch" placeholder="Buscar entradas, productos, páginas…" />
    </div>

    <!-- Acciones Rápidas del Dueño -->
    <div class="v65-top-actions">
      <button class="v65-btn-icon" id="btnThemeToggle" aria-label="Cambiar tema">
        <i class="fa-solid fa-circle-half-stroke"></i>
      </button>

      <a href="/" target="_blank" class="v65-btn-icon" aria-label="Sitio web">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
      </a>

      <div class="v65-user-badge" id="btnUserBadge">
        <div class="v65-user-avatar">WT</div>
        <div>
          <div class="v65-user-name">Wilder Taype</div>
          <div class="v65-user-role">Dueño / Admin</div>
        </div>
      </div>
    </div>
  </header>

  <!-- Sidebar Jerárquico: 1.Dashboard, 2.Notepad, 3.Mi negocio, etc. (Sin witip) -->
  <aside class="v65-sidebar" id="sidebarMenu">
    <nav class="v65-nav" aria-label="Menú del dueño">
      {modulos.map((m, idx) => (
        <button 
          class={`v65-nav-item ${idx === 0 ? 'active' : ''}`} 
          data-panel-target={m.id}
        >
          <i class={m.icono}></i>
          <span>{m.nombre}</span>
        </button>
      ))}
    </nav>

    <!-- Pie con Botón Plegar Menú -->
    <div class="v65-sidebar-footer">
      <button class="v65-btn-collapse" id="btnCollapseSidebar">
        <i class="fa-solid fa-arrow-left-long" id="iconCollapse"></i>
        <span id="labelCollapse">Plegar menú</span>
      </button>
    </div>
  </aside>

  <!-- Shell de Trabajo -->
  <main class="v65-main-shell">

    <!-- 1. MÓDULO: DASHBOARD -->
    <section class="v65-panel active" id="panel-dashboard">
      <div class="v65-section-header">
        <div class="v65-section-title-wrap">
          <h1 class="v65-section-title">Dashboard del Dueño</h1>
          <p class="v65-section-sub">Resumen integral y control directo de la planta de Surquillo.</p>
        </div>
        <div class="v65-header-actions">
          <button class="v65-btn v65-btn-primary" data-jump-to="notepad">
            <i class="fa-solid fa-note-sticky"></i> Abrir Notepad
          </button>
        </div>
      </div>

      <!-- 4 KPIs Ejecutivos Compactos -->
      <div class="v65-kpi-grid">
        <div class="v65-kpi-card">
          <div class="v65-kpi-info">
            <span class="v65-kpi-label">Estado de Planta</span>
            <span class="v65-kpi-val">Operativa</span>
            <span class="v65-kpi-note"><i class="fa-solid fa-check"></i> Despacho activo</span>
          </div>
          <div class="v65-kpi-icon-wrap"><i class="fa-solid fa-truck-fast"></i></div>
        </div>

        <div class="v65-kpi-card">
          <div class="v65-kpi-info">
            <span class="v65-kpi-label">Apuntes Notepad</span>
            <span class="v65-kpi-val" id="dashNotesCount">3 Notas</span>
            <span class="v65-kpi-note"><i class="fa-solid fa-pen-nib"></i> Bloc activo</span>
          </div>
          <div class="v65-kpi-icon-wrap"><i class="fa-solid fa-note-sticky"></i></div>
        </div>

        <div class="v65-kpi-card">
          <div class="v65-kpi-info">
            <span class="v65-kpi-label">Fotos en Galería</span>
            <span class="v65-kpi-val">6 en R2</span>
            <span class="v65-kpi-note"><i class="fa-solid fa-cloud"></i> media.solgas...</span>
          </div>
          <div class="v65-kpi-icon-wrap"><i class="fa-solid fa-images"></i></div>
        </div>

        <div class="v65-kpi-card">
          <div class="v65-kpi-info">
            <span class="v65-kpi-label">Balones en Catálogo</span>
            <span class="v65-kpi-val">4 Productos</span>
            <span class="v65-kpi-note"><i class="fa-solid fa-layer-group"></i> 10kg, 45kg</span>
          </div>
          <div class="v65-kpi-icon-wrap"><i class="fa-solid fa-fire"></i></div>
        </div>
      </div>

      <!-- Grilla Dividida: Notepad Rápido + Mi Negocio al Día -->
      <div class="v65-split-grid">
        <!-- Notepad Rápido en Dashboard (Sustituye a Borrador de Blog) -->
        <div class="v65-card">
          <div class="v65-card-head">
            <h3><i class="fa-solid fa-note-sticky" style="color:var(--brand-orange)"></i> Notepad Rápido</h3>
            <button class="v65-btn v65-btn-secondary" data-jump-to="notepad" style="padding:4px 10px; font-size:var(--fz_s3);">
              Ir al Notepad <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>
          <div class="v65-card-body">
            <!-- Formulario de nota exprés -->
            <form id="formDashQuickNote" style="display:flex; flex-direction:column; gap:10px; margin-bottom:14px;">
              <div style="display:flex; gap:10px;">
                <select id="dashQuickNoteTag" class="v65-select" style="max-width:140px;">
                  <option value="Urgente">⚡ Urgente</option>
                  <option value="Planta">🏢 Planta</option>
                  <option value="Pedidos">🛵 Pedidos</option>
                  <option value="Idea">💡 Idea</option>
                </select>
                <input type="text" id="dashQuickNoteText" class="v65-input" placeholder="Anotar pendiente rápido de hoy..." required style="flex:1;" />
                <button type="submit" class="v65-btn v65-btn-primary">
                  <i class="fa-solid fa-plus"></i> Anotar
                </button>
              </div>
            </form>

            <!-- Lista de últimas 3 notas -->
            <div style="display:flex; flex-direction:column; gap:8px;" id="dashNotesList">
              <!-- Renderizado dinámico -->
            </div>
          </div>
        </div>

        <!-- Mi Negocio Glance Card -->
        <div class="v65-card">
          <div class="v65-card-head">
            <h3><i class="fa-solid fa-store" style="color:var(--brand-blue)"></i> Mi Negocio al Día</h3>
            <button class="v65-btn v65-btn-secondary" data-jump-to="business" style="padding:4px 10px; font-size:var(--fz_s3);">
              Editar Ficha
            </button>
          </div>
          <div class="v65-card-body">
            <div style="display:flex; flex-direction:column; gap:12px;">
              <div style="display:flex; align-items:center; gap:12px;">
                <img src="/imgwii/logo.webp" alt="Logo" style="height:38px; border-radius:6px; background:var(--raised); padding:4px;" />
                <div>
                  <strong style="font-size:var(--fz_m1); color:var(--ink); display:block;">Solgas Surquillo</strong>
                  <span style="font-size:var(--fz_s3); color:var(--muted);">RUC: 20608945123 · Sede Oficial</span>
                </div>
              </div>

              <div style="background:var(--raised); padding:10px 12px; border-radius:8px; border:1px solid var(--line); font-size:var(--fz_s4); display:flex; flex-direction:column; gap:6px;">
                <div><i class="fa-solid fa-location-dot" style="color:var(--brand-orange); width:18px;"></i> Jr. Dante 260, Surquillo, Lima</div>
                <div><i class="fa-solid fa-phone" style="color:var(--green); width:18px;"></i> (01) 241-5555 · 940 200 400</div>
                <div><i class="fa-solid fa-clock" style="color:var(--brand-blue); width:18px;"></i> Lunes a Sábado: 6:00 am - 10:00 pm</div>
                <div><i class="fa-solid fa-map" style="color:var(--warning); width:18px;"></i> Surquillo, Miraflores, San Isidro, San Borja, Surco</div>
              </div>

              <div style="display:flex; gap:8px;">
                <a href="https://wa.me/51940200400" target="_blank" class="v65-btn v65-btn-secondary" style="flex:1; justify-content:center;">
                  <i class="fa-brands fa-whatsapp" style="color:var(--green)"></i> Probar WhatsApp
                </a>
                <button class="v65-btn v65-btn-secondary" data-jump-to="products" style="flex:1; justify-content:center;">
                  <i class="fa-solid fa-box-archive"></i> Ver Catálogo
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tira de Galería Reciente -->
      <div class="v65-card">
        <div class="v65-card-head">
          <h3><i class="fa-solid fa-images" style="color:var(--green)"></i> Fotos Recientes en Cloudflare R2</h3>
          <button class="v65-btn v65-btn-secondary" data-jump-to="gallery" style="padding:4px 10px; font-size:var(--fz_s3);">
            Ver Toda la Galería
          </button>
        </div>
        <div class="v65-card-body">
          <div class="v65-media-strip">
            {fotosGaleriaDemo.slice(0, 5).map(f => (
              <div class="v65-media-item" data-media-url={f.url} data-media-name={f.nombre}>
                <div class="v65-media-thumb-wrap">
                  <img src={f.url} alt={f.nombre} class="v65-media-thumb" />
                </div>
                <div class="v65-media-meta">
                  <span class="v65-media-name">{f.nombre}</span>
                  <span class="v65-media-sub">{f.peso} · {f.dim}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. MÓDULO: NOTEPAD (ARQUITECTURA 70% EDITOR / 30% LISTA) -->
    <section class="v65-panel" id="panel-notepad">
      <div class="v65-section-header">
        <div class="v65-section-title-wrap">
          <h1 class="v65-section-title">Notepad del Dueño</h1>
          <p class="v65-section-sub">Espacio amplio para anotaciones diarias, compras a planta y recordatorios.</p>
        </div>
        <div class="v65-header-actions">
          <button class="v65-btn v65-btn-secondary" id="btnNewNoteCanvas">
            <i class="fa-solid fa-file-circle-plus"></i> Nueva Nota en Blanco
          </button>
        </div>
      </div>

      <div class="v65-notepad-layout">
        <!-- 70%: Lienzo de Escritura Amplio y Cómodo -->
        <div class="v65-note-editor-card">
          <div class="v65-note-editor-toolbar">
            <div class="v65-tag-selector" id="tagPillGroup">
              <span class="v65-tag-pill active" data-tag="Urgente">⚡ Urgente</span>
              <span class="v65-tag-pill" data-tag="Planta">🏢 Planta Solgas</span>
              <span class="v65-tag-pill" data-tag="Pedidos">🛵 Pedido Especial</span>
              <span class="v65-tag-pill" data-tag="Idea">💡 Idea / Proyecto</span>
              <span class="v65-tag-pill" data-tag="Cliente">📞 Cliente</span>
            </div>
            <span id="noteEditorStatus" style="font-size:var(--fz_s3); color:var(--muted);">Editando nota</span>
          </div>

          <form id="formNotepadFull" class="v65-note-canvas">
            <input type="hidden" id="notepadCurrentId" value="" />
            <input 
              type="text" 
              id="notepadTitle" 
              class="v65-note-title-input" 
              placeholder="Título o Asunto de la nota (ej: Pedido urgente de 50 balones para el fin de semana)..." 
              required 
            />
            <textarea 
              id="notepadContent" 
              class="v65-note-body-textarea" 
              placeholder="Escribe libremente todos los detalles aquí: números de teléfono, direcciones, acuerdos con planta, cantidades, recordatorios..." 
              required
            ></textarea>
          </form>

          <div class="v65-note-editor-footer">
            <div class="v65-note-stats">
              <span id="noteCharCount">0 caracteres</span>
              <span>·</span>
              <span id="noteWordCount">0 palabras</span>
            </div>
            <div style="display:flex; gap:10px;">
              <button type="button" class="v65-btn v65-btn-secondary" id="btnClearNote">
                Limpiar
              </button>
              <button type="button" class="v65-btn v65-btn-primary" id="btnSaveNotepadFull">
                <i class="fa-solid fa-floppy-disk"></i> Guardar Nota
              </button>
            </div>
          </div>
        </div>

        <!-- 30%: Lista Compacta de Notas (10 palabras + ...) -->
        <div class="v65-note-list-card">
          <div class="v65-note-list-head">
            <h3 style="font-size:var(--fz_m2);"><i class="fa-solid fa-list-ul"></i> Notas Guardadas</h3>
            <span class="v65-badge v65-badge-blue" id="notepadBadgeCount">3 notas</span>
          </div>
          <div class="v65-note-items-scroll" id="notepadCompactList">
            <!-- Renderizado dinámico con recorte de 10 palabras -->
          </div>
        </div>
      </div>
    </section>

    <!-- 3. MÓDULO: MI NEGOCIO -->
    <section class="v65-panel" id="panel-business">
      <div class="v65-section-header">
        <div class="v65-section-title-wrap">
          <h1 class="v65-section-title">Mi Negocio</h1>
          <p class="v65-section-sub">Información fiscal, canales de despacho y cobertura de la planta.</p>
        </div>
        <div class="v65-header-actions">
          <button class="v65-btn v65-btn-primary" id="btnSaveBusiness">
            <i class="fa-solid fa-floppy-disk"></i> Guardar Cambios
          </button>
        </div>
      </div>

      <div class="v65-card">
        <div class="v65-card-body">
          <form id="formBusinessDetails" style="display:flex; flex-direction:column; gap:20px;">
            <!-- 01 Identidad -->
            <div>
              <h3 style="font-size:var(--fz_m2); margin-bottom:12px; color:var(--brand-orange);">
                01. Identidad Corporativa
              </h3>
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:14px;">
                <div class="v65-field-group">
                  <label class="v65-label">Nombre Comercial</label>
                  <input type="text" class="v65-input" id="bizNombre" value="Solgas Surquillo" required />
                </div>
                <div class="v65-field-group">
                  <label class="v65-label">RUC de Planta</label>
                  <input type="text" class="v65-input" id="bizRuc" value="20608945123" maxlength="11" />
                </div>
                <div class="v65-field-group" style="grid-column:1/-1;">
                  <label class="v65-label">Razón Social</label>
                  <input type="text" class="v65-input" id="bizLegal" value="DISTRIBUIDORA GASWII SOLGAS S.A.C." />
                </div>
                <div class="v65-field-group" style="grid-column:1/-1;">
                  <label class="v65-label">Descripción de la Empresa</label>
                  <textarea class="v65-textarea" id="bizDesc" rows="2">Distribuidor Oficial de Solgas en Surquillo y distritos aledaños. Más de 25 años garantizando pesaje exacto, válvulas de seguridad y despacho express a domicilio.</textarea>
                </div>
              </div>
            </div>

            <hr style="border:0; border-top:1px solid var(--line); margin:0;" />

            <!-- 02 Contacto -->
            <div>
              <h3 style="font-size:var(--fz_m2); margin-bottom:12px; color:var(--green);">
                02. Canales de Contacto y Despacho
              </h3>
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:14px;">
                <div class="v65-field-group">
                  <label class="v65-label">Teléfono Fijo Central</label>
                  <input type="tel" class="v65-input" id="bizPhone" value="(01) 241-5555" />
                </div>
                <div class="v65-field-group">
                  <label class="v65-label">WhatsApp de Despacho (con +51)</label>
