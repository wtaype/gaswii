const articulosDemo = [
  { id: 'art-1', titulo: 'Cómo verificar el peso exacto de tu balón de gas de 10 kg', categoria: 'Seguridad', estado: 'Publicado', fecha: '20 Sep 2026', visitas: 342 },
  { id: 'art-2', titulo: '5 Consejos para ahorrar gas en la cocina de tu hogar', categoria: 'Ahorro', estado: 'Publicado', fecha: '18 Sep 2026', visitas: 215 },
  { id: 'art-3', titulo: 'Válvula Premium Click-On vs Regulador Tradicional: Diferencias', categoria: 'Equipos', estado: 'Publicado', fecha: '15 Sep 2026', visitas: 189 },
  { id: 'art-4', titulo: 'Protocolo de instalación segura y detección de fugas', categoria: 'Seguridad', estado: 'Borrador', fecha: 'Ayer', visitas: 0 },
  { id: 'art-5', titulo: 'Nuevos distritos de cobertura express en Lima Sur', categoria: 'Novedades', estado: 'Borrador', fecha: '12 Sep 2026', visitas: 0 }
