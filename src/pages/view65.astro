const paginasDemo = [
  { id: 'pag-1', titulo: 'Inicio (Página Principal)', slug: '/', estado: 'Activa', modif: 'Hoy 02:40' },
  { id: 'pag-2', titulo: 'Nosotros y 25 Años en Lima', slug: '/#nosotros', estado: 'Activa', modif: '18 Sep' },
  { id: 'pag-3', titulo: 'Garantía de Pesaje Digital Inacal', slug: '/#pesaje', estado: 'Activa', modif: '16 Sep' },
  { id: 'pag-4', titulo: 'Protocolo Cero Fugas y Seguridad', slug: '/#seguridad', estado: 'Activa', modif: '15 Sep' },
  { id: 'pag-5', titulo: 'Preguntas Frecuentes (FAQ)', slug: '/#faq', estado: 'Activa', modif: '14 Sep' },
  { id: 'pag-6', titulo: 'Sede Jr. Dante 260 y Cobertura', slug: '/#mapa', estado: 'Activa', modif: '10 Sep' }
