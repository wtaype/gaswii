  <!-- Scripts Nativos de View65 (0 TS en runtime) -->
  <script is:inline>
    (function () {
      // 1. Selector de Pestañas
      const navItems = document.querySelectorAll('.v65-nav-item');
      const panels = document.querySelectorAll('.v65-panel');

      function switchPanel(targetId) {
        navItems.forEach(item => {
          const isTarget = item.getAttribute('data-panel-target') === targetId;
          item.classList.toggle('active', isTarget);
        });

        panels.forEach(p => {
          p.classList.toggle('active', p.id === `panel-${targetId}`);
        });

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      navItems.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-panel-target');
          if (target) switchPanel(target);
        });
      });

      document.querySelectorAll('[data-jump-to]').forEach(btn => {
        btn.addEventListener('click', () => {
          const dest = btn.getAttribute('data-jump-to');
          if (dest) switchPanel(dest);
        });
      });

      // 2. Colapsar Sidebar
      const btnCollapse = document.getElementById('btnCollapseSidebar');
      const iconCollapse = document.getElementById('iconCollapse');
      const labelCollapse = document.getElementById('labelCollapse');

      function toggleSidebar() {
        const isCollapsed = document.documentElement.classList.toggle('is-collapsed');
        localStorage.setItem('gaswii_sidebar_collapsed', isCollapsed ? 'true' : 'false');
        if (iconCollapse && labelCollapse) {
          if (isCollapsed) {
            iconCollapse.className = 'fa-solid fa-arrow-right-long';
            labelCollapse.textContent = 'Expandir';
          } else {
            iconCollapse.className = 'fa-solid fa-arrow-left-long';
            labelCollapse.textContent = 'Plegar menú';
          }
        }
      }

      btnCollapse?.addEventListener('click', toggleSidebar);

      // 3. Conmutador de Temas (Futuro / Luz)
      const btnTheme = document.getElementById('btnThemeToggle');
      btnTheme?.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme || 'futuro';
        const next = current === 'futuro' ? 'luz' : 'futuro';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('gaswii-theme', next);
        
        if (window.Notificacion) {
          window.Notificacion(`Tema cambiado a ${next === 'futuro' ? 'Modo Futuro (Oscuro)' : 'Modo Luz (Claro)'}`, 'info', 2000);
        }
      });

      // ============================================================
      // 4. GESTOR DE NOTEPAD UNIFICADO (DASHBOARD + MODULO NOTEPAD 70/30)
      // ============================================================
      const STORAGE_KEY_NOTES = 'gaswii_owner_notes';
      let notas = [
        { 
          id: 'n1', 
          tag: 'Urgente', 
          titulo: 'Coordinación fin de semana con planta', 
          texto: 'Coordinar con planta Solgas el ingreso de 50 balones de 10kg para el fin de semana por alta demanda proyectada en Surquillo y Miraflores.', 
          fecha: '20 Sep, 10:30 am', 
          done: false 
        },
        { 
          id: 'n2', 
          tag: 'Planta', 
          titulo: 'Calibración balanza Inacal', 
          texto: 'Calibración semanal de la balanza digital Inacal programada para el jueves a primera hora con técnico certificado.', 
          fecha: '19 Sep, 04:15 pm', 
          done: false 
        },
        { 
          id: 'n3', 
          tag: 'Pedidos', 
          titulo: 'Cliente frecuente pollería Angamos', 
          texto: 'Cliente frecuente Sr. Méndez solicita 2 balones de 45kg para pollería en Angamos con factura a nombre de su empresa.', 
          fecha: '18 Sep, 02:00 pm', 
          done: true 
        }
      ];

      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY_NOTES));
        if (Array.isArray(saved) && saved.length > 0) notas = saved;
      } catch (e) {}

      // Elementos del módulo Notepad
      const notepadCompactList = document.getElementById('notepadCompactList');
      const notepadBadgeCount = document.getElementById('notepadBadgeCount');
      const notepadTitle = document.getElementById('notepadTitle');
      const notepadContent = document.getElementById('notepadContent');
      const notepadCurrentId = document.getElementById('notepadCurrentId');
      const noteEditorStatus = document.getElementById('noteEditorStatus');
      const noteCharCount = document.getElementById('noteCharCount');
      const noteWordCount = document.getElementById('noteWordCount');
      const tagPillGroup = document.getElementById('tagPillGroup');
      const btnSaveNotepadFull = document.getElementById('btnSaveNotepadFull');
      const btnClearNote = document.getElementById('btnClearNote');
      const btnNewNoteCanvas = document.getElementById('btnNewNoteCanvas');

      // Elementos del Dashboard
      const dashNotesCount = document.getElementById('dashNotesCount');
      const dashNotesList = document.getElementById('dashNotesList');
      const formDashQuickNote = document.getElementById('formDashQuickNote');

      let currentActiveTag = 'Urgente';

      // Selector de pastillas de tags
      tagPillGroup?.querySelectorAll('.v65-tag-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          tagPillGroup.querySelectorAll('.v65-tag-pill').forEach(p => p.classList.remove('active'));
          pill.classList.add('active');
          currentActiveTag = pill.getAttribute('data-tag') || 'Urgente';
        });
      });

      function setTagPill(tag) {
        currentActiveTag = tag;
        tagPillGroup?.querySelectorAll('.v65-tag-pill').forEach(p => {
          p.classList.toggle('active', p.getAttribute('data-tag') === tag);
        });
      }

      function updateCounts() {
        const chars = notepadContent?.value?.length || 0;
        const words = (notepadContent?.value?.trim() || '').split(/\s+/).filter(Boolean).length;
        if (noteCharCount) noteCharCount.textContent = `${chars} caracteres`;
        if (noteWordCount) noteWordCount.textContent = `${words} palabras`;
      }

      notepadContent?.addEventListener('input', updateCounts);

      // Función que recorta a ~10 palabras + "..."
      function recortarDiezPalabras(str) {
        if (!str) return '';
        const palabras = str.trim().split(/\s+/);
        if (palabras.length <= 10) return str;
        return palabras.slice(0, 10).join(' ') + '...';
      }

      // Renderizar ambas vistas de notas
      function renderAllNotes() {
        // 1. Contador global
        if (notepadBadgeCount) notepadBadgeCount.textContent = `${notas.length} notas`;
        if (dashNotesCount) dashNotesCount.textContent = `${notas.length} Notas`;

        // 2. Renderizar lista compacta en módulo Notepad (30%)
        if (notepadCompactList) {
          if (notas.length === 0) {
            notepadCompactList.innerHTML = '<p style="color:var(--muted); font-size:var(--fz_s3); text-align:center; padding:16px;">Sin notas guardadas.</p>';
          } else {
            notepadCompactList.innerHTML = notas.map(n => {
              const resumen10 = recortarDiezPalabras(n.texto || n.titulo);
              const isActive = notepadCurrentId?.value === n.id;
              return `
                <div class="v65-note-summary-card ${isActive ? 'active' : ''}" data-note-id="${n.id}">
                  <div class="v65-note-summary-top">
                    <span class="v65-note-summary-tag ${n.tag === 'Urgente' ? 'v65-badge-warning' : 'v65-badge-blue'}">${n.tag}</span>
                    <span class="v65-note-summary-date">${n.fecha}</span>
                  </div>
                  <strong style="font-size:var(--fz_s4); color:var(--ink); line-height:1.3;">${n.titulo || 'Nota sin título'}</strong>
                  <p class="v65-note-summary-snippet ${n.done ? 'done' : ''}">${resumen10}</p>
                  <div class="v65-note-summary-bottom">
                    <button class="v65-btn v65-btn-secondary btn-toggle-done" style="padding:2px 8px; font-size:11px;" title="${n.done ? 'Marcar pendiente' : 'Marcar lista'}">
                      <i class="fa-solid ${n.done ? 'fa-rotate-left' : 'fa-check'}"></i> ${n.done ? 'Hecha' : 'Completar'}
                    </button>
                    <button class="v65-btn v65-btn-danger btn-delete-note" style="padding:2px 6px; font-size:11px;" title="Eliminar">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </div>
                </div>
              `;
            }).join('');
          }
        }

        // 3. Renderizar miniatura en Dashboard (últimas 3 notas)
        if (dashNotesList) {
          const ultimas = notas.slice(0, 3);
          if (ultimas.length === 0) {
            dashNotesList.innerHTML = '<p style="color:var(--muted); font-size:var(--fz_s4);">No tienes notas hoy. Puedes anotar arriba.</p>';
          } else {
            dashNotesList.innerHTML = ultimas.map(n => `
              <div class="v65-dash-note-item">
                <span class="v65-badge ${n.tag === 'Urgente' ? 'v65-badge-warning' : 'v65-badge-blue'}" style="font-size:10px;">${n.tag}</span>
                <span class="v65-dash-note-text ${n.done ? 'done' : ''}">${n.titulo || recortarDiezPalabras(n.texto)}</span>
                <button class="v65-btn v65-btn-secondary btn-dash-toggle" data-id="${n.id}" style="padding:2px 6px; font-size:11px;">
                  <i class="fa-solid ${n.done ? 'fa-rotate-left' : 'fa-check'}"></i>
                </button>
              </div>
            `).join('');
          }
        }

        // Vincular eventos de la lista compacta
        notepadCompactList?.querySelectorAll('.v65-note-summary-card').forEach(card => {
          card.addEventListener('click', (e) => {
            if (e.target.closest('.btn-toggle-done') || e.target.closest('.btn-delete-note')) return;
            const id = card.getAttribute('data-note-id');
            const targetNote = notas.find(item => item.id === id);
            if (targetNote) {
              loadNoteIntoEditor(targetNote);
            }
          });
        });

        notepadCompactList?.querySelectorAll('.btn-toggle-done').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const card = btn.closest('.v65-note-summary-card');
            const id = card?.getAttribute('data-note-id');
            const note = notas.find(item => item.id === id);
            if (note) {
              note.done = !note.done;
              saveNotesToStorage();
              renderAllNotes();
            }
          });
        });

        notepadCompactList?.querySelectorAll('.btn-delete-note').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const card = btn.closest('.v65-note-summary-card');
            const id = card?.getAttribute('data-note-id');
            notas = notas.filter(item => item.id !== id);
            if (notepadCurrentId?.value === id) {
              clearEditor();
            }
            saveNotesToStorage();
            renderAllNotes();
            if (window.Notificacion) window.Notificacion('Nota eliminada', 'warning', 2000);
          });
        });

        // Eventos del dashboard mini-list
        dashNotesList?.querySelectorAll('.btn-dash-toggle').forEach(btn => {
          btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const note = notas.find(item => item.id === id);
            if (note) {
              note.done = !note.done;
              saveNotesToStorage();
              renderAllNotes();
            }
          });
        });
      }

      function saveNotesToStorage() {
        localStorage.setItem(STORAGE_KEY_NOTES, JSON.stringify(notas));
      }

      function loadNoteIntoEditor(note) {
        if (!notepadTitle || !notepadContent) return;
        notepadCurrentId.value = note.id;
        notepadTitle.value = note.titulo || '';
        notepadContent.value = note.texto || '';
        setTagPill(note.tag || 'Urgente');
        if (noteEditorStatus) noteEditorStatus.textContent = `Editando nota de ${note.fecha}`;
        updateCounts();
        renderAllNotes();
      }

      function clearEditor() {
        if (!notepadTitle || !notepadContent) return;
        notepadCurrentId.value = '';
        notepadTitle.value = '';
        notepadContent.value = '';
        setTagPill('Urgente');
        if (noteEditorStatus) noteEditorStatus.textContent = 'Nueva nota en blanco';
        updateCounts();
        renderAllNotes();
      }

      btnClearNote?.addEventListener('click', clearEditor);
      btnNewNoteCanvas?.addEventListener('click', () => {
        clearEditor();
        notepadTitle?.focus();
      });

      // Guardar desde el editor amplio (70%)
      btnSaveNotepadFull?.addEventListener('click', () => {
        const titulo = notepadTitle?.value?.trim();
        const texto = notepadContent?.value?.trim();
        if (!texto && !titulo) {
          if (window.Notificacion) window.Notificacion('Escribe al menos un título o texto en la nota', 'warning', 2500);
          return;
        }

        const now = new Date();
        const fechaStr = `${now.getDate()} ${now.toLocaleString('es-ES', { month: 'short' })}, ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
        const existingId = notepadCurrentId?.value;

        if (existingId) {
          const idx = notas.findIndex(n => n.id === existingId);
          if (idx >= 0) {
            notas[idx].titulo = titulo || 'Nota';
            notas[idx].texto = texto;
            notas[idx].tag = currentActiveTag;
            notas[idx].fecha = fechaStr;
          }
        } else {
          notas.unshift({
            id: 'n_' + Date.now(),
            tag: currentActiveTag,
            titulo: titulo || 'Nota',
            texto: texto,
            fecha: fechaStr,
            done: false
          });
        }

        saveNotesToStorage();
        renderAllNotes();
        if (window.Notificacion) {
          window.Notificacion('Nota guardada correctamente en el bloc', 'success', 2500);
        }
      });

      // Guardar nota rápida desde el Dashboard
      formDashQuickNote?.addEventListener('submit', (e) => {
        e.preventDefault();
        const tag = document.getElementById('dashQuickNoteTag')?.value || 'Urgente';
        const texto = document.getElementById('dashQuickNoteText')?.value?.trim();
        if (!texto) return;

        const now = new Date();
        const fechaStr = `${now.getDate()} ${now.toLocaleString('es-ES', { month: 'short' })}, ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;

        notas.unshift({
          id: 'n_' + Date.now(),
          tag,
          titulo: texto.length > 35 ? texto.substring(0, 35) + '...' : texto,
          texto,
          fecha: fechaStr,
          done: false
        });

        saveNotesToStorage();
        renderAllNotes();
        formDashQuickNote.reset();

        if (window.Notificacion) {
          window.Notificacion('Apunte rápido registrado en Notepad', 'success', 2500);
        }
      });

      // Inicializar notas y cargar la primera en el editor si existe
      renderAllNotes();
      if (notas.length > 0) {
        loadNoteIntoEditor(notas[0]);
      }

      // 5. Copiar URL de Medios
      document.querySelectorAll('.btn-copy-url').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const url = btn.getAttribute('data-url');
          if (url && navigator.clipboard) {
            navigator.clipboard.writeText(window.location.origin + url);
            if (window.Notificacion) {
              window.Notificacion('Enlace directo copiado al portapapeles', 'success', 2500);
            }
          }
        });
      });

      // 6. Modal de Previsualización de Fotos
      const modalPreview = document.getElementById('modalImgPreview');
      const previewImg = document.getElementById('modalPreviewImg');
      const previewTitle = document.getElementById('modalPreviewTitle');
      const previewUrl = document.getElementById('modalPreviewUrl');
      const btnClosePreview = document.getElementById('btnClosePreview');
      const btnModalCopy = document.getElementById('btnModalCopyUrl');

      document.querySelectorAll('.v65-media-item').forEach(card => {
        card.addEventListener('click', () => {
          const url = card.getAttribute('data-media-url');
          const name = card.getAttribute('data-media-name');
          if (previewImg && url) previewImg.src = url;
          if (previewTitle) previewTitle.textContent = name || 'Foto';
          if (previewUrl) previewUrl.textContent = window.location.origin + url;
          if (modalPreview) modalPreview.classList.add('active');
        });
      });

      btnClosePreview?.addEventListener('click', () => {
        modalPreview?.classList.remove('active');
      });
      modalPreview?.addEventListener('click', (e) => {
        if (e.target === modalPreview) modalPreview.classList.remove('active');
      });

      btnModalCopy?.addEventListener('click', () => {
        if (previewUrl && navigator.clipboard) {
          navigator.clipboard.writeText(previewUrl.textContent);
          if (window.Notificacion) {
            window.Notificacion('URL de Cloudflare R2 copiada', 'success', 2000);
          }
          modalPreview?.classList.remove('active');
        }
      });

      // 7. Guardar Mi Negocio
      document.getElementById('btnSaveBusiness')?.addEventListener('click', () => {
        if (window.Notificacion) {
          window.Notificacion('Datos de Mi Negocio guardados con éxito', 'success', 3000);
        }
      });

      // 8. Eliminar Entrada con confirmación
      document.querySelectorAll('.btn-delete-post').forEach(btn => {
        btn.addEventListener('click', async () => {
          const title = btn.getAttribute('data-title') || 'esta entrada';
          if (window.wiConfirmar) {
            const conf = await window.wiConfirmar(`¿Deseas eliminar la entrada <strong>${title}</strong>?`, {
              tipo: 'danger',
              siTexto: 'Eliminar',
              noTexto: 'Cancelar'
            });
            if (conf && window.Notificacion) {
              window.Notificacion(`Entrada eliminada correctamente`, 'warning', 2500);
              btn.closest('tr')?.remove();
            }
          }
        });
      });

      // 9. Buscador Global
      const globalSearch = document.getElementById('v65GlobalSearch');
      globalSearch?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        if (!query) return;

        if (query.includes('nota') || query.includes('pad')) switchPanel('notepad');
        else if (query.includes('negocio')) switchPanel('business');
        else if (query.includes('prod') || query.includes('balon')) switchPanel('products');
        else if (query.includes('foto') || query.includes('gal')) switchPanel('gallery');
        else if (query.includes('blog') || query.includes('entrad')) switchPanel('posts');
        else if (query.includes('pag')) switchPanel('pages');
        else if (query.includes('ajuste') || query.includes('seo')) switchPanel('settings');
      });

    })();
  </script>

  <!-- Importador dinámico de Notificacion y wiConfirmar de widev.js -->
  <script type="module">
    import { Notificacion, wiConfirmar } from '../core/widev/widev.js';
    window.Notificacion = Notificacion;
    window.wiConfirmar = wiConfirmar;
  </script>
</body>
</html>
