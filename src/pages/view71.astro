---
// src/pages/view71.astro
// DEMO 3: Portal de Cliente con Sidebar - Enfoque Control de Recargas, Alerta Inteligente y Fidelización
import { avatar } from '../core/widev/nombre.js';
import witemaCss from '../core/wicss/witema.css?inline';

const cliente = {
  nombre: 'Valeria',
  nombreCompleto: 'Valeria Mendoza',
  nivelVIP: 'Cliente Platino · 14 Recargas',
  ultimoPedido: {
    codigo: 'PED-1042',
    fecha: '27 de Agosto (hace 26 días)',
    producto: 'Balón SOLGAS 10 kg',
    precioPEN: 65.00,
    direccion: 'Jr. Dante 260, Dpto 301, Surquillo',
    pesajeVerificado: '10.05 kg Neto en balanza Inacal',
    comprobante: 'Boleta B001-0004921'
  },
  estadisticas: {
    diasUso: 26,
    duracionPromedioDias: 28,
    diasRestantesEstimados: 2,
    porcentajeRestante: 7, // 7% restante
    gastoTotalPEN: 910.00
  },
  historial: [
    { id: 'PED-1042', fecha: '27 Ago', producto: 'Balón SOLGAS 10 kg', monto: 65.00, estado: 'Entregado', balanza: '10.05 kg' },
    { id: 'PED-0985', fecha: '30 Jul', producto: 'Balón SOLGAS 10 kg', monto: 65.00, estado: 'Entregado', balanza: '10.02 kg' },
    { id: 'PED-0920', fecha: '02 Jul', producto: 'Balón SOLGAS 10 kg', monto: 65.00, estado: 'Entregado', balanza: '10.08 kg' },
    { id: 'PED-0861', fecha: '04 Jun', producto: 'Balón SOLGAS 10 kg', monto: 65.00, estado: 'Entregado', balanza: '10.04 kg' }
  ]
};
---

<!doctype html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Control de Recargas & Fidelización · Solgas Surquillo | View 71</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('gaswii_theme_cliente') || localStorage.getItem('wiTema') || 'futuro';
      document.documentElement.dataset.theme = savedTheme;
      if (localStorage.getItem('gaswii_cliente_sidebar_v71') === 'true') {
        document.documentElement.classList.add('is-collapsed');
      }
    } catch (e) {}
  </script>

  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />
  <style is:global set:html={witemaCss}></style>

  <style>
    :root {
      --side-w: 240px;
      --side-collapsed-w: 68px;
      --topbar-h: 62px;
      --cl-orange: #ff6600;
      --cl-orange-hover: #ff771a;
      --cl-amber: #f59e0b;
      --cl-emerald: #10b981;
      --cl-wa: #25d366;
    }

    *, *::before, *::after { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: var(--fz_m);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* TOPBAR */
    .v71-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--topbar-h);
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      backdrop-filter: blur(14px);
    }

    .v71-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }

    .v71-brand-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1rem;
      font-weight: 800;
      color: var(--ink);
    }
    .v71-brand-title span { color: var(--cl-orange); }

    .v71-topbar-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .v71-icon-btn {
      background: var(--surface2, rgba(255,255,255,0.06));
      border: 1px solid var(--line);
      color: var(--ink);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      cursor: pointer;
    }

    .v71-user-card {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 14px 4px 6px;
      background: var(--surface2, rgba(255,255,255,0.04));
      border: 1px solid var(--line);
      border-radius: 30px;
    }

    .v71-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--cl-orange);
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 0.85rem;
    }

    /* SIDEBAR */
    .v71-sidebar {
      position: fixed;
      top: var(--topbar-h);
      left: 0;
      bottom: 0;
      width: var(--side-w);
      background: var(--surface);
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 16px 12px;
      z-index: 40;
      transition: width 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .v71-sidebar { width: var(--side-collapsed-w); }

    .v71-nav { display: flex; flex-direction: column; gap: 6px; }

    .v71-nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      border-radius: 10px;
      border: none;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.88rem;
      text-align: left;
      transition: all 0.18s;
      width: 100%;
    }

    .v71-nav-item i { font-size: 1.1rem; width: 22px; text-align: center; flex-shrink: 0; }

    .v71-nav-item:hover {
      background: var(--surface2, rgba(255,255,255,0.05));
      color: var(--ink);
    }

    .v71-nav-item.active {
      background: rgba(255, 102, 0, 0.12);
      color: var(--cl-orange);
      border: 1px solid rgba(255, 102, 0, 0.25);
    }

    html.is-collapsed .v71-nav-text,
    html.is-collapsed #lblCollapse71 { display: none; }

    .v71-sidebar-foot { border-top: 1px solid var(--line); padding-top: 12px; }

    .v71-btn-collapse {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 9px 12px;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--muted);
      cursor: pointer;
      font-size: 0.82rem;
      font-weight: 600;
    }

    /* MAIN */
    .v71-main {
      margin-top: var(--topbar-h);
      margin-left: var(--side-w);
      padding: 24px 28px;
      min-height: calc(100vh - var(--topbar-h));
      transition: margin-left 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .v71-main { margin-left: var(--side-collapsed-w); }

    /* WIDGET ALERTA INTELIGENTE */
    .v71-alert-card {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.12) 0%, rgba(255, 102, 0, 0.08) 100%), var(--surface);
      border: 1.5px solid rgba(245, 158, 11, 0.35);
      border-radius: 20px;
      padding: 24px;
      margin-bottom: 24px;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 20px;
      align-items: center;
    }

    @media (max-width: 860px) {
      .v71-alert-card { grid-template-columns: 1fr; }
    }

    .v71-alert-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--cl-amber);
      color: #000;
      font-weight: 800;
      font-size: 0.75rem;
      padding: 4px 10px;
      border-radius: 20px;
      margin-bottom: 10px;
      font-family: var(--ff_O, sans-serif);
      letter-spacing: 0.03em;
    }

    .v71-alert-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--ink);
      margin-bottom: 6px;
    }

    .v71-alert-desc {
      color: var(--muted);
      font-size: 0.88rem;
      line-height: 1.4;
      max-width: 600px;
    }

    /* BARRA DE PROGRESO DE CONSUMO */
    .v71-progress-box {
      margin-top: 14px;
      max-width: 500px;
    }

    .v71-progress-labels {
      display: flex;
      justify-content: space-between;
      font-size: 0.76rem;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .v71-progress-bar-bg {
      height: 10px;
      background: var(--surface2, rgba(255,255,255,0.1));
      border-radius: 5px;
      overflow: hidden;
    }

    .v71-progress-bar-fill {
      height: 100%;
      width: 93%; /* 26/28 días transcurridos */
      background: linear-gradient(90deg, #10b981 0%, #f59e0b 80%, #ef4444 100%);
      border-radius: 5px;
    }

    /* BOTÓN REPETIR 1-CLIC GIGANTE */
    .v71-btn-reorder {
      background: var(--cl-orange);
      color: #fff;
      border: none;
      border-radius: 14px;
      padding: 16px 26px;
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.05rem;
      font-weight: 800;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s;
      box-shadow: 0 6px 20px rgba(255, 102, 0, 0.3);
      white-space: nowrap;
    }
    .v71-btn-reorder:hover {
      background: var(--cl-orange-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(255, 102, 0, 0.4);
    }
    .v71-btn-reorder small {
      font-size: 0.72rem;
      font-weight: 500;
      opacity: 0.9;
    }

    /* STATS ROW */
    .v71-stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 24px;
    }

    @media (max-width: 900px) {
      .v71-stats-row { grid-template-columns: repeat(2, 1fr); }
    }

    .v71-stat-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 18px;
    }

    .v71-stat-num {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.5rem;
      font-weight: 800;
      color: var(--ink);
      margin-bottom: 2px;
    }

    .v71-stat-lbl {
      font-size: 0.76rem;
      color: var(--muted);
      font-weight: 600;
    }

    /* TABLA HISTORIAL */
    .v71-card-table {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 22px;
    }

    .v71-card-table h3 {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.15rem;
      font-weight: 800;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .v71-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }

    .v71-table th {
      padding: 10px 14px;
      font-size: 0.74rem;
      text-transform: uppercase;
      color: var(--muted);
      border-bottom: 1px solid var(--line);
      font-weight: 700;
    }

    .v71-table td {
      padding: 14px;
      font-size: 0.86rem;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
    }

    .v71-badge-status {
      background: rgba(16, 185, 129, 0.12);
      color: #10b981;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 0.74rem;
      font-weight: 700;
    }

    .v71-btn-repeat-row {
      background: transparent;
      border: 1px solid var(--line);
      color: var(--cl-orange);
      border-radius: 8px;
      padding: 6px 12px;
      font-size: 0.78rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }
    .v71-btn-repeat-row:hover {
      background: var(--cl-orange);
      color: #fff;
    }
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <header class="v71-topbar">
    <a href="/view71" class="v71-brand">
      <img src="/imgwii/logo.webp" alt="Solgas" style="height:32px;" />
      <div class="v71-brand-title">SOLGAS <span>SURQUILLO</span> · Mi Panel</div>
    </a>

    <div class="v71-topbar-right">
      <button class="v71-icon-btn" id="btnTheme71" title="Alternar tema">
        <i class="fa-solid fa-moon"></i>
      </button>

      <div class="v71-user-card">
        <div class="v71-avatar">{avatar(cliente.nombre)}</div>
        <div>
          <div style="font-size:0.85rem; font-weight:700;">{cliente.nombreCompleto}</div>
          <div style="font-size:0.68rem; color:#f59e0b; font-weight:600;">{cliente.nivelVIP}</div>
        </div>
      </div>
    </div>
  </header>

  <!-- SIDEBAR -->
  <aside class="v71-sidebar">
    <nav class="v71-nav">
      <button class="v71-nav-item" onclick="window.location.href='/view69'">
        <i class="fa-solid fa-bolt"></i>
        <span class="v71-nav-text">Pedido 1-Clic</span>
      </button>
      <button class="v71-nav-item" onclick="window.location.href='/view70'">
        <i class="fa-solid fa-map-location-dot"></i>
        <span class="v71-nav-text">Mis Direcciones</span>
      </button>
      <button class="v71-nav-item active">
        <i class="fa-solid fa-chart-pie"></i>
        <span class="v71-nav-text">Consumo & Fidelidad</span>
      </button>
      <button class="v71-nav-item">
        <i class="fa-solid fa-receipt"></i>
        <span class="v71-nav-text">Mis Comprobantes</span>
      </button>
    </nav>

    <div class="v71-sidebar-foot">
      <button class="v71-btn-collapse" id="btnCollapse71">
        <i class="fa-solid fa-arrow-left-long"></i>
        <span id="lblCollapse71">Colapsar</span>
      </button>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="v71-main">
    <!-- WIDGET ALERTA PREVENTIVA INTELIGENTE -->
    <div class="v71-alert-card">
      <div>
        <div class="v71-alert-tag">
          <i class="fa-solid fa-bell"></i> ALERTA PREVENTIVA DE RECARGA
        </div>
        <div class="v71-alert-title">
          Tu balón tiene 26 días de uso. ¡Te quedan aprox. 2 días de gas!
        </div>
        <div class="v71-alert-desc">
          Tu frecuencia de consumo promedio es de 28 días. Pide ahora para no quedarte sin gas a mitad de cocinar. Sede Jr. Dante 260 tiene unidades en Surquillo listas para entrega en 12–15 min.
        </div>

        <div class="v71-progress-box">
          <div class="v71-progress-labels">
            <span>Día 26 de 28 estimado</span>
            <span style="color:#ef4444; font-weight:800;">~7% de gas restante</span>
          </div>
          <div class="v71-progress-bar-bg">
            <div class="v71-progress-bar-fill"></div>
          </div>
        </div>
      </div>

      <!-- BOTÓN 1-CLIC GIGANTE -->
      <a 
        href={`https://wa.me/51936369384?text=${encodeURIComponent(`¡Hola Solgas Surquillo! Deseo REPETIR mi recarga habitual de Balón SOLGAS 10 kg a Jr. Dante 260, Dpto 301, Surquillo (S/ 65.00). Ref: Frente al parque.`)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="v71-btn-reorder"
      >
        <span><i class="fa-brands fa-whatsapp"></i> Repetir Pedido Habitual</span>
        <small>Balón SOLGAS 10 kg · S/ 65.00 en 1-Clic</small>
      </a>
    </div>

    <!-- FILA DE ESTADÍSTICAS -->
    <div class="v71-stats-row">
      <div class="v71-stat-card">
        <div class="v71-stat-num">14</div>
        <div class="v71-stat-lbl">Pedidos Totales Recibidos</div>
      </div>
      <div class="v71-stat-card">
        <div class="v71-stat-num" style="color:#10b981;">100%</div>
        <div class="v71-stat-lbl">Con Balanza Digital Inacal</div>
      </div>
      <div class="v71-stat-card">
        <div class="v71-stat-num">28 días</div>
        <div class="v71-stat-lbl">Duración Promedio de Balón</div>
      </div>
      <div class="v71-stat-card">
        <div class="v71-stat-num" style="color:var(--cl-orange);">S/ 910.00</div>
        <div class="v71-stat-lbl">Inversión Total en Solgas</div>
      </div>
    </div>

    <!-- HISTORIAL DE PEDIDOS -->
    <div class="v71-card-table">
      <h3><i class="fa-solid fa-clock-rotate-left" style="color:var(--cl-orange);"></i> Mis Compras Recientes</h3>

      <table class="v71-table">
        <thead>
          <tr>
            <th>Código</th>
            <th>Fecha</th>
            <th>Cilindro</th>
            <th>Total</th>
            <th>Pesaje Inacal</th>
            <th>Estado</th>
            <th>Acción</th>
          </tr>
        </thead>
        <tbody>
          {cliente.historial.map(p => (
            <tr>
              <td><strong>{p.id}</strong></td>
              <td style="color:var(--muted);">{p.fecha}</td>
              <td>{p.producto}</td>
              <td><strong>S/ {p.monto.toFixed(2)}</strong></td>
              <td><i class="fa-solid fa-scale-balanced" style="color:#10b981;"></i> {p.balanza}</td>
              <td><span class="v71-badge-status">{p.estado}</span></td>
              <td>
                <a 
                  href={`https://wa.me/51936369384?text=${encodeURIComponent(`Hola Solgas Surquillo, deseo reordenar el pedido ${p.id} (${p.producto})`)}`}
                  target="_blank"
                  class="v71-btn-repeat-row"
                >
                  Repetir
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>

  <script is:inline>
    (function() {
      // SIDEBAR COLLAPSE
      document.getElementById('btnCollapse71')?.addEventListener('click', () => {
        const isCollapsed = document.documentElement.classList.toggle('is-collapsed');
        localStorage.setItem('gaswii_cliente_sidebar_v71', isCollapsed ? 'true' : 'false');
      });

      // THEME TOGGLE
      document.getElementById('btnTheme71')?.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme;
        const next = cur === 'luz' ? 'futuro' : 'luz';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('gaswii_theme_cliente', next);
      });
    })();
  </script>
</body>
</html>
