---

<!doctype html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Portal Cliente VIP · Pedido 1-Clic | View 69</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Script Anti-FOUC y Persistencia de Tema/Sidebar -->
  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('gaswii_theme_cliente') || localStorage.getItem('wiTema') || 'futuro';
      document.documentElement.dataset.theme = savedTheme;
      if (localStorage.getItem('gaswii_cliente_sidebar_v69') === 'true') {
        document.documentElement.classList.add('is-collapsed');
      }
    } catch (e) {}
  </script>

  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />
  <style is:global set:html={witemaCss}></style>

  <style>
    /* Estilos base inspirados en feature/personal */
    :root {
      --side-w: 240px;
      --side-collapsed-w: 68px;
      --topbar-h: 62px;
      --cl-orange: #ff6600;
      --cl-orange-hover: #ff771a;
      --cl-wa: #25d366;
      --cl-wa-hover: #1ebd5b;
    }

    *, *::before, *::after { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: var(--fz_m);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* TOPBAR */
    .cl-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--topbar-h);
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      gap: 16px;
      backdrop-filter: blur(14px);
    }

    .cl-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }

    .cl-logo {
      height: 32px;
      width: auto;
      object-fit: contain;
    }

    .cl-brand-info {
      display: flex;
      flex-direction: column;
    }

    .cl-brand-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1rem;
      font-weight: 800;
      color: var(--ink);
      line-height: 1.15;
    }

    .cl-brand-title span { color: var(--cl-orange); }

    .cl-brand-sub {
      font-size: 0.72rem;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .cl-dot-live {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--cl-wa);
      box-shadow: 0 0 8px var(--cl-wa);
      display: inline-block;
    }

    .cl-topbar-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .cl-icon-btn {
      background: var(--surface2, rgba(255,255,255,0.06));
      border: 1px solid var(--line);
      color: var(--ink);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      cursor: pointer;
      font-size: 0.9rem;
      transition: all 0.2s;
    }
    .cl-icon-btn:hover {
      border-color: var(--cl-orange);
      color: var(--cl-orange);
    }

    .cl-user-badge {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 12px 4px 6px;
      background: var(--surface2, rgba(255,255,255,0.04));
      border: 1px solid var(--line);
      border-radius: 30px;
    }

    .cl-user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--cl-orange);
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 0.85rem;
    }

    .cl-user-meta {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }
    .cl-user-meta strong { font-size: 0.82rem; color: var(--ink); }
    .cl-user-meta small { font-size: 0.68rem; color: var(--muted); }

    /* SIDEBAR */
    .cl-sidebar {
      position: fixed;
      top: var(--topbar-h);
      left: 0;
      bottom: 0;
      width: var(--side-w);
      background: var(--surface);
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 16px 12px;
      z-index: 40;
      transition: width 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .cl-sidebar {
      width: var(--side-collapsed-w);
    }

    .cl-nav {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .cl-nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      border-radius: 10px;
      border: none;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.88rem;
      text-align: left;
      transition: all 0.18s;
      white-space: nowrap;
      overflow: hidden;
      width: 100%;
    }

    .cl-nav-item i {
      font-size: 1.1rem;
      width: 22px;
      text-align: center;
      flex-shrink: 0;
    }

    .cl-nav-item:hover {
      background: var(--surface2, rgba(255,255,255,0.05));
      color: var(--ink);
    }

    .cl-nav-item.active {
      background: rgba(255, 102, 0, 0.12);
      color: var(--cl-orange);
      border: 1px solid rgba(255, 102, 0, 0.25);
    }

    .cl-nav-badge {
      margin-left: auto;
      background: var(--surface2, rgba(255,255,255,0.1));
      color: var(--ink);
      font-size: 0.7rem;
      padding: 2px 7px;
      border-radius: 12px;
      font-family: var(--ff_O, sans-serif);
      font-weight: 700;
    }

    html.is-collapsed .cl-nav-text,
    html.is-collapsed .cl-nav-badge,
    html.is-collapsed #labelCollapse {
      display: none;
    }

    .cl-sidebar-footer {
      border-top: 1px solid var(--line);
      padding-top: 12px;
    }

    .cl-btn-collapse {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 9px 12px;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--muted);
      cursor: pointer;
      font-size: 0.82rem;
      font-weight: 600;
      transition: all 0.2s;
    }
    .cl-btn-collapse:hover {
      color: var(--ink);
      border-color: var(--muted);
    }

    /* MAIN SHELL */
    .cl-main {
      margin-top: var(--topbar-h);
      margin-left: var(--side-w);
      padding: 24px 28px;
      min-height: calc(100vh - var(--topbar-h));
      transition: margin-left 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .cl-main {
      margin-left: var(--side-collapsed-w);
    }

    /* HEADER BANNER */
    .cl-header-banner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 18px 24px;
    }

    .cl-header-banner h1 {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--ink);
      margin-bottom: 4px;
    }

    .cl-header-banner p {
      color: var(--muted);
      font-size: 0.85rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .cl-pill-garantia {
      background: rgba(16, 185, 129, 0.12);
      color: #10b981;
      border: 1px solid rgba(16, 185, 129, 0.25);
      border-radius: 20px;
      padding: 4px 12px;
      font-size: 0.78rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* GRID CONTENIDO (60% FORM / 40% WHATSAPP PREVIEW) */
    .cl-grid-express {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 24px;
      align-items: start;
    }

    @media (max-width: 1080px) {
      .cl-grid-express { grid-template-columns: 1fr; }
    }

    /* TARJETAS SECCIÓN */
    .cl-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 20px;
    }

    .cl-card-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--ink);
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
    }

    .cl-card-title i { color: var(--cl-orange); font-size: 1.1rem; }

    /* PRODUCTOS GRID */
    .cl-prods-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    @media (max-width: 640px) {
      .cl-prods-grid { grid-template-columns: 1fr; }
    }

    .cl-prod-card {
      background: var(--surface2, rgba(255,255,255,0.03));
      border: 1.5px solid var(--line);
      border-radius: 14px;
      padding: 14px;
      cursor: pointer;
      position: relative;
      transition: all 0.2s;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .cl-prod-card:hover {
      border-color: rgba(255, 102, 0, 0.4);
      transform: translateY(-2px);
    }

    .cl-prod-card.active {
      border-color: var(--cl-orange);
      background: rgba(255, 102, 0, 0.05);
      box-shadow: 0 4px 20px rgba(255, 102, 0, 0.15);
    }

    .cl-prod-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 0.68rem;
      font-weight: 700;
      font-family: var(--ff_O, sans-serif);
    }
    .badge-fire { background: rgba(255, 102, 0, 0.2); color: #ff771a; }
    .badge-blue { background: rgba(2, 132, 199, 0.2); color: #38bdf8; }
    .badge-emerald { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .badge-gold { background: rgba(234, 179, 8, 0.2); color: #facc15; }

    .cl-prod-img {
      width: 70px;
      height: 70px;
      object-fit: contain;
      margin: 8px auto 12px;
      display: block;
    }

    .cl-prod-name {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--ink);
      margin-bottom: 4px;
    }

    .cl-prod-price {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--cl-orange);
      margin-bottom: 10px;
    }

    .cl-checks-box {
      border-top: 1px dashed var(--line);
      padding-top: 8px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .cl-check-row {
      font-size: 0.72rem;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .cl-check-row i { color: #10b981; font-size: 0.68rem; }

    /* DIRECCIÓN Y PAGOS */
    .cl-address-select {
      width: 100%;
      padding: 12px 14px;
      border-radius: 10px;
      background: var(--surface2, rgba(255,255,255,0.05));
      border: 1px solid var(--line);
      color: var(--ink);
      font-weight: 600;
      font-size: 0.88rem;
      outline: none;
      cursor: pointer;
    }
    .cl-address-select:focus { border-color: var(--cl-orange); }

    .cl-chips-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 10px;
    }

    .cl-chip {
      background: var(--surface2, rgba(255,255,255,0.05));
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 6px 14px;
      color: var(--ink);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }
    .cl-chip:hover { border-color: var(--cl-orange); }
    .cl-chip.active {
      background: var(--cl-orange);
      color: #fff;
      border-color: var(--cl-orange);
    }

    .cl-textarea {
      width: 100%;
      padding: 10px 12px;
      border-radius: 10px;
      background: var(--surface2, rgba(255,255,255,0.04));
      border: 1px solid var(--line);
      color: var(--ink);
      font-size: 0.84rem;
      resize: vertical;
      min-height: 60px;
      outline: none;
      margin-top: 8px;
    }
    .cl-textarea:focus { border-color: var(--cl-orange); }

    /* WHATSAPP MOCKUP COLUMN */
    .cl-wa-mockup {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.15);
      position: sticky;
      top: calc(var(--topbar-h) + 20px);
    }

    .cl-wa-top {
      background: #008069;
      color: #fff;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .cl-wa-avatar {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: #fff;
      object-fit: contain;
      padding: 4px;
    }

    .cl-wa-top-meta strong { font-size: 0.92rem; display: block; line-height: 1.2; }
    .cl-wa-top-meta small { font-size: 0.72rem; opacity: 0.85; }

    .cl-wa-body {
      background: #efeae2;
      padding: 18px 14px;
      min-height: 280px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    html[data-theme="futuro"] .cl-wa-body {
      background: #0b141a;
    }

    .cl-bubble-incoming {
      background: #fff;
      color: #111b21;
      border-radius: 10px 10px 10px 2px;
      padding: 10px 12px;
      font-size: 0.82rem;
      max-width: 85%;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
      line-height: 1.4;
    }
    html[data-theme="futuro"] .cl-bubble-incoming {
      background: #202c33;
      color: #e9edef;
    }

    .cl-bubble-outgoing {
      background: #d9fdd3;
      color: #111b21;
      border-radius: 10px 10px 2px 10px;
      padding: 12px 14px;
      font-size: 0.84rem;
      max-width: 90%;
      margin-left: auto;
      box-shadow: 0 1px 2px rgba(0,0,0,0.1);
      white-space: pre-line;
      line-height: 1.45;
    }
    html[data-theme="futuro"] .cl-bubble-outgoing {
      background: #005c4b;
      color: #e9edef;
    }

    .cl-wa-time {
      font-size: 0.65rem;
      opacity: 0.65;
      text-align: right;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 4px;
      margin-top: 4px;
    }

    .cl-wa-action-box {
      padding: 16px;
      background: var(--surface);
      border-top: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .cl-btn-wa-cta {
      background: var(--cl-wa);
      color: #fff;
      border: none;
      border-radius: 12px;
      padding: 14px 20px;
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.05rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
    }
    .cl-btn-wa-cta:hover {
      background: var(--cl-wa-hover);
      transform: translateY(-2px);
    }

    .cl-btn-call-sub {
      background: transparent;
      border: 1px solid var(--line);
      color: var(--ink);
      border-radius: 10px;
      padding: 10px;
      font-size: 0.84rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      transition: all 0.2s;
    }
    .cl-btn-call-sub:hover { border-color: var(--cl-orange); color: var(--cl-orange); }

    /* TOAST */
    #clToast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--ink);
      color: var(--bg);
      padding: 10px 18px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.85rem;
      display: none;
      z-index: 100;
      box-shadow: 0 6px 20px rgba(0,0,0,0.3);
    }
  </style>
</head>
<body>

  <!-- TOPBAR -->
  <header class="cl-topbar">
    <a href="/view69" class="cl-brand">
      <img src="/imgwii/logo.webp" alt="Solgas" class="cl-logo" />
      <div class="cl-brand-info">
        <span class="cl-brand-title">SOLGAS <span>SURQUILLO</span></span>
        <span class="cl-brand-sub">
          <span class="cl-dot-live"></span> Jr. Dante 260 · Despacho Activo
        </span>
      </div>
    </a>

    <div class="cl-topbar-actions">
      <!-- Selector de Tema -->
      <button class="cl-icon-btn" id="btnTheme" title="Alternar tema luz/futuro">
        <i class="fa-solid fa-moon" id="iconTheme"></i>
      </button>

      <!-- Selector de Idioma -->
      <button class="cl-icon-btn" id="btnLang" title="Idioma ES / EN">
        <strong>ES</strong>
      </button>

      <!-- Badge de Usuario Cliente -->
      <div class="cl-user-badge">
        <div class="cl-user-avatar">{avatar(cliente.nombre)}</div>
        <div class="cl-user-meta">
          <strong>{cliente.nombreCompleto}</strong>
          <small>Cliente VIP · Jr. Dante 260</small>
        </div>
      </div>
    </div>
  </header>

  <!-- SIDEBAR DEL CLIENTE (INSPIRADO EN PERSONAL) -->
  <aside class="cl-sidebar" id="sidebarMenu">
    <nav class="cl-nav">
      <button class="cl-nav-item active" data-tab="pedido">
        <i class="fa-solid fa-bolt"></i>
        <span class="cl-nav-text">Pedido 1-Clic</span>
      </button>
      <button class="cl-nav-item" data-tab="direcciones">
        <i class="fa-solid fa-map-location-dot"></i>
        <span class="cl-nav-text">Mis Direcciones</span>
        <span class="cl-nav-badge">{cliente.direcciones.length}</span>
      </button>
      <button class="cl-nav-item" data-tab="comprobantes">
        <i class="fa-solid fa-file-invoice-dollar"></i>
        <span class="cl-nav-text">Facturación / RUC</span>
      </button>
      <button class="cl-nav-item" data-tab="historial">
        <i class="fa-solid fa-clock-rotate-left"></i>
        <span class="cl-nav-text">Historial de Gas</span>
      </button>
      <button class="cl-nav-item" data-tab="contacto">
        <i class="fa-solid fa-headset"></i>
        <span class="cl-nav-text">Atención Directa</span>
      </button>
    </nav>

    <div class="cl-sidebar-footer">
      <button class="cl-btn-collapse" id="btnCollapse">
        <i class="fa-solid fa-arrow-left-long" id="iconCollapse"></i>
        <span id="labelCollapse">Colapsar menú</span>
      </button>
    </div>
  </aside>

  <!-- SHELL PRINCIPAL -->
  <main class="cl-main">
    <!-- BANNER SALUDO Y GARANTÍA -->
    <div class="cl-header-banner">
      <div>
        <h1>¡Hola {cliente.nombre}! 👋</h1>
        <p>Selecciona tu balón y confirma tu entrega con un solo clic. Balanza digital Inacal en tu puerta.</p>
      </div>
      <div class="cl-pill-garantia">
        <i class="fa-solid fa-shield-check"></i> Pesaje digital verificado
      </div>
    </div>

    <!-- GRID EXPRESS (CATÁLOGO + WHATSAPP LIVE) -->
    <div class="cl-grid-express">
      <!-- COLUMNA IZQUIERDA: CONFIGURAR PEDIDO -->
      <div>
        <!-- SECCIÓN 1: PRODUCTOS -->
        <section class="cl-card">
          <div class="cl-card-title">
            <i class="fa-solid fa-fire-flame-curved"></i>
            <span>1. Elige tu cilindro oficial</span>
          </div>

          <div class="cl-prods-grid">
            {productos.map((prod, idx) => (
              <div 
                class={`cl-prod-card ${idx === 0 ? 'active' : ''}`}
                data-id={prod.id}
                data-nombre={prod.nombre}
                data-precio={prod.precioPEN}
              >
                <span class={`cl-prod-badge ${prod.tagClase}`}>{prod.badge}</span>
                <img src={prod.imagen} alt={prod.nombre} class="cl-prod-img" />
                <div class="cl-prod-name">{prod.nombre}</div>
                <div class="cl-prod-price">S/ {prod.precioPEN.toFixed(2)}</div>
                <div class="cl-checks-box">
                  {prod.checks.map(c => (
                    <div class="cl-check-row">
                      <i class="fa-solid fa-check"></i>
                      <span><strong>{c.label}:</strong> {c.valor}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- SECCIÓN 2: DESTINO DE ENTREGA -->
        <section class="cl-card">
          <div class="cl-card-title">
            <i class="fa-solid fa-location-dot"></i>
            <span>2. Dirección de entrega</span>
          </div>

          <select class="cl-address-select" id="selectAddress">
            {cliente.direcciones.map(d => (
              <option 
                value={d.id} 
                data-calle={d.calle} 
                data-distrito={d.distrito} 
                data-ref={d.referencia}
                data-eta={d.eta}
                selected={d.esPrincipal}
              >
                {d.alias} · {d.calle}, {d.distrito} ({d.eta})
              </option>
            ))}
          </select>
        </section>

        <!-- SECCIÓN 3: PAGO Y NOTAS -->
        <section class="cl-card">
          <div class="cl-card-title">
            <i class="fa-solid fa-wallet"></i>
            <span>3. Medio de pago & Vuelto</span>
          </div>

          <div style="font-size:0.84rem; font-weight:600; color:var(--muted); margin-bottom:6px;">¿Cómo pagarás al repartidor?</div>
          <div class="cl-chips-row" id="chipsPago">
            <button type="button" class="cl-chip active" data-pago="Efectivo (Vuelto de S/ 100)">Efectivo (Vuelto S/ 100)</button>
            <button type="button" class="cl-chip" data-pago="Efectivo (Monto Exacto)">Efectivo Exacto</button>
            <button type="button" class="cl-chip" data-pago="Yape / Plin (Contraentrega)">Yape / Plin</button>
            <button type="button" class="cl-chip" data-pago="Tarjeta POS en puerta">Tarjeta POS</button>
          </div>

          <div style="font-size:0.84rem; font-weight:600; color:var(--muted); margin: 16px 0 6px;">Instrucciones para el motorizado:</div>
          <div class="cl-chips-row" id="quickNotes">
            <button type="button" class="cl-chip" data-note="🏢 Dejar con vigilancia">🏢 Dejar en vigilancia</button>
            <button type="button" class="cl-chip" data-note="🚪 Piso 3, timbre no suena fuerte">🚪 Piso 3</button>
            <button type="button" class="cl-chip" data-note="📞 Llamar al llegar al portón">📞 Llamar al llegar</button>
          </div>
          <textarea class="cl-textarea" id="textNotes" placeholder="Escribe alguna referencia adicional...">{cliente.notas}</textarea>
        </section>
      </div>

      <!-- COLUMNA DERECHA: MOCKUP WHATSAPP EN VIVO -->
      <aside>
        <div class="cl-wa-mockup">
          <div class="cl-wa-top">
            <img src="/imgwii/logo.webp" alt="Solgas" class="cl-wa-avatar" />
            <div class="cl-wa-top-meta">
              <strong>Solgas Surquillo Oficial</strong>
              <small>en línea · Despachos desde Jr. Dante 260</small>
            </div>
          </div>

          <div class="cl-wa-body">
            <div class="cl-bubble-incoming">
              ¡Hola {cliente.nombre}! 👋 Tenemos motorizados listos con balanza Inacal calibrada en tu zona.
              <div class="cl-wa-time">10:30 a. m.</div>
            </div>

            <div class="cl-bubble-outgoing" id="waBubbleMsg">
¡Hola Solgas Surquillo! Deseo pedir mi recarga con mis datos guardados:

👤 Nombre: {cliente.nombre}
📦 Producto: Balón SOLGAS 10 kg (S/ 65.00)
📍 Entrega: Jr. Dante 260, Dpto 301, Surquillo
🧭 Ref: Frente al parque, portón marrón
💳 Pago: Efectivo (Vuelto de S/ 100)
📝 Nota: {cliente.notas}
⏱️ Llegada estimada: 12–15 min
              <div class="cl-wa-time">
                <span id="waLiveClock">10:32 a. m.</span>
                <i class="fa-solid fa-check-double" style="color:#53bdeb;"></i>
              </div>
            </div>
          </div>

          <div class="cl-wa-action-box">
            <a href="https://wa.me/51936369384" target="_blank" rel="noopener noreferrer" class="cl-btn-wa-cta" id="btnWaCta">
              <i class="fa-brands fa-whatsapp"></i>
              <span id="labelWaCta">Pedir por WhatsApp (S/ 65.00)</span>
            </a>
            <a href="tel:936369384" class="cl-btn-call-sub">
              <i class="fa-solid fa-phone"></i>
              <span>O llamar a central telefónica: 936 369 384</span>
            </a>
          </div>
        </div>
      </aside>
    </div>
  </main>

  <div id="clToast">Mensaje actualizado</div>

  <!-- CONTROLADOR INTERACTIVO REACTIVO (0ms) -->
  <script is:inline>
    (function() {
      // Estado reactivo de la demo
      const state = {
        nombre: 'Valeria',
        producto: 'Balón SOLGAS 10 kg',
        precio: 65.00,
        calle: 'Jr. Dante 260, Dpto 301',
        distrito: 'Surquillo',
        ref: 'Frente al parque, portón marrón',
        eta: '12–15 min',
        pago: 'Efectivo (Vuelto de S/ 100)',
        nota: 'Piso 3, timbre no suena fuerte. Dejar con vigilancia si no contesto.'
      };

      const waBubble = document.getElementById('waBubbleMsg');
      const btnWaCta = document.getElementById('btnWaCta');
      const labelWaCta = document.getElementById('labelWaCta');
      const toast = document.getElementById('clToast');

      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.style.display = 'block';
        clearTimeout(window._tId);
        window._tId = setTimeout(() => { toast.style.display = 'none'; }, 1800);
      }

      function updateWA() {
        const text = 
`¡Hola Solgas Surquillo! Deseo pedir mi recarga con mis datos guardados:

👤 Nombre: ${state.nombre}
📦 Producto: ${state.producto} (S/ ${state.precio.toFixed(2)})
📍 Entrega: ${state.calle}, ${state.distrito}
🧭 Ref: ${state.ref}
💳 Pago: ${state.pago}
📝 Nota: ${state.nota}
⏱️ Llegada estimada: ${state.eta}`;

        if (waBubble) {
          waBubble.innerHTML = text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>') +
            `<div class="cl-wa-time"><span>10:32 a. m.</span> <i class="fa-solid fa-check-double" style="color:#53bdeb;"></i></div>`;
        }

        if (labelWaCta) {
          labelWaCta.textContent = `Pedir por WhatsApp (S/ ${state.precio.toFixed(2)})`;
        }

        if (btnWaCta) {
          btnWaCta.href = `https://wa.me/51936369384?text=${encodeURIComponent(text)}`;
        }
      }

      // SELECCIÓN DE PRODUCTOS
      document.querySelectorAll('.cl-prod-card').forEach(card => {
        card.addEventListener('click', () => {
          document.querySelectorAll('.cl-prod-card').forEach(c => c.classList.remove('active'));
          card.classList.add('active');
          state.producto = card.dataset.nombre;
          state.precio = parseFloat(card.dataset.precio);
          updateWA();
          showToast(`Seleccionado: ${state.producto}`);
        });
      });

      // SELECCIÓN DE DIRECCIÓN
      const selAddr = document.getElementById('selectAddress');
      if (selAddr) {
        selAddr.addEventListener('change', () => {
          const opt = selAddr.options[selAddr.selectedIndex];
          state.calle = opt.dataset.calle;
          state.distrito = opt.dataset.distrito;
          state.ref = opt.dataset.ref;
          state.eta = opt.dataset.eta;
          updateWA();
          showToast(`Destino: ${state.distrito} (${state.eta})`);
        });
      }

      // CHIPS DE PAGO
      document.querySelectorAll('#chipsPago .cl-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          document.querySelectorAll('#chipsPago .cl-chip').forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          state.pago = chip.dataset.pago;
          updateWA();
          showToast(`Pago: ${state.pago}`);
        });
      });

      // NOTAS RÁPIDAS
      const notesEl = document.getElementById('textNotes');
      document.querySelectorAll('#quickNotes .cl-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          const noteText = chip.dataset.note;
          if (notesEl) {
            notesEl.value = noteText;
            state.nota = noteText;
            updateWA();
            showToast('Nota aplicada');
          }
        });
      });

      if (notesEl) {
        notesEl.addEventListener('input', () => {
          state.nota = notesEl.value.trim();
          updateWA();
        });
      }

      // COLAPSAR SIDEBAR
      const btnCollapse = document.getElementById('btnCollapse');
      btnCollapse?.addEventListener('click', () => {
        const isCollapsed = document.documentElement.classList.toggle('is-collapsed');
        localStorage.setItem('gaswii_cliente_sidebar_v69', isCollapsed ? 'true' : 'false');
      });

      // CAMBIAR TEMA
      const btnTheme = document.getElementById('btnTheme');
      btnTheme?.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme;
        const next = cur === 'luz' ? 'futuro' : 'luz';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('gaswii_theme_cliente', next);
      });

      // INICIALIZACIÓN
      updateWA();
    })();
  </script>
</body>
</html>
