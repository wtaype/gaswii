        <button class="v51-icon-btn-round" id="btnNotifications" title="Notificaciones de Pedidos" onclick="showToast('🔔 3 pedidos pendientes de entrega en Surquillo')">
          <i class="fa-regular fa-bell"></i>
          <span class="v51-notif-dot"></span>
        </button>

        <!-- Modo Oscuro / Claro -->
        <button class="v51-icon-btn-round" id="btnToggleTheme" title="Alternar Modo Oscuro/Claro">
