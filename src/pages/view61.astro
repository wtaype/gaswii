<dialog id="editorDialog" class="modal wide"><div class="modal-head"><div><p id="editorEyebrow" class="eyebrow">LOS DETALLES IMPORTAN</p><h2 id="editorTitle">Editar</h2></div><button class="icon-btn" data-close="editorDialog" aria-label="Cerrar editor">✕</button></div><form id="editorForm"><div class="modal-body" id="editorFields"></div><p class="editor-error error" id="editorError" role="alert" hidden></p><div class="modal-actions"><button type="button" class="btn secondary" data-close="editorDialog">Cancelar</button><button type="submit" id="editorSubmit" class="btn primary">Guardar cambios</button></div></form></dialog>
