<dialog id="confirmDialog" class="modal"><div class="modal-head"><h2 id="confirmTitle">Confirmar</h2><button class="icon-btn" data-close="confirmDialog" aria-label="Cerrar confirmación">✕</button></div><div class="modal-body"><p id="confirmText" class="subheading"></p></div><div class="modal-actions"><button class="btn secondary" data-close="confirmDialog">Cancelar</button><button class="btn primary" id="confirmAction">Continuar</button></div></dialog>
