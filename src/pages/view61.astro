});
beforePage=id=>{
 const dirty=currentPage==='business'&&businessDirty||currentPage==='profile'&&profileDirty;if(dirty&&id!==currentPage){const page=currentPage;ask('¿Salir sin guardar?','Hay cambios pendientes en '+(page==='business'?'Mi negocio':'tu perfil')+'. Puedes volver para guardarlos.',()=>{if(page==='business')loadBusiness();else loadProfile();showPage(id)});return false}return true;
};
function closeEditorSafely(){if(editorDirty)ask('¿Descartar estos cambios?','La ficha todavía no se ha guardado.',()=>{editorDirty=false;$('editorDialog').close()});else $('editorDialog').close()}
document.addEventListener('click',e=>{if(e.target.closest('[data-close="editorDialog"]')){e.preventDefault();e.stopImmediatePropagation();closeEditorSafely()}},true);
$('editorDialog').addEventListener('cancel',e=>{if(editorDirty){e.preventDefault();closeEditorSafely()}});
$('editorDialog').addEventListener('click',e=>{if(e.target!==$('editorDialog'))return;const r=e.target.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom){e.stopImmediatePropagation();closeEditorSafely()}},true);
$('editorDialog').addEventListener('close',()=>{editorDirty=false});
window.addEventListener('beforeunload',e=>{if(businessDirty||profileDirty||editorDirty){e.preventDefault();e.returnValue=''}});
document.querySelectorAll('[data-reset]').forEach(b=>b.addEventListener('click',()=>ask('¿Restablecer la demostración?','Se borrarán los cambios de esta preview en este navegador: catálogo, equipo, negocio y operaciones.',()=>{businessDirty=profileDirty=editorDirty=false;try{localStorage.removeItem(PAGE_KEY)}catch{}location.reload()})));
loadBusiness();loadProfile();refresh();
})();</script></body></html>
