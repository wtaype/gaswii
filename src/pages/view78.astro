---
// src/pages/view78.astro
// VIEW 78: Horizontal Cards + Top Floating Live Message Editor Bar
// Header completo y realista · Edición de mensaje en barra superior con chips en tiempo real
// Ajuste 100vh en Desktop · Mobile Dock Nativo · 100% Español · Cero build pesado
import { avatar } from '../core/widev/nombre.js';
import witemaCss from '../core/wicss/witema.css?inline';

const cliente = {
  nombre: 'Valeria',
  apellido: 'Mendoza',
  nombreCompleto: 'Valeria Mendoza',
  usuario: 'valeria.m',
  telefono: '+51 987 654 321',
  email: 'valeria.mendoza@gmail.com',
  dni: '74829103',
  tipoComprobante: 'boleta',
  direcciones: [
    { id: 'dir-1', alias: 'Casa Principal', calle: 'Jr. Dante 260, Dpto 301', distrito: 'Surquillo', eta: '12–15 min', esPrincipal: true },
    { id: 'dir-2', alias: 'Oficina / Estudio', calle: 'Av. República de Panamá 3565', distrito: 'San Isidro', eta: '18–25 min', esPrincipal: false }
  ]
};

const productos = [
  {
    id: 'bal-n-solgas-premium-10-kg',
    nombre: 'Balón SOLGAS Premium 10 kg',
    nombreCorto: 'Solgas 10 kg',
    badge: 'MÁS PEDIDO',
    tagClase: 'badge-fire',
    precioPEN: 65.00,
    imagen: '/imgwii/productos/BALON-10KG.webp',
    valvula: 'Click-On o Rosca estándar',
    balanza: 'Balanza digital Inacal en puerta'
  },
  {
    id: 'balon-solgas-45-kg',
    nombre: 'Balón SOLGAS 45 kg',
    nombreCorto: 'Solgas 45 kg',
    badge: 'COMERCIAL',
    tagClase: 'badge-blue',
    precioPEN: 230.00,
    imagen: '/imgwii/productos/BALON-45KG.webp',
    valvula: 'Rosca industrial alta presión',
    balanza: 'Caudal continuo para negocios'
  },
  {
    id: 'balon-masgas-de-10-kg',
    nombre: 'Balón MASGAS de 10 kg',
    nombreCorto: 'Masgas 10 kg',
    badge: 'ECONÓMICO',
    tagClase: 'badge-emerald',
    precioPEN: 55.00,
    imagen: '/imgwii/productos/MASGAS-10KG.webp',
    valvula: 'Universal estándar para hogar',
    balanza: 'Rendimiento diario garantizado'
  },
  {
    id: 'kit-regulador-solgas',
    nombre: 'Kit Regulador SOLGAS',
    nombreCorto: 'Regulador Solgas',
    badge: 'SEGURIDAD',
    tagClase: 'badge-gold',
    precioPEN: 70.00,
    imagen: '/imgwii/productos/REGULADOR.webp',
    valvula: 'Click-On traba antifugas',
    balanza: 'Homologado por Osinergmin'
  }
];
---

<!doctype html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Portal de Cliente · Solgas Surquillo | View 78</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('gaswii_theme_cliente') || localStorage.getItem('wiTema') || 'futuro';
      document.documentElement.dataset.theme = savedTheme;
      if (localStorage.getItem('gaswii_sidebar_v78') === 'true') {
        document.documentElement.classList.add('is-collapsed');
      }
    } catch (e) {}
  </script>

  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />
  <style is:global set:html={witemaCss}></style>

  <style>
    :root {
      --side-w: 230px;
      --side-collapsed-w: 68px;
      --topbar-h: clamp(54px, 6.8vh, 62px);
      --cl-orange: #ff6600;
      --cl-orange-hover: #ff771a;
      --cl-wa: #25d366;
      --cl-wa-hover: #1ebd5b;
      --cl-blue: #0284c7;
      --cl-emerald: #10b981;
      --cl-card-bg: #0d1424;
      --cl-card-border: rgba(255, 255, 255, 0.08);
      --cl-input-bg: #070c18;
    }

    html[data-theme="luz"] {
      --cl-card-bg: #ffffff;
      --cl-card-border: #e2e8f0;
      --cl-input-bg: #f8fafc;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      height: 100vh;
      overflow: hidden;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: var(--fz_m);
      line-height: 1.4;
      -webkit-font-smoothing: antialiased;
    }

    @media (max-width: 960px) {
      html, body {
        height: auto;
        overflow-y: auto;
        padding-bottom: 75px;
      }
    }

    /* ============================================================
       1. HEADER COMPLETO Y REALISTA (ESTILO PROFESIONAL)
       ============================================================ */
    .v78-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--topbar-h);
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      z-index: 60;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.8vw;
      backdrop-filter: blur(14px);
    }

    .v78-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }

    .v78-logo {
      height: clamp(30px, 4.2vh, 36px);
      width: auto;
      object-fit: contain;
    }

    .v78-brand-info {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .v78-brand-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: clamp(0.92rem, 1.15vw, 1.08rem);
      font-weight: 800;
      color: var(--ink);
      line-height: 1.15;
    }

    .v78-brand-title span { color: var(--cl-orange); }

    .v78-brand-sub {
      font-size: clamp(0.66rem, 0.72vw, 0.75rem);
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .v78-live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--cl-emerald);
      box-shadow: 0 0 8px var(--cl-emerald);
    }

    .v78-topbar-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .v78-btn-tienda {
      background: rgba(255, 102, 0, 0.1);
      border: 1px solid rgba(255, 102, 0, 0.25);
      color: var(--cl-orange);
      padding: 5px 12px;
      border-radius: 8px;
      font-size: 0.78rem;
      font-weight: 700;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.16s;
    }
    .v78-btn-tienda:hover { background: var(--cl-orange); color: #fff; }

    .v78-btn-icon {
      background: var(--surface2, rgba(255,255,255,0.05));
      border: 1px solid var(--line);
      color: var(--ink);
      width: clamp(32px, 4vh, 36px);
      height: clamp(32px, 4vh, 36px);
      border-radius: 8px;
      display: grid;
      place-items: center;
      cursor: pointer;
      font-size: 0.84rem;
      transition: all 0.18s;
    }
    .v78-btn-icon:hover { border-color: var(--cl-orange); color: var(--cl-orange); }

    .v78-user-chip {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 4px 12px 4px 5px;
      background: var(--surface2, rgba(255,255,255,0.04));
      border: 1px solid var(--line);
      border-radius: 20px;
    }

    .v78-avatar-sm {
      width: clamp(26px, 3.4vh, 30px);
      height: clamp(26px, 3.4vh, 30px);
      border-radius: 50%;
      background: var(--cl-orange);
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 0.78rem;
    }

    .v78-user-meta {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }
    .v78-user-name { font-size: 0.8rem; font-weight: 700; color: var(--ink); }
    .v78-user-badge { font-size: 0.65rem; color: #f59e0b; font-weight: 700; }

    /* ============================================================
       2. SIDEBAR DEL CLIENTE
       ============================================================ */
    .v78-sidebar {
      position: fixed;
      top: var(--topbar-h);
      left: 0;
      bottom: 0;
      width: var(--side-w);
      background: var(--surface);
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 1.4vh 0.8vw;
      z-index: 50;
      transition: width 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .v78-sidebar { width: var(--side-collapsed-w); }

    @media (max-width: 960px) {
      .v78-sidebar { display: none; }
    }

    .v78-nav { display: flex; flex-direction: column; gap: 0.6vh; }

    .v78-nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: clamp(8px, 1.2vh, 11px) 12px;
      border-radius: 8px;
      border: none;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-weight: 600;
      font-size: clamp(0.78rem, 0.85vw, 0.88rem);
      text-align: left;
      transition: all 0.16s;
      width: 100%;
      position: relative;
    }

    .v78-nav-item i { font-size: 1.05rem; width: 22px; text-align: center; }
    .v78-nav-item:hover { background: var(--surface2, rgba(255,255,255,0.05)); color: var(--ink); }
    .v78-nav-item.active { background: rgba(255, 102, 0, 0.12); color: var(--cl-orange); font-weight: 700; }
    .v78-nav-item.active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 3px;
      background: var(--cl-orange);
      border-radius: 0 4px 4px 0;
    }

    .v78-nav-badge {
      margin-left: auto;
      background: rgba(255, 102, 0, 0.18);
      color: var(--cl-orange);
      font-size: 0.68rem;
      padding: 1px 6px;
      border-radius: 10px;
      font-weight: 700;
    }

    html.is-collapsed .v78-nav-text,
    html.is-collapsed .v78-nav-badge,
    html.is-collapsed #lblCollapse78 { display: none; }

    .v78-sidebar-foot { border-top: 1px solid var(--line); padding-top: 1vh; }

    .v78-btn-collapse {
      display: flex;
      align-items: center;
      gap: 8px;
      width: 100%;
      padding: 7px 10px;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 6px;
      color: var(--muted);
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 600;
    }

    /* ============================================================
       3. CONTENEDOR PRINCIPAL (100VH EXACTO)
       ============================================================ */
    .v78-main {
      margin-top: var(--topbar-h);
      margin-left: var(--side-w);
      height: calc(100vh - var(--topbar-h));
      padding: 1.4vh 1.6vw;
      box-sizing: border-box;
      overflow: hidden;
      transition: margin-left 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .v78-main { margin-left: var(--side-collapsed-w); }

    @media (max-width: 960px) {
      .v78-main {
        margin-left: 0 !important;
        height: auto;
        overflow: visible;
        padding: 14px;
      }
    }

    .v78-grid-split {
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      gap: 1.5vw;
      height: 100%;
    }

    @media (max-width: 1120px) {
      .v78-grid-split { grid-template-columns: 1fr; height: auto; }
    }

    /* ============================================================
       COLUMNA IZQUIERDA: 4 CARDS HORIZONTALES (ESTILO VIEW 76)
       ============================================================ */
    .v78-prods-list {
      display: grid;
      grid-template-rows: repeat(4, 1fr);
      gap: 1vh;
      height: 100%;
    }

    .v78-h-card {
      background: var(--cl-card-bg);
      border: 1.5px solid var(--cl-card-border);
      border-radius: 1.3vh;
      padding: 1vh 1.2vw;
      display: grid;
      grid-template-columns: 88px 1fr auto;
      gap: 14px;
      align-items: center;
      cursor: pointer;
      transition: all 0.18s;
      position: relative;
    }

    .v78-h-card:hover {
      border-color: rgba(255, 102, 0, 0.55);
      transform: translateX(4px);
    }

    .v78-h-card.active {
      border-color: var(--cl-orange);
      background: rgba(255, 102, 0, 0.05);
      box-shadow: 0 4px 18px rgba(255, 102, 0, 0.16);
    }

    .v78-h-img-box {
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .v78-h-img {
      max-height: clamp(60px, 9vh, 85px);
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 4px 10px rgba(0,0,0,0.25));
    }

    .v78-h-info {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
    }

    .v78-h-badge-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .v78-h-badge {
      font-size: 0.65rem;
      font-weight: 800;
      font-family: var(--ff_O, sans-serif);
      padding: 2px 7px;
      border-radius: 5px;
    }
    .badge-fire { background: rgba(255, 102, 0, 0.2); color: #ff771a; }
    .badge-blue { background: rgba(2, 132, 199, 0.2); color: #38bdf8; }
    .badge-emerald { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .badge-gold { background: rgba(234, 179, 8, 0.2); color: #facc15; }

    .v78-h-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: clamp(0.92rem, 1.05vw, 1.1rem);
      font-weight: 800;
      color: var(--ink);
      line-height: 1.2;
    }

    .v78-h-checks {
      font-size: clamp(0.68rem, 0.74vw, 0.76rem);
      color: var(--muted);
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .v78-h-checks span { display: flex; align-items: center; gap: 5px; }
    .v78-h-checks span i { color: var(--cl-emerald); font-size: 0.65rem; }

    .v78-h-price-col {
      text-align: right;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-end;
      gap: 4px;
    }

    .v78-h-price {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: clamp(1.25rem, 1.45vw, 1.55rem);
      font-weight: 800;
      color: var(--cl-orange);
    }

    .v78-h-free {
      color: var(--cl-emerald);
      font-size: 0.72rem;
      font-weight: 700;
    }

    /* ============================================================
       COLUMNA DERECHA: BARRA SUPERIOR EDITABLE + WHATSAPP EN VIVO
       ============================================================ */
    .v78-col-right {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 100%;
      gap: 1vh;
    }

    /* BARRA SUPERIOR DE MENSAJE EDITABLE (ENFOQUE 1) */
    .v78-editor-card {
      background: var(--cl-card-bg);
      border: 1px solid var(--cl-card-border);
      border-radius: 1.4vh;
      padding: 1.2vh 1vw;
      display: flex;
      flex-direction: column;
      gap: 0.6vh;
    }

    .v78-editor-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .v78-editor-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--cl-orange);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .v78-editor-badge {
      font-size: 0.68rem;
      color: var(--cl-emerald);
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    /* CHIPS DE TEXTO RÁPIDO */
    .v78-quick-chips-row {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin: 2px 0;
    }

    .v78-chip-tag {
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      color: var(--muted);
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 0.7rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }
    .v78-chip-tag:hover {
      color: var(--cl-orange);
      border-color: var(--cl-orange);
      background: rgba(255, 102, 0, 0.08);
    }

    /* TEXTAREA EDITABLE QUE SE SINCRONIZA CON WHATSAPP */
    .v78-editable-input {
      width: 100%;
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--ink);
      padding: 8px 10px;
      font-size: 0.78rem;
      font-family: inherit;
      resize: none;
      height: 52px;
      outline: none;
      line-height: 1.35;
      transition: border-color 0.2s;
    }
    .v78-editable-input:focus {
      border-color: var(--cl-orange);
      box-shadow: 0 0 10px rgba(255, 102, 0, 0.2);
    }

    /* SELECTOR RÁPIDO DE DESTINO & VUELTO */
    .v78-quick-params-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-size: 0.74rem;
      padding-top: 4px;
      border-top: 1px solid var(--line);
    }

    .v78-sel-dir {
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      border-radius: 6px;
      color: var(--ink);
      font-size: 0.74rem;
      font-weight: 700;
      padding: 3px 8px;
      outline: none;
      cursor: pointer;
    }

    /* MOCKUP WHATSAPP REALISTA */
    .v78-wa-box {
      background: var(--cl-card-bg);
      border: 1px solid var(--cl-card-border);
      border-radius: 1.4vh;
      overflow: hidden;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .v78-wa-header {
      background: #008069;
      color: #fff;
      padding: 0.8vh 1vw;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .v78-wa-header-left {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .v78-wa-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #fff;
      object-fit: contain;
      padding: 2px;
    }

    .v78-wa-body {
      background: #efeae2;
      padding: 1.2vh 1vw;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 8px;
    }
    html[data-theme="futuro"] .v78-wa-body { background: #0b141a; }

    .v78-bubble-out {
      background: #d9fdd3;
      color: #111b21;
      border-radius: 8px 8px 2px 8px;
      padding: 0.9vh 1vw;
      font-size: clamp(0.72rem, 0.78vw, 0.84rem);
      max-width: 95%;
      margin-left: auto;
      white-space: pre-line;
      line-height: 1.38;
      box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }
    html[data-theme="futuro"] .v78-bubble-out { background: #005c4b; color: #e9edef; }

    .v78-wa-time {
      font-size: 0.62rem;
      opacity: 0.65;
      text-align: right;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 3px;
      margin-top: 3px;
    }

    .v78-summary-box {
      padding: 0.8vh 1vw;
      border-top: 1px solid var(--line);
      background: var(--surface);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .v78-summary-prod {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: clamp(0.9rem, 1.05vw, 1.1rem);
      font-weight: 800;
      color: var(--ink);
    }
    .v78-summary-sub { font-size: 0.7rem; color: var(--muted); }

    .v78-summary-price {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: clamp(1.25rem, 1.45vw, 1.55rem);
      font-weight: 800;
      color: var(--cl-orange);
    }

    .v78-actions-row {
      padding: 0.8vh 1vw;
      background: var(--surface);
      border-top: 1px solid var(--line);
      display: flex;
      gap: 8px;
    }

    .v78-btn-call {
      width: clamp(38px, 4.8vh, 44px);
      height: clamp(38px, 4.8vh, 44px);
      border-radius: 8px;
      background: rgba(2, 132, 199, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(2, 132, 199, 0.3);
      display: grid;
      place-items: center;
      font-size: 0.95rem;
      text-decoration: none;
      flex-shrink: 0;
    }
    .v78-btn-call:hover { background: #0284c7; color: #fff; }

    .v78-btn-wa-order {
      flex: 1;
      background: var(--cl-wa);
      color: #fff;
      border: none;
      border-radius: 8px;
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: clamp(0.9rem, 1.05vw, 1.1rem);
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35);
      transition: all 0.16s;
    }
    .v78-btn-wa-order:hover {
      background: var(--cl-wa-hover);
      transform: translateY(-1px);
    }

    /* BOTTOM NAV BAR MÓVIL */
    .v78-mobile-nav { display: none; }
    @media (max-width: 960px) {
      .v78-mobile-nav {
        display: flex;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 64px;
        background: var(--surface);
        border-top: 1px solid var(--line);
        z-index: 100;
        justify-content: space-around;
        align-items: center;
      }
      .v78-m-btn {
        background: transparent;
        border: none;
        color: var(--muted);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        font-size: 0.68rem;
        font-weight: 700;
      }
      .v78-m-btn.active { color: var(--cl-orange); }
    }
  </style>
</head>
<body>

  <!-- 1. HEADER COMPLETO Y REALISTA -->
  <header class="v78-topbar">
    <a href="/view78" class="v78-brand">
      <img src="/imgwii/logo.webp" alt="Solgas" class="v78-logo" />
      <div class="v78-brand-info">
        <span class="v78-brand-title">SOLGAS <span>SURQUILLO</span></span>
        <span class="v78-brand-sub">
          <span class="v78-live-dot"></span> Jr. Dante 260 · Despacho Activo
        </span>
      </div>
    </a>

    <div class="v78-topbar-right">
      <a href="/" class="v78-btn-tienda" title="Ir a la web principal">
        <i class="fa-solid fa-store"></i> Ver Tienda
      </a>

      <button class="v78-btn-icon" id="btnTheme78" title="Alternar tema">
        <i class="fa-solid fa-moon"></i>
      </button>

      <div class="v78-user-chip">
        <div class="v78-avatar-sm">{avatar(cliente.nombre)}</div>
        <div class="v78-user-meta">
          <span class="v78-user-name">{cliente.nombre}</span>
          <span class="v78-user-badge">Cliente VIP</span>
        </div>
      </div>
    </div>
  </header>

  <!-- 2. SIDEBAR DEL CLIENTE -->
  <aside class="v78-sidebar">
    <nav class="v78-nav">
      <button class="v78-nav-item active"><i class="fa-solid fa-bolt"></i><span class="v78-nav-text">Pedir gas</span></button>
      <button class="v78-nav-item"><i class="fa-solid fa-map-location-dot"></i><span class="v78-nav-text">Direcciones</span><span class="v78-nav-badge">2</span></button>
      <button class="v78-nav-item"><i class="fa-solid fa-headset"></i><span class="v78-nav-text">Soporte</span></button>
      <button class="v78-nav-item"><i class="fa-solid fa-user-gear"></i><span class="v78-nav-text">Mi cuenta</span></button>
    </nav>
    <div class="v78-sidebar-foot">
      <button class="v78-btn-collapse" id="btnCollapse78"><i class="fa-solid fa-arrow-left-long"></i><span id="lblCollapse78">Colapsar</span></button>
    </div>
  </aside>

  <!-- 3. CONTENEDOR 100VH -->
  <main class="v78-main">
    <div class="v78-grid-split">
      
      <!-- COLUMNA IZQUIERDA: 4 CARDS HORIZONTALES -->
      <div class="v78-prods-list">
        {productos.map((prod, idx) => (
          <div 
            class={`v78-h-card ${idx === 0 ? 'active' : ''}`} 
            data-id={prod.id} 
            data-nombre={prod.nombre} 
            data-nombrecorto={prod.nombreCorto} 
            data-precio={prod.precioPEN}
          >
            <div class="v78-h-img-box">
              <img src={prod.imagen} alt={prod.nombre} class="v78-h-img" />
            </div>

            <div class="v78-h-info">
              <div class="v78-h-badge-row">
                <span class={`v78-h-badge ${prod.tagClase}`}>{prod.badge}</span>
                <span class="v78-h-title">{prod.nombre}</span>
              </div>
              <div class="v78-h-checks">
                <span><i class="fa-solid fa-check"></i> {prod.valvula}</span>
                <span><i class="fa-solid fa-check"></i> {prod.balanza}</span>
              </div>
            </div>

            <div class="v78-h-price-col">
              <div class="v78-h-price">S/ {prod.precioPEN.toFixed(2)}</div>
              <span class="v78-h-free">Entrega Gratis</span>
            </div>
          </div>
        ))}
      </div>

      <!-- COLUMNA DERECHA: EDITOR DE MENSAJE FLOTANTE + WHATSAPP LIVE -->
      <div class="v78-col-right">
        
        <!-- BARRA / CAJA DE EDICIÓN DE MENSAJE EN VIVO (ENFOQUE 1) -->
        <div class="v78-editor-card">
          <div class="v78-editor-top">
            <span class="v78-editor-title">
              <i class="fa-solid fa-pen-to-square"></i> Mensaje para WhatsApp
            </span>
            <span class="v78-editor-badge">
              <i class="fa-solid fa-bolt"></i> En vivo 0ms
            </span>
          </div>

          <!-- CHIPS RÁPIDOS PARA AGREGAR INDICACIONES AL TEXTO -->
          <div class="v78-quick-chips-row" id="chipsEditor78">
            <button type="button" class="v78-chip-tag" data-add="🔔 Timbre 301">🔔 Timbre 301</button>
            <button type="button" class="v78-chip-tag" data-add="📞 Llamar al portón">📞 Llamar</button>
            <button type="button" class="v78-chip-tag" data-add="🏢 Dejar con vigilancia">🏢 Vigilancia</button>
            <button type="button" class="v78-chip-tag" data-add="💵 Vuelto de S/ 100">💵 Vuelto S/ 100</button>
            <button type="button" class="v78-chip-tag" data-add="⚖️ Balanza digital">⚖️ Balanza</button>
          </div>

          <!-- TEXTAREA EDITABLE QUE IMPACTA EN TIEMPO REAL -->
          <textarea class="v78-editable-input" id="inLiveNota78" placeholder="Escribe aquí cualquier indicación o pedido especial...">{cliente.notas}</textarea>

          <div class="v78-quick-params-row">
            <div style="display:flex; align-items:center; gap:6px;">
              <span style="color:var(--muted); font-weight:700;"><i class="fa-solid fa-location-dot" style="color:var(--cl-orange);"></i> Destino:</span>
              <select class="v78-sel-dir" id="selDir78">
                {cliente.direcciones.map(d => (
                  <option value={d.id} data-calle={d.calle} data-distrito={d.distrito} data-ref={d.referencia} data-eta={d.eta} selected={d.esPrincipal}>
                    {d.alias} ({d.eta})
                  </option>
                ))}
              </select>
            </div>
            <span style="color:var(--cl-emerald); font-weight:700;">Pesaje Inacal ✓</span>
          </div>
        </div>

        <!-- MOCKUP WHATSAPP REALISTA -->
        <div class="v78-wa-box">
          <div class="v78-wa-header">
            <div class="v78-wa-header-left">
              <img src="/imgwii/logo.webp" alt="Solgas" class="v78-wa-avatar" />
              <div>
                <strong style="font-size:0.84rem;">Solgas Surquillo Oficial</strong>
                <small style="font-size:0.68rem; opacity:0.9;">en línea · Despacho Jr. Dante 260</small>
              </div>
            </div>
            <i class="fa-solid fa-phone" style="font-size:0.85rem;"></i>
          </div>

          <div class="v78-wa-body">
            <div class="v78-bubble-out" id="bubbleWa78">
¡Hola Solgas Surquillo! Deseo pedir mi recarga con mis datos:

👤 Nombre: Valeria
📦 Balón SOLGAS Premium 10 kg (S/ 65.00)
📍 Jr. Dante 260, Dpto 301, Surquillo
📝 Nota: Piso 3, timbre no suena fuerte.
⏱️ Llegada estimada: 12–15 min
              <div class="v78-wa-time"><span>10:32 a. m.</span> <i class="fa-solid fa-check-double" style="color:#53bdeb;"></i></div>
            </div>
          </div>

          <div class="v78-summary-box">
            <div>
              <div class="v78-summary-prod" id="sumNom78">Solgas 10 kg</div>
              <div class="v78-summary-sub" id="sumEta78">Surquillo · 12–15 min</div>
            </div>
            <div class="v78-summary-price" id="sumPr78">S/ 65.00</div>
          </div>

          <div class="v78-actions-row">
            <a href="tel:936369384" class="v78-btn-call" title="Llamar"><i class="fa-solid fa-phone"></i></a>
            <a href="https://wa.me/51936369384" target="_blank" rel="noopener noreferrer" class="v78-btn-wa-order" id="btnWa78">
              <i class="fa-brands fa-whatsapp"></i> <span id="lblBtnWa78">Pedir por WhatsApp (S/ 65.00)</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </main>

  <nav class="v78-mobile-nav">
    <button class="v78-m-btn active"><i class="fa-solid fa-bolt"></i><span>Pedir</span></button>
    <button class="v78-m-btn"><i class="fa-solid fa-map-location-dot"></i><span>Sedes</span></button>
    <button class="v78-m-btn"><i class="fa-solid fa-headset"></i><span>Soporte</span></button>
    <button class="v78-m-btn"><i class="fa-solid fa-user"></i><span>Cuenta</span></button>
  </nav>

  <script is:inline>
    (function() {
      let state = {
        nombre: 'Valeria',
        producto: 'Balón SOLGAS Premium 10 kg',
        productoCorto: 'Solgas 10 kg',
        precio: 65.00,
        calle: 'Jr. Dante 260, Dpto 301',
        distrito: 'Surquillo',
        eta: '12–15 min',
        nota: 'Piso 3, timbre no suena fuerte. Dejar con vigilancia si no contesto.'
      };

      const bubble = document.getElementById('bubbleWa78');
      const sumNom = document.getElementById('sumNom78');
      const sumEta = document.getElementById('sumEta78');
      const sumPr = document.getElementById('sumPr78');
      const btnWa = document.getElementById('btnWa78');
      const lblBtn = document.getElementById('lblBtnWa78');
      const inNota = document.getElementById('inLiveNota78');

      function update() {
        const msg = 
`¡Hola Solgas Surquillo! Deseo pedir mi recarga con mis datos:

👤 Nombre: ${state.nombre}
📦 ${state.producto} (S/ ${state.precio.toFixed(2)})
📍 ${state.calle}, ${state.distrito}
📝 Nota: ${state.nota}
⏱️ Llegada estimada: ${state.eta}`;

        if (bubble) {
          bubble.innerHTML = msg.replace(/\n/g, '<br>') + `<div class="v78-wa-time"><span>10:32 a. m.</span> <i class="fa-solid fa-check-double" style="color:#53bdeb;"></i></div>`;
        }
        if (sumNom) sumNom.textContent = state.productoCorto;
        if (sumEta) sumEta.textContent = `${state.distrito} · ${state.eta}`;
        if (sumPr) sumPr.textContent = `S/ ${state.precio.toFixed(2)}`;
        if (lblBtn) lblBtn.textContent = `Pedir por WhatsApp (S/ ${state.precio.toFixed(2)})`;
        if (btnWa) btnWa.href = `https://wa.me/51936369384?text=${encodeURIComponent(msg)}`;
      }

      // CLICK EN CARDS
      document.querySelectorAll('.v78-h-card').forEach(card => {
        card.addEventListener('click', () => {
          document.querySelectorAll('.v78-h-card').forEach(c => c.classList.remove('active'));
          card.classList.add('active');
          state.producto = card.dataset.nombre;
          state.productoCorto = card.dataset.nombrecorto;
          state.precio = parseFloat(card.dataset.precio);
          update();
        });
      });

      // EDICIÓN EN TIEMPO REAL DEL TEXTAREA
      inNota?.addEventListener('input', () => {
        state.nota = inNota.value;
        update();
      });

      // CHIPS RÁPIDOS
      document.querySelectorAll('#chipsEditor78 .v78-chip-tag').forEach(tag => {
        tag.addEventListener('click', () => {
          const val = tag.dataset.add;
          if (inNota) {
            inNota.value = inNota.value ? `${inNota.value} · ${val}` : val;
            state.nota = inNota.value;
            update();
          }
        });
      });

      // CAMBIO DE DIRECCIÓN
      const selDir = document.getElementById('selDir78');
      selDir?.addEventListener('change', () => {
        const opt = selDir.options[selDir.selectedIndex];
        state.calle = opt.dataset.calle;
        state.distrito = opt.dataset.distrito;
        state.eta = opt.dataset.eta;
        update();
      });

      // TEMA
      document.getElementById('btnTheme78')?.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme;
        const next = cur === 'luz' ? 'futuro' : 'luz';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('gaswii_theme_cliente', next);
      });

      // SIDEBAR COLLAPSE
      document.getElementById('btnCollapse78')?.addEventListener('click', () => {
        const isCollapsed = document.documentElement.classList.toggle('is-collapsed');
        localStorage.setItem('gaswii_sidebar_v78', isCollapsed ? 'true' : 'false');
      });

      update();
    })();
  </script>
</body>
</html>
