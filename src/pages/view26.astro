        </button>

        <!-- Botón Hamburguesa Móvil -->
        <button class="mobile-only" onclick="abrirDrawer()" aria-label="Abrir Menú" style="background: var(--bg-subtle); border: 1px solid var(--border-card); color: var(--text-bright); width: 4.5vh; height: 4.5vh; border-radius: 0.8vh; cursor: pointer; align-items: center; justify-content: center; font-size: 1.2rem;">
