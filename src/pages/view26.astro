    let idiomaActual = 'es';

    // Manejo de Tema
    const themeBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');

    function aplicarTema(t) {
      document.documentElement.dataset.theme = t;
      try { localStorage.setItem('wiTema_gaswii_view26', t); } catch (e) {}
      if (themeIcon) {
        themeIcon.className = t === 'futuro' ? 'fas fa-moon' : 'fas fa-sun';
      }
    }

    if (themeBtn) {
      themeBtn.addEventListener('click', () => {
        const actual = document.documentElement.dataset.theme || 'futuro';
        const nuevo = actual === 'futuro' ? 'luz' : 'futuro';
        aplicarTema(nuevo);
      });
    }

    const temaInit = document.documentElement.dataset.theme || 'futuro';
    if (themeIcon) {
      themeIcon.className = temaInit === 'futuro' ? 'fas fa-moon' : 'fas fa-sun';
    }

    // Manejo de Idioma
    document.querySelectorAll('#langSwitcher button').forEach(btn => {
      btn.addEventListener('click', () => {
        idiomaActual = btn.dataset.lang;
        document.querySelectorAll('#langSwitcher button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        document.querySelectorAll('[data-i18n]').forEach(el => {
          const key = el.dataset.i18n;
          if (diccView21[idiomaActual] && diccView21[idiomaActual][key]) {
            el.textContent = diccView21[idiomaActual][key];
          }
        });

        recalcularDuracion();
      });
    });

    // Selector Dinámico de Distrito en Hero
    document.querySelectorAll('.district-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.district-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        const distName = btn.dataset.district;
        const distTime = btn.dataset.time;
        const infoEl = document.getElementById('distritoActualInfo');
        
        if (infoEl) {
          infoEl.innerHTML = `Despachando a <strong>${distName}</strong>: tiempo estimado <strong>${distTime}</strong>`;
        }

        const selPedDist = document.getElementById('pedDistrito');
        if (selPedDist) {
          selPedDist.value = distName;
        }
      });
    });

    // Lógica de la Calculadora de Consumo
    function recalcularDuracion() {
      const personas = parseInt(document.getElementById('calcPersonas')?.value || 3);
      const horas = parseFloat(document.getElementById('calcHoras')?.value || 2.5);
      const kg = parseInt(document.getElementById('calcTamano')?.value || 10);

      const personasEl = document.getElementById('personasDisplay');
      const horasEl = document.getElementById('horasDisplay');

      if (personasEl) {
        personasEl.textContent = idiomaActual === 'es' ? `${personas} personas` : `${personas} persons`;
      }
      if (horasEl) {
        horasEl.textContent = idiomaActual === 'es' ? `${horas} horas / día` : `${horas} hrs / day`;
      }

      const totalHorasDisponibles = (kg / 10) * 80;
      const consumoDiarioHoras = horas * (0.55 + (personas * 0.15));
      const dias = Math.max(8, Math.round(totalHorasDisponibles / consumoDiarioHoras));

      const resEl = document.getElementById('calcDiasResult');
      if (resEl) {
        resEl.textContent = idiomaActual === 'es' ? `${dias} días` : `${dias} days`;
      }
    }

    document.getElementById('calcPersonas')?.addEventListener('input', recalcularDuracion);
    document.getElementById('calcHoras')?.addEventListener('input', recalcularDuracion);
    document.getElementById('calcTamano')?.addEventListener('change', recalcularDuracion);

    // Control del Drawer Móvil
    function abrirDrawer() {
      document.getElementById('mobileDrawer')?.classList.add('open');
      document.getElementById('drawerBackdrop')?.classList.add('active');
    }

    function cerrarDrawer() {
      document.getElementById('mobileDrawer')?.classList.remove('open');
      document.getElementById('drawerBackdrop')?.classList.remove('active');
    }

    // Funciones de Modales: Login
    function abrirModalLogin() {
      document.getElementById('modalLogin')?.classList.add('open');
    }

    function cerrarModalLogin() {
      document.getElementById('modalLogin')?.classList.remove('open');
    }

    function procesarLogin() {
      const email = document.getElementById('loginEmail')?.value;
      alert(`¡Bienvenido de vuelta, ${email}! Has iniciado sesión correctamente.`);
      cerrarModalLogin();
    }

    // Funciones de Modales: Pedido Express
    function abrirModalPedido(productoPreseleccionado) {
      if (productoPreseleccionado) {
        const selProd = document.getElementById('pedProducto');
        if (selProd) {
          for (let i = 0; i < selProd.options.length; i++) {
            if (selProd.options[i].text.toLowerCase().includes(productoPreseleccionado.toLowerCase())) {
              selProd.selectedIndex = i;
              break;
            }
          }
        }
      }
      document.getElementById('modalPedido')?.classList.add('open');
    }

    function cerrarModalPedido() {
      document.getElementById('modalPedido')?.classList.remove('open');
    }

    // ==========================================================================
    // ENVÍO DE PEDIDO A WHATSAPP (SENCILLO, CLARO Y CON TONO SERVICIAL)
    // ==========================================================================
    function enviarPedidoModalWhatsApp() {
      const nombre = document.getElementById('pedNombre')?.value.trim() || '';
      const telefono = document.getElementById('pedTelefono')?.value.trim() || '';
      const distrito = document.getElementById('pedDistrito')?.value || 'Surquillo';
      const direccion = document.getElementById('pedDireccion')?.value.trim() || '';
      const producto = document.getElementById('pedProducto')?.value || 'Balón SOLGAS de 10 kg';
      const pago = document.getElementById('pedPago')?.value || 'Efectivo';
      const comentarios = document.getElementById('pedComentarios')?.value.trim() || 'Ninguno';

      if (!direccion) {
        alert('Por favor indícanos tu dirección (calle, número o referencia) para llevarte el balón.');
        document.getElementById('pedDireccion')?.focus();
        return;
      }

      const textoMensaje = 
        `🔥 *NUEVO PEDIDO DE GAS - SOLGAS SURQUILLO*\n` +
        `━━━━━━━━━━━━━━━━━━━━━\n` +
        `👤 *Cliente:* ${nombre || 'Vecino Solgas'}\n` +
        `📱 *Teléfono:* ${telefono || 'Por coordinar'}\n` +
        `📍 *Distrito:* ${distrito}\n` +
        `🏠 *Dirección:* ${direccion}\n` +
        `📦 *Producto:* ${producto}\n` +
        `💳 *Método de Pago:* ${pago}\n` +
        `📝 *Indicaciones:* ${comentarios}\n` +
        `⚖️ *Garantía:* Balanza digital en puerta y prueba cero fugas\n` +
        `━━━━━━━━━━━━━━━━━━━━━\n` +
        `🛵 _Sede Jr. Dante 260, Surquillo • ¡Te atendemos con gusto en 15 a 20 min!_`;

      const urlWa = `https://api.whatsapp.com/send?phone=51936369384&text=${encodeURIComponent(textoMensaje)}`;
      window.open(urlWa, '_blank');
      cerrarModalPedido();
    }

    // Exponer funciones globales
    window.abrirDrawer = abrirDrawer;
    window.cerrarDrawer = cerrarDrawer;
    window.abrirModalLogin = abrirModalLogin;
    window.cerrarModalLogin = cerrarModalLogin;
    window.procesarLogin = procesarLogin;
    window.abrirModalPedido = abrirModalPedido;
    window.cerrarModalPedido = cerrarModalPedido;
    window.enviarPedidoModalWhatsApp = enviarPedidoModalWhatsApp;
    

    document.addEventListener('DOMContentLoaded', () => {
      recalcularDuracion();
    });
    recalcularDuracion();
  </script>

