  <!-- 3. PRODUCTOS: VENTA DE BALONES A DOMICILIO CON PESO EXACTO -->
  <section id="productos" style="padding: 7vh 0; background: var(--bg-body);">
    <div class="page-container">
      
      <div style="text-align: center; max-width: 680px; margin: 0 auto 5vh;">
        <span class="badge-fire" style="margin-bottom: 1.2vh;">
          <i class="fas fa-boxes"></i> <span data-i18n="catalog_badge">CATÁLOGO OFICIAL SOLGAS SURQUILLO</span>
        </span>
        <h2 style="font-size: clamp(1.7rem, 2.5vw, 2.8rem); margin-bottom: 1.2vh;" data-i18n="catalog_title">
