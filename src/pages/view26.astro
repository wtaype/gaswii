<!DOCTYPE html>
<html lang="es" data-theme="futuro" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <title>Solgas Surquillo | Balón Lleno con Peso Exacto en 15-20 min - Tel. 936 369 384</title>
  <meta name="description" content="¿Cansado de balones que duran poco? En Solgas Surquillo (Jr. Dante 260) pesamos tu balón frente a tus ojos con balanza digital. Despacho en 15-20 min a Surquillo, Miraflores, San Borja y San Isidro." />

  <!-- Fuentes Locales y FontAwesome -->
  <link rel="preload" href="/google/Outfit-600.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/google/Outfit-700.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/google/Poppins-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/google/Poppins-500.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/google/Poppins-600.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="preload" href="/google/Poppins-700.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />

  <!-- Anti-FOUC Inmediato -->
  <script is:inline>
    (function() {
      try {
        const guardado = localStorage.getItem('wiTema_gaswii_view26');
        const sistema = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'futuro' : 'luz';
        document.documentElement.dataset.theme = guardado || sistema || 'futuro';
      } catch (e) {}
    })();
  </script>

  <style is:global>
    /* ==========================================================================
       VARIABLES Y SISTEMA DE DISEÑO DUAL (FUTURO / LUZ) - SOLGAS SURQUILLO
       ========================================================================== */
    :root[data-theme="futuro"] {
      --bg-body: #060913;
      --bg-surface: #0a0f1f;
      --bg-surface-elevated: #0f172e;
      --bg-card: #0d1428;
      --bg-card-hover: #131c38;
      --bg-subtle: rgba(255, 255, 255, 0.04);
      --border-card: rgba(255, 255, 255, 0.08);
      --border-accent: rgba(255, 102, 0, 0.5);
      --text-main: #e2e8f0;
      --text-muted: #94a3b8;
      --text-bright: #ffffff;
      
      --brand-orange: #ff6600;
      --brand-orange-hover: #ff771a;
      --brand-blue: #0284c7;
      --brand-blue-hover: #0369a1;
      --brand-glow-orange: rgba(255, 102, 0, 0.35);
      --brand-glow-blue: rgba(2, 132, 199, 0.35);
      
      --primary: #ff6600;
      --accent-cyan: #06b6d4;
      --accent-gold: #f59e0b;
      --accent-emerald: #10b981;
      --wa-green: #25d366;
      --wa-hover: #1ebd5b;
      
      --header-bg: rgba(6, 9, 19, 0.95);
      --topbar-bg: linear-gradient(90deg, #ff6600 0%, #0284c7 50%, #ff6600 100%);
      --shadow-card: 0 1vh 3vh rgba(0, 0, 0, 0.45);
      --shadow-hover: 0 1.8vh 4.5vh rgba(0, 0, 0, 0.65);
      --modal-bg: #0c1326;
    }

    :root[data-theme="luz"] {
      --bg-body: #f8fafc;
      --bg-surface: #ffffff;
      --bg-surface-elevated: #f1f5f9;
      --bg-card: #ffffff;
      --bg-card-hover: #f8faff;
      --bg-subtle: rgba(15, 23, 42, 0.03);
      --border-card: rgba(15, 23, 42, 0.09);
      --border-accent: rgba(224, 86, 0, 0.5);
      --text-main: #1e293b;
      --text-muted: #64748b;
      --text-bright: #0f172a;
      
      --brand-orange: #e05600;
      --brand-orange-hover: #c44b00;
      --brand-blue: #0369a1;
      --brand-blue-hover: #075985;
      --brand-glow-orange: rgba(224, 86, 0, 0.20);
      --brand-glow-blue: rgba(3, 105, 161, 0.20);
      
      --primary: #e05600;
      --accent-cyan: #0284c7;
      --accent-gold: #d97706;
      --accent-emerald: #059669;
      --wa-green: #16a34a;
      --wa-hover: #15803d;
      
      --header-bg: rgba(255, 255, 255, 0.96);
      --topbar-bg: linear-gradient(90deg, #e05600 0%, #0369a1 50%, #e05600 100%);
      --shadow-card: 0 0.8vh 2.5vh rgba(15, 23, 42, 0.06);
      --shadow-hover: 0 1.5vh 4vh rgba(15, 23, 42, 0.12);
      --modal-bg: #ffffff;
    }

    /* Reset y Tipografía */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-body);
      color: var(--text-main);
      line-height: 1.6;
      overflow-x: hidden;
      transition: background-color 0.3s ease, color 0.3s ease;
      padding-bottom: 11vh;
    }

    h1, h2, h3, h4, h5, h6, .font-heading {
      font-family: 'Outfit', 'Poppins', sans-serif;
      font-weight: 700;
      line-height: 1.25;
      color: var(--text-bright);
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* CONTENEDOR EXIGIDO: MAX-WIDTH 85VW */
    .page-container {
      width: 100%;
      max-width: 85vw;
      margin: 0 auto;
    }

    /* Tarjetas Limpias */
    .clean-card {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 1.2vh;
      box-shadow: var(--shadow-card);
      transition: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }

    .clean-card:hover {
      border-color: var(--border-accent);
      background: var(--bg-card-hover);
      box-shadow: var(--shadow-hover);
      transform: translateY(-0.35vh);
    }

    /* Botones Profesionales */
    .btn-fire {
      background: linear-gradient(135deg, var(--brand-orange) 0%, #ff8800 100%);
      color: #ffffff !important;
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6vw;
      border-radius: 1vh;
      padding: 1.2vh 1.6vw;
      box-shadow: 0 0.8vh 2.5vh var(--brand-glow-orange);
      transition: all 0.22s ease;
      font-size: clamp(0.88rem, 0.95vw, 1.12rem);
    }

    .btn-fire:hover {
      transform: translateY(-0.25vh);
      box-shadow: 0 1.2vh 3.2vh var(--brand-glow-orange);
      filter: brightness(1.08);
    }

    .btn-whatsapp {
      background: linear-gradient(135deg, var(--wa-green) 0%, #1ebd5b 100%);
      color: #ffffff !important;
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6vw;
      border-radius: 1vh;
      padding: 1.2vh 1.6vw;
      box-shadow: 0 0.8vh 2.5vh rgba(37, 211, 102, 0.35);
      transition: all 0.22s ease;
      font-size: clamp(0.88rem, 0.95vw, 1.12rem);
    }

    .btn-whatsapp:hover {
      transform: translateY(-0.25vh);
      box-shadow: 0 1.2vh 3.2vh rgba(37, 211, 102, 0.5);
      filter: brightness(1.06);
    }

    .btn-call {
      background: linear-gradient(135deg, var(--brand-blue) 0%, #0ea5e9 100%);
      color: #ffffff !important;
      font-family: 'Outfit', sans-serif;
      font-weight: 700;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6vw;
      border-radius: 1vh;
      padding: 1.2vh 1.6vw;
      box-shadow: 0 0.8vh 2.5vh var(--brand-glow-blue);
      transition: all 0.22s ease;
      font-size: clamp(0.88rem, 0.95vw, 1.12rem);
    }

    .btn-call:hover {
      transform: translateY(-0.25vh);
      box-shadow: 0 1.2vh 3.2vh var(--brand-glow-blue);
      filter: brightness(1.08);
    }

    .btn-outline {
      background: var(--bg-subtle);
      border: 1px solid var(--border-card);
      color: var(--text-main);
      font-family: 'Outfit', sans-serif;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5vw;
      border-radius: 1vh;
      padding: 1vh 1.2vw;
      transition: all 0.2s ease;
      font-size: clamp(0.82rem, 0.88vw, 0.98rem);
    }

    .btn-outline:hover {
      border-color: var(--primary);
      color: var(--primary);
      transform: translateY(-0.2vh);
    }

    /* Badges */
    .badge-fire {
      background: rgba(255, 102, 0, 0.12);
      border: 1px solid rgba(255, 102, 0, 0.35);
      color: var(--brand-orange);
      padding: 0.4vh 0.8vw;
      border-radius: 999px;
      font-size: clamp(0.72rem, 0.78vw, 0.85rem);
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.4vw;
    }

    .badge-blue {
      background: rgba(2, 132, 199, 0.12);
      border: 1px solid rgba(2, 132, 199, 0.35);
      color: var(--brand-blue);
      padding: 0.4vh 0.8vw;
      border-radius: 999px;
      font-size: clamp(0.72rem, 0.78vw, 0.85rem);
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.4vw;
    }

    .badge-emerald {
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.35);
      color: var(--accent-emerald);
      padding: 0.4vh 0.8vw;
      border-radius: 999px;
      font-size: clamp(0.72rem, 0.78vw, 0.85rem);
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.4vw;
    }

    .badge-gold {
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.35);
      color: var(--accent-gold);
      padding: 0.4vh 0.8vw;
      border-radius: 999px;
      font-size: clamp(0.72rem, 0.78vw, 0.85rem);
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.4vw;
    }

    /* Switcher Idioma y Tema */
    .pill-group {
      display: inline-flex;
      align-items: center;
      background: var(--bg-subtle);
      border: 1px solid var(--border-card);
      border-radius: 999px;
      padding: 0.3vh 0.3vw;
      gap: 0.2vw;
    }

    .pill-btn {
      border: none;
      background: transparent;
      padding: 0.5vh 0.8vw;
      border-radius: 999px;
      font-size: clamp(0.72rem, 0.78vw, 0.85rem);
      font-weight: 700;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }

    .pill-btn.active {
      background: var(--primary);
      color: #ffffff;
      box-shadow: 0 0.3vh 1vh var(--brand-glow-orange);
    }

    /* ==========================================================================
       MODAL LOGIN Y MODAL PEDIDO EXPRESS EN 2 Y 3 COLUMNAS (CERO SCROLL)
       ========================================================================== */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      z-index: 20000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 2vh 3vw;
    }

    .modal-overlay.open {
      display: flex;
    }

    /* Modal Login Compacto */
    .modal-login-box {
      background: var(--modal-bg);
      border: 1px solid var(--border-card);
      border-radius: 1.5vh;
      max-width: 460px;
      width: 100%;
      padding: 3.5vh 2.5vw;
      box-shadow: 0 2vh 6vh rgba(0, 0, 0, 0.6);
      position: relative;
    }

    /* Modal Pedido Ancho en 2 y 3 Columnas */
    .modal-pedido-box {
      background: var(--modal-bg);
      border: 1px solid var(--border-card);
      border-radius: 1.5vh;
      max-width: 820px;
      width: 100%;
      max-height: 94vh;
      overflow-y: auto;
      padding: 3vh 2.2vw;
      box-shadow: 0 2.5vh 7vh rgba(0, 0, 0, 0.7);
      position: relative;
    }

    
    .address-subgrid {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 0.6vw;
    }
    @media (max-width: 767px) {
      .address-subgrid {
        grid-template-columns: 1fr !important;
        gap: 1vh !important;
      }
    }

    /* Cuadrícula Multicolumna para Formulario de Pedido */
    .modal-grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1vw;
      margin-bottom: 1.6vh;
    }

    .modal-grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1vw;
      margin-bottom: 1.6vh;
    }

    .form-group {
      margin-bottom: 0;
    }

    .form-group label {
      display: block;
      font-size: clamp(0.78rem, 0.82vw, 0.92rem);
      font-weight: 700;
      margin-bottom: 0.5vh;
      color: var(--text-bright);
    }

    .form-input, .form-select, .form-textarea {
      width: 100%;
      padding: 1.1vh 1vw;
      background: var(--bg-surface-elevated);
      border: 1px solid var(--border-card);
      border-radius: 0.8vh;
      color: var(--text-main);
      font-family: inherit;
      font-size: clamp(0.88rem, 0.9vw, 1rem);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    
    @media (max-width: 767px) {
      .form-input, .form-select, .form-textarea {
        font-size: 16px !important; /* Evita zoom automático molesto en iOS */
        padding: 12px 14px !important;
        border-radius: 8px !important;
      }
      .modal-pedido-box {
        padding: 2.5vh 4.5vw !important;
        max-height: 92vh !important;
        border-radius: 16px !important;
      }
      .btn-fire, .btn-whatsapp, .btn-call {
        min-height: 48px !important;
      }
    }

    .form-input:focus, .form-select:focus, .form-textarea:focus {
      border-color: var(--primary);
    }

    /* Barra Sticky Móvil Inferior Premium */
    .mobile-sticky-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 9999;
      background: var(--header-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid var(--border-card);
      padding: 1.2vh 3.5vw;
      display: flex;
      gap: 2.5vw;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 -0.8vh 3vh rgba(0, 0, 0, 0.45);
    }

    /* Drawer Móvil */
    .mobile-drawer {
      position: fixed;
      top: 0;
      right: -100%;
      width: 78vw;
      max-width: 360px;
      height: 100vh;
      background: var(--bg-surface);
      border-left: 1px solid var(--border-card);
      z-index: 10001;
      padding: 4vh 6vw;
      display: flex;
      flex-direction: column;
      gap: 2.5vh;
      box-shadow: -1vw 0 4vw rgba(0, 0, 0, 0.5);
      transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .mobile-drawer.open {
      right: 0;
    }

    .drawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
      z-index: 10000;
      display: none;
    }

    .drawer-backdrop.active {
      display: block;
    }

    /* ==========================================================================
       MEDIA QUERIES RESPONSIVAS
       ========================================================================== */
    @media (max-width: 767px) {
      .desktop-only { display: none !important; }
      .mobile-only { display: flex !important; }
      .hero-layout { grid-template-columns: 1fr !important; gap: 4vh !important; }
      .catalog-grid { grid-template-columns: 1fr !important; gap: 3vh !important; }
      .stats-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 2vh !important; }
      .split-grid { grid-template-columns: 1fr !important; gap: 3.5vh !important; }
      .hero-img-box { height: 35vh !important; }
      .map-container { height: 38vh !important; }
      .modal-grid-3, .modal-grid-2 { grid-template-columns: 1fr !important; gap: 1.5vh !important; }
    }

    @media (min-width: 768px) and (max-width: 1024px) {
      .desktop-only { display: none !important; }
      .mobile-only { display: flex !important; }
      .hero-layout { grid-template-columns: 1fr !important; gap: 4vh !important; }
      .catalog-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 2.5vh !important; }
      .stats-grid { grid-template-columns: repeat(4, 1fr) !important; }
      .split-grid { grid-template-columns: 1fr !important; gap: 3.5vh !important; }
      .hero-img-box { height: 42vh !important; }
      .map-container { height: 45vh !important; }
      .modal-grid-3 { grid-template-columns: repeat(2, 1fr) !important; }
    }

    @media (min-width: 1025px) {
      .mobile-only { display: none !important; }
      .desktop-only { display: flex !important; }
      .mobile-sticky-bar { display: none !important; }
      body { padding-bottom: 0 !important; }
      .hero-layout { grid-template-columns: 1.15fr 0.85fr !important; gap: 3.5vw !important; }
      .catalog-grid { grid-template-columns: repeat(4, 1fr) !important; gap: 1.6vw !important; }
      .stats-grid { grid-template-columns: repeat(4, 1fr) !important; gap: 1.5vw !important; }
      .split-grid { grid-template-columns: 1fr 1fr !important; gap: 3.5vw !important; }
      .hero-img-box { height: 48vh !important; }
      .map-container { height: 55vh !important; }
    }
  </style>
</head>

