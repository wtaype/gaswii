---
// src/pages/blog.astro
// Catálogo Público de Artículos de Blog en Español
import Principal from '../core/layouts/Principal.astro';
import BlogCatalog from '../feature/blog/components/BlogCatalog.astro';
import blogsData from '../semillas/blogs.json';
import { datosNegocio } from '../negocio.js';

const idioma = 'es';
const ruta = '/blog';
const rutasIdioma = {
  es: '/blog',
  en: '/en/blog'
};

const posts = (blogsData || []).filter((p: any) => (p.lang === 'es' || !p.lang) && p.activo !== false);

const pageTitle = `Blog & Consejos Oficiales | ${datosNegocio.nombre}`;
const pageDesc = 'Artículos, guías y consejos oficiales sobre seguridad GLP, peso exacto en balanza digital y eficiencia energética.';
---

<Principal
  idioma={idioma}
  ruta={ruta}
  rutasIdioma={rutasIdioma}
  title={pageTitle}
  description={pageDesc}
>
  <BlogCatalog posts={posts} idioma={idioma} />
</Principal>
