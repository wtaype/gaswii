---

<!doctype html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Portal de Cliente · Solgas Surquillo | View 72</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Script Anti-FOUC síncrono en 0ms -->
  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('gaswii_theme_cliente') || localStorage.getItem('wiTema') || 'futuro';
      document.documentElement.dataset.theme = savedTheme;
      if (localStorage.getItem('gaswii_sidebar_v72') === 'true') {
        document.documentElement.classList.add('is-collapsed');
      }
    } catch (e) {}
  </script>

  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />
  <style is:global set:html={witemaCss}></style>

  <style>
    /* ============================================================
       VARIABLES Y RESET (ESTILO IMAGEN 2 CON COMPACIDAD)
       ============================================================ */
    :root {
      --side-w: 240px;
      --side-collapsed-w: 68px;
      --topbar-h: 50px; /* HEADER COMPACTO SOLICITADO */
      --cl-orange: #ff6600;
      --cl-orange-hover: #ff771a;
      --cl-wa: #25d366;
      --cl-wa-hover: #1ebd5b;
      --cl-blue: #0284c7;
      --cl-emerald: #10b981;
      --cl-card-bg: #0d1424;
      --cl-card-border: rgba(255, 255, 255, 0.08);
      --cl-input-bg: #070c18;
    }

    html[data-theme="luz"] {
      --cl-card-bg: #ffffff;
      --cl-card-border: #e2e8f0;
      --cl-input-bg: #f8fafc;
    }

    *, *::before, *::after { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: var(--fz_m);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* ============================================================
       1. HEADER COMPACTO (~50PX)
       ============================================================ */
    .v72-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--topbar-h);
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      z-index: 60;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 18px;
      backdrop-filter: blur(14px);
    }

    .v72-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: inherit;
    }

    .v72-logo {
      height: 28px;
      width: auto;
      object-fit: contain;
    }

    .v72-brand-text {
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .v72-brand-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--ink);
      letter-spacing: -0.2px;
    }

    .v72-brand-title span { color: var(--cl-orange); }

    .v72-brand-sede {
      font-size: 0.72rem;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .v72-live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--cl-emerald);
      box-shadow: 0 0 8px var(--cl-emerald);
    }

    .v72-topbar-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .v72-btn-icon {
      background: var(--surface2, rgba(255,255,255,0.05));
      border: 1px solid var(--line);
      color: var(--ink);
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: grid;
      place-items: center;
      cursor: pointer;
      font-size: 0.82rem;
      transition: all 0.2s;
    }
    .v72-btn-icon:hover { border-color: var(--cl-orange); color: var(--cl-orange); }

    .v72-user-chip {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 3px 10px 3px 4px;
      background: var(--surface2, rgba(255,255,255,0.04));
      border: 1px solid var(--line);
      border-radius: 20px;
    }

    .v72-avatar-sm {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--cl-orange);
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 0.75rem;
    }

    .v72-user-name {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--ink);
    }

    /* ============================================================
       2. SIDEBAR DEL CLIENTE (ESTILO IMAGEN 2)
       ============================================================ */
    .v72-sidebar {
      position: fixed;
      top: var(--topbar-h);
      left: 0;
      bottom: 0;
      width: var(--side-w);
      background: var(--surface);
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 14px 10px;
      z-index: 50;
      transition: width 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .v72-sidebar { width: var(--side-collapsed-w); }

    .v72-nav {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .v72-nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 9px 12px;
      border-radius: 8px;
      border: none;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.85rem;
      text-align: left;
      transition: all 0.16s;
      width: 100%;
      white-space: nowrap;
      overflow: hidden;
      position: relative;
    }

    .v72-nav-item i {
      font-size: 1.05rem;
      width: 22px;
      text-align: center;
      flex-shrink: 0;
    }

    .v72-nav-item:hover {
      background: var(--surface2, rgba(255,255,255,0.05));
      color: var(--ink);
    }

    .v72-nav-item.active {
      background: rgba(255, 102, 0, 0.12);
      color: var(--cl-orange);
      font-weight: 700;
    }

    .v72-nav-item.active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 3px;
      background: var(--cl-orange);
      border-radius: 0 4px 4px 0;
    }

    .v72-nav-badge {
      margin-left: auto;
      background: rgba(255, 102, 0, 0.18);
      color: var(--cl-orange);
      font-size: 0.7rem;
      padding: 2px 6px;
      border-radius: 10px;
      font-weight: 700;
      font-family: var(--ff_O, sans-serif);
    }

    html.is-collapsed .v72-nav-text,
    html.is-collapsed .v72-nav-badge,
    html.is-collapsed #lblCollapse72 { display: none; }

    .v72-sidebar-foot {
      border-top: 1px solid var(--line);
      padding-top: 10px;
    }

    .v72-btn-collapse {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 8px 10px;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 6px;
      color: var(--muted);
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 600;
    }

    /* ============================================================
       3. CONTENEDOR PRINCIPAL Y PANELES
       ============================================================ */
    .v72-main {
      margin-top: var(--topbar-h);
      margin-left: var(--side-w);
      padding: 18px 22px;
      min-height: calc(100vh - var(--topbar-h));
      transition: margin-left 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .v72-main { margin-left: var(--side-collapsed-w); }

    .v72-panel { display: none; }
    .v72-panel.active { display: block; animation: v72Fade 0.2s ease-out; }

    @keyframes v72Fade {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============================================================
       MÓDULO 1: PEDIR GAS (FUSIÓN EXACTA CON IMAGEN 1)
       ============================================================ */
    .v72-hero-banner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }

    .v72-hero-banner h1 {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--ink);
    }

    .v72-hero-banner h1 span { color: var(--cl-orange); }

    .v72-btn-manage-ficha {
      background: transparent;
      border: 1px solid rgba(255, 102, 0, 0.4);
      color: var(--cl-orange);
      padding: 6px 14px;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.18s;
    }
    .v72-btn-manage-ficha:hover {
      background: rgba(255, 102, 0, 0.1);
    }

    /* BANDA DE 3 METADATOS (IMAGEN 1) */
    .v72-meta-band {
      display: grid;
      grid-template-columns: 1fr 1fr 1.6fr;
      gap: 12px;
      background: var(--cl-card-bg);
      border: 1px solid var(--cl-card-border);
      border-radius: 12px;
      padding: 10px 14px;
      margin-bottom: 18px;
      align-items: center;
    }

    @media (max-width: 860px) {
      .v72-meta-band { grid-template-columns: 1fr; }
    }

    .v72-meta-item { display: flex; flex-direction: column; gap: 2px; }
    .v72-meta-label {
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--muted);
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .v72-meta-label i { color: var(--cl-orange); }
    .v72-meta-val {
      font-size: 0.86rem;
      font-weight: 700;
      color: var(--ink);
    }

    .v72-meta-select {
      width: 100%;
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--ink);
      font-size: 0.82rem;
      font-weight: 600;
      padding: 6px 10px;
      outline: none;
      cursor: pointer;
    }

    /* LAYOUT 60% / 40% (GRID IMAGEN 1) */
    .v72-grid-pedir {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 20px;
      align-items: start;
    }

    @media (max-width: 1100px) {
      .v72-grid-pedir { grid-template-columns: 1fr; }
    }

    .v72-sec-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.95rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--ink);
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
    }

    .v72-sec-tag-green {
      color: var(--cl-emerald);
      font-size: 0.74rem;
      text-transform: none;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 5px;
    }

    /* 4 CARDS PRODUCTOS (IMAGEN 1) */
    .v72-cards-prods {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 18px;
    }

    @media (max-width: 600px) {
      .v72-cards-prods { grid-template-columns: 1fr; }
    }

    .v72-card-p {
      background: var(--cl-card-bg);
      border: 1.5px solid var(--cl-card-border);
      border-radius: 12px;
      padding: 12px;
      cursor: pointer;
      position: relative;
      transition: all 0.18s;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .v72-card-p:hover {
      border-color: rgba(255, 102, 0, 0.5);
    }

    .v72-card-p.active {
      border-color: var(--cl-orange);
      background: rgba(255, 102, 0, 0.04);
      box-shadow: 0 4px 18px rgba(255, 102, 0, 0.12);
    }

    .v72-card-top-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
    }

    .v72-p-badge {
      font-size: 0.64rem;
      font-weight: 800;
      font-family: var(--ff_O, sans-serif);
      padding: 2px 7px;
      border-radius: 6px;
    }
    .badge-fire { background: rgba(255, 102, 0, 0.2); color: #ff771a; }
    .badge-blue { background: rgba(2, 132, 199, 0.2); color: #38bdf8; }
    .badge-emerald { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .badge-gold { background: rgba(234, 179, 8, 0.2); color: #facc15; }

    .v72-p-uso {
      font-size: 0.68rem;
      color: var(--muted);
      font-weight: 600;
    }

    .v72-p-img-box {
      text-align: center;
      position: relative;
      margin: 6px 0;
    }

    .v72-p-img {
      height: 64px;
      width: auto;
      object-fit: contain;
    }

    .v72-p-pill-weight {
      position: absolute;
      bottom: 2px;
      right: 4px;
      background: rgba(0,0,0,0.65);
      color: #fff;
      font-size: 0.62rem;
      font-weight: 700;
      padding: 1px 6px;
      border-radius: 8px;
    }

    .v72-p-name {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.88rem;
      font-weight: 800;
      color: var(--ink);
      margin-bottom: 6px;
    }

    /* DESCRIPCIÓN OFICIAL PRODUCTO.MD */
    .v72-p-desc {
      font-size: 0.72rem;
      color: var(--muted);
      line-height: 1.35;
      margin-bottom: 8px;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .v72-p-checks {
      border-top: 1px dashed var(--line);
      padding-top: 6px;
      display: flex;
      flex-direction: column;
      gap: 3px;
      margin-bottom: 8px;
    }

    .v72-p-check-item {
      font-size: 0.68rem;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .v72-p-check-item i { color: var(--cl-emerald); font-size: 0.62rem; }

    .v72-p-foot-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-top: 1px solid var(--line);
      padding-top: 6px;
      margin-top: auto;
    }

    .v72-p-price {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--cl-orange);
    }

    .v72-p-free-delivery {
      color: var(--cl-emerald);
      font-size: 0.68rem;
      font-weight: 700;
    }

    /* FORMAS DE PAGO & INDICACIONES (IMAGEN 1) */
    .v72-card-box {
      background: var(--cl-card-bg);
      border: 1px solid var(--cl-card-border);
      border-radius: 12px;
      padding: 14px;
      margin-bottom: 14px;
    }

    .v72-pago-indicaciones-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    @media (max-width: 700px) {
      .v72-pago-indicaciones-grid { grid-template-columns: 1fr; }
    }

    .v72-tabs-pago {
      display: flex;
      gap: 6px;
      margin-bottom: 10px;
    }

    .v72-btn-tab-pago {
      flex: 1;
      padding: 7px 10px;
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--muted);
      font-weight: 700;
      font-size: 0.78rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.16s;
    }

    .v72-btn-tab-pago.active {
      border-color: var(--cl-orange);
      color: var(--cl-orange);
      background: rgba(255, 102, 0, 0.1);
    }

    .v72-chips-vuelto {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 6px;
      margin-bottom: 8px;
    }

    .v72-chip-btn {
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      color: var(--ink);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.74rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.14s;
    }

    .v72-chip-btn:hover { border-color: var(--cl-orange); }
    .v72-chip-btn.active {
      background: var(--cl-orange);
      color: #fff;
      border-color: var(--cl-orange);
    }

    .v72-vuelto-calc-box {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(16, 185, 129, 0.08);
      border: 1px solid rgba(16, 185, 129, 0.2);
      border-radius: 6px;
      padding: 5px 10px;
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--cl-emerald);
      margin-top: 6px;
    }

    .v72-quick-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 8px;
    }

    .v72-quick-tag {
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      color: var(--muted);
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 0.7rem;
      font-weight: 600;
      cursor: pointer;
    }
    .v72-quick-tag:hover { color: var(--cl-orange); border-color: var(--cl-orange); }

    .v72-notes-textarea {
      width: 100%;
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--ink);
      padding: 8px 10px;
      font-size: 0.78rem;
      resize: vertical;
      min-height: 52px;
      outline: none;
    }
    .v72-notes-textarea:focus { border-color: var(--cl-orange); }

    /* ============================================================
       COLUMNA STICKY DE WHATSAPP MOCKUP (IMAGEN 1)
       ============================================================ */
    .v72-wa-card {
      background: var(--cl-card-bg);
      border: 1px solid var(--cl-card-border);
      border-radius: 16px;
      overflow: hidden;
      position: sticky;
      top: calc(var(--topbar-h) + 14px);
    }

    .v72-wa-header {
      background: #008069;
      color: #fff;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .v72-wa-header-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .v72-wa-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #fff;
      object-fit: contain;
      padding: 3px;
    }

    .v72-wa-header-info strong {
      font-size: 0.84rem;
      display: block;
      line-height: 1.15;
    }
    .v72-wa-header-info small {
      font-size: 0.68rem;
      opacity: 0.9;
    }

    .v72-wa-body {
      background: #efeae2;
      padding: 14px 12px;
      min-height: 250px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    html[data-theme="futuro"] .v72-wa-body {
      background: #0b141a;
    }

    .v72-bubble-in {
      background: #fff;
      color: #111b21;
      border-radius: 8px 8px 8px 2px;
      padding: 8px 10px;
      font-size: 0.78rem;
      max-width: 88%;
      box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }
    html[data-theme="futuro"] .v72-bubble-in {
      background: #202c33;
      color: #e9edef;
    }

    .v72-bubble-out {
      background: #d9fdd3;
      color: #111b21;
      border-radius: 8px 8px 2px 8px;
      padding: 10px 12px;
      font-size: 0.8rem;
      max-width: 92%;
      margin-left: auto;
      white-space: pre-line;
      line-height: 1.4;
      box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }
    html[data-theme="futuro"] .v72-bubble-out {
      background: #005c4b;
      color: #e9edef;
    }

    .v72-wa-time {
      font-size: 0.62rem;
      opacity: 0.65;
      text-align: right;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 3px;
      margin-top: 3px;
    }

    /* RESUMEN TOTAL DE COMPRA */
    .v72-summary-box {
      padding: 12px 14px;
      border-top: 1px solid var(--line);
      background: var(--surface);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .v72-summary-prod {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--ink);
    }
    .v72-summary-sub {
      font-size: 0.72rem;
      color: var(--muted);
    }

    .v72-summary-price {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--cl-orange);
    }

    .v72-dest-pill-card {
      padding: 10px 14px;
      background: var(--surface2, rgba(255,255,255,0.02));
      border-top: 1px solid var(--line);
    }
    .v72-dest-head {
      display: flex;
      justify-content: space-between;
      font-size: 0.68rem;
      color: var(--muted);
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 2px;
    }
    .v72-dest-head span { color: var(--cl-emerald); }
    .v72-dest-title {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--ink);
    }
    .v72-dest-sub {
      font-size: 0.72rem;
      color: var(--muted);
    }

    .v72-actions-row {
      padding: 12px 14px;
      background: var(--surface);
      border-top: 1px solid var(--line);
      display: flex;
      gap: 8px;
    }

    .v72-btn-call {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: rgba(2, 132, 199, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(2, 132, 199, 0.3);
      display: grid;
      place-items: center;
      font-size: 1rem;
      text-decoration: none;
      transition: all 0.18s;
      flex-shrink: 0;
    }
    .v72-btn-call:hover { background: #0284c7; color: #fff; }

    .v72-btn-wa-order {
      flex: 1;
      background: var(--cl-wa);
      color: #fff;
      border: none;
      border-radius: 10px;
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.95rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.18s;
      box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
    }
    .v72-btn-wa-order:hover {
      background: var(--cl-wa-hover);
      transform: translateY(-1px);
    }

    /* ============================================================
       MÓDULO 4: MI CUENTA (ESTILO IMAGEN 2 CON SUB-PESTAÑAS)
       ============================================================ */
    .v72-cuenta-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
    }

    .v72-cuenta-header h2 {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--ink);
      margin: 0;
    }
    .v72-cuenta-header p {
      font-size: 0.8rem;
      color: var(--muted);
      margin: 2px 0 0;
    }

    .v72-btn-save-primary {
      background: var(--cl-orange);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 8px 18px;
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.88rem;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.18s;
    }
    .v72-btn-save-primary:hover {
      background: var(--cl-orange-hover);
      transform: translateY(-1px);
    }

    /* BARRA DE SUB-PESTAÑAS SEGMENTADAS (IMAGEN 2) */
    .v72-subtabs-bar {
      display: flex;
      gap: 6px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 4px;
      margin-bottom: 20px;
      overflow-x: auto;
    }

    .v72-subtab-btn {
      padding: 7px 16px;
      background: transparent;
      border: none;
      border-radius: 7px;
      color: var(--muted);
      font-weight: 700;
      font-size: 0.8rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.16s;
      white-space: nowrap;
    }

    .v72-subtab-btn:hover { color: var(--ink); }
    .v72-subtab-btn.active {
      background: var(--cl-orange);
      color: #fff;
    }

    .v72-subpanel { display: none; }
    .v72-subpanel.active { display: block; animation: v72Fade 0.2s ease-out; }

    .v72-form-card {
      background: var(--cl-card-bg);
      border: 1px solid var(--cl-card-border);
      border-radius: 14px;
      padding: 20px;
      margin-bottom: 16px;
    }

    .v72-form-card-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--cl-orange);
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .v72-form-card-sub {
      font-size: 0.74rem;
      color: var(--muted);
      margin-bottom: 16px;
    }

    .v72-form-grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    @media (max-width: 640px) {
      .v72-form-grid-2 { grid-template-columns: 1fr; }
    }

    .v72-form-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .v72-form-group label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--ink);
    }

    .v72-form-input {
      width: 100%;
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--ink);
      padding: 8px 12px;
      font-size: 0.82rem;
      outline: none;
    }
    .v72-form-input:focus { border-color: var(--cl-orange); }

    /* TOAST DE CONFIRMACIÓN */
    #v72Toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: var(--ink);
      color: var(--bg);
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 700;
      display: none;
      z-index: 100;
      box-shadow: 0 4px 14px rgba(0,0,0,0.3);
    }
  </style>
</head>
<body>

  <!-- ============================================================
       1. HEADER COMPACTO (~50PX)
       ============================================================ -->
  <header class="v72-topbar">
    <a href="/view72" class="v72-brand">
      <img src="/imgwii/logo.webp" alt="Solgas" class="v72-logo" />
      <div class="v72-brand-text">
        <span class="v72-brand-title">SOLGAS <span>SURQUILLO</span></span>
        <span class="v72-brand-sede">
          <span class="v72-live-dot"></span> Jr. Dante 260 · Despacho Activo
        </span>
      </div>
    </a>

    <div class="v72-topbar-right">
      <button class="v72-btn-icon" id="btnTheme72" title="Alternar modo claro / oscuro">
        <i class="fa-solid fa-moon"></i>
      </button>

      <div class="v72-user-chip">
        <div class="v72-avatar-sm">{avatar(cliente.nombre)}</div>
        <span class="v72-user-name">{cliente.nombre} · VIP</span>
      </div>
    </div>
  </header>

  <!-- ============================================================
       2. SIDEBAR MODULAR (ESTILO IMAGEN 2)
       ============================================================ -->
  <aside class="v72-sidebar">
    <nav class="v72-nav">
      <button class="v72-nav-item active" data-target="pedir-gas">
        <i class="fa-solid fa-bolt"></i>
        <span class="v72-nav-text">Pedir gas</span>
      </button>

      <button class="v72-nav-item" data-target="direcciones">
        <i class="fa-solid fa-map-location-dot"></i>
        <span class="v72-nav-text">Direcciones</span>
        <span class="v72-nav-badge">{cliente.direcciones.length}</span>
      </button>

      <button class="v72-nav-item" data-target="soporte">
        <i class="fa-solid fa-headset"></i>
        <span class="v72-nav-text">Soporte & Boletas</span>
      </button>

      <button class="v72-nav-item" data-target="mi-cuenta">
        <i class="fa-solid fa-user-gear"></i>
        <span class="v72-nav-text">Mi cuenta</span>
      </button>
    </nav>

    <div class="v72-sidebar-foot">
      <button class="v72-btn-collapse" id="btnCollapse72">
        <i class="fa-solid fa-arrow-left-long"></i>
        <span id="lblCollapse72">Colapsar</span>
      </button>
    </div>
  </aside>

  <!-- ============================================================
       3. SHELL PRINCIPAL CON PANELES
       ============================================================ -->
  <main class="v72-main">

    <!-- ========================================================
         PANEL 1: PEDIR GAS (FUSIÓN EXACTA CON IMAGEN 1)
         ======================================================== -->
    <section class="v72-panel active" id="panel-pedir-gas">
      <!-- HEADER SALUDO (IMAGEN 1) -->
      <div class="v72-hero-banner">
        <h1>¡Buenas noches {cliente.nombre}! 🔥 <span>Realiza tu Pedido Hoy</span></h1>
        <button type="button" class="v72-btn-manage-ficha" id="btnGoFicha">
          <i class="fa-solid fa-address-card"></i> Gestionar Ficha & Direcciones
        </button>
      </div>

      <!-- BANDA DE 3 METADATOS (IMAGEN 1) -->
      <div class="v72-meta-band">
        <div class="v72-meta-item">
          <span class="v72-meta-label"><i class="fa-solid fa-user"></i> Nombre Receptor</span>
          <span class="v72-meta-val" id="metaNombre">{cliente.nombre}</span>
        </div>

        <div class="v72-meta-item">
          <span class="v72-meta-label"><i class="fa-brands fa-whatsapp"></i> WhatsApp Confirmación</span>
          <span class="v72-meta-val" id="metaTelefono">{cliente.telefono}</span>
        </div>

        <div class="v72-meta-item">
          <span class="v72-meta-label"><i class="fa-solid fa-location-dot"></i> Dirección de Envío</span>
          <select class="v72-meta-select" id="metaSelectDir">
            {cliente.direcciones.map(d => (
              <option 
                value={d.id} 
                data-calle={d.calle} 
                data-distrito={d.distrito} 
                data-ref={d.referencia}
                data-eta={d.eta}
                data-alias={d.alias}
                selected={d.esPrincipal}
              >
                {d.alias} - {d.distrito} ({d.eta})
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- GRID PRINCIPAL (CATÁLOGO + WHATSAPP LIVE) -->
      <div class="v72-grid-pedir">
        <!-- COLUMNA IZQUIERDA: PRODUCTOS Y PAGOS -->
        <div>
          <div class="v72-sec-title">
            <span>Selecciona tu Producto de Hoy</span>
            <span class="v72-sec-tag-green">
              <i class="fa-solid fa-truck-fast"></i> Delivery y Pesaje Incluido
            </span>
          </div>

          <!-- 4 CARDS DE PRODUCTO CON DESCRIPCIONES DE PRODUCTO.MD -->
          <div class="v72-cards-prods">
            {productos.map((prod, idx) => (
              <div 
                class={`v72-card-p ${idx === 0 ? 'active' : ''}`}
                data-id={prod.id}
                data-nombre={prod.nombre}
                data-nombrecorto={prod.nombreCorto}
                data-precio={prod.precioPEN}
              >
                <div class="v72-card-top-row">
                  <span class={`v72-p-badge ${prod.tagClase}`}>{prod.badge}</span>
                  <span class="v72-p-uso">{prod.tipoUso}</span>
                </div>

                <div class="v72-p-img-box">
                  <img src={prod.imagen} alt={prod.nombre} class="v72-p-img" />
                  <span class="v72-p-pill-weight">{prod.capacidad}</span>
                </div>

                <div class="v72-p-name">{prod.nombre}</div>

                <!-- DESCRIPCIÓN OFICIAL PRODUCTO.MD -->
                <p class="v72-p-desc" title={prod.descripcion}>
                  {prod.descripcion}
                </p>

                <div class="v72-p-checks">
                  {prod.checks.map(c => (
                    <div class="v72-p-check-item">
                      <i class="fa-solid fa-check"></i>
                      <span><strong>{c.label}:</strong> {c.valor}</span>
                    </div>
                  ))}
                </div>

                <div class="v72-p-foot-row">
                  <span class="v72-p-price">S/ {prod.precioPEN.toFixed(2)}</span>
                  <span class="v72-p-free-delivery">Entrega Gratis</span>
                </div>
              </div>
            ))}
          </div>

          <!-- FORMA DE PAGO & INDICACIONES DE ENTREGA (IMAGEN 1) -->
          <div class="v72-sec-title">
            <span>Forma de Pago & Indicaciones de Entrega</span>
            <span style="font-size:0.72rem; color:var(--muted); text-transform:none;">Sin comisiones adicionales</span>
          </div>

          <div class="v72-card-box">
            <div class="v72-pago-indicaciones-grid">
              <!-- MÉTODO DE PAGO -->
              <div>
                <div style="font-size:0.76rem; font-weight:700; color:var(--muted); margin-bottom:6px;">
                  <i class="fa-solid fa-wallet" style="color:var(--cl-orange);"></i> Método de Pago
                </div>

                <div class="v72-tabs-pago">
                  <button type="button" class="v72-btn-tab-pago active" data-metodo="efectivo">
                    <i class="fa-solid fa-money-bill-wave"></i> Efectivo
                  </button>
                  <button type="button" class="v72-btn-tab-pago" data-metodo="yape-plin">
                    <i class="fa-solid fa-mobile-screen-button"></i> Yape / Plin
                  </button>
                </div>

                <!-- SELECTOR DE VUELTO SI ES EFECTIVO -->
                <div id="boxVuelto">
                  <div style="font-size:0.72rem; color:var(--muted); font-weight:600;">¿Con cuánto pagarás? (Vuelto)</div>
                  <div class="v72-chips-vuelto" id="chipsVuelto">
                    <button type="button" class="v72-chip-btn" data-vuelto="exacto">Exacto</button>
                    <button type="button" class="v72-chip-btn" data-vuelto="20">S/ 20</button>
                    <button type="button" class="v72-chip-btn" data-vuelto="50">S/ 50</button>
                    <button type="button" class="v72-chip-btn active" data-vuelto="100">S/ 100</button>
                    <button type="button" class="v72-chip-btn" data-vuelto="otro">Otro</button>
                  </div>

                  <div class="v72-vuelto-calc-box" id="calcVueltoRow">
                    <span>Vuelto estimado:</span>
                    <span id="valVueltoCalculado">S/ 35.00</span>
                  </div>
                </div>
              </div>

              <!-- INDICACIONES PARA EL REPARTIDOR -->
              <div>
                <div style="font-size:0.76rem; font-weight:700; color:var(--muted); margin-bottom:6px;">
                  <i class="fa-solid fa-comment-dots" style="color:var(--cl-orange);"></i> Indicaciones para el Repartidor
                </div>

                <div class="v72-quick-tags" id="tagsNotas">
                  <button type="button" class="v72-quick-tag" data-tag="Tocar timbre">🔔 Timbre</button>
                  <button type="button" class="v72-quick-tag" data-tag="Llamar al llegar">📞 Llamar</button>
                  <button type="button" class="v72-quick-tag" data-tag="Dejar en recepción">🏢 Recepción</button>
                  <button type="button" class="v72-quick-tag" data-tag="Piso 3 sin ascensor">🚪 Piso 3</button>
                </div>

                <textarea class="v72-notes-textarea" id="txtNotas">{cliente.notas}</textarea>
              </div>
            </div>
          </div>
        </div>

        <!-- COLUMNA DERECHA: MOCKUP REALISTA WHATSAPP (IMAGEN 1) -->
        <aside>
          <div class="v72-wa-card">
            <!-- HEADER CHAT WHATSAPP -->
            <div class="v72-wa-header">
              <div class="v72-wa-header-left">
                <i class="fa-solid fa-arrow-left" style="font-size:0.8rem; cursor:pointer;"></i>
                <img src="/imgwii/logo.webp" alt="Solgas" class="v72-wa-avatar" />
                <div class="v72-wa-header-info">
                  <strong>Solgas Surquillo Oficial</strong>
                  <small>en línea · Respuesta inmediata</small>
                </div>
              </div>
              <div style="display:flex; gap:10px; font-size:0.88rem;">
                <i class="fa-solid fa-phone"></i>
                <i class="fa-solid fa-ellipsis-vertical"></i>
              </div>
            </div>

            <!-- CHAT AREA -->
            <div class="v72-wa-body">
              <div class="v72-bubble-in">
                ¡Hola Valeria! 👋 En Solgas Surquillo tenemos unidades en Jr. Dante 260 listas con balanza digital Inacal.
                <div class="v72-wa-time">10:30 a. m.</div>
              </div>

              <div class="v72-bubble-out" id="bubbleWaText">
¡Hola Solgas Surquillo! Deseo pedir mi recarga con mis datos guardados:

👤 Nombre: Valeria
📦 Producto: Balón SOLGAS Premium 10 kg (S/ 65.00)
📍 Entrega: Jr. Dante 260, Dpto 301, Surquillo
🧭 Ref: Frente al parque, portón marrón
💳 Pago: Efectivo (Llevar vuelto de S/ 100.00)
📝 Nota: Piso 3, timbre no suena fuerte.
⏱️ Llegada estimada: 12–15 min
                <div class="v72-wa-time">
                  <span>10:32 a. m.</span>
                  <i class="fa-solid fa-check-double" style="color:#53bdeb;"></i>
                </div>
              </div>
            </div>

            <!-- RESUMEN PRECIO Y PRODUCTO -->
            <div class="v72-summary-box">
              <div>
                <div class="v72-summary-prod" id="sumNombreProd">Solgas 10 kg</div>
                <div class="v72-summary-sub" id="sumDistritoEta">Surquillo · 12–15 min</div>
              </div>
              <div class="v72-summary-price" id="sumPrecioTotal">S/ 65.00</div>
            </div>

            <!-- DESTINO DE ENTREGA SELECCIONADO -->
            <div class="v72-dest-pill-card">
              <div class="v72-dest-head">
                <span><i class="fa-solid fa-location-dot"></i> Destino de Entrega</span>
                <span id="destEtaPill">12–15 min</span>
              </div>
              <div class="v72-dest-title" id="destAliasTxt">Casa Principal</div>
