  <div id="v72Toast">Datos actualizados</div>

  <!-- ============================================================
       4. CONTROLADOR JAVASCRIPT REACTIVO (0MS OVERHEAD)
       ============================================================ */ -->
  <script is:inline>
    (function() {
      // ESTADO REACTIVO DEL PEDIDO
      const state = {
        nombre: 'Valeria',
        telefono: '+51 987 654 321',
        producto: 'Balón SOLGAS Premium 10 kg',
        productoCorto: 'Solgas 10 kg',
        precio: 65.00,
        alias: 'Casa Principal',
        calle: 'Jr. Dante 260, Dpto 301',
        distrito: 'Surquillo',
        ref: 'Frente al parque, portón marrón',
        eta: '12–15 min',
        metodoPago: 'efectivo',
        vueltoSeleccionado: '100',
        pagoTexto: 'Efectivo (Llevar vuelto de S/ 100.00)',
        nota: 'Piso 3, timbre no suena fuerte. Dejar con vigilancia si no contesto.'
      };

      const bubbleWa = document.getElementById('bubbleWaText');
      const sumProd = document.getElementById('sumNombreProd');
      const sumEta = document.getElementById('sumDistritoEta');
      const sumPrecio = document.getElementById('sumPrecioTotal');
      const destAlias = document.getElementById('destAliasTxt');
      const destCalleRef = document.getElementById('destCalleRefTxt');
      const destEtaPill = document.getElementById('destEtaPill');
      const btnWa = document.getElementById('btnWaAction');
      const lblBtnWa = document.getElementById('lblBtnWa');
      const toast = document.getElementById('v72Toast');
      const calcVueltoRow = document.getElementById('calcVueltoRow');
      const valVuelto = document.getElementById('valVueltoCalculado');

      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.style.display = 'block';
        clearTimeout(window._t72Id);
        window._t72Id = setTimeout(() => { toast.style.display = 'none'; }, 1600);
      }

      function updateWA() {
        // Cálculo de vuelto
        if (state.metodoPago === 'efectivo') {
          if (state.vueltoSeleccionado === 'exacto') {
            state.pagoTexto = `Efectivo (Monto Exacto: S/ ${state.precio.toFixed(2)})`;
            if (calcVueltoRow) calcVueltoRow.style.display = 'none';
          } else if (state.vueltoSeleccionado === 'otro') {
            state.pagoTexto = 'Efectivo (Coordinar vuelto)';
            if (calcVueltoRow) calcVueltoRow.style.display = 'none';
          } else {
            const billete = parseFloat(state.vueltoSeleccionado) || 100;
            const diff = billete - state.precio;
            state.pagoTexto = `Efectivo (Paga con S/ ${billete.toFixed(2)}, Llevar vuelto de S/ ${diff > 0 ? diff.toFixed(2) : '0.00'})`;
            if (calcVueltoRow && valVuelto) {
              calcVueltoRow.style.display = 'flex';
              valVuelto.textContent = diff > 0 ? `S/ ${diff.toFixed(2)}` : 'S/ 0.00';
            }
          }
        } else {
          state.pagoTexto = 'Yape / Plin (Contraentrega con QR)';
          if (calcVueltoRow) calcVueltoRow.style.display = 'none';
        }

        const msg = 
`¡Hola Solgas Surquillo! Deseo pedir mi recarga con mis datos guardados:

👤 Nombre: ${state.nombre}
📦 Producto: ${state.producto} (S/ ${state.precio.toFixed(2)})
📍 Entrega: ${state.calle}, ${state.distrito}
🧭 Ref: ${state.ref}
💳 Pago: ${state.pagoTexto}
📝 Nota: ${state.nota}
⏱️ Llegada estimada: ${state.eta}`;

        if (bubbleWa) {
          bubbleWa.innerHTML = msg.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>') +
            `<div class="v72-wa-time"><span>10:32 a. m.</span> <i class="fa-solid fa-check-double" style="color:#53bdeb;"></i></div>`;
        }

        if (sumProd) sumProd.textContent = state.productoCorto;
        if (sumEta) sumEta.textContent = `${state.distrito} · ${state.eta}`;
        if (sumPrecio) sumPrecio.textContent = `S/ ${state.precio.toFixed(2)}`;
        if (destAlias) destAlias.textContent = state.alias;
        if (destCalleRef) destCalleRef.textContent = `${state.calle}, ${state.distrito} · ${state.ref}`;
        if (destEtaPill) destEtaPill.textContent = state.eta;

        if (lblBtnWa) lblBtnWa.textContent = `Pedir por WhatsApp (S/ ${state.precio.toFixed(2)})`;
        if (btnWa) btnWa.href = `https://wa.me/51936369384?text=${encodeURIComponent(msg)}`;
      }

      // CAMBIO DE MÓDULOS DEL SIDEBAR EN 0MS
      document.querySelectorAll('.v72-nav-item').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.dataset.target;
          document.querySelectorAll('.v72-nav-item').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          document.querySelectorAll('.v72-panel').forEach(p => p.classList.remove('active'));
          const targetPanel = document.getElementById(`panel-${targetId}`);
          if (targetPanel) targetPanel.classList.add('active');
        });
      });

      // BOTÓN "GESTIONAR FICHA & DIRECCIONES"
      document.getElementById('btnGoFicha')?.addEventListener('click', () => {
        const cuentaNavBtn = document.querySelector('.v72-nav-item[data-target="mi-cuenta"]');
        cuentaNavBtn?.click();
      });

      // CAMBIO DE SUB-PESTAÑAS EN MI CUENTA (ESTILO IMAGEN 2)
      document.querySelectorAll('.v72-subtab-btn').forEach(tab => {
        tab.addEventListener('click', () => {
          const subId = tab.dataset.sub;
          document.querySelectorAll('.v72-subtab-btn').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');

          document.querySelectorAll('.v72-subpanel').forEach(sp => sp.classList.remove('active'));
          const targetSub = document.getElementById(`subpanel-${subId}`);
          if (targetSub) targetSub.classList.add('active');
        });
      });

      // SELECCIÓN DE PRODUCTOS
      document.querySelectorAll('.v72-card-p').forEach(card => {
        card.addEventListener('click', () => {
          document.querySelectorAll('.v72-card-p').forEach(c => c.classList.remove('active'));
          card.classList.add('active');
          state.producto = card.dataset.nombre;
          state.productoCorto = card.dataset.nombrecorto;
          state.precio = parseFloat(card.dataset.precio);
          updateWA();
          showToast(`Balón: ${state.productoCorto}`);
        });
      });

      // SELECCIÓN DE DIRECCIÓN DESDE EL DROPDOWN
      const selDir = document.getElementById('metaSelectDir');
      selDir?.addEventListener('change', () => {
        const opt = selDir.options[selDir.selectedIndex];
        state.alias = opt.dataset.alias;
        state.calle = opt.dataset.calle;
        state.distrito = opt.dataset.distrito;
        state.ref = opt.dataset.ref;
        state.eta = opt.dataset.eta;
        updateWA();
        showToast(`Entrega: ${state.alias} (${state.eta})`);
      });

      // FORMAS DE PAGO (EFECTIVO VS YAPE/PLIN)
      document.querySelectorAll('.v72-btn-tab-pago').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.v72-btn-tab-pago').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          state.metodoPago = tab.dataset.metodo;
          const boxVuelto = document.getElementById('boxVuelto');
          if (boxVuelto) {
            boxVuelto.style.display = state.metodoPago === 'efectivo' ? 'block' : 'none';
          }
          updateWA();
        });
      });

      // CHIPS DE VUELTO
      document.querySelectorAll('#chipsVuelto .v72-chip-btn').forEach(chip => {
        chip.addEventListener('click', () => {
          document.querySelectorAll('#chipsVuelto .v72-chip-btn').forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          state.vueltoSeleccionado = chip.dataset.vuelto;
          updateWA();
        });
      });

      // NOTAS RÁPIDAS
      const txtNotas = document.getElementById('txtNotas');
      document.querySelectorAll('#tagsNotas .v72-quick-tag').forEach(tag => {
        tag.addEventListener('click', () => {
          const tVal = tag.dataset.tag;
          if (txtNotas) {
            txtNotas.value = txtNotas.value ? `${txtNotas.value}, ${tVal}` : tVal;
            state.nota = txtNotas.value;
            updateWA();
          }
        });
      });

      txtNotas?.addEventListener('input', () => {
        state.nota = txtNotas.value.trim();
        updateWA();
      });

      // GUARDAR CAMBIOS DE MI CUENTA
      document.getElementById('btnSaveMiCuenta')?.addEventListener('click', () => {
        const nuevoNombre = document.getElementById('inNombrePila')?.value.trim();
        const nuevoTel = document.getElementById('inTelefono')?.value.trim();
        if (nuevoNombre) {
          state.nombre = nuevoNombre;
          const metaNom = document.getElementById('metaNombre');
          if (metaNom) metaNom.textContent = nuevoNombre;
        }
        if (nuevoTel) {
          state.telefono = nuevoTel;
          const metaTel = document.getElementById('metaTelefono');
          if (metaTel) metaTel.textContent = nuevoTel;
        }
        updateWA();
        showToast('¡Ficha de cliente guardada con éxito!');
      });

      // COLAPSAR SIDEBAR
      document.getElementById('btnCollapse72')?.addEventListener('click', () => {
        const isCollapsed = document.documentElement.classList.toggle('is-collapsed');
        localStorage.setItem('gaswii_sidebar_v72', isCollapsed ? 'true' : 'false');
      });

      // CAMBIAR TEMA
      document.getElementById('btnTheme72')?.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme;
        const next = cur === 'luz' ? 'futuro' : 'luz';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('gaswii_theme_cliente', next);
      });

      // INICIALIZACIÓN
      updateWA();
    })();
  </script>
</body>
</html>
