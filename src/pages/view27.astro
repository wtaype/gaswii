  <body class="v27">
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <aside class="sidebar">
      <a class="brand" href="/view27" aria-label="Solgas Surquillo, mi cuenta"><img src="/imgwii/logo.webp" alt="Solgas" /><span>Surquillo<small>SIEMPRE CONTIGO</small></span></a>
      <div class="space-label">MI ESPACIO</div>
      <nav aria-label="Mi cuenta">{menu.map(([id, icon, label]) => <button type="button" data-view={id} class:list={['nav-item', { active: id === 'resumen' }]} aria-current={id === 'resumen' ? 'page' : undefined}><i class={`fa-solid fa-${icon}`} aria-hidden="true"></i><span class="desktop-label">{label}</span><span class="mobile-label">{({ resumen: 'Resumen', pedidos: 'Pedidos', direcciones: 'Direcciones', puntos: 'Puntos', comprobantes: 'Boletas' })[id]}</span>{id === 'pedidos' && <b class="count">1</b>}</button>)}</nav>
      <div class="sidebar-bottom"><div class="help-card"><span class="help-icon"><i class="fa-solid fa-headset" aria-hidden="true"></i></span><h3>Estamos para ayudarte</h3><p>Tu equipo de Surquillo, a un mensaje de distancia.</p><button class="text-button" data-help>Hablar con nosotros <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></button></div>
      <button class="profile" data-view="perfil"><span class="avatar">{avatar(smile.nombre)}</span><span><strong>{smile.nombre}</strong><small>Mi cuenta <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></small></span></button></div>
    </aside>
    <div class="workspace">
      <header class="topbar"><span class="breadcrumb">Mi cuenta <span>/</span> <strong id="breadcrumb">Mi resumen</strong></span><div class="top-actions"><span class="preview-badge">Preview · datos ficticios</span><button class="icon-button" id="theme-toggle" aria-label="Activar tema oscuro" aria-pressed="false"><i class="fa-solid fa-moon" aria-hidden="true"></i></button><button class="avatar small" data-view="perfil" aria-label="Ver perfil de Valeria">VM</button></div></header>
      <main id="contenido" tabindex="-1">
        <section data-panel="resumen">
          <div class="page-heading"><div><div class="eyebrow">TU HOGAR, BIEN ATENDIDO</div><h1>Hola, {getNombre(smile.nombre)}<span class="hello-dot">.</span></h1><p>Qué bueno tenerte aquí. Tu gas y tus pedidos, en un solo lugar.</p></div><button class="primary" data-order><i class="fa-solid fa-plus" aria-hidden="true"></i> Hacer un pedido</button></div>
          <div class="dashboard-grid">
            <article class="card tracking"><div class="card-heading"><span class="overline"><i class="fa-solid fa-motorcycle" aria-hidden="true"></i> TU PEDIDO ACTIVO</span><span class="status">En camino</span></div><div class="tracking-main"><div><h2>Tu gas ya va<br />hacia casa.</h2><p>Pedido #GW-1028 <span>·</span> Hoy, 10:32 a. m.</p><div class="eta"><i class="fa-regular fa-clock" aria-hidden="true"></i><div><strong>12–18 min</strong><small>Llegada estimada · simulación</small></div></div></div><div class="product-stage"><img src={producto.imagen} alt={producto.nombre} /><span>10 kg <b>SOLGAS</b></span></div></div>
              <ol class="tracking-steps" aria-label="Estado del pedido"><li class="done"><i class="fa-solid fa-check" aria-hidden="true"></i><span>Confirmado</span></li><li class="current" aria-current="step"><i class="fa-solid fa-motorcycle" aria-hidden="true"></i><span>En camino</span></li><li><i class="fa-solid fa-house" aria-hidden="true"></i><span>En tu puerta</span></li></ol>
              <div class="delivery-bottom"><span><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Casa · <span data-address-text>Jr. Las Orquídeas 248, dpto. 302</span></span><button class="text-button" data-track>Ver detalle <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></div>
            </article>
            <article class="card points-card"><div class="card-heading"><span class="overline">CADA RECARGA SUMA</span><i class="fa-solid fa-gift" aria-hidden="true"></i></div><h2>Ser de casa<br />tiene sus beneficios.</h2><div class="points-total">{smile.puntos}<span>puntos</span></div><progress value="150" max="200" aria-label="150 de 200 puntos"></progress><p>Te faltan <strong>50 puntos</strong> para tu próxima recompensa.</p><button class="points-link" data-view="puntos">Explorar mis beneficios <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button><small>Beneficio de ejemplo sujeto a validación.</small></article>
            <article class="card reorder"><div class="card-heading"><h2>El de siempre, sin vueltas</h2><span class="muted">Tu favorito</span></div><div class="reorder-content"><img src={producto.imagen} alt="" /><div><h3>SOLGAS de 10 kg</h3><p>Recarga para tu hogar</p><strong class="price">{money(producto.precioPEN)}</strong></div><button class="secondary" data-order>Volver a pedir <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></div><div class="small-note"><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i> Pesaje en tu puerta en cada entrega.</div></article>
            <article class="card gas"><div class="card-heading"><h2>Tu próxima recarga</h2><span class="pill">Estimación</span></div><div class="gas-content"><div class="gauge" role="img" aria-label="Estimación: 18 por ciento restante"><span>18<small>%</small></span></div><div><h3>Quedan unos 5 días</h3><p>Según tu última recarga y tu consumo habitual.</p></div></div><button class="text-button" data-estimate>Ajustar mi consumo <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button><p class="fineprint">Orientativo. No es una medición del balón.</p></article>
          </div>
          <article class="card history"><div class="card-heading"><div><h2>Tus últimos pedidos</h2><p>Todo listo para cuando vuelvas a necesitarlo.</p></div><button class="text-button" data-view="pedidos">Ver todos <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button></div><div class="table-scroll"><table><caption class="sr-only">Pedidos recientes de ejemplo</caption><thead><tr><th>Pedido / fecha</th><th>Producto</th><th>Entrega</th><th>Total</th><th>Estado</th><th><span class="sr-only">Acciones</span></th></tr></thead><tbody>{pedidos.slice(0, 2).map(p => <tr><td><strong>#{p.id}</strong><small>{p.fecha}</small></td><td><div class="table-product"><img src={producto.imagen} alt="" />SOLGAS 10 kg</div></td><td>Casa · Surquillo</td><td><strong>{money(producto.precioPEN)}</strong></td><td><span class:list={['status', { delivered: p.estado === 'Entregado' }]}>{p.estado}</span></td><td><button class="icon-button" data-track={p.id} aria-label={`Ver pedido ${p.id}`}><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></button></td></tr>)}</tbody></table></div></article>
          <div class="trust-strip"><span><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i> Peso que puedes comprobar</span><span><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Atención en cada entrega</span><span><i class="fa-solid fa-location-dot" aria-hidden="true"></i> Tu distribuidor en Surquillo</span></div>
        </section>
        <section data-panel="pedidos" hidden><div class="page-heading"><div><div class="eyebrow">DE NUESTRA PUERTA A LA TUYA</div><h1>Mis pedidos</h1><p>Consulta tus entregas y vuelve a pedir tu favorito.</p></div><button class="primary" data-order>Hacer un pedido</button></div><div class="filters" aria-label="Filtrar pedidos"><button class="secondary active" data-filter="todos" aria-pressed="true">Todos</button><button class="secondary" data-filter="En camino" aria-pressed="false">En camino</button><button class="secondary" data-filter="Entregado" aria-pressed="false">Entregados</button></div><div class="order-list">{pedidos.map(p => <article class="card order-row" data-order-status={p.estado}><img src={producto.imagen} alt="" /><div><span class="status">{p.estado}</span><h2>SOLGAS de 10 kg</h2><p>#{p.id} · {p.fecha} · Casa</p></div><strong class="price">{money(producto.precioPEN)}</strong><button class="secondary" data-track={p.id}>Ver detalle</button>{p.estado === 'Entregado' && <button class="text-button" data-order>Volver a pedir</button>}</article>)}</div></section>
        <section data-panel="direcciones" hidden><div class="page-heading"><div><div class="eyebrow">TUS LUGARES FAVORITOS</div><h1>Mis direcciones</h1><p>La dirección correcta, lista para tu próxima entrega.</p></div></div><article class="card address-card"><span class="address-icon"><i class="fa-solid fa-house" aria-hidden="true"></i></span><span class="pill">Predeterminada</span><h2>Casa</h2><p data-address-text>Jr. Las Orquídeas 248, dpto. 302</p><p>Surquillo, Lima</p><hr /><p>Tocar el intercomunicador 302.</p><button class="secondary" data-edit-address>Editar dirección</button></article><p class="fineprint">Dirección ficticia. Los cambios duran hasta recargar esta preview.</p></section>
        <section data-panel="puntos" hidden><div class="page-heading"><div><div class="eyebrow">GRACIAS POR ELEGIRNOS</div><h1>Mis puntos</h1><p>Cada pedido te acerca a un nuevo beneficio.</p></div></div><div class="two-col"><article class="card points-card"><h2>Tu saldo disponible</h2><div class="points-total">150<span>puntos</span></div><progress value="150" max="200" aria-label="150 de 200 puntos"></progress><p>50 puntos más para llegar a la meta de 200.</p></article><article class="card"><span class="overline">PRÓXIMA RECOMPENSA</span><h2>Una recarga de 10 kg</h2><p>Propuesta de beneficio al alcanzar 200 puntos.</p><button class="secondary" disabled>Necesitas 50 puntos más</button><p class="fineprint">Reglas, vigencia y disponibilidad pendientes de confirmar con el negocio.</p></article></div><article class="card history"><h2>Últimos movimientos</h2><div class="movement"><span>Pedido #GW-0984 · 12 ago 2026</span><strong>+25 puntos</strong></div><div class="movement"><span>Pedido #GW-0916 · 15 jul 2026</span><strong>+25 puntos</strong></div><p class="fineprint">Movimientos ilustrativos; no representan una regla de acumulación vigente.</p></article></section>
        <section data-panel="comprobantes" hidden><div class="page-heading"><div><div class="eyebrow">TODO EN ORDEN</div><h1>Mis comprobantes</h1><p>Encuentra los documentos de tus pedidos entregados.</p></div></div><article class="card"><div class="document-row"><span class="address-icon"><i class="fa-regular fa-file-lines" aria-hidden="true"></i></span><div><h2>Documento de muestra</h2><p>Pedido #GW-0984 · 12 ago 2026 · {money(producto.precioPEN)}</p></div><button class="secondary" data-receipt>Ver muestra</button></div><p class="fineprint">Esta preview no emite boletas ni facturas. La integración fiscal se plantea en el plan.</p></article></section>
        <section data-panel="perfil" hidden><div class="page-heading"><div><div class="eyebrow">TU ESPACIO PERSONAL</div><h1>Mi cuenta</h1><p>Así se verá tu perfil después de iniciar sesión.</p></div></div><article class="card profile-card"><span class="avatar">{avatar(smile.nombre)}</span><h2>{smile.nombre}</h2><p>@{smile.usuario}</p><dl><div><dt>Correo</dt><dd>{smile.email}</dd></div><div><dt>Estado</dt><dd>Cuenta activa</dd></div><div><dt>Plan</dt><dd>VIP</dd></div><div><dt>Producto habitual</dt><dd>{smile.pin}</dd></div></dl><p class="fineprint">Perfil ficticio basado en el modelo de registro actual. No necesitas iniciar sesión para explorar esta propuesta.</p></article></section>
        <footer class="page-footer"><span>© 2026 {datosNegocio.nombre}</span><span>Hecho para que en casa no falte nada.</span></footer>
      </main>
    </div>
    <dialog id="preview-dialog" aria-labelledby="dialog-title"><div class="dialog-top"><span class="eyebrow">MI SOLGAS · PREVIEW</span><button id="dialog-close" class="icon-button" aria-label="Cerrar"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div><div id="dialog-content"></div></dialog>
    <template id="order-template"><h2 id="dialog-title">Tu próxima recarga</h2><p>Revisa los datos antes de continuar.</p><form id="order-form"><div class="order-summary"><img src={producto.imagen} alt="" /><div><strong>{producto.nombre}</strong><p>{money(producto.precioPEN)} · precio de catálogo</p></div></div><label>Entregar en<select name="direccion"><option>Casa · Surquillo</option></select></label><p data-address-text>Jr. Las Orquídeas 248, dpto. 302</p><label>Forma de pago<select name="pago"><option>Yape al recibir</option><option>Efectivo al recibir</option></select></label><div class="movement"><span>Total de ejemplo</span><strong>{money(producto.precioPEN)}</strong></div><p class="fineprint">Simulación: no se enviará ningún pedido. Ya tienes un pedido de ejemplo en camino.</p><button class="primary full" type="submit">Simular pedido</button></form></template>
    <template id="address-template"><h2 id="dialog-title">Editar dirección</h2><p>Casa · Surquillo</p><form id="address-form"><label>Dirección<input name="direccion" required maxlength="120" autocomplete="off" /></label><p class="fineprint">Se aplicará únicamente en esta preview.</p><button class="primary full" type="submit">Guardar cambios</button></form></template>
    <template id="estimate-template"><h2 id="dialog-title">Ajusta tu consumo</h2><p>Referencia orientativa para organizar tu próxima compra.</p><form id="estimate-form"><label>Horas de cocina al día<select name="horas"><option value="1">1 hora</option><option value="2" selected>2 horas</option><option value="3">3 horas</option></select></label><p class="fineprint">Ejemplo basado en un saldo ficticio del 18 %. El consumo real varía según la cocina y el uso.</p><button class="primary full" type="submit">Actualizar estimación</button></form></template>
    <div id="preview-toast" role="status" aria-live="polite" hidden></div>
    <script is:inline type="module">
// Estado efímero: no importar auth.js ni escribir en las claves de la sesión real.
const dialog = document.querySelector('#preview-dialog');
const content = document.querySelector('#dialog-content');
let direccion = 'Jr. Las Orquídeas 248, dpto. 302';
let lastTrigger;
let toastTimer;
const labels = { resumen: 'Mi resumen', pedidos: 'Mis pedidos', direcciones: 'Mis direcciones', puntos: 'Mis puntos', comprobantes: 'Comprobantes', perfil: 'Mi cuenta' };
function view(id, focus = true) {
  if (!Object.hasOwn(labels, id)) id = 'resumen';
  document.querySelectorAll('[data-panel]').forEach(p => { p.hidden = p.dataset.panel !== id; });
  document.querySelectorAll('.nav-item').forEach(b => {
    const active = b.dataset.view === id;
    b.classList.toggle('active', active);
    if (active) b.setAttribute('aria-current', 'page'); else b.removeAttribute('aria-current');
  });
  document.querySelector('#breadcrumb').textContent = labels[id];
  if (focus) {
    history.replaceState(null, '', `#${id}`);
    document.querySelector('#contenido').focus({ preventScroll: true });
    window.scrollTo({ top: 0, behavior: 'instant' });
  }
}
function openDialog(trigger) {
  lastTrigger = trigger;
  dialog.showModal();
}
function closeDialog() { dialog.close(); }
dialog.addEventListener('close', () => lastTrigger?.focus());
document.querySelector('#dialog-close').addEventListener('click', closeDialog);
function template(id, trigger) {
  content.replaceChildren(document.querySelector(id).content.cloneNode(true));
  content.querySelectorAll('[data-address-text]').forEach(e => { e.textContent = direccion; });
  openDialog(trigger);
}
function message(title, paragraphs, trigger) {
  content.replaceChildren();
  const heading = document.createElement('h2'); heading.id = 'dialog-title'; heading.textContent = title;
  content.append(heading);
  paragraphs.forEach(text => { const p = document.createElement('p'); p.textContent = text; content.append(p); });
  openDialog(trigger);
}
function toast(text) {
  const el = document.querySelector('#preview-toast');
  clearTimeout(toastTimer); el.textContent = text; el.hidden = false;
  toastTimer = setTimeout(() => { el.hidden = true; }, 5000);
}
document.addEventListener('click', event => {
  const button = event.target.closest('button'); if (!button) return;
  if (button.dataset.view) view(button.dataset.view);
  if (button.hasAttribute('data-order')) {
    template('#order-template', button);
    content.querySelector('form').addEventListener('submit', e => {
      e.preventDefault();
      const pago = new FormData(e.currentTarget).get('pago');
      closeDialog(); toast(`Simulación completada: recarga para Casa, ${pago}. No se envió un pedido real.`);
    });
  }
  if (button.hasAttribute('data-track')) {
    const id = button.dataset.track || 'GW-1028';
    const active = id === 'GW-1028';
    message(`Pedido #${id}`, [active ? 'En camino · llegada estimada en 12–18 min.' : 'Entregado · recibido en Casa.', `SOLGAS de 10 kg · Casa · ${direccion}, Surquillo.`, active ? 'Confirmado a las 10:32 a. m. · Salida de reparto a las 10:40 a. m.' : 'Entrega completada. Puedes repetir este pedido desde Mis pedidos.', 'Datos ficticios. El seguimiento real y sus horarios se conectarán al servicio de pedidos.'], button);
  }
  if (button.hasAttribute('data-edit-address')) {
    template('#address-template', button);
    content.querySelector('input').value = direccion;
    content.querySelector('form').addEventListener('submit', e => {
      e.preventDefault();
      const input = content.querySelector('input');
      const value = input.value.trim();
      if (!value) { input.setCustomValidity('Escribe una dirección.'); input.reportValidity(); input.addEventListener('input', () => input.setCustomValidity(''), { once: true }); return; }
      direccion = value;
      document.querySelectorAll('[data-address-text]').forEach(el => { el.textContent = direccion; });
      closeDialog(); toast('Dirección actualizada en la preview.');
    });
  }
  if (button.hasAttribute('data-estimate')) {
    template('#estimate-template', button);
    content.querySelector('form').addEventListener('submit', e => {
      e.preventDefault();
      const horas = Number(new FormData(e.currentTarget).get('horas'));
      document.querySelector('.gas-content h3').textContent = `Quedan unos ${Math.round(10 / horas)} días`;
      closeDialog(); toast('Estimación de ejemplo actualizada.');
    });
  }
  if (button.hasAttribute('data-receipt')) message('Documento de muestra', ['SIN VALIDEZ FISCAL · No es una boleta ni una factura.', 'Pedido #GW-0984 · 12 de agosto de 2026.', 'Cliente ficticia: Valeria Mendoza. Producto: recarga SOLGAS de 10 kg.', 'En producción, este espacio abrirá el documento emitido por el proveedor de comprobantes.'], button);
  if (button.hasAttribute('data-help')) message('Tu equipo de Surquillo', ['En el portal final podrás contactar al equipo de atención desde aquí.', 'Esta preview no inicia llamadas ni envía mensajes.'], button);
  if (button.hasAttribute('data-filter')) {
    document.querySelectorAll('[data-filter]').forEach(el => { const active = el === button; el.classList.toggle('active', active); el.setAttribute('aria-pressed', String(active)); });
    document.querySelectorAll('[data-order-status]').forEach(el => { el.hidden = button.dataset.filter !== 'todos' && el.dataset.orderStatus !== button.dataset.filter; });
  }
});
document.querySelector('#theme-toggle').addEventListener('click', e => {
  const dark = document.body.classList.toggle('dark');
  e.currentTarget.setAttribute('aria-pressed', String(dark));
  e.currentTarget.setAttribute('aria-label', dark ? 'Activar tema claro' : 'Activar tema oscuro');
  e.currentTarget.querySelector('i').className = `fa-solid fa-${dark ? 'sun' : 'moon'}`;
});
view(location.hash.slice(1), false);
window.addEventListener('hashchange', () => view(location.hash.slice(1), false));

    </script>
  </body>
</html>
