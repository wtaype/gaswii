---

<!DOCTYPE html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Dashboard del Dueño · Solgas Surquillo (View 64)</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Anti-FOUC Inmediato -->
  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('gaswii-theme') || 'futuro';
      document.documentElement.dataset.theme = savedTheme;
      if (localStorage.getItem('gaswii_sidebar_collapsed') === 'true') {
        document.documentElement.classList.add('is-collapsed');
      }
    } catch (e) {}
  </script>

  <!-- Tipografías e Iconos -->
  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />

  <!-- Estilos WiTema V2.0 Inlined -->
  <style is:global set:html={witemaCss}></style>

  <!-- Estilos Estructurados de View64 -->
  <style is:global>
    :root {
      --side-w: 240px;
      --side-collapsed-w: 72px;
      --topbar-h: 62px;
    }

    /* Reset y base tipográfica compacta */
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: var(--fz_m);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    h1, h2, h3, h4, p { margin: 0; }
    button, input, select, textarea { font-family: inherit; font-size: inherit; }

    /* Layout Shell */
    .v64-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--topbar-h);
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      z-index: 50;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 20px;
      gap: 16px;
      backdrop-filter: blur(16px);
    }

    .v64-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }
    .v64-logo {
      height: 32px;
      width: auto;
      object-fit: contain;
    }
    .v64-brand-text {
      display: flex;
      flex-direction: column;
    }
    .v64-brand-title {
      font-size: var(--fz_m1);
      font-weight: 700;
      letter-spacing: -0.2px;
      color: var(--ink);
      line-height: 1.2;
    }
    .v64-brand-sub {
      font-size: var(--fz_s3);
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .v64-badge-online {
      display: inline-block;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 8px var(--green);
    }

    .v64-top-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .v64-search-box {
      position: relative;
      width: 280px;
    }
    .v64-search-box input {
      width: 100%;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 7px 12px 7px 34px;
      color: var(--ink);
      font-size: var(--fz_s4);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .v64-search-box input:focus {
      border-color: var(--brand-orange);
      box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.15);
    }
    .v64-search-icon {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      font-size: var(--fz_s3);
      pointer-events: none;
    }

    .v64-btn-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      border: 1px solid var(--line);
      background: var(--raised);
      color: var(--ink);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s, transform 0.15s;
    }
    .v64-btn-icon:hover {
      border-color: var(--brand-orange);
      color: var(--brand-orange);
      transform: translateY(-1px);
    }

    .v64-user-badge {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 10px 4px 4px;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 20px;
      cursor: pointer;
    }
    .v64-user-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--brand-orange), #ff9900);
      color: #fff;
      font-weight: 700;
      font-size: var(--fz_s3);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .v64-user-name {
      font-size: var(--fz_s4);
      font-weight: 600;
      color: var(--ink);
    }
    .v64-user-role {
      font-size: var(--fz_s2);
      color: var(--brand-orange);
      text-transform: uppercase;
      font-weight: 700;
      letter-spacing: 0.5px;
    }

    /* Sidebar */
    .v64-sidebar {
      position: fixed;
      top: var(--topbar-h);
      bottom: 0;
      left: 0;
      width: var(--side-w);
      background: var(--surface);
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      z-index: 40;
      transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      overflow-y: auto;
      overflow-x: hidden;
    }
    html.is-collapsed .v64-sidebar {
      width: var(--side-collapsed-w);
    }

    .v64-nav {
      padding: 14px 10px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1;
    }

    .v64-nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 9px 12px;
      border-radius: 8px;
      color: var(--muted);
      border: none;
      background: none;
      cursor: pointer;
      text-align: left;
      font-size: var(--fz_m);
      font-weight: 500;
      transition: background 0.15s, color 0.15s;
      white-space: nowrap;
      position: relative;
    }
    .v64-nav-item:hover {
      background: var(--raised);
      color: var(--ink);
    }
    .v64-nav-item.active {
      background: var(--raised);
      color: var(--brand-orange);
      font-weight: 600;
    }
    .v64-nav-item.active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 6px;
      bottom: 6px;
      width: 3px;
      border-radius: 0 3px 3px 0;
      background: var(--brand-orange);
    }
    .v64-nav-item i {
      font-size: 15px;
      width: 20px;
      text-align: center;
      flex-shrink: 0;
    }
    html.is-collapsed .v64-nav-item {
      justify-content: center;
      padding: 10px 0;
    }
    html.is-collapsed .v64-nav-item span {
      display: none;
    }

    .v64-sidebar-footer {
      padding: 12px 10px;
      border-top: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .v64-btn-collapse {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 8px 12px;
      border-radius: 8px;
      background: none;
      border: 1px solid transparent;
      color: var(--muted);
      cursor: pointer;
      font-size: var(--fz_s4);
      transition: background 0.15s, color 0.15s, border-color 0.15s;
      white-space: nowrap;
    }
    .v64-btn-collapse:hover {
      background: var(--raised);
      color: var(--ink);
      border-color: var(--line);
    }
    html.is-collapsed .v64-btn-collapse {
      justify-content: center;
      padding: 8px 0;
    }
    html.is-collapsed .v64-btn-collapse span {
      display: none;
    }

    /* Contenido Principal */
    .v64-main-shell {
      margin-left: var(--side-w);
      margin-top: var(--topbar-h);
      padding: 24px 28px 60px;
      min-height: calc(100vh - var(--topbar-h));
      transition: margin-left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    html.is-collapsed .v64-main-shell {
      margin-left: var(--side-collapsed-w);
    }

    /* Encabezado de Sección */
    .v64-section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .v64-section-title-wrap {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .v64-section-title {
      font-size: var(--fz_m3);
      font-weight: 700;
      letter-spacing: -0.3px;
      color: var(--ink);
    }
    .v64-section-sub {
      font-size: var(--fz_s4);
      color: var(--muted);
    }
    .v64-header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* Botones primarios y secundarios */
    .v64-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 8px;
      font-size: var(--fz_s4);
      font-weight: 600;
      cursor: pointer;
      border: 1px solid transparent;
      transition: background 0.15s, transform 0.15s, border-color 0.15s, box-shadow 0.15s;
      white-space: nowrap;
    }
    .v64-btn:hover { transform: translateY(-1px); }
    .v64-btn-primary {
      background: var(--brand-orange);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(255, 102, 0, 0.25);
    }
    .v64-btn-primary:hover {
      background: var(--brand-orange-hover);
    }
    .v64-btn-secondary {
      background: var(--raised);
      border-color: var(--line);
      color: var(--ink);
    }
    .v64-btn-secondary:hover {
      border-color: var(--brand-orange);
      color: var(--brand-orange);
    }
    .v64-btn-danger {
      background: rgba(251, 124, 133, 0.12);
      border-color: rgba(251, 124, 133, 0.3);
      color: var(--red);
    }
    .v64-btn-danger:hover {
      background: var(--red);
      color: #ffffff;
    }

    /* Paneles de Contenido */
    .v64-panel {
      display: none;
      animation: v64FadeIn 0.2s ease-out;
    }
    .v64-panel.active {
      display: block;
    }
    @keyframes v64FadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Grilla de Tarjetas y Métricas */
    .v64-kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 22px;
    }
    .v64-kpi-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .v64-kpi-card:hover {
      border-color: rgba(255, 102, 0, 0.35);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }
    .v64-kpi-info {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .v64-kpi-label {
      font-size: var(--fz_s3);
      color: var(--muted);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .v64-kpi-val {
      font-size: var(--fz_m3);
      font-weight: 700;
      color: var(--ink);
    }
    .v64-kpi-note {
      font-size: var(--fz_s2);
      color: var(--green);
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .v64-kpi-icon-wrap {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: var(--raised);
      color: var(--brand-orange);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
    }

    /* Grilla Dividida de Dashboard */
    .v64-split-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 20px;
      margin-bottom: 22px;
    }
    @media (max-width: 980px) {
      .v64-split-grid { grid-template-columns: 1fr; }
    }

    .v64-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 12px;
      overflow: hidden;
    }
    .v64-card-head {
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .v64-card-head h3 {
      font-size: var(--fz_m2);
      font-weight: 600;
      color: var(--ink);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .v64-card-body {
      padding: 18px;
    }

    /* Borrador Rápido (Quick Draft) */
    .v64-draft-form {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .v64-field-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .v64-label {
      font-size: var(--fz_s3);
      font-weight: 600;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    .v64-input, .v64-textarea, .v64-select {
      width: 100%;
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 8px 12px;
      color: var(--ink);
      font-size: var(--fz_m);
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .v64-input:focus, .v64-textarea:focus, .v64-select:focus {
      border-color: var(--brand-orange);
      box-shadow: 0 0 0 3px rgba(255, 102, 0, 0.15);
    }
    .v64-textarea {
      resize: vertical;
      min-height: 85px;
    }

    /* Galería Tira Rápida */
    .v64-media-strip {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 12px;
    }
    .v64-media-item {
      background: var(--raised);
      border: 1px solid var(--line);
      border-radius: 8px;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.15s, border-color 0.15s;
      position: relative;
    }
    .v64-media-item:hover {
      transform: translateY(-2px);
      border-color: var(--brand-orange);
    }
    .v64-media-thumb-wrap {
      height: 90px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.1);
      padding: 6px;
    }
    .v64-media-thumb {
      max-height: 100%;
      max-width: 100%;
      object-fit: contain;
    }
    .v64-media-meta {
      padding: 6px 8px;
      display: flex;
      flex-direction: column;
    }
    .v64-media-name {
      font-size: var(--fz_s3);
      font-weight: 600;
      color: var(--ink);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .v64-media-sub {
      font-size: var(--fz_s2);
      color: var(--muted);
    }

    /* Tablas Compactas */
    .v64-table-wrap {
      overflow-x: auto;
      border-radius: 8px;
      border: 1px solid var(--line);
    }
    .v64-table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: var(--fz_m);
    }
    .v64-table th {
      background: var(--raised);
      color: var(--muted);
      font-size: var(--fz_s3);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 10px 14px;
      border-bottom: 1px solid var(--line);
      white-space: nowrap;
    }
    .v64-table td {
      padding: 10px 14px;
      border-bottom: 1px solid var(--line);
      color: var(--ink);
      vertical-align: middle;
      white-space: nowrap;
    }
    .v64-table tr:last-child td {
      border-bottom: none;
    }
    .v64-table tr:hover td {
      background: var(--raised);
    }

    /* Chips y Badges */
    .v64-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 8px;
      border-radius: 4px;
      font-size: var(--fz_s2);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }
    .v64-badge-success { background: rgba(32, 195, 150, 0.15); color: var(--green); }
    .v64-badge-warning { background: rgba(255, 167, 38, 0.15); color: var(--warning); }
    .v64-badge-orange  { background: rgba(255, 102, 0, 0.15); color: var(--brand-orange); }
    .v64-badge-blue    { background: rgba(2, 132, 199, 0.15); color: var(--brand-blue); }

    /* Notepad / Bloc de Notas del Dueño */
    .v64-notepad-grid {
      display: grid;
      grid-template-columns: 340px 1fr;
      gap: 20px;
    }
    @media (max-width: 900px) {
      .v64-notepad-grid { grid-template-columns: 1fr; }
    }
    .v64-notepad-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-height: 600px;
      overflow-y: auto;
    }
    .v64-note-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 12px 14px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      transition: border-color 0.15s, transform 0.15s;
      position: relative;
    }
    .v64-note-card:hover {
      border-color: var(--brand-orange);
      transform: translateY(-1px);
    }
    .v64-note-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .v64-note-tag {
      font-size: var(--fz_s2);
      font-weight: 700;
      padding: 2px 6px;
      border-radius: 4px;
      text-transform: uppercase;
    }
    .v64-note-date {
      font-size: var(--fz_s2);
      color: var(--muted);
    }
    .v64-note-body {
      font-size: var(--fz_m);
      color: var(--ink);
      line-height: 1.45;
    }
    .v64-note-body.done {
      text-decoration: line-through;
      color: var(--muted);
    }
    .v64-note-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 4px;
    }

    /* Modal emergente para previsualización */
    .v64-modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .v64-modal.active { display: flex; }
    .v64-modal-content {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 14px;
      max-width: 540px;
      width: 100%;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
      animation: v64ModalZoom 0.2s ease-out;
    }
    @keyframes v64ModalZoom {
      from { transform: scale(0.94); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .v64-modal-head {
      padding: 14px 18px;
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .v64-modal-body {
      padding: 18px;
    }
  </style>
</head>
<body>

  <!-- Topbar Unificada -->
  <header class="v64-topbar">
    <div class="v64-brand">
      <img src="/imgwii/logo.webp" alt="Solgas Surquillo" class="v64-logo" />
      <div class="v64-brand-text">
        <span class="v64-brand-title">SOLGAS SURQUILLO</span>
        <span class="v64-brand-sub">
          <span class="v64-badge-online"></span>
          Sede Jr. Dante 260 · Centro de Operaciones
        </span>
      </div>
    </div>

    <!-- Buscador Global Unificado -->
    <div class="v64-search-box">
      <i class="fa-solid fa-magnifying-glass v64-search-icon"></i>
      <input type="text" id="v64GlobalSearch" placeholder="Buscar entradas, productos, páginas…" />
    </div>

    <!-- Acciones Rápidas del Dueño -->
    <div class="v64-top-actions">
      <!-- Botón de cambio de tema -->
      <button class="v64-btn-icon" id="btnThemeToggle" data-witip="Cambiar tema (Futuro / Luz)" aria-label="Cambiar tema">
        <i class="fa-solid fa-circle-half-stroke"></i>
      </button>

      <!-- Ir al sitio público -->
      <a href="/" target="_blank" class="v64-btn-icon" data-witip="Ver sitio web público" aria-label="Sitio web">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
      </a>

      <!-- Perfil del Dueño -->
      <div class="v64-user-badge" id="btnUserBadge" data-witip="Perfil y Sesión del Dueño">
        <div class="v64-user-avatar">WT</div>
        <div>
          <div class="v64-user-name">Wilder Taype</div>
          <div class="v64-user-role">Dueño / Admin</div>
        </div>
      </div>
    </div>
  </header>

  <!-- Sidebar Jerárquico de 8 Módulos -->
  <aside class="v64-sidebar" id="sidebarMenu">
    <nav class="v64-nav" aria-label="Menú principal del dueño">
      {modulos.map((m, idx) => (
        <button 
          class={`v64-nav-item ${idx === 0 ? 'active' : ''}`} 
          data-panel-target={m.id}
          data-witip={m.nombre}
        >
          <i class={m.icono}></i>
          <span>{m.nombre}</span>
        </button>
      ))}
    </nav>

    <!-- Pie de Sidebar con Botón Plegar Menú -->
    <div class="v64-sidebar-footer">
      <button class="v64-btn-collapse" id="btnCollapseSidebar" data-witip="Plegar o expandir menú">
        <i class="fa-solid fa-arrow-left-long" id="iconCollapse"></i>
        <span id="labelCollapse">Plegar menú</span>
      </button>
    </div>
  </aside>

  <!-- Shell de Trabajo Principal -->
  <main class="v64-main-shell">

    <!-- 1. MÓDULO: DASHBOARD -->
    <section class="v64-panel active" id="panel-dashboard">
      <div class="v64-section-header">
        <div class="v64-section-title-wrap">
          <h1 class="v64-section-title">Dashboard del Dueño</h1>
          <p class="v64-section-sub">Resumen integral y control directo de la planta de Surquillo.</p>
        </div>
        <div class="v64-header-actions">
          <button class="v64-btn v64-btn-primary" id="btnQuickNewPost">
            <i class="fa-solid fa-plus"></i> Nueva Entrada
          </button>
        </div>
      </div>

      <!-- 4 KPIs Ejecutivos Compactos -->
      <div class="v64-kpi-grid">
        <div class="v64-kpi-card">
          <div class="v64-kpi-info">
            <span class="v64-kpi-label">Estado de Planta</span>
            <span class="v64-kpi-val">Operativa</span>
            <span class="v64-kpi-note"><i class="fa-solid fa-check"></i> Despacho activo</span>
          </div>
          <div class="v64-kpi-icon-wrap"><i class="fa-solid fa-truck-fast"></i></div>
        </div>

        <div class="v64-kpi-card">
          <div class="v64-kpi-info">
            <span class="v64-kpi-label">Entradas de Blog</span>
            <span class="v64-kpi-val">5 Artículos</span>
            <span class="v64-kpi-note"><i class="fa-solid fa-newspaper"></i> 3 publicadas · 2 borradores</span>
          </div>
          <div class="v64-kpi-icon-wrap"><i class="fa-solid fa-pen-nib"></i></div>
        </div>

        <div class="v64-kpi-card">
          <div class="v64-kpi-info">
            <span class="v64-kpi-label">Fotos en Galería</span>
            <span class="v64-kpi-val">6 en Cloudflare R2</span>
            <span class="v64-kpi-note"><i class="fa-solid fa-cloud"></i> media.solgas...</span>
          </div>
          <div class="v64-kpi-icon-wrap"><i class="fa-solid fa-images"></i></div>
        </div>

        <div class="v64-kpi-card">
          <div class="v64-kpi-info">
            <span class="v64-kpi-label">Balones en Catálogo</span>
            <span class="v64-kpi-val">4 Productos</span>
            <span class="v64-kpi-note"><i class="fa-solid fa-layer-group"></i> 10kg, 45kg y accesorios</span>
          </div>
          <div class="v64-kpi-icon-wrap"><i class="fa-solid fa-fire"></i></div>
        </div>
      </div>

      <!-- Grilla Dividida: Borrador Rápido + Mi Negocio al Día -->
      <div class="v64-split-grid">
        <!-- Borrador Rápido (Quick Draft como en WordPress) -->
        <div class="v64-card">
          <div class="v64-card-head">
            <h3><i class="fa-solid fa-bolt" style="color:var(--brand-orange)"></i> Borrador Rápido de Entrada</h3>
            <span class="v64-badge v64-badge-orange">Boceto</span>
          </div>
          <div class="v64-card-body">
            <form id="formQuickDraft" class="v64-draft-form">
              <div class="v64-field-group">
                <label class="v64-label" for="draftTitle">Título del artículo</label>
                <input type="text" id="draftTitle" class="v64-input" placeholder="Ej: Horario especial por feriados en Surquillo" required />
              </div>
              <div class="v64-field-group">
                <label class="v64-label" for="draftCategory">Categoría</label>
                <select id="draftCategory" class="v64-select">
                  <option value="Seguridad">Seguridad y Prevención</option>
                  <option value="Ahorro">Ahorro y Eficiencia</option>
                  <option value="Novedades">Novedades de la Planta</option>
                  <option value="Recetas">Recetas y Cocina con GLP</option>
                </select>
              </div>
              <div class="v64-field-group">
                <label class="v64-label" for="draftContent">¿En qué estás pensando?</label>
                <textarea id="draftContent" class="v64-textarea" placeholder="Escribe aquí los puntos principales..."></textarea>
              </div>
              <div style="display:flex; justify-content:flex-end;">
                <button type="submit" class="v64-btn v64-btn-primary">
                  <i class="fa-solid fa-floppy-disk"></i> Guardar Borrador
                </button>
              </div>
            </form>
          </div>
        </div>

        <!-- Mi Negocio Glance Card -->
        <div class="v64-card">
          <div class="v64-card-head">
            <h3><i class="fa-solid fa-store" style="color:var(--brand-blue)"></i> Mi Negocio al Día</h3>
            <button class="v64-btn v64-btn-secondary" data-jump-to="business">Editar Ficha</button>
          </div>
          <div class="v64-card-body">
            <div style="display:flex; flex-direction:column; gap:12px;">
              <div style="display:flex; align-items:center; gap:12px;">
                <img src="/imgwii/logo.webp" alt="Logo" style="height:38px; border-radius:6px; background:var(--raised); padding:4px;" />
                <div>
                  <strong style="font-size:var(--fz_m1); color:var(--ink); display:block;">Solgas Surquillo</strong>
                  <span style="font-size:var(--fz_s3); color:var(--muted);">RUC: 20608945123 · Sede Oficial</span>
                </div>
              </div>

              <div style="background:var(--raised); padding:10px 12px; border-radius:8px; border:1px solid var(--line); font-size:var(--fz_s4); display:flex; flex-direction:column; gap:6px;">
                <div><i class="fa-solid fa-location-dot" style="color:var(--brand-orange); width:18px;"></i> Jr. Dante 260, Surquillo, Lima</div>
                <div><i class="fa-solid fa-phone" style="color:var(--green); width:18px;"></i> (01) 241-5555 · 940 200 400</div>
                <div><i class="fa-solid fa-clock" style="color:var(--brand-blue); width:18px;"></i> Lunes a Sábado: 6:00 am - 10:00 pm</div>
                <div><i class="fa-solid fa-map" style="color:var(--warning); width:18px;"></i> Surquillo, Miraflores, San Isidro, San Borja, Surco</div>
              </div>

              <div style="display:flex; gap:8px;">
                <a href="https://wa.me/51940200400" target="_blank" class="v64-btn v64-btn-secondary" style="flex:1; justify-content:center;">
                  <i class="fa-brands fa-whatsapp" style="color:var(--green)"></i> Probar WhatsApp
                </a>
                <button class="v64-btn v64-btn-secondary" data-jump-to="notepad" style="flex:1; justify-content:center;">
                  <i class="fa-solid fa-note-sticky"></i> Anotar en Notepad
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Tira de Galería Reciente -->
      <div class="v64-card">
        <div class="v64-card-head">
          <h3><i class="fa-solid fa-images" style="color:var(--green)"></i> Fotos Recientes en Cloudflare R2</h3>
          <button class="v64-btn v64-btn-secondary" data-jump-to="gallery">Ver Toda la Galería</button>
        </div>
        <div class="v64-card-body">
          <div class="v64-media-strip">
            {fotosGaleriaDemo.slice(0, 5).map(f => (
              <div class="v64-media-item" data-media-url={f.url} data-media-name={f.nombre}>
                <div class="v64-media-thumb-wrap">
                  <img src={f.url} alt={f.nombre} class="v64-media-thumb" />
                </div>
                <div class="v64-media-meta">
                  <span class="v64-media-name">{f.nombre}</span>
                  <span class="v64-media-sub">{f.peso} · {f.dim}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 2. MÓDULO: MI NEGOCIO -->
    <section class="v64-panel" id="panel-business">
      <div class="v64-section-header">
        <div class="v64-section-title-wrap">
          <h1 class="v64-section-title">Mi Negocio</h1>
          <p class="v64-section-sub">Información fiscal, canales de despacho y cobertura de la planta.</p>
        </div>
        <div class="v64-header-actions">
          <button class="v64-btn v64-btn-primary" id="btnSaveBusiness">
            <i class="fa-solid fa-floppy-disk"></i> Guardar Cambios
          </button>
        </div>
      </div>

      <div class="v64-card">
        <div class="v64-card-body">
          <form id="formBusinessDetails" style="display:flex; flex-direction:column; gap:20px;">
            <!-- 01 Identidad -->
            <div>
              <h3 style="font-size:var(--fz_m2); margin-bottom:12px; color:var(--brand-orange);">
                01. Identidad Corporativa
              </h3>
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:14px;">
                <div class="v64-field-group">
                  <label class="v64-label">Nombre Comercial</label>
                  <input type="text" class="v64-input" id="bizNombre" value="Solgas Surquillo" required />
                </div>
                <div class="v64-field-group">
                  <label class="v64-label">RUC de Planta</label>
                  <input type="text" class="v64-input" id="bizRuc" value="20608945123" maxlength="11" />
                </div>
                <div class="v64-field-group" style="grid-column:1/-1;">
                  <label class="v64-label">Razón Social</label>
                  <input type="text" class="v64-input" id="bizLegal" value="DISTRIBUIDORA GASWII SOLGAS S.A.C." />
                </div>
                <div class="v64-field-group" style="grid-column:1/-1;">
                  <label class="v64-label">Descripción de la Empresa</label>
                  <textarea class="v64-textarea" id="bizDesc" rows="2">Distribuidor Oficial de Solgas en Surquillo y distritos aledaños. Más de 25 años garantizando pesaje exacto, válvulas de seguridad y despacho express a domicilio.</textarea>
                </div>
              </div>
            </div>

            <hr style="border:0; border-top:1px solid var(--line); margin:0;" />

            <!-- 02 Contacto -->
            <div>
              <h3 style="font-size:var(--fz_m2); margin-bottom:12px; color:var(--green);">
                02. Canales de Contacto y Despacho
              </h3>
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:14px;">
                <div class="v64-field-group">
                  <label class="v64-label">Teléfono Fijo Central</label>
                  <input type="tel" class="v64-input" id="bizPhone" value="(01) 241-5555" />
                </div>
                <div class="v64-field-group">
                  <label class="v64-label">WhatsApp de Despacho (con +51)</label>
                  <input type="tel" class="v64-input" id="bizWhatsapp" value="+51 940 200 400" />
                </div>
                <div class="v64-field-group">
                  <label class="v64-label">Correo Electrónico</label>
                  <input type="email" class="v64-input" id="bizEmail" value="pedidos@solgassurquillo.com" />
                </div>
              </div>
            </div>

            <hr style="border:0; border-top:1px solid var(--line); margin:0;" />

            <!-- 03 Ubicación y Cobertura -->
            <div>
              <h3 style="font-size:var(--fz_m2); margin-bottom:12px; color:var(--brand-blue);">
                03. Ubicación y Zonas de Cobertura
              </h3>
              <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:14px;">
                <div class="v64-field-group" style="grid-column:1/-1;">
                  <label class="v64-label">Dirección Física de la Planta</label>
                  <input type="text" class="v64-input" id="bizAddress" value="Jr. Dante 260, Surquillo, Lima" />
                </div>
                <div class="v64-field-group">
                  <label class="v64-label">Referencia</label>
                  <input type="text" class="v64-input" id="bizRef" value="A media cuadra de Av. Angamos Este" />
                </div>
                <div class="v64-field-group">
                  <label class="v64-label">Enlace de Google Maps</label>
                  <input type="url" class="v64-input" id="bizMap" value="https://maps.google.com/?q=Jr.+Dante+260+Surquillo" />
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- 3. MÓDULO: PRODUCTOS -->
    <section class="v64-panel" id="panel-products">
      <div class="v64-section-header">
        <div class="v64-section-title-wrap">
          <h1 class="v64-section-title">Catálogo de Productos</h1>
          <p class="v64-section-sub">Control de balones Solgas, stocks y precios sincronizados.</p>
        </div>
        <div class="v64-header-actions">
          <button class="v64-btn v64-btn-primary" id="btnNewProduct">
            <i class="fa-solid fa-plus"></i> Nuevo Producto
          </button>
        </div>
      </div>

      <div class="v64-table-wrap">
        <table class="v64-table">
          <thead>
            <tr>
              <th>Producto</th>
              <th>Tipo</th>
              <th>Precio Reg.</th>
              <th>Con Envase</th>
              <th>Stock</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            {productosDemo.map(p => (
              <tr>
                <td>
                  <strong style="color:var(--ink);">{p.nombre}</strong>
                </td>
                <td><span class="v64-badge v64-badge-blue">{p.tipo}</span></td>
                <td><strong style="color:var(--brand-orange)">S/ {p.precio}</strong></td>
                <td>S/ {p.envase}</td>
                <td><span class="v64-badge v64-badge-success">{p.stock} unid.</span></td>
                <td><span class="v64-badge v64-badge-orange">{p.estado}</span></td>
                <td>
                  <button class="v64-btn v64-btn-secondary" style="padding:4px 8px;" data-witip="Editar producto">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 4. MÓDULO: GALERIA -->
    <section class="v64-panel" id="panel-gallery">
      <div class="v64-section-header">
        <div class="v64-section-title-wrap">
          <h1 class="v64-section-title">Galería Multimedia</h1>
          <p class="v64-section-sub">Imágenes optimizadas en Cloudflare R2 (media.solgassurquillo.com).</p>
        </div>
        <div class="v64-header-actions">
          <label class="v64-btn v64-btn-primary" style="cursor:pointer;">
            <i class="fa-solid fa-cloud-arrow-up"></i> Subir Foto a R2
            <input type="file" id="r2InputFile" accept="image/*" hidden />
          </label>
        </div>
      </div>

      <div class="v64-media-strip" style="grid-template-columns:repeat(auto-fill, minmax(180px, 1fr));">
        {fotosGaleriaDemo.map(f => (
          <div class="v64-media-item" data-media-url={f.url} data-media-name={f.nombre}>
            <div class="v64-media-thumb-wrap" style="height:120px;">
              <img src={f.url} alt={f.nombre} class="v64-media-thumb" />
            </div>
            <div class="v64-media-meta">
              <span class="v64-media-name">{f.nombre}</span>
              <span class="v64-media-sub">{f.peso} · {f.dim} · {f.fecha}</span>
              <button class="v64-btn v64-btn-secondary btn-copy-url" data-url={f.url} style="margin-top:6px; padding:4px 8px; font-size:var(--fz_s2);">
                <i class="fa-solid fa-copy"></i> Copiar URL
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 5. MÓDULO: ENTRADAS -->
    <section class="v64-panel" id="panel-posts">
      <div class="v64-section-header">
        <div class="v64-section-title-wrap">
          <h1 class="v64-section-title">Entradas y Blog</h1>
          <p class="v64-section-sub">Publicaciones de consejos de seguridad, ahorro y cocina con GLP.</p>
        </div>
        <div class="v64-header-actions">
          <button class="v64-btn v64-btn-primary" id="btnNewPostModal">
            <i class="fa-solid fa-plus"></i> Nueva Entrada
          </button>
        </div>
      </div>

      <div class="v64-table-wrap">
        <table class="v64-table">
          <thead>
            <tr>
              <th>Título</th>
              <th>Categoría</th>
              <th>Estado</th>
              <th>Fecha</th>
              <th>Vistas</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            {articulosDemo.map(a => (
              <tr>
                <td><strong>{a.titulo}</strong></td>
                <td><span class="v64-badge v64-badge-blue">{a.categoria}</span></td>
                <td>
                  <span class={`v64-badge ${a.estado === 'Publicado' ? 'v64-badge-success' : 'v64-badge-warning'}`}>
                    {a.estado}
                  </span>
                </td>
                <td>{a.fecha}</td>
                <td>{a.visitas > 0 ? `${a.visitas} lecturas` : '—'}</td>
                <td>
                  <div style="display:flex; gap:6px;">
                    <button class="v64-btn v64-btn-secondary" style="padding:4px 8px;" data-witip="Editar entrada">
                      <i class="fa-solid fa-pen-to-square"></i>
                    </button>
                    <button class="v64-btn v64-btn-danger btn-delete-post" data-title={a.titulo} style="padding:4px 8px;" data-witip="Eliminar">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 6. MÓDULO: PÁGINAS -->
    <section class="v64-panel" id="panel-pages">
      <div class="v64-section-header">
        <div class="v64-section-title-wrap">
          <h1 class="v64-section-title">Páginas del Sitio</h1>
          <p class="v64-section-sub">Estructura y estado de las páginas oficiales de Solgas Surquillo.</p>
        </div>
      </div>

      <div class="v64-table-wrap">
        <table class="v64-table">
          <thead>
            <tr>
              <th>Nombre de la Página</th>
              <th>Ruta / Slug</th>
              <th>Estado</th>
              <th>Última Modificación</th>
              <th>Acción</th>
            </tr>
          </thead>
          <tbody>
            {paginasDemo.map(p => (
              <tr>
                <td><strong>{p.titulo}</strong></td>
                <td><code style="background:var(--raised); padding:2px 6px; border-radius:4px; font-size:var(--fz_s3);">{p.slug}</code></td>
                <td><span class="v64-badge v64-badge-success">{p.estado}</span></td>
                <td>{p.modif}</td>
                <td>
                  <a href={p.slug} target="_blank" class="v64-btn v64-btn-secondary" style="padding:4px 8px;">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Ver
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- 7. MÓDULO: NOTEPAD -->
    <section class="v64-panel" id="panel-notepad">
      <div class="v64-section-header">
        <div class="v64-section-title-wrap">
          <h1 class="v64-section-title">Notepad del Dueño</h1>
          <p class="v64-section-sub">Apuntes operativos, recordatorios de compra a planta y notas rápidas.</p>
        </div>
      </div>

      <div class="v64-notepad-grid">
        <!-- Creador de Nota -->
        <div class="v64-card">
          <div class="v64-card-head">
            <h3><i class="fa-solid fa-pen" style="color:var(--brand-orange)"></i> Nueva Nota</h3>
          </div>
          <div class="v64-card-body">
            <form id="formNewNote" class="v64-draft-form">
              <div class="v64-field-group">
                <label class="v64-label">Etiqueta de Prioridad</label>
                <select id="noteTag" class="v64-select">
                  <option value="Urgente">⚡ Urgente / Hoy</option>
                  <option value="Planta">🏢 Compra a Planta</option>
                  <option value="Pedidos">🛵 Pedido Especial</option>
                  <option value="Idea">💡 Idea / Proyecto</option>
                </select>
              </div>
              <div class="v64-field-group">
                <label class="v64-label">Contenido del apunte</label>
                <textarea id="noteText" class="v64-textarea" placeholder="Escribe aquí tu recordatorio..." rows="4" required></textarea>
              </div>
              <button type="submit" class="v64-btn v64-btn-primary" style="width:100%; justify-content:center;">
                <i class="fa-solid fa-plus"></i> Guardar Nota
              </button>
            </form>
          </div>
        </div>

        <!-- Listado de Notas Persistentes -->
        <div class="v64-card">
          <div class="v64-card-head">
            <h3><i class="fa-solid fa-clipboard-list" style="color:var(--green)"></i> Mis Notas Registradas</h3>
            <span id="noteCount" class="v64-badge v64-badge-blue">3 notas</span>
          </div>
          <div class="v64-card-body">
            <div class="v64-notepad-list" id="notepadContainer">
              <!-- Renderizado dinámico desde script -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. MÓDULO: AJUSTES -->
    <section class="v64-panel" id="panel-settings">
      <div class="v64-section-header">
        <div class="v64-section-title-wrap">
          <h1 class="v64-section-title">Ajustes Generales</h1>
          <p class="v64-section-sub">Configuración del sitio, SEO, WhatsApp API y credenciales de Cloudflare.</p>
        </div>
        <div class="v64-header-actions">
          <button class="v64-btn v64-btn-primary" id="btnSaveSettings">
            <i class="fa-solid fa-floppy-disk"></i> Guardar Ajustes
          </button>
        </div>
      </div>

      <div class="v64-card">
        <div class="v64-card-body" style="display:flex; flex-direction:column; gap:18px;">
          <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:14px;">
            <div class="v64-field-group">
              <label class="v64-label">Título SEO del Sitio</label>
              <input type="text" class="v64-input" value="Solgas Surquillo · Distribuidor Oficial Autorizado" />
            </div>
            <div class="v64-field-group">
              <label class="v64-label">Dominio Cloudflare R2</label>
              <input type="text" class="v64-input" value="https://media.solgassurquillo.com" readonly />
            </div>
            <div class="v64-field-group" style="grid-column:1/-1;">
              <label class="v64-label">Descripción Meta (Google Snippet)</label>
              <textarea class="v64-textarea" rows="2">Pedir balón de gas Solgas de 10kg y 45kg en Surquillo. Despacho rápido a Jr. Dante, Angamos, Miraflores y distritos vecinos con pesaje digital verificado.</textarea>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <!-- Modal de Previsualización de Imagen -->
  <div class="v64-modal" id="modalImgPreview">
    <div class="v64-modal-content">
      <div class="v64-modal-head">
        <h3 style="font-size:var(--fz_m2);" id="modalPreviewTitle">Detalle de Foto</h3>
        <button class="v64-btn-icon" id="btnClosePreview" aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="v64-modal-body" style="text-align:center;">
        <img id="modalPreviewImg" src="" alt="Preview" style="max-height:280px; max-width:100%; object-fit:contain; border-radius:8px; margin-bottom:14px;" />
        <p id="modalPreviewUrl" style="font-size:var(--fz_s3); color:var(--muted); word-break:break-all; background:var(--raised); padding:8px; border-radius:6px; border:1px solid var(--line);"></p>
        <button class="v64-btn v64-btn-primary" id="btnModalCopyUrl" style="margin-top:12px; width:100%; justify-content:center;">
          <i class="fa-solid fa-copy"></i> Copiar Enlace Directo
        </button>
      </div>
    </div>
  </div>

  <!-- Scripts Nativos del Dashboard (0 TypeScript en runtime) -->
  <script is:inline>
    (function () {
      // 1. Selector de Pestañas (8 Módulos)
      const navItems = document.querySelectorAll('.v64-nav-item');
      const panels = document.querySelectorAll('.v64-panel');

      function switchPanel(targetId) {
        navItems.forEach(item => {
          const isTarget = item.getAttribute('data-panel-target') === targetId;
          item.classList.toggle('active', isTarget);
        });

        panels.forEach(p => {
          p.classList.toggle('active', p.id === `panel-${targetId}`);
        });

        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      navItems.forEach(btn => {
        btn.addEventListener('click', () => {
          const target = btn.getAttribute('data-panel-target');
          if (target) switchPanel(target);
        });
      });

      // Botones de salto entre paneles
      document.querySelectorAll('[data-jump-to]').forEach(btn => {
        btn.addEventListener('click', () => {
          const dest = btn.getAttribute('data-jump-to');
          if (dest) switchPanel(dest);
        });
      });

      // 2. Colapsar / Plegar Sidebar
      const btnCollapse = document.getElementById('btnCollapseSidebar');
      const iconCollapse = document.getElementById('iconCollapse');
      const labelCollapse = document.getElementById('labelCollapse');

      function toggleSidebar() {
        const isCollapsed = document.documentElement.classList.toggle('is-collapsed');
        localStorage.setItem('gaswii_sidebar_collapsed', isCollapsed ? 'true' : 'false');
        if (iconCollapse && labelCollapse) {
          if (isCollapsed) {
            iconCollapse.className = 'fa-solid fa-arrow-right-long';
            labelCollapse.textContent = 'Expandir';
          } else {
            iconCollapse.className = 'fa-solid fa-arrow-left-long';
            labelCollapse.textContent = 'Plegar menú';
          }
        }
      }

      btnCollapse?.addEventListener('click', toggleSidebar);

      // 3. Conmutador de Temas (Futuro / Luz)
      const btnTheme = document.getElementById('btnThemeToggle');
      btnTheme?.addEventListener('click', () => {
        const current = document.documentElement.dataset.theme || 'futuro';
        const next = current === 'futuro' ? 'luz' : 'futuro';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('gaswii-theme', next);
        
        // Notificación WiDev si está disponible
        if (window.Notificacion) {
          window.Notificacion(`Tema cambiado a ${next === 'futuro' ? 'Modo Futuro (Oscuro)' : 'Modo Luz (Claro)'}`, 'info', 2000);
        }
      });

      // 4. Bloc de Notas (Notepad) Reactivo y Persistente
      const notepadContainer = document.getElementById('notepadContainer');
      const formNewNote = document.getElementById('formNewNote');
      const noteCount = document.getElementById('noteCount');

      const STORAGE_KEY_NOTES = 'gaswii_owner_notes';
      let notas = [
        { id: 'n1', tag: 'Urgente', texto: 'Coordinar con planta Solgas el ingreso de 50 balones de 10kg para el fin de semana.', fecha: '20 Sep, 10:30 am', done: false },
        { id: 'n2', tag: 'Planta', texto: 'Calibración semanal de la balanza digital Inacal programada para el jueves.', fecha: '19 Sep, 04:15 pm', done: false },
        { id: 'n3', tag: 'Pedidos', texto: 'Cliente frecuente Sr. Méndez solicita 2 balones de 45kg para pollería en Angamos.', fecha: '18 Sep, 02:00 pm', done: true }
      ];

      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY_NOTES));
        if (Array.isArray(saved)) notas = saved;
      } catch (e) {}

      function renderNotes() {
        if (!notepadContainer) return;
        if (noteCount) noteCount.textContent = `${notas.length} notas`;

        if (notas.length === 0) {
          notepadContainer.innerHTML = '<p style="color:var(--muted); text-align:center; padding:20px;">No tienes notas pendientes. ¡Todo en orden!</p>';
          return;
        }

        notepadContainer.innerHTML = notas.map(n => `
          <div class="v64-note-card" data-note-id="${n.id}">
            <div class="v64-note-head">
              <span class="v64-note-tag ${n.tag === 'Urgente' ? 'v64-badge-warning' : 'v64-badge-blue'}">${n.tag}</span>
              <span class="v64-note-date">${n.fecha}</span>
            </div>
            <p class="v64-note-body ${n.done ? 'done' : ''}">${n.texto}</p>
            <div class="v64-note-actions">
              <button class="v64-btn v64-btn-secondary btn-toggle-note" style="padding:2px 6px; font-size:11px;" title="${n.done ? 'Marcar pendiente' : 'Marcar completado'}">
                <i class="fa-solid ${n.done ? 'fa-rotate-left' : 'fa-check'}"></i>
              </button>
              <button class="v64-btn v64-btn-danger btn-del-note" style="padding:2px 6px; font-size:11px;" title="Eliminar nota">
                <i class="fa-solid fa-trash"></i>
              </button>
            </div>
          </div>
        `).join('');

        // Eventos en notas
        notepadContainer.querySelectorAll('.btn-toggle-note').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const card = e.target.closest('.v64-note-card');
            const id = card?.getAttribute('data-note-id');
            const note = notas.find(item => item.id === id);
            if (note) {
              note.done = !note.done;
              localStorage.setItem(STORAGE_KEY_NOTES, JSON.stringify(notas));
              renderNotes();
            }
          });
        });

        notepadContainer.querySelectorAll('.btn-del-note').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const card = e.target.closest('.v64-note-card');
            const id = card?.getAttribute('data-note-id');
            notas = notas.filter(item => item.id !== id);
            localStorage.setItem(STORAGE_KEY_NOTES, JSON.stringify(notas));
            renderNotes();
          });
        });
      }

      formNewNote?.addEventListener('submit', (e) => {
        e.preventDefault();
        const tag = document.getElementById('noteTag')?.value || 'General';
        const texto = document.getElementById('noteText')?.value?.trim();
        if (!texto) return;

        const now = new Date();
        const fechaStr = `${now.getDate()} ${now.toLocaleString('es-ES', { month: 'short' })}, ${now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;

        notas.unshift({
          id: 'n_' + Date.now(),
          tag,
          texto,
          fecha: fechaStr,
          done: false
        });

        localStorage.setItem(STORAGE_KEY_NOTES, JSON.stringify(notas));
        renderNotes();
        formNewNote.reset();
        
        if (window.Notificacion) {
          window.Notificacion('Nota guardada en tu bloc personal', 'success', 2500);
        }
      });

      renderNotes();

      // 5. Borrador Rápido en Dashboard
      const formQuickDraft = document.getElementById('formQuickDraft');
      formQuickDraft?.addEventListener('submit', (e) => {
        e.preventDefault();
        const title = document.getElementById('draftTitle')?.value?.trim();
        if (title && window.Notificacion) {
          window.Notificacion(`Borrador <strong>"${title}"</strong> guardado correctamente`, 'success', 3000);
          formQuickDraft.reset();
        }
      });

      // 6. Copiar URL de Medios
      document.querySelectorAll('.btn-copy-url').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const url = btn.getAttribute('data-url');
          if (url && navigator.clipboard) {
            navigator.clipboard.writeText(window.location.origin + url);
            if (window.Notificacion) {
              window.Notificacion('Enlace directo copiado al portapapeles', 'success', 2500);
            }
          }
        });
      });

      // 7. Modal de Previsualización de Fotos
      const modalPreview = document.getElementById('modalImgPreview');
      const previewImg = document.getElementById('modalPreviewImg');
      const previewTitle = document.getElementById('modalPreviewTitle');
      const previewUrl = document.getElementById('modalPreviewUrl');
      const btnClosePreview = document.getElementById('btnClosePreview');
      const btnModalCopy = document.getElementById('btnModalCopyUrl');

      document.querySelectorAll('.v64-media-item').forEach(card => {
        card.addEventListener('click', () => {
          const url = card.getAttribute('data-media-url');
          const name = card.getAttribute('data-media-name');
          if (previewImg && url) previewImg.src = url;
          if (previewTitle) previewTitle.textContent = name || 'Foto';
          if (previewUrl) previewUrl.textContent = window.location.origin + url;
          if (modalPreview) modalPreview.classList.add('active');
        });
      });

      btnClosePreview?.addEventListener('click', () => {
        modalPreview?.classList.remove('active');
      });
      modalPreview?.addEventListener('click', (e) => {
        if (e.target === modalPreview) modalPreview.classList.remove('active');
      });

      btnModalCopy?.addEventListener('click', () => {
        if (previewUrl && navigator.clipboard) {
          navigator.clipboard.writeText(previewUrl.textContent);
          if (window.Notificacion) {
            window.Notificacion('URL de Cloudflare R2 copiada', 'success', 2000);
          }
          modalPreview?.classList.remove('active');
        }
      });

      // 8. Botón Guardar Mi Negocio
      document.getElementById('btnSaveBusiness')?.addEventListener('click', () => {
        if (window.Notificacion) {
          window.Notificacion('Datos de Mi Negocio guardados con éxito', 'success', 3000);
        }
      });

      // 9. Eliminar Entrada con confirmación
      document.querySelectorAll('.btn-delete-post').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const title = btn.getAttribute('data-title') || 'esta entrada';
          if (window.wiConfirmar) {
            const conf = await window.wiConfirmar(`¿Deseas eliminar la entrada <strong>${title}</strong>?`, {
              tipo: 'danger',
              siTexto: 'Eliminar',
              noTexto: 'Cancelar'
            });
            if (conf && window.Notificacion) {
              window.Notificacion(`Entrada eliminada correctamente`, 'warning', 2500);
              btn.closest('tr')?.remove();
            }
          }
        });
      });

      // 10. Buscador Global Unificado
      const globalSearch = document.getElementById('v64GlobalSearch');
      globalSearch?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        if (!query) return;

        // Si coincide con un módulo, podemos sugerir o saltar
        if (query.includes('negocio')) switchPanel('business');
        else if (query.includes('prod') || query.includes('balon')) switchPanel('products');
        else if (query.includes('foto') || query.includes('gal')) switchPanel('gallery');
        else if (query.includes('blog') || query.includes('entrad')) switchPanel('posts');
        else if (query.includes('pag')) switchPanel('pages');
        else if (query.includes('nota') || query.includes('pad')) switchPanel('notepad');
      });

    })();
  </script>

  <!-- Importador dinámico de widev.js para notificaciones y tooltips -->
  <script type="module">
    import { Notificacion, wiConfirmar, wiTip } from '../core/widev/widev.js';
    window.Notificacion = Notificacion;
    window.wiConfirmar = wiConfirmar;
    window.wiTip = wiTip;
    
    // Inicializar tooltips en elementos con data-witip
    try {
      wiTip();
    } catch (e) {}
  </script>
</body>
</html>
