---
// src/pages/view80.astro
// VIEW 80: Horizontal Cards + Smart Tabbed Message Composer (Modo Rápido vs Modo Libre)
// Header completo y realista · Selector por pestañas (Toggles guiados vs Mensaje libre) · Emojis · Reset
// Ajuste 100vh en Desktop · Mobile Dock Nativo · 100% Español · Cero build pesado
import { avatar } from '../core/widev/nombre.js';
import witemaCss from '../core/wicss/witema.css?inline';

const cliente = {
  nombre: 'Valeria',
  apellido: 'Mendoza',
  nombreCompleto: 'Valeria Mendoza',
  usuario: 'valeria.m',
  telefono: '+51 987 654 321',
  email: 'valeria.mendoza@gmail.com',
  dni: '74829103',
  tipoComprobante: 'boleta',
