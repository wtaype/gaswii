  <script is:inline define:vars={{products}}>
    (() => {
      const $ = id => document.getElementById(id);
      const money = amount => 'S/ ' + Number(amount).toLocaleString('es-PE', {minimumFractionDigits:2,maximumFractionDigits:2});
      const escape = value => String(value ?? '').replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
      const orders = [
        {id:1048,name:'Valeria Mendoza',address:'Jr. Dante 260, Surquillo',product:'solgas',quantity:1,payment:'Yape',status:'Pendiente',driver:'Sin asignar',time:'Hace 2 min'},
        {id:1047,name:'Restaurante El Dante',address:'Av. Angamos Este 1540, Surquillo',product:'industrial',quantity:1,payment:'Transferencia',status:'En camino',driver:'Carlos Mendoza',time:'Hace 5 min'},
        {id:1046,name:'Claudia Romero',address:'Av. Paseo de la República 4890, Miraflores',product:'solgas',quantity:1,payment:'Efectivo',status:'En camino',driver:'Luis Ramos',time:'Hace 8 min'},
        {id:1045,name:'Jorge Zegarra',address:'Jr. Huáscar 820, Surquillo',product:'masgas',quantity:1,payment:'Plin',status:'Pendiente',driver:'Sin asignar',time:'Hace 10 min'},
        {id:1044,name:'Lucía Fernández',address:'Calle Las Águilas 180, Surquillo',product:'solgas',quantity:2,payment:'Yape',status:'En camino',driver:'Carlos Mendoza',time:'Hace 12 min'},
        {id:1043,name:'Daniel Torres',address:'Jr. San Pedro 340, Surquillo',product:'solgas',quantity:1,payment:'Efectivo',status:'Pendiente',driver:'Sin asignar',time:'Hace 14 min'}
      ];
      let filter='all', selectedOrder=null, restockId=null, toastTimer;
      const pageNames={overview:['Un buen día para avanzar.','Hola, Wilder. Tu equipo, tus clientes y tu planta, en un solo lugar.'],orders:['Los pedidos, en tus manos.','Organiza, asigna y acompaña cada entrega.'],inventory:['El control empieza aquí.','Todo lo que entra, todo lo que sale.'],team:['Juntos, llegamos más lejos.','Las personas detrás de cada entrega.'],customers:['Más que clientes, vecinos.','Cada nombre es una relación que cuidar.'],sunat:['Tus comprobantes, en orden.','Prepara cada documento con claridad y confianza.'],whatsapp:['Más cerca, en cada mensaje.','Una comunicación cálida, clara y a tiempo.'],reports:['Una mirada al crecimiento.','Información clara para tu próxima decisión.']};
      function toast(message){$('toastText').textContent=message;$('toast').classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').classList.remove('show'),3500)}
      function closeMenu(){$('sidebar').classList.remove('open');$('scrim').hidden=true;$('menuButton').setAttribute('aria-expanded','false')}
      function navigate(page){if(!pageNames[page])return;document.querySelectorAll('[data-panel]').forEach(el=>el.hidden=el.dataset.panel!==page);document.querySelectorAll('.nav-item').forEach(el=>{el.classList.toggle('active',el.dataset.page===page);if(el.dataset.page===page)el.setAttribute('aria-current','page');else el.removeAttribute('aria-current')});$('breadcrumb').textContent=document.querySelector('.nav-item[data-page="'+page+'"] span').textContent;$('pageTitle').textContent=pageNames[page][0];$('pageSubtitle').textContent=pageNames[page][1];closeMenu();window.scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'})}
      document.querySelectorAll('[data-page]').forEach(el=>el.addEventListener('click',()=>navigate(el.dataset.page)));
      $('menuButton').addEventListener('click',()=>{const open=$('sidebar').classList.toggle('open');$('scrim').hidden=!open;$('menuButton').setAttribute('aria-expanded',String(open))});$('scrim').addEventListener('click',closeMenu);document.addEventListener('keydown',e=>{if(e.key==='Escape')closeMenu()});
      $('themeButton').addEventListener('click',()=>{const theme=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=theme;try{localStorage.setItem('gaswii-view57-theme',theme)}catch{}});
      $('notifications').addEventListener('click',()=>{navigate('inventory');const low=products.filter(p=>p.stock<p.min);toast(low.length?'Por reponer: '+low.map(p=>p.name).join(', ')+'.':'Todo en orden. Existencias saludables.')});
      $('profile').addEventListener('click',()=>toast('Wilder Alarcón · Gestor propietario · Sesión de demostración'));
      $('dateLabel').textContent=new Intl.DateTimeFormat('es-PE',{weekday:'long',day:'numeric',month:'long',timeZone:'America/Lima'}).format(new Date()).toUpperCase();
      const getProduct=id=>products.find(p=>p.id===id);
      const initials=name=>name.trim().split(/\s+/).slice(0,2).map(n=>n[0]).join('').toUpperCase();
      function statusTag(status){const color=status==='Pendiente'?'amber':status==='En camino'?'blue':'green';return '<span class="tag '+color+'"><span class="status-dot"></span>'+escape(status)+'</span>'}
