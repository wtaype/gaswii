      function render(){const active=orders.filter(o=>o.status!=='Entregado');const filtered=active.filter(o=>filter==='all'||o.status===filter);$('overviewOrders').innerHTML=filtered.length?filtered.slice(0,6).map(orderRow).join(''):'<tr><td colspan="5" class="empty">Todo en orden. No hay pedidos en este estado.</td></tr>';const query=$('orderSearch').value.toLocaleLowerCase('es').trim();const state=$('orderStatus').value;const all=orders.filter(o=>(state==='all'||o.status===state)&&[o.name,o.address,'GW-'+o.id].some(s=>s.toLocaleLowerCase('es').includes(query)));$('allOrders').innerHTML=all.length?all.map(orderRow).join(''):'<tr><td colspan="5" class="empty">No encontramos pedidos con esa búsqueda.</td></tr>';$('activeCount').textContent=active.length;$('navCount').textContent=active.length;$('pendingCount').textContent=orders.filter(o=>o.status==='Pendiente').length;$('routeKpi').textContent=orders.filter(o=>o.status==='En camino').length;$('visibleCount').textContent=active.length+' pedidos activos';const delivered=orders.filter(o=>o.status==='Entregado');$('completedKpi').innerHTML=(42+delivered.length)+' <span class="value-unit">pedidos</span>';$('salesKpi').textContent=(2860+delivered.reduce((sum,o)=>sum+getProduct(o.product).price*o.quantity,0)).toLocaleString('es-PE');renderCustomers()}
      document.querySelectorAll('[data-status]').forEach(el=>el.addEventListener('click',()=>{filter=el.dataset.status;document.querySelectorAll('[data-status]').forEach(b=>{b.classList.toggle('selected',b===el);b.setAttribute('aria-pressed',String(b===el))});render()}));
      $('orderSearch').addEventListener('input',render);$('orderStatus').addEventListener('change',render);$('focusSearch').addEventListener('click',()=>{navigate('orders');$('orderSearch').focus()});
      function renderCustomers(){const query=$('customerSearch').value.toLocaleLowerCase('es').trim();const unique=[...new Map(orders.map(o=>[o.name,o])).values()].filter(o=>o.name.toLocaleLowerCase('es').includes(query));$('customerGrid').innerHTML=unique.length?unique.map(o=>'<article class="customer-card"><span class="avatar green">'+escape(initials(o.name))+'</span><h3>'+escape(o.name)+'</h3><p>'+escape(o.address)+'</p><span class="tag neutral">'+escape(getProduct(o.product).name)+'</span></article>').join(''):'<p class="empty">No encontramos clientes con ese nombre.</p>'}
      $('customerSearch').addEventListener('input',()=>renderCustomers());
      document.querySelectorAll('[data-close]').forEach(button=>button.addEventListener('click',()=>$(button.dataset.close).close()));document.querySelectorAll('dialog').forEach(dialog=>dialog.addEventListener('click',event=>{if(event.target!==dialog)return;const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close()}));
      const form=$('orderForm');function total(){const product=getProduct(form.elements.product.value);$('formTotal').textContent=money(product.price*Math.max(0,Number(form.elements.quantity.value)||0))}form.addEventListener('input',total);form.addEventListener('change',total);
      document.querySelectorAll('[data-new-order]').forEach(button=>button.addEventListener('click',()=>{form.reset();total();$('orderDialog').showModal()}));
      form.addEventListener('submit',event=>{event.preventDefault();const data=new FormData(form);const name=String(data.get('name')).trim(),address=String(data.get('address')).trim(),quantity=Number(data.get('quantity'));if(!name||!address||!Number.isInteger(quantity)||quantity<1)return;orders.unshift({id:Math.max(...orders.map(o=>o.id))+1,name,address,product:String(data.get('product')),quantity,payment:String(data.get('payment')),driver:String(data.get('driver')),status:'Pendiente',time:'Ahora'});$('orderDialog').close();filter='all';document.querySelector('[data-status="all"]').click();$('orderSearch').value='';$('orderStatus').value='all';render();navigate('orders');toast('Pedido creado. Ya está listo para organizar su entrega.')});
      function detail(id){const o=orders.find(o=>o.id===id);if(!o)return;selectedOrder=id;const p=getProduct(o.product);$('detailId').textContent='PEDIDO #GW-'+o.id;$('detailName').textContent=o.name;$('detailContent').innerHTML='<div class="detail-status">'+statusTag(o.status)+'</div><dl class="detail-list">'+[['Dirección',o.address],['Producto',o.quantity+' × '+p.name+' '+p.size],['Pago',o.payment],['Repartidor',o.driver],['Total',money(p.price*o.quantity)]].map(([k,v])=>'<div><dt>'+escape(k)+'</dt><dd>'+escape(v)+'</dd></div>').join('')+'</dl>'+(o.status==='Pendiente'?'<label>Repartidor para esta salida<select id="detailDriver"><option>Carlos Mendoza</option><option>Luis Ramos</option><option>Jorge Peralta</option></select></label><p class="form-note">La salida descuenta las unidades del inventario de ejemplo.</p>':'<p class="form-note">Operación de demostración. No se envían mensajes ni comprobantes.</p>');if(o.status==='Pendiente'&&o.driver!=='Sin asignar')$('detailDriver').value=o.driver;$('advanceOrder').textContent=o.status==='Pendiente'?'Confirmar salida':o.status==='En camino'?'Marcar como entregado':'Entrega completada';$('advanceOrder').disabled=o.status==='Entregado';$('detailDialog').showModal()}
      ['overviewOrders','allOrders'].forEach(id=>$(id).addEventListener('click',event=>{const button=event.target.closest('[data-order]');if(button)detail(Number(button.dataset.order))}));
      function refreshStock(){
        products.forEach(p=>{
          document.querySelectorAll('[data-stock="'+p.id+'"],[data-mini-stock="'+p.id+'"]').forEach(el=>el.textContent=p.stock);
          const card=document.querySelector('[data-restock="'+p.id+'"]').closest('.product-card');
          card.querySelector('.stock-track span').style.width=Math.min(100,p.stock)+'%';
          const mini=document.querySelector('[data-mini-stock="'+p.id+'"]');
          if(mini){const health=mini.closest('.stock-mini').querySelector('.stock-health');health.textContent=p.stock<p.min?'● Reponer pronto':'● Stock saludable';health.classList.toggle('warning',p.stock<p.min)}
        });
        const low=products.filter(p=>p.stock<p.min);
        document.querySelector('.insight p').textContent=low.length?low.map(p=>p.name).join(', ')+' necesita reposición. Anticípate a los pedidos de la tarde.':'Tu inventario está listo. Aprovecha para preparar las siguientes entregas.';
        document.querySelector('.nav-dot').hidden=!low.length;
        document.querySelector('[data-panel="inventory"] .section-banner .tag').textContent=low.length?low.length+' producto'+(low.length>1?'s':'')+' por reponer':'Existencias saludables';
      }
      $('advanceOrder').addEventListener('click',()=>{const o=orders.find(o=>o.id===selectedOrder);if(!o||o.status==='Entregado')return;if(o.status==='Pendiente'){const p=getProduct(o.product);if(p.stock<o.quantity){$('detailDialog').close();navigate('inventory');toast('Stock insuficiente. Registra una reposición antes de despachar.');return}p.stock-=o.quantity;o.driver=$('detailDriver').value;o.status='En camino';refreshStock()}else o.status='Entregado';$('detailDialog').close();render();toast(o.status==='Entregado'?'Entrega completada. ¡Una familia más con energía!':'Pedido en camino. Inventario de ejemplo actualizado.')});
      document.querySelectorAll('[data-restock]').forEach(button=>button.addEventListener('click',()=>{restockId=button.dataset.restock;$('restockName').textContent=getProduct(restockId).name;$('restockForm').reset();$('restockDialog').showModal()}));$('restockForm').addEventListener('submit',event=>{event.preventDefault();const units=Number(new FormData(event.target).get('units'));if(!Number.isInteger(units)||units<1||units>500)return;getProduct(restockId).stock+=units;refreshStock();$('restockDialog').close();toast('Ingreso registrado: '+units+' unidades añadidas al inventario de ejemplo.')});
      document.querySelectorAll('[data-availability]').forEach(input=>input.addEventListener('change',()=>{const tag=input.closest('.team-card').querySelector('.tag');tag.textContent=input.checked?'Disponible':'Fuera de turno';tag.className='tag '+(input.checked?'green':'neutral');toast(input.dataset.availability+': '+(input.checked?'disponible en turno':'fuera de turno'))}));
      $('exportButton').addEventListener('click',()=>{const cell=value=>'"'+String(/^[=+@\-\t\r\n]/.test(String(value))?"'"+value:value).replace(/"/g,'""')+'"';const rows=[['Pedido','Cliente','Dirección','Producto','Cantidad','Estado','Total PEN'],...orders.map(o=>['GW-'+o.id,o.name,o.address,getProduct(o.product).name,o.quantity,o.status,getProduct(o.product).price*o.quantity])];const blob=new Blob(['\uFEFF'+rows.map(row=>row.map(cell).join(';')).join('\r\n')],{type:'text/csv;charset=utf-8'});const url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download='gaswii-pedidos-demo.csv';link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);toast('Reporte de pedidos exportado.')});
      render();
      // Extensiones autónomas de la propuesta 057.
      const customersExtra=[]; const drafts=[]; let editing=null, template='route';
      const customerBase=renderCustomers;
      renderCustomers=function(){customerBase();const query=$('customerSearch').value.toLowerCase().trim();const list=customersExtra.filter(c=>c.name.toLowerCase().includes(query));if(list.length&&$('customerGrid').querySelector('.empty'))$('customerGrid').textContent='';list.forEach(c=>{const article=document.createElement('article');article.className='customer-card';article.innerHTML='<span class="avatar blue">'+escape(initials(c.name))+'</span><h3>'+escape(c.name)+'</h3><p>'+escape(c.address)+'</p><p>'+escape(c.phone)+'</p><span class="tag neutral">Nuevo cliente</span>';$('customerGrid').append(article)});document.querySelector('[data-module-count="CARTERA"]').textContent=new Set(orders.map(o=>o.name)).size+customersExtra.length};
      const oldStock=refreshStock;refreshStock=function(){oldStock();document.querySelector('[data-module-count="INVENTARIO"]').textContent=products.reduce((n,p)=>n+p.stock,0)};
      function clock(){const now=new Date();$('liveClock').textContent=new Intl.DateTimeFormat('es-PE',{hour:'2-digit',minute:'2-digit',timeZone:'America/Lima'}).format(now)}clock();setInterval(clock,30000);
      function field(label,name,value='',type='text'){return '<label class="span-two">'+label+'<input name="'+name+'" type="'+type+'" value="'+escape(value)+'" required maxlength="140" '+(type==='number'?'min="0" step="0.01"':'')+'/></label>'}
      function editor(kind,id){editing={kind,id};$('editorTitle').textContent=kind==='product'?'Una ficha, bien cuidada.':kind==='staff'?'Una persona que suma.':'Un nuevo vecino.';const p=kind==='product'?getProduct(id):null;$('editorFields').innerHTML=p?field('Nombre del producto','name',p.name)+field('Precio de venta (S/)','price',p.price,'number'):kind==='staff'?field('Nombre completo','name')+field('Cargo / función','role'):field('Nombre del cliente','name')+field('Dirección','address')+field('Teléfono','phone');$('editorDialog').showModal()}
      $('addCustomer').addEventListener('click',()=>editor('customer'));$('addStaff').addEventListener('click',()=>editor('staff'));document.querySelectorAll('[data-edit-product]').forEach(b=>b.addEventListener('click',()=>editor('product',b.dataset.editProduct)));
      $('editorForm').addEventListener('submit',e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));if(!d.name.trim())return;if(editing.kind==='customer'){customersExtra.push(d);renderCustomers()}else if(editing.kind==='product'){const p=getProduct(editing.id);p.name=d.name.trim();p.price=Number(d.price);const card=document.querySelector('[data-edit-product="'+p.id+'"]').closest('.product-card');card.querySelector('h2').textContent=p.name;card.querySelector('.product-info>p strong').textContent=money(p.price);document.querySelectorAll('option[value="'+p.id+'"]').forEach(o=>o.textContent=p.name+' '+p.size);const mini=document.querySelector('[data-mini-stock="'+p.id+'"]');if(mini)mini.closest('.stock-mini').querySelector('strong').textContent=p.name;render();invoicePreview()}else{const card=document.createElement('article');card.className='card team-card';card.innerHTML='<div class="team-card-top"><span class="avatar large blue">'+escape(initials(d.name))+'</span><span class="tag green">Disponible</span></div><h2>'+escape(d.name)+'</h2><p>'+escape(d.role)+'</p><div class="team-stat"><strong>0</strong><span>entregas completadas</span></div><p class="form-note">Nuevo colaborador de esta sesión</p>';document.querySelector('.team-grid').append(card);document.querySelector('[data-module-count="PERSONAL"]').textContent=document.querySelectorAll('.team-card').length}$('editorDialog').close();toast('Cambios guardados en esta demostración.')});
      function invoicePreview(){const f=$('invoiceForm').elements,p=getProduct(f.product.value),q=Math.max(0,Number(f.quantity.value)||0);$('receiptType').textContent=f.type.value.toUpperCase();$('receiptCustomer').textContent=f.customer.value||'Cliente general';$('receiptDocument').textContent=f.document.value||'—';$('receiptPayment').textContent=f.payment.value;$('receiptProduct').textContent=q+' × '+p.name+' '+p.size;$('receiptAmount').textContent=money(p.price*q);$('receiptTotal').textContent=money(p.price*q)}
      $('invoiceForm').addEventListener('input',invoicePreview);$('invoiceForm').addEventListener('change',invoicePreview);$('invoiceForm').addEventListener('submit',e=>{e.preventDefault();const f=e.target.elements;if(f.type.value==='Factura'&&!/^\d{11}$/.test(f.document.value)){f.document.setCustomValidity('Para una factura escribe un RUC de 11 dígitos.');f.document.reportValidity();return}const p=getProduct(f.product.value);drafts.unshift({id:'BOR-'+String(drafts.length+1).padStart(3,'0'),customer:f.customer.value,type:f.type.value,total:p.price*Number(f.quantity.value)});$('draftList').innerHTML=drafts.map(d=>'<div class="draft-row"><span class="metric-icon purple"><svg class="icon"><use href="#i-wallet"/></svg></span><div><strong>'+escape(d.customer)+'</strong><small>'+d.id+' · '+d.type+'</small></div><span class="tag purple">Borrador</span><strong>'+money(d.total)+'</strong></div>').join('');$('draftCount').textContent=drafts.length+(drafts.length===1?' borrador':' borradores');document.querySelector('[data-module-count="COMPROBANTES"]').textContent=drafts.length;toast('Borrador guardado. No se ha emitido a SUNAT.')});$('invoiceForm').elements.document.addEventListener('input',e=>e.target.setCustomValidity(''));$('invoiceForm').elements.type.addEventListener('change',()=>$('invoiceForm').elements.document.setCustomValidity(''));
      function message(){const f=$('waForm').elements,name=f.customer.value||'vecino';const header='¡Hola, '+name+'! 👋\nSomos Solgas Surquillo.\n\n';$('waPreview').textContent=header+(template==='route'?'🛵 Tu pedido ya está en camino.\n\n📦 '+f.product.value+'\n👤 '+f.driver.value+'\n⏱ Tiempo estimado: '+f.eta.value+'\n\nMuy pronto estaremos en tu puerta. ¡Gracias por confiar en nosotros!':template==='confirm'?'✅ Recibimos tu pedido de '+f.product.value+'.\n\nNuestro equipo está preparando tu entrega. Te avisaremos cuando salga de planta.\n\n¡Gracias por elegirnos!':'🧡 Gracias por dejarnos llevar energía a tu hogar.\n\nEsperamos que todo haya llegado muy bien. Si necesitas ayuda, estamos aquí para ti.\n\nSolgas Surquillo · Cerca de ti.')}document.querySelectorAll('[data-template]').forEach(b=>b.addEventListener('click',()=>{template=b.dataset.template;document.querySelectorAll('[data-template]').forEach(x=>x.classList.toggle('selected',x===b));message()}));$('waForm').addEventListener('input',message);$('waForm').addEventListener('change',message);$('waForm').addEventListener('submit',e=>e.preventDefault());$('copyMessage').addEventListener('click',async()=>{try{await navigator.clipboard.writeText($('waPreview').textContent);toast('Mensaje copiado. Listo para compartir.')}catch{toast('No se pudo copiar. Selecciona el texto de la vista previa.')}});message();invoicePreview();renderCustomers();
    })();
  </script>
</body>
</html>
