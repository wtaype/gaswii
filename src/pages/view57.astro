---
// Propuesta visual autónoma. Todos los cambios de operación son de demostración.
const nav = [
  ['overview', 'Inicio', 'grid'], ['orders', 'Pedidos', 'bag'],
  ['inventory', 'Productos', 'box'], ['team', 'Personal', 'users'],
  ['customers', 'Clientes', 'heart'], ['sunat', 'Comprobantes', 'wallet'], ['whatsapp', 'WhatsApp', 'chat'], ['reports', 'Reportes', 'chart']
];
const icons: Record<string, string> = {
  chat: 'M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5 M8 10h8 M8 14h5',
  grid: 'M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z',
  bag: 'M5 7h14l2 14H3L5 7z M9 8V6a3 3 0 0 1 6 0v2',
  box: 'm12 3 9 5-9 5-9-5 9-5z M3 8v9l9 5 9-5V8 M12 13v9 M7.5 5.5l9 5',
  users: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M16 4a4 4 0 0 1 0 8 M22 21v-2a4 4 0 0 0-3-3.87 M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0',
  heart: 'M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8',
  chart: 'M3 3v18h18 M7 15l4-4 4 2 6-8',
  search: 'M21 21l-5-5 M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0',
  arrow: 'M5 12h14 M12 5l7 7-7 7',
  bell: 'M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9 M10 21h4',
  sun: 'M12 2v2 M12 20v2 M2 12h2 M20 12h2 M5 5l1 1 M18 18l1 1 M5 19l1-1 M18 6l1-1 M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0',
  clock: 'M12 8v5l3 2 M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0',
  plus: 'M12 5v14 M5 12h14',
  wallet: 'M20 7V4H4a2 2 0 0 0-2 2v14h20V7H4a1 1 0 0 1 0-2 M22 11h-6v5h6 M18 13h.01',
  truck: 'M1 3h13v13H1z M14 8h4l4 5v3h-8 M8 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0 M20 18a2 2 0 1 1-4 0 2 2 0 0 1 4 0',
  check: 'm5 12 4 4L19 6',
  pin: 'M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0 M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0',
  menu: 'M3 6h18 M3 12h18 M3 18h18',
  close: 'm6 6 12 12 M6 18 18 6',
  download: 'M12 3v12 m-5-5 5 5 5-5 M4 16v5h16v-5',
  flame: 'M12 2c1 5 7 7 7 13a7 7 0 0 1-14 0c0-3 2-6 4-8 0 4 2 4 3 5 2-3 1-6 0-10z'
};
const products = [
  {id:'solgas',name:'Solgas Premium',size:'10 kg',image:'BALON-10KG.webp',price:65,stock:84,empty:32,min:30,color:'orange'},
  {id:'industrial',name:'Solgas Industrial',size:'45 kg',image:'BALON-45KG.webp',price:230,stock:16,empty:6,min:8,color:'blue'},
  {id:'masgas',name:'Masgas Hogar',size:'10 kg',image:'MASGAS-10KG.webp',price:55,stock:12,empty:10,min:15,color:'green'},
  {id:'kit',name:'Kit regulador',size:'Accesorio',image:'REGULADOR.webp',price:70,stock:18,empty:0,min:5,color:'purple'}
];
const staff = [
  {name:'Carlos Mendoza',initials:'CM',role:'Repartidor · Torito 02',status:'En ruta',deliveries:18,color:'orange'},
  {name:'Luis Ramos',initials:'LR',role:'Repartidor · Furgón 01',status:'En ruta',deliveries:15,color:'blue'},
  {name:'Rosa Quispe',initials:'RQ',role:'Operadora · Planta',status:'Disponible',deliveries:0,color:'purple'},
  {name:'Jorge Peralta',initials:'JP',role:'Conductor · Camión 03',status:'Disponible',deliveries:9,color:'green'}
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="theme-color" content="#080e1c" />
  <title>Solgas Surquillo · Centro de operaciones</title>
  <link rel="icon" href="/favicon.ico" />
  <link rel="stylesheet" href="/google/fonts.css" />
  <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem('gaswii-view57-theme') || 'dark'; } catch {}</script>
</head>
<body>
  <svg class="icon-library" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><defs>{Object.entries(icons).map(([id,path]) => <symbol id={'i-'+id} viewBox="0 0 24 24"><path d={path} /></symbol>)}</defs></svg>
  <a class="skip" href="#main">Saltar al contenido</a>
  <button class="scrim" id="scrim" aria-label="Cerrar navegación" hidden></button>
  <aside class="sidebar" id="sidebar" aria-label="Navegación principal">
    <a class="brand" href="/view57" aria-label="Solgas Surquillo inicio"><img src="/imgwii/logo.webp" alt="Solgas Surquillo" /><span class="brand-caption">CENTRO DE OPERACIONES</span></a>
    <div class="workspace"><span class="workspace-icon">S</span><div><strong>Solgas Surquillo</strong><small>Consola de operaciones</small></div><span class="workspace-chevron">⌄</span></div>
    <span class="nav-label">TU ESPACIO DE TRABAJO</span>
    <nav>{nav.map(([id,label,icon],i) => <button class:list={['nav-item',{active:i===0}]} data-page={id} aria-current={i===0?'page':undefined}><svg class="icon"><use href={'#i-'+icon} /></svg><span>{label}</span>{id==='orders' && <span class="nav-count" id="navCount">6</span>}{id==='inventory' && <span class="nav-dot"></span>}</button>)}</nav>
    <div class="sidebar-bottom"><div class="shift-card"><div><span class="live-dot"></span><strong>Tu planta, conectada.</strong></div><p>Turno de mañana<br /><span>06:30 — 15:30</span></p><div class="mini-avatars">{staff.map(p=><span title={p.name}>{p.initials}</span>)}<small>4 en turno</small></div></div><button class="profile" id="profile"><span class="avatar orange">WA</span><span><strong>Wilder Alarcón</strong><small>Gestor propietario</small></span><svg class="icon"><use href="#i-arrow" /></svg></button></div>
    <span class="sidebar-foot">SOLGAS SURQUILLO · JR. DANTE 260</span>
  </aside>
  <div class="shell">
    <header class="topbar">
      <div class="breadcrumb"><button class="icon-button mobile-menu" id="menuButton" aria-label="Abrir menú" aria-expanded="false"><svg class="icon"><use href="#i-menu" /></svg></button><img class="mobile-brand" src="/imgwii/logo.webp" alt="Solgas Surquillo"/><span class="top-plant"><span class="live-dot"></span> PLANTA SURQUILLO</span><span class="slash">/</span><strong id="breadcrumb">Inicio</strong></div>
      <div class="top-actions"><span class="demo-label">Vista de demostración</span><button class="icon-button" id="themeButton" aria-label="Cambiar tema"><svg class="icon"><use href="#i-sun" /></svg></button><button class="icon-button notification-button" id="notifications" aria-label="Ver alertas de inventario"><svg class="icon"><use href="#i-bell" /></svg><b></b></button><span class="top-divider"></span><span class="avatar small orange" aria-label="Wilder Alarcón">WA</span></div>
    </header>
    <main id="main">
      <div class="page-heading"><div><p class="eyebrow"><span class="live-dot"></span> SOLGAS SURQUILLO <span class="eyebrow-divider">/</span> <span id="dateLabel">MIÉRCOLES, 16 SEPTIEMBRE</span></p><h1 id="pageTitle">Un buen día para avanzar<span>.</span></h1><p class="page-subtitle" id="pageSubtitle">Hola, Wilder. Tu equipo, tus clientes y tu planta, en un solo lugar.</p></div><div class="heading-actions"><div class="live-clock"><strong id="liveClock">12:00 p. m.</strong><span><span class="live-dot"></span> TURNO EN MARCHA</span></div><button class="button primary" data-new-order><svg class="icon"><use href="#i-plus" /></svg>Nuevo pedido</button></div></div>

      <section data-panel="overview" class="panel">
        <div class="hero"><div class="hero-copy"><span class="hero-kicker"><span class="live-dot"></span> LA ENERGÍA DE SOLGAS SURQUILLO</span><h2>Cerca de tus clientes.<br /><span>Un paso adelante.</span></h2><p>Cada entrega cuenta. Mantén a tu equipo conectado<br class="desktop-break" /> y haz que la energía llegue a tiempo.</p><button class="hero-link" data-page="orders">Organizar los pedidos <svg class="icon"><use href="#i-arrow" /></svg></button><div class="hero-foot"><span class="hero-check">✓</span> 42 entregas completadas en la jornada de ejemplo</div></div><div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><span class="art-plus plus-one">+</span><span class="art-plus plus-two">+</span><div class="product-plinth"></div><img class="hero-cylinder" src="/imgwii/productos/BALON-10KG.webp" alt="" /><div class="floating-label delivery-label"><span class="round-icon"><svg class="icon"><use href="#i-check" /></svg></span><div><strong>Entrega completada</strong><small>Una familia con energía</small></div></div><div class="floating-label weight-label"><svg class="icon"><use href="#i-box" /></svg><span><strong>10 kg</strong><small>Peso exacto. Siempre.</small></span></div><span class="art-caption">LA ENERGÍA QUE NOS CONECTA</span></div></div>
        <div class="metrics">
          <article class="metric"><div class="metric-top"><span>Ventas de hoy</span><span class="metric-icon orange"><svg class="icon"><use href="#i-wallet" /></svg></span></div><div class="metric-value"><small>S/</small> <span id="salesKpi">2,860</span><svg class="spark" viewBox="0 0 110 35" aria-hidden="true"><path d="M1 30 15 25 26 28 41 13 52 18 69 9 81 14 108 2" /></svg></div><p><span class="trend">↗ 12.8%</span> frente a ayer · datos de ejemplo</p></article>
          <article class="metric"><div class="metric-top"><span>Pedidos completados</span><span class="metric-icon green"><svg class="icon"><use href="#i-bag" /></svg></span></div><div class="metric-value" id="completedKpi">42 <span class="value-unit">pedidos</span></div><p><span class="trend">↗ 6 más</span> que en la jornada anterior</p></article>
          <article class="metric"><div class="metric-top"><span>En camino</span><span class="metric-icon blue"><svg class="icon"><use href="#i-truck" /></svg></span></div><div class="metric-value"><span id="routeKpi">3</span><span class="value-unit">entregas</span><span class="pulse-badge">EN RUTA</span></div><p><span class="dot-inline"></span> Carlos y Luis están repartiendo</p></article>
          <article class="metric"><div class="metric-top"><span>Tiempo de entrega</span><span class="metric-icon purple"><svg class="icon"><use href="#i-clock" /></svg></span></div><div class="metric-value">18 <span class="value-unit">min</span></div><p><span class="trend">↓ 4 min</span> por debajo de la meta</p></article>
        </div>
        <div class="module-heading"><div><span class="eyebrow">TODO CONECTADO</span><h2>Tu negocio, de un vistazo.</h2></div><span>Elige un módulo para continuar <span aria-hidden="true">↘</span></span></div>
<div class="module-grid">
{[
['customers','orange','heart','CARTERA','6','Clientes que confían en ti','Hogares y negocios, con toda su información a mano.','Ver directorio'],
['inventory','green','box','CATÁLOGO','4','Productos con energía','Solgas, Masgas y accesorios listos para la próxima entrega.','Gestionar productos'],
['team','blue','users','PERSONAL','4','Un equipo en movimiento','Repartidores y operadores conectados con tu planta.','Ver colaboradores'],
['sunat','purple','wallet','COMPROBANTES','0','Documentos en orden','Prepara tus borradores y revisa el detalle de cada venta.','Preparar comprobante'],
['inventory','amber','box','INVENTARIO','130','Unidades listas para salir','Llenos y accesorios disponibles. 48 vacíos para canje.','Controlar existencias']
].map(([page,color,icon,kicker,value,title,description,action],i)=><button class:list={['module-card',color,{'module-wide':i>2}]} data-page={page}><div class="module-card-top"><span>{kicker}</span><svg class="icon"><use href={'#i-'+icon}/></svg></div><strong class="module-number" data-module-count={kicker}>{value}</strong><h3>{title}</h3><p>{description}</p><div class="module-card-foot"><span>{i===4?'● Control de almacén':i===3?'● Borradores de demostración':'● Información de esta sesión'}</span><strong>{action} →</strong></div></button>)}
</div><div class="section-divider"><span>EL DÍA A DÍA</span><span></span></div><div class="operations-grid">
          <article class="card orders-card"><div class="card-heading"><div><h2>La operación, en movimiento <span class="soft-count" id="activeCount">6</span></h2><p>Los pedidos que necesitan a tu equipo.</p></div><button class="text-button" data-page="orders">Ver todos <span>↗</span></button></div><div class="order-toolbar"><div class="segmented" aria-label="Filtrar pedidos"><button class="selected" data-status="all" aria-pressed="true">Todos</button><button data-status="Pendiente" aria-pressed="false">Pendientes <span id="pendingCount">3</span></button><button data-status="En camino" aria-pressed="false">En camino</button></div><button class="icon-button" id="focusSearch" aria-label="Buscar pedidos"><svg class="icon"><use href="#i-search" /></svg></button></div><div class="table-scroll"><table><thead><tr><th>CLIENTE / PEDIDO</th><th>PRODUCTO</th><th>ESTADO</th><th>IMPORTE</th><th><span class="sr-only">Detalle</span></th></tr></thead><tbody id="overviewOrders"></tbody></table></div><div class="card-bottom"><span><span class="live-dot"></span> Datos de ejemplo · cambios en esta sesión</span><span id="visibleCount">6 pedidos activos</span></div></article>
          <article class="card delivery-card"><div class="card-heading"><div><h2>Tu equipo, cerca</h2><p>Reparto en Surquillo</p></div><span class="tag green">2 en ruta</span></div><div class="map-art" role="img" aria-label="Esquema ilustrativo del reparto en Surquillo, no es ubicación GPS"><svg viewBox="0 0 400 235" preserveAspectRatio="xMidYMid slice"><rect width="400" height="235" fill="var(--map-bg)"/><g fill="var(--map-block)" stroke="var(--map-stroke)" stroke-width="1"><path d="M0 0h72v48H0z M90 0h85v48H90z M195 0h95v48h-95z M312 0h88v48h-88z M0 67h72v63H0z M90 67h85v63H90z M195 67h95v63h-95z M312 67h88v63h-88z M0 151h72v84H0z M90 151h85v84H90z M195 151h95v84h-95z M312 151h88v84h-88z" /></g><path d="M0 179 400 65" stroke="var(--map-bg)" stroke-width="25"/><path d="M15 231 120 0" stroke="var(--map-bg)" stroke-width="19"/><path d="M183 143h118V59h53" fill="none" stroke="#e97540" stroke-width="3" stroke-dasharray="6 5"/><path d="M183 143H81V95" fill="none" stroke="#548dba" stroke-width="3" stroke-dasharray="6 5"/><g fill="var(--muted)" font-size="9" font-family="sans-serif" letter-spacing="1"><text x="206" y="32">SURQUILLO</text><text x="130" y="61">AV. ANGAMOS</text><text x="225" y="208">JR. DANTE</text><text x="15" y="213">MIRAFLORES</text></g><circle cx="183" cy="143" r="23" fill="#ed773f" opacity=".15"/><circle cx="183" cy="143" r="13" fill="#ee763d"/><path d="m177 145 6-7 6 7v5h-12z" fill="white"/><g><circle cx="301" cy="90" r="18" fill="#172c28" stroke="white" stroke-width="3"/><text x="301" y="94" text-anchor="middle" fill="white" font-family="sans-serif" font-size="10">CM</text><circle cx="81" cy="98" r="18" fill="#548dba" stroke="white" stroke-width="3"/><text x="81" y="102" text-anchor="middle" fill="white" font-family="sans-serif" font-size="10">LR</text></g></svg><span class="map-caption">Recorrido ilustrativo</span></div><div class="driver-row"><span class="avatar orange">CM</span><div><strong>Carlos Mendoza</strong><small>Torito 02 · 2 pedidos asignados</small></div><span class="tag neutral">12 min</span></div><div class="driver-row"><span class="avatar blue">LR</span><div><strong>Luis Ramos</strong><small>Furgón 01 · 1 pedido asignado</small></div><span class="tag neutral">8 min</span></div><button class="wide-link" data-page="team">Ver equipo y disponibilidad <svg class="icon"><use href="#i-arrow" /></svg></button></article>
        </div>
        <div class="bottom-grid"><article class="card stock-overview"><div class="card-heading"><div><h2>Energía lista para salir</h2><p>Un vistazo a tus existencias.</p></div><button class="text-button" data-page="inventory">Inventario <span>↗</span></button></div><div class="stock-mini-grid">{products.slice(0,3).map(p=><button class="stock-mini" data-page="inventory"><div class:list={['mini-product',p.color]}><img src={'/imgwii/productos/'+p.image} alt={p.name} loading="lazy" /></div><div><strong>{p.name}</strong><small>{p.size} · <span data-mini-stock={p.id}>{p.stock}</span> llenos</small><span class:list={['stock-health',{warning:p.stock<p.min}]}>{p.stock<p.min?'● Reponer pronto':'● Stock saludable'}</span></div></button>)}</div></article><article class="insight"><div class="insight-icon"><svg class="icon"><use href="#i-chart" /></svg></div><div><span class="eyebrow">UNA OPORTUNIDAD PARA HOY</span><h3>Que nadie se quede sin energía.</h3><p>Masgas 10 kg está por debajo del mínimo. Anticípate a los pedidos de la tarde.</p><button class="text-button" data-page="inventory">Revisar existencias <span>→</span></button></div></article></div>
      </section>

      <section data-panel="orders" class="panel" hidden><div class="section-banner"><div><span class="eyebrow">DEL PEDIDO A LA PUERTA</span><h2>Cada entrega, bajo control.</h2><p>Busca un pedido, revisa su detalle y avanza su estado.</p></div><svg class="banner-icon"><use href="#i-truck" /></svg></div><article class="card"><div class="card-heading"><div class="search-field"><svg class="icon"><use href="#i-search" /></svg><input id="orderSearch" type="search" placeholder="Buscar cliente, dirección o pedido…" aria-label="Buscar pedidos" /></div><select id="orderStatus" aria-label="Estado de pedidos"><option value="all">Todos los estados</option><option>Pendiente</option><option>En camino</option><option>Entregado</option></select></div><div class="table-scroll"><table><thead><tr><th>CLIENTE / PEDIDO</th><th>PRODUCTO</th><th>ESTADO</th><th>IMPORTE</th><th>DETALLE</th></tr></thead><tbody id="allOrders"></tbody></table></div></article></section>
      <section data-panel="inventory" class="panel" hidden><div class="section-banner"><div><span class="eyebrow">TU ALMACÉN, EN EQUILIBRIO</span><h2>Preparados para la próxima entrega.</h2><p>Control de llenos, vacíos y reposición por producto.</p></div><span class="tag amber">1 producto por reponer</span></div><div class="product-grid">{products.map(p=><article class="card product-card"><div class:list={['product-image',p.color]}><span class="tag neutral">{p.size}</span><img src={'/imgwii/productos/'+p.image} alt={p.name+' '+p.size} loading="lazy" /></div><div class="product-info"><h2>{p.name}</h2><p>Precio de venta <strong>S/ {p.price.toFixed(2)}</strong></p><div class="stock-numbers"><div><strong data-stock={p.id}>{p.stock}</strong><span>Llenos / unidades</span></div><div><strong>{p.empty}</strong><span>Vacíos</span></div></div><div class="stock-track"><span style={'width:'+Math.min(100,p.stock/100*100)+'%'}></span></div><small>Mínimo recomendado: {p.min} unidades</small><button class="text-button edit-product" data-edit-product={p.id}>Editar ficha y precio ↗</button><button class="button secondary full" data-restock={p.id}><svg class="icon"><use href="#i-plus" /></svg>Registrar reposición</button></div></article>)}</div></section>
      <section data-panel="team" class="panel" hidden><div class="section-banner"><div><span class="eyebrow">PERSONAS QUE HACEN LA DIFERENCIA</span><h2>El motor de tu negocio.</h2><p>Revisa la jornada y actualiza la disponibilidad del equipo.</p></div><button class="button secondary" id="addStaff">+ Agregar colaborador</button></div><div class="team-grid">{staff.map(p=><article class="card team-card"><div class="team-card-top"><span class:list={['avatar large',p.color]}>{p.initials}</span><span class:list={['tag',p.status==='En ruta'?'blue':'green']}>{p.status}</span></div><h2>{p.name}</h2><p>{p.role}</p><div class="team-stat"><strong>{p.deliveries || '—'}</strong><span>{p.deliveries?'entregas completadas':'Apoyo en almacén'}</span></div><label class="availability"><span>Disponible en turno</span><input type="checkbox" checked data-availability={p.name} /><span class="switch" aria-hidden="true"></span></label></article>)}</div></section>
      <section data-panel="customers" class="panel" hidden><div class="section-banner"><div><span class="eyebrow">RELACIONES QUE DURAN</span><h2>Conoce a quienes confían en ti.</h2><p>Una cartera cercana, con el contexto de cada entrega.</p></div><svg class="banner-icon"><use href="#i-heart" /></svg></div><article class="card"><div class="card-heading"><div><h2>Tu directorio de clientes</h2><button class="text-button" id="addCustomer">+ Registrar cliente</button></div><div class="search-field"><svg class="icon"><use href="#i-search" /></svg><input id="customerSearch" type="search" placeholder="Buscar cliente…" aria-label="Buscar clientes" /></div></div><div class="customer-grid" id="customerGrid"></div></article></section>
      <section data-panel="reports" class="panel" hidden><div class="section-banner"><div><span class="eyebrow">MÁS CLARIDAD. MEJORES DECISIONES.</span><h2>Los números también cuentan historias.</h2><p>Resumen ilustrativo de ventas de la semana.</p></div><button class="button secondary" id="exportButton"><svg class="icon"><use href="#i-download" /></svg>Exportar pedidos CSV</button></div><div class="report-grid"><article class="card"><div class="card-heading"><div><h2>Una semana con energía</h2><p>Ventas diarias · soles · datos de ejemplo</p></div><span class="tag green">↗ 12.8%</span></div><div class="bar-chart" role="img" aria-label="Ventas de ejemplo: lunes 2140 soles, martes 2535, miércoles 2860, jueves 1980, viernes 3100, sábado 3540, domingo 2680">{[['Lun',2140],['Mar',2535],['Mié',2860],['Jue',1980],['Vie',3100],['Sáb',3540],['Dom',2680]].map(([day,value])=><div class="bar-column"><span>S/ {value}</span><div class:list={['bar',{highlight:day==='Mié'}]} style={'height:'+Number(value)/36+'%'}></div><strong>{day}</strong></div>)}</div></article><article class="card report-summary"><span class="eyebrow">VENTAS DE LA SEMANA</span><h2>S/ 18,835<span>.00</span></h2><p>Una vista simple de lo que mueve tu negocio.</p><hr /><div><span>Producto más vendido</span><strong>Solgas Premium 10 kg</strong></div><div><span>Mejor jornada</span><strong>Sábado · S/ 3,540</strong></div><div><span>Datos de este reporte</span><strong>Demostración visual</strong></div></article></div></section>

<section data-panel="sunat" class="panel" hidden>
<div class="section-banner"><div><span class="eyebrow">COMPROBANTES · SUNAT</span><h2>Una venta clara, de principio a fin.</h2><p>Prepara el documento y revisa su vista previa antes de continuar.</p></div><span class="tag amber">Modo borrador · sin emisión fiscal</span></div>
<div class="document-grid"><article class="card document-form"><div class="card-heading"><div><h2>Datos del comprobante</h2><p>Completa los detalles de la venta.</p></div><svg class="icon"><use href="#i-wallet"/></svg></div><form id="invoiceForm"><div class="form-grid"><label>Tipo de documento<select name="type"><option>Boleta</option><option>Factura</option></select></label><label>Forma de pago<select name="payment"><option>Yape</option><option>Efectivo</option><option>Plin</option><option>Transferencia</option></select></label><label class="span-two">Cliente<input name="customer" placeholder="Nombre o razón social" required maxlength="100"/></label><label class="span-two">Documento del cliente<input name="document" placeholder="DNI o RUC" required inputmode="numeric" pattern="[0-9]{8}|[0-9]{11}" maxlength="11"/></label><label>Producto<select name="product">{products.map(p=><option value={p.id}>{p.name} {p.size}</option>)}</select></label><label>Cantidad<input name="quantity" type="number" min="1" max="100" value="1" required/></label></div><p class="form-note">Esta vista prepara borradores. No se conecta a SUNAT ni descuenta inventario.</p><button class="button primary full" type="submit">Guardar borrador <svg class="icon"><use href="#i-arrow"/></svg></button></form></article>
<article class="receipt-wrap"><span class="eyebrow">VISTA PREVIA DEL DOCUMENTO</span><div class="receipt"><img src="/imgwii/logo.webp" alt="Solgas Surquillo"/><h2>SOLGAS SURQUILLO</h2><p>Jr. Dante 260 · Surquillo, Lima</p><span class="receipt-stamp">BORRADOR · SIN VALIDEZ FISCAL</span><h3 id="receiptType">BOLETA</h3><div class="receipt-rule"></div><dl><div><dt>Cliente</dt><dd id="receiptCustomer">Cliente general</dd></div><div><dt>Documento</dt><dd id="receiptDocument">—</dd></div><div><dt>Pago</dt><dd id="receiptPayment">Yape</dd></div></dl><div class="receipt-rule"></div><div class="receipt-item"><span id="receiptProduct">1 × Solgas Premium 10 kg</span><strong id="receiptAmount">S/ 65.00</strong></div><div class="receipt-rule"></div><div class="receipt-total"><span>TOTAL</span><strong id="receiptTotal">S/ 65.00</strong></div><p class="receipt-thanks">Gracias por confiar en nuestra energía.</p><div class="receipt-bars" aria-hidden="true"></div><small>VISTA PREVIA · SOLGAS SURQUILLO</small></div></article></div>
<article class="card draft-card"><div class="card-heading"><div><h2>Borradores de esta sesión</h2><p>Documentos preparados, pendientes de una integración real.</p></div><span class="tag purple" id="draftCount">0 borradores</span></div><div id="draftList" class="draft-list"><p class="empty">Todavía no hay borradores. Prepara el primero con el formulario.</p></div></article></section>
<section data-panel="whatsapp" class="panel" hidden><div class="section-banner"><div><span class="eyebrow">CONVERSACIONES CON ENERGÍA</span><h2>La tranquilidad también se entrega.</h2><p>Personaliza un mensaje y revisa cómo lo verá tu cliente.</p></div><span class="tag green">Asistente de mensajes</span></div><div class="document-grid"><article class="card document-form"><div class="card-heading"><div><h2>Un mensaje en el momento justo</h2><p>Elige una plantilla y hazla tuya.</p></div></div><form id="waForm"><div class="template-options"><button type="button" class="selected" data-template="route">↗ En camino</button><button type="button" data-template="confirm">✓ Confirmación</button><button type="button" data-template="thanks">♡ Agradecimiento</button></div><div class="form-grid"><label class="span-two">Nombre del cliente<input name="customer" value="Valeria" maxlength="80"/></label><label>Producto<select name="product">{products.map(p=><option>{p.name} {p.size}</option>)}</select></label><label>Tiempo estimado<input name="eta" value="15 minutos" maxlength="30"/></label><label class="span-two">Repartidor<select name="driver"><option>Carlos Mendoza</option><option>Luis Ramos</option><option>Jorge Peralta</option></select></label></div><p class="form-note">Revisa y copia el mensaje para compartirlo desde tu WhatsApp.</p><button type="button" class="button primary full" id="copyMessage">Copiar mensaje <svg class="icon"><use href="#i-arrow"/></svg></button></form></article><article class="phone-wrap"><div class="phone-preview"><div class="phone-top"><span class="avatar green">SS</span><div><strong>Solgas Surquillo</strong><small>Tu energía, cerca de ti</small></div><span>⋮</span></div><div class="chat-area"><span class="chat-date">HOY</span><div class="chat-message"><p id="waPreview"></p><span>12:30 <b>✓✓</b></span></div><div class="chat-note">Vista previa del mensaje</div></div><div class="phone-bottom"><span>Mensaje</span><span>＋</span></div></div></article></div></section>
<dialog id="editorDialog" class="modal"><form id="editorForm"><div class="modal-heading"><div><span class="eyebrow">TU NEGOCIO AL DÍA</span><h2 id="editorTitle">Editar</h2></div><button type="button" class="icon-button" data-close="editorDialog" aria-label="Cerrar formulario"><svg class="icon"><use href="#i-close"/></svg></button></div><div class="form-grid" id="editorFields"></div><p class="form-note">Los cambios se mantienen durante esta visita de demostración.</p><button type="submit" class="button primary full">Guardar cambios</button></form></dialog>
