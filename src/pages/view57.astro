  </div>

  <dialog id="orderDialog" class="modal"><form id="orderForm"><div class="modal-heading"><div><span class="eyebrow">UNA NUEVA ENTREGA</span><h2>Vamos con ese pedido.</h2></div><button type="button" class="icon-button" data-close="orderDialog" aria-label="Cerrar"><svg class="icon"><use href="#i-close" /></svg></button></div><p class="modal-description">Registra los datos y prepara la salida.</p><div class="form-grid"><label class="span-two">Nombre del cliente<input name="name" required maxlength="80" placeholder="Ej. Valeria Mendoza" /></label><label class="span-two">Dirección de entrega<input name="address" required maxlength="140" placeholder="Calle, número y distrito" /></label><label>Producto<select name="product">{products.map(p=><option value={p.id}>{p.name} {p.size}</option>)}</select></label><label>Cantidad<input name="quantity" type="number" min="1" max="50" value="1" required /></label><label>Método de pago<select name="payment"><option>Yape</option><option>Efectivo</option><option>Plin</option><option>Transferencia</option></select></label><label>Asignar a<select name="driver"><option>Sin asignar</option><option>Carlos Mendoza</option><option>Luis Ramos</option><option>Jorge Peralta</option></select></label></div><div class="order-total"><span>Total del pedido</span><strong id="formTotal">S/ 65.00</strong></div><p class="form-note">Demostración: el pedido se conserva durante esta visita.</p><button type="submit" class="button primary full">Crear pedido <svg class="icon"><use href="#i-arrow" /></svg></button></form></dialog>
  <dialog id="detailDialog" class="modal"><div class="modal-heading"><div><span class="eyebrow" id="detailId">PEDIDO</span><h2 id="detailName"></h2></div><button class="icon-button" data-close="detailDialog" aria-label="Cerrar detalle"><svg class="icon"><use href="#i-close" /></svg></button></div><div id="detailContent"></div><button class="button primary full" id="advanceOrder">Preparar salida</button></dialog>
  <dialog id="restockDialog" class="modal compact"><form id="restockForm"><div class="modal-heading"><h2>Reponer existencias</h2><button type="button" class="icon-button" data-close="restockDialog" aria-label="Cerrar"><svg class="icon"><use href="#i-close" /></svg></button></div><p id="restockName" class="modal-description"></p><label>Unidades que ingresan<input name="units" type="number" min="1" max="500" value="20" required /></label><p class="form-note">Movimiento de ejemplo, solo durante esta visita.</p><button type="submit" class="button primary full">Registrar ingreso</button></form></dialog>
