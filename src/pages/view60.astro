function renderCart(){
 document.querySelectorAll('[data-cart-count]').forEach(e=>e.textContent=state.cart.reduce((s,l)=>s+l.qty,0));document.querySelectorAll('[data-subtotal]').forEach(e=>e.textContent=money(total()));
 $('cartLines').innerHTML=state.cart.length?state.cart.map((l,i)=>'<div class="cart-line"><img src="'+productImage(product(l.id))+'" alt=""/><div><strong>'+product(l.id).name+'</strong><small>'+lineName(l)+'</small><div class="quantity"><button data-qty="'+i+'" data-delta="-1" aria-label="Quitar una unidad de '+product(l.id).name+'">−</button><span>'+l.qty+'</span><button data-qty="'+i+'" data-delta="1" aria-label="Agregar una unidad de '+product(l.id).name+'" '+(l.qty>=20?'disabled':'')+'>+</button></div></div><span class="money">'+money(unitPrice(l)*l.qty)+'</span></div>').join(''):'<div class="empty">'+icon('bag')+'Tu pedido empieza aquí.<br/><span class="small-text">Agrega la energía que necesitas.</span></div>';
 const a=state.addresses.find(a=>a.id===state.delivery.addressId);$('cartAddress').textContent=a?a.alias+' · '+a.street+', '+a.district:'Elige o agrega una dirección para tu entrega.';
 $('reviewOrder').disabled=$('mobileReview').disabled=$('clearCart').disabled=!state.cart.length;$('orderError').hidden=true;
}
function addProduct(id,mode){
 const p=product(id);if(!p)return;mode=p.type==='accessory'?'unit':mode||'refill';const line=state.cart.find(l=>l.id===id&&l.mode===mode);
 if(line&&line.qty>=20){toast('Puedes agregar hasta 20 unidades por presentación.');return}
 if(line)line.qty++;else state.cart.push({id,mode,qty:1});
 persist();renderCart();toast(p.name+' agregado a tu pedido.');
}
function renderAddresses(){
 $('deliveryAddresses').innerHTML=state.addresses.length?state.addresses.map(a=>'<button type="button" class="address-choice '+(a.id===state.delivery.addressId?'selected':'')+'" data-select-address="'+esc(a.id)+'" aria-pressed="'+(a.id===state.delivery.addressId)+'"><strong>'+esc(a.alias)+'<span class="radio"></span></strong><small>'+esc(a.street)+'<br/>'+esc(a.district)+'</small></button>').join(''):'<div class="empty">'+icon('pin')+'Agrega una dirección para recibir tu pedido.<br/><button class="text-btn" data-new-address>+ Guardar mi primera dirección</button></div>';
 $('addressCards').innerHTML=state.addresses.length?state.addresses.map(a=>'<article class="card address-card"><header><span class="chip-icon">'+icon('pin')+'</span>'+(a.primary?'<span class="tag green">PRINCIPAL</span>':'')+'</header><h3>'+esc(a.alias)+'</h3><p>'+esc(a.street)+'<br/>'+esc(a.district)+'</p><p class="section-gap small-text">'+esc(a.reference||'Sin referencia adicional.')+'</p><div class="address-actions"><button data-edit-address="'+esc(a.id)+'">Editar</button>'+(!a.primary?'<button data-primary-address="'+esc(a.id)+'">Hacer principal</button>':'')+'<button data-delete-address="'+esc(a.id)+'">Eliminar</button></div></article>').join(''):'<div class="card empty">'+icon('pin')+'Tus lugares favoritos estarán aquí.<br/><button class="text-btn" data-new-address>+ Agregar una dirección</button></div>';
 renderIdentity();renderCart();
}
function openAddress(id=''){
 const a=state.addresses.find(a=>a.id===id);$('addressForm').reset();fill($('addressForm'),a||{id:'',district:'Surquillo'});$('addressForm').elements.primary.checked=a?.primary||!state.addresses.length;$('addressTitle').textContent=a?'Editar dirección':'Nueva dirección';$('addressDialog').showModal();
}
$('addressForm').addEventListener('submit',e=>{
 e.preventDefault();const f=e.currentTarget;if(!f.reportValidity())return;const d=Object.fromEntries(new FormData(f));d.alias=d.alias.trim();d.street=d.street.trim();d.reference=d.reference.trim();if(!d.alias||!d.street){toast('Escribe un nombre y una dirección válidos.');return}
 const existing=state.addresses.find(a=>a.id===d.id);d.primary=f.elements.primary.checked||!state.addresses.length;if(existing?.primary&&!d.primary&&!state.addresses.some(a=>a.id!==d.id&&a.primary))d.primary=true;
 if(d.primary)state.addresses.forEach(a=>a.primary=false);d.id=d.id||crypto.randomUUID();const index=state.addresses.findIndex(a=>a.id===d.id);if(index>=0)state.addresses[index]=d;else state.addresses.push(d);if(!state.delivery.addressId)state.delivery.addressId=d.id;
 persist();renderAddresses();$('addressDialog').close();toast('Dirección guardada para tus próximos pedidos.');
});
document.addEventListener('click',e=>{
 const b=e.target.closest('button');if(!b)return;
 if(b.hasAttribute('data-new-address'))openAddress();
 if(b.dataset.editAddress)openAddress(b.dataset.editAddress);
 if(b.dataset.primaryAddress){state.addresses.forEach(a=>a.primary=a.id===b.dataset.primaryAddress);persist();renderAddresses();toast('Dirección principal actualizada.')}
 if(b.dataset.deleteAddress)ask('¿Eliminar esta dirección?','Dejará de estar disponible en tus próximos pedidos.',()=>{state.addresses=state.addresses.filter(a=>a.id!==b.dataset.deleteAddress);if(state.addresses.length&&!state.addresses.some(a=>a.primary))state.addresses[0].primary=true;if(state.delivery.addressId===b.dataset.deleteAddress)state.delivery.addressId=primaryAddress()?.id||'';persist();renderAddresses();toast('Dirección eliminada.');});
 if(b.dataset.selectAddress){state.delivery.addressId=b.dataset.selectAddress;persist();renderAddresses()}
 if(b.dataset.quickAdd){addProduct(b.dataset.quickAdd);showPage('order')}
 if(b.dataset.add)addProduct(b.dataset.add,document.querySelector('[data-mode="'+b.dataset.add+'"]')?.value);
 if(b.hasAttribute('data-qty')){const i=Number(b.dataset.qty),l=state.cart[i];if(!l)return;l.qty=Math.min(20,l.qty+Number(b.dataset.delta));if(l.qty<=0)state.cart.splice(i,1);persist();renderCart()}
 if(b.dataset.category){category=b.dataset.category;document.querySelectorAll('[data-category]').forEach(el=>{el.classList.toggle('active',el===b);el.setAttribute('aria-pressed',String(el===b))});renderProducts()}
});
document.addEventListener('change',e=>{if(e.target.dataset.mode){const p=product(e.target.dataset.mode);$('price-'+p.id).textContent=money(e.target.value==='full'?p.full:p.price)}});
$('usualOrder').addEventListener('click',()=>{addProduct(state.profile.usual);showPage('order')});
$('clearCart').addEventListener('click',()=>ask('¿Vaciar tu pedido?','Tus direcciones y preferencias se conservarán.',()=>{state.cart=[];persist();renderCart()}));
function syncPayment(){
 const f=$('paymentForm'),cash=f.elements.payment.value==='Efectivo',invoice=f.elements.documentType.value==='Factura';
 $('cashField').hidden=!cash;f.elements.cash.disabled=!cash;f.elements.cash.required=false;
 $('dniField').hidden=invoice;f.elements.dni.disabled=invoice;
 ['ruc','legalName'].forEach(n=>{f.elements[n].required=invoice;f.elements[n].disabled=!invoice});$('rucField').hidden=$('legalField').hidden=!invoice;
}
[$('deliveryForm'),$('paymentForm')].forEach(f=>{f.addEventListener('submit',e=>e.preventDefault());f.addEventListener('input',()=>{const target=f.id==='deliveryForm'?state.delivery:state.payment;Object.assign(target,Object.fromEntries(new FormData(f)));syncPayment();persist()});f.addEventListener('change',()=>{const target=f.id==='deliveryForm'?state.delivery:state.payment;Object.assign(target,Object.fromEntries(new FormData(f)));syncPayment();persist()})});
function reviewOrder(){
 if(!state.cart.length)return;
 const fail=message=>{$('orderError').textContent=message;$('orderError').hidden=false;toast(message)};
 const address=state.addresses.find(a=>a.id===state.delivery.addressId);
 if(!address){fail('Agrega o elige una dirección para continuar.');$('deliveryAddresses').scrollIntoView({block:'center'});return}
 if(!$('deliveryForm').reportValidity()||!$('paymentForm').reportValidity()){fail('Revisa los campos de contacto y comprobante.');return}
 if(!state.delivery.receiver.trim()){fail('Escribe el nombre de quien recibe.');return}
 if(state.payment.documentType==='Factura'&&!state.payment.legalName.trim()){fail('Completa la razón social de la factura.');return}
 if(state.payment.payment==='Efectivo'&&state.payment.cash&&Number(state.payment.cash)<total()){fail('El monto en efectivo debe cubrir al menos el subtotal de productos.');return}
 const lines=state.cart.map(l=>({...l,name:product(l.id).name,price:unitPrice(l),presentation:lineName(l)}));
 const invoice=state.payment.documentType==='Factura'?'Factura · RUC '+state.payment.ruc+'\nRazón social: '+state.payment.legalName:'Boleta'+(state.payment.dni?' · DNI '+state.payment.dni:'');
 const message='Hola, Solgas Surquillo. Quisiera coordinar este pedido:\n\n'+lines.map(l=>'• '+l.qty+' × '+l.name+' — '+l.presentation+'\n  '+money(l.price)+' c/u · '+money(l.price*l.qty)).join('\n')+'\n\nSubtotal de productos: '+money(total())+'\nEnvío: por confirmar.\n\nEntrega en: '+address.alias+'\n'+address.street+', '+address.district+(address.reference?'\nReferencia: '+address.reference:'')+'\nRecibe: '+state.delivery.receiver+'\nCelular: '+state.delivery.phone+(state.delivery.notes?'\nIndicaciones: '+state.delivery.notes:'')+'\n\nPago: '+state.payment.payment+(state.payment.payment==='Efectivo'&&state.payment.cash?' · pagaré con '+money(state.payment.cash):'')+'\nComprobante: '+invoice+'\n\nPor favor, confirmen disponibilidad, total con envío y tiempo estimado.\n\n[PRUEBA DE DISEÑO · NO ES UN PEDIDO REAL. Precios referenciales.]';
 currentSnapshot={id:crypto.randomUUID(),date:new Date().toISOString(),lines,address:clone(address),delivery:clone(state.delivery),payment:clone(state.payment),total:total(),message,status:'Borrador guardado'};
 $('messagePreview').textContent=message;$('waOpen').href='https://wa.me/51936369384?text='+encodeURIComponent(message);$('orderError').hidden=true;$('reviewDialog').showModal();
}
$('reviewOrder').addEventListener('click',reviewOrder);$('mobileReview').addEventListener('click',reviewOrder);
function recordSnapshot(status){if(!currentSnapshot)return;currentSnapshot.status=status;const i=state.history.findIndex(h=>h.id===currentSnapshot.id);if(i>=0)state.history[i]=clone(currentSnapshot);else state.history.unshift(clone(currentSnapshot));state.history=state.history.slice(0,40);persist();renderHistory()}
$('saveDraft').addEventListener('click',()=>{recordSnapshot('Borrador guardado');$('reviewDialog').close();toast('Borrador guardado en Mis pedidos.');});
$('waOpen').addEventListener('click',()=>{recordSnapshot('WhatsApp abierto');$('reviewDialog').close();toast('Envía el mensaje en WhatsApp para coordinar con la planta.');});
function renderHistory(){
 $('historyList').innerHTML=state.history.length?state.history.map(h=>'<article class="card history-card"><div><span class="tag '+(h.status==='WhatsApp abierto'?'green':'orange')+'">'+esc(h.status)+'</span><h3>'+h.lines.map(l=>esc(l.qty+' × '+l.name)).join(' · ')+'</h3><p>'+new Date(h.date).toLocaleString('es-PE',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'})+' · '+esc(h.address.alias)+'</p></div><div><span class="small-text muted">Subtotal de productos</span><strong class="money">'+money(h.total)+'</strong><p>Entrega y confirmación pendientes.</p></div><div class="history-actions"><button class="btn secondary small" data-history-view="'+h.id+'">Ver detalle</button><button class="btn primary small" data-repeat="'+h.id+'">Volver a pedir</button></div></article>').join(''):'<div class="card empty">'+icon('clock')+'Aquí empieza tu historia con nosotros.<br/><span class="small-text">Guarda tu primer borrador al revisar un pedido.</span><br/><button class="btn primary section-gap" data-go="order">Preparar mi primer pedido</button></div>';
}
document.addEventListener('click',e=>{
 const b=e.target.closest('button');if(!b)return;
 if(b.dataset.historyView){const h=state.history.find(h=>h.id===b.dataset.historyView);if(!h)return;currentSnapshot=clone(h);$('messagePreview').textContent=h.message;$('waOpen').href='https://wa.me/51936369384?text='+encodeURIComponent(h.message);$('reviewDialog').showModal()}
 if(b.dataset.repeat){const h=state.history.find(h=>h.id===b.dataset.repeat);if(!h)return;const repeat=()=>{state.cart=h.lines.filter(l=>product(l.id)).map(l=>({id:l.id,mode:l.mode,qty:l.qty}));persist();renderCart();showPage('order');toast('Productos agregados. Revisa los precios y tu dirección actuales.');};if(state.cart.length)ask('¿Preparar este pedido de nuevo?','Reemplazará los productos que tienes ahora. Usaremos tus datos de entrega y precios actuales.',repeat);else repeat()}
});
function loadProfile(){fill($('profileForm'),state.profile);profileDirty=false;$('profileStatus').textContent='Tus cambios se guardan en esta demostración.';$('profileStatus').classList.remove('saved')}
$('profileForm').addEventListener('input',()=>{profileDirty=true;$('profileStatus').textContent='Tienes cambios sin guardar.';$('profileStatus').classList.remove('saved')});
$('discardProfile').addEventListener('click',()=>{loadProfile();toast('Se restauraron tus datos guardados.');});
$('profileForm').addEventListener('submit',e=>{
 e.preventDefault();if(!e.currentTarget.reportValidity())return;const d=Object.fromEntries(new FormData(e.currentTarget));d.name=d.name.trim();d.surname=d.surname.trim();if(!d.name||!d.surname){toast('Completa tus nombres y apellidos.');return}
 const old=clone(state.profile);['name','surname','phone','dni','payment','usual','notes'].forEach(k=>state.profile[k]=d[k]);
 if(state.delivery.receiver===old.name+' '+old.surname)state.delivery.receiver=fullName();if(state.delivery.phone===old.phone)state.delivery.phone=d.phone;if(state.delivery.notes===old.notes)state.delivery.notes=d.notes;if(state.payment.payment===old.payment)state.payment.payment=d.payment;if(state.payment.dni===old.dni)state.payment.dni=d.dni;
 const saved=persist();loadProfile();fill($('deliveryForm'),state.delivery);fill($('paymentForm'),state.payment);syncPayment();renderIdentity();if(saved){$('profileStatus').textContent='Cambios guardados en este navegador.';$('profileStatus').classList.add('saved');toast('Tu perfil está actualizado.');}
});
beforePage=id=>{if(currentPage==='profile'&&id!=='profile'&&profileDirty){ask('¿Salir sin guardar?','Los cambios de tu perfil aún no se han guardado.',()=>{loadProfile();showPage(id)});return false}return true};
window.addEventListener('beforeunload',e=>{if(profileDirty){e.preventDefault();e.returnValue=''}});
$('newCustomerDemo').addEventListener('click',()=>ask('¿Probar un perfil por completar?','Quitaremos el celular y las direcciones de esta demostración. Tu cuenta real no se modifica.',()=>{state.profile.phone='';state.addresses=[];state.delivery.phone='';state.delivery.addressId='';persist();loadProfile();fill($('deliveryForm'),state.delivery);renderAddresses();showPage('home');toast('Así recibe la página a una cuenta nueva.');}));
document.querySelectorAll('[data-reset]').forEach(b=>b.addEventListener('click',()=>ask('¿Restablecer la demostración?','Se borrarán los cambios, direcciones y borradores de esta preview, únicamente en este navegador.',()=>{profileDirty=false;try{localStorage.removeItem(PAGE_KEY)}catch{}location.reload()})));
renderProducts();renderAddresses();renderHistory();loadProfile();fill($('deliveryForm'),state.delivery);fill($('paymentForm'),state.payment);syncPayment();
})();</script></body></html>
