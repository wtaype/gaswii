---

<!doctype html>
<html lang="es" data-theme="futuro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex,nofollow" />
  <title>Portal de Cliente · Solgas Surquillo | View 74</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Script Anti-FOUC síncrono en 0ms -->
  <script is:inline>
    try {
      const savedTheme = localStorage.getItem('gaswii_theme_cliente') || localStorage.getItem('wiTema') || 'futuro';
      document.documentElement.dataset.theme = savedTheme;
      if (localStorage.getItem('gaswii_sidebar_v74') === 'true') {
        document.documentElement.classList.add('is-collapsed');
      }
    } catch (e) {}
  </script>

  <link rel="stylesheet" href="/google/fonts.css" />
  <link rel="stylesheet" href="/fontawesome/css/all.min.css" />
  <style is:global set:html={witemaCss}></style>

  <style>
    /* ============================================================
       VARIABLES DE DISEÑO
       ============================================================ */
    :root {
      --side-w: 240px;
      --side-collapsed-w: 68px;
      --topbar-h: 62px;
      --cl-orange: #ff6600;
      --cl-orange-hover: #ff771a;
      --cl-wa: #25d366;
      --cl-wa-hover: #1ebd5b;
      --cl-blue: #0284c7;
      --cl-emerald: #10b981;
      --cl-card-bg: #0d1424;
      --cl-card-border: rgba(255, 255, 255, 0.08);
      --cl-input-bg: #070c18;
    }

    html[data-theme="luz"] {
      --cl-card-bg: #ffffff;
      --cl-card-border: #e2e8f0;
      --cl-input-bg: #f8fafc;
    }

    *, *::before, *::after { box-sizing: border-box; }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: var(--ff_P, 'Poppins', sans-serif);
      font-size: var(--fz_m);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    /* ============================================================
       1. HEADER (62PX CONFORTABLE)
       ============================================================ */
    .v74-topbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: var(--topbar-h);
      background: var(--surface);
      border-bottom: 1px solid var(--line);
      z-index: 60;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      backdrop-filter: blur(14px);
    }

    .v74-brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }

    .v74-logo {
      height: 34px;
      width: auto;
      object-fit: contain;
    }

    .v74-brand-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .v74-brand-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--ink);
      line-height: 1.2;
    }

    .v74-brand-title span { color: var(--cl-orange); }

    .v74-brand-sede {
      font-size: 0.74rem;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .v74-live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--cl-emerald);
      box-shadow: 0 0 8px var(--cl-emerald);
    }

    .v74-topbar-right {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .v74-btn-icon {
      background: var(--surface2, rgba(255,255,255,0.05));
      border: 1px solid var(--line);
      color: var(--ink);
      width: 38px;
      height: 38px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      cursor: pointer;
      font-size: 0.9rem;
      transition: all 0.18s;
    }
    .v74-btn-icon:hover { border-color: var(--cl-orange); color: var(--cl-orange); }

    .v74-user-chip {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 5px 14px 5px 6px;
      background: var(--surface2, rgba(255,255,255,0.04));
      border: 1px solid var(--line);
      border-radius: 25px;
    }

    .v74-avatar-sm {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: var(--cl-orange);
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 700;
      font-size: 0.8rem;
    }

    .v74-user-name {
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--ink);
    }

    /* ============================================================
       2. SIDEBAR DEL CLIENTE ("SOPORTE" NOMBRE CORTO)
       ============================================================ */
    .v74-sidebar {
      position: fixed;
      top: var(--topbar-h);
      left: 0;
      bottom: 0;
      width: var(--side-w);
      background: var(--surface);
      border-right: 1px solid var(--line);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 16px 12px;
      z-index: 50;
      transition: width 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .v74-sidebar { width: var(--side-collapsed-w); }

    .v74-nav {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .v74-nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 14px;
      border-radius: 10px;
      border: none;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      font-weight: 600;
      font-size: 0.88rem;
      text-align: left;
      transition: all 0.16s;
      width: 100%;
      white-space: nowrap;
      overflow: hidden;
      position: relative;
    }

    .v74-nav-item i {
      font-size: 1.1rem;
      width: 22px;
      text-align: center;
      flex-shrink: 0;
    }

    .v74-nav-item:hover {
      background: var(--surface2, rgba(255,255,255,0.05));
      color: var(--ink);
    }

    .v74-nav-item.active {
      background: rgba(255, 102, 0, 0.12);
      color: var(--cl-orange);
      font-weight: 700;
    }

    .v74-nav-item.active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 8px;
      bottom: 8px;
      width: 3.5px;
      background: var(--cl-orange);
      border-radius: 0 4px 4px 0;
    }

    .v74-nav-badge {
      margin-left: auto;
      background: rgba(255, 102, 0, 0.18);
      color: var(--cl-orange);
      font-size: 0.72rem;
      padding: 2px 7px;
      border-radius: 12px;
      font-weight: 700;
      font-family: var(--ff_O, sans-serif);
    }

    html.is-collapsed .v74-nav-text,
    html.is-collapsed .v74-nav-badge,
    html.is-collapsed #lblCollapse74 { display: none; }

    .v74-sidebar-foot {
      border-top: 1px solid var(--line);
      padding-top: 12px;
    }

    .v74-btn-collapse {
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      padding: 9px 12px;
      background: transparent;
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--muted);
      cursor: pointer;
      font-size: 0.82rem;
      font-weight: 600;
    }

    /* ============================================================
       3. CONTENEDOR PRINCIPAL
       ============================================================ */
    .v74-main {
      margin-top: var(--topbar-h);
      margin-left: var(--side-w);
      padding: 22px 28px;
      min-height: calc(100vh - var(--topbar-h));
      transition: margin-left 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    html.is-collapsed .v74-main { margin-left: var(--side-collapsed-w); }

    .v74-panel { display: none; }
    .v74-panel.active { display: block; animation: v74Fade 0.2s ease-out; }

    @keyframes v74Fade {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============================================================
       MÓDULO 1: PEDIR GAS (PRODUCTOS PROTAGONISTAS)
       ============================================================ */
    .v74-hero-banner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .v74-hero-banner h1 {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--ink);
      margin: 0;
    }

    .v74-hero-banner h1 span { color: var(--cl-orange); }

    .v74-btn-manage-ficha {
      background: transparent;
      border: 1px solid rgba(255, 102, 0, 0.4);
      color: var(--cl-orange);
      padding: 7px 16px;
      border-radius: 8px;
      font-size: 0.84rem;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.18s;
    }
    .v74-btn-manage-ficha:hover {
      background: rgba(255, 102, 0, 0.1);
    }

    /* GRID 1.2fr / 0.8fr */
    .v74-grid-pedir {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 24px;
      align-items: start;
    }

    @media (max-width: 1140px) {
      .v74-grid-pedir { grid-template-columns: 1fr; }
    }

    .v74-sec-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.95rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--ink);
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .v74-sec-tag-green {
      color: var(--cl-emerald);
      font-size: 0.76rem;
      text-transform: none;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* 4 CARDS PRODUCTOS CON IMÁGENES GRANDES Y TÍTULOS CENTRADOS */
    .v74-cards-prods {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    @media (max-width: 650px) {
      .v74-cards-prods { grid-template-columns: 1fr; }
    }

    .v74-card-p {
      background: var(--cl-card-bg);
      border: 1.5px solid var(--cl-card-border);
      border-radius: 16px;
      padding: 18px 16px;
      cursor: pointer;
      position: relative;
      transition: all 0.2s;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      text-align: center; /* CENTRADO SOLICITADO */
    }

    .v74-card-p:hover {
      border-color: rgba(255, 102, 0, 0.55);
      transform: translateY(-3px);
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.2);
    }

    .v74-card-p.active {
      border-color: var(--cl-orange);
      background: rgba(255, 102, 0, 0.04);
      box-shadow: 0 6px 24px rgba(255, 102, 0, 0.16);
    }

    .v74-card-top-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 10px;
    }

    .v74-p-badge {
      font-size: 0.68rem;
      font-weight: 800;
      font-family: var(--ff_O, sans-serif);
      padding: 3px 8px;
      border-radius: 6px;
    }
    .badge-fire { background: rgba(255, 102, 0, 0.2); color: #ff771a; }
    .badge-blue { background: rgba(2, 132, 199, 0.2); color: #38bdf8; }
    .badge-emerald { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .badge-gold { background: rgba(234, 179, 8, 0.2); color: #facc15; }

    .v74-p-uso {
      font-size: 0.74rem;
      color: var(--muted);
      font-weight: 600;
    }

    /* IMAGEN DE PRODUCTO MÁS GRANDE */
    .v74-p-img-box {
      text-align: center;
      position: relative;
      margin: 10px auto 14px;
      height: 115px; /* AUMENTADO SIGNIFICATIVAMENTE */
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .v74-p-img {
      max-height: 115px; /* MÁS GRANDE */
      max-width: 100%;
      object-fit: contain;
      filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.25));
      transition: transform 0.2s;
    }

    .v74-card-p:hover .v74-p-img {
      transform: scale(1.04);
    }

    .v74-p-pill-weight {
      position: absolute;
      bottom: 0;
      right: 50%;
      transform: translateX(50%);
      background: rgba(0,0,0,0.72);
      color: #fff;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 10px;
      white-space: nowrap;
    }

    /* TÍTULO DE PRODUCTO CENTRADO */
    .v74-p-name {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.05rem; /* MÁS GRANDE Y CLARO */
      font-weight: 800;
      color: var(--ink);
      margin: 4px 0 10px;
      text-align: center; /* CENTRADO SOLICITADO */
      line-height: 1.25;
    }

    /* 2 CHECKS TÉCNICOS DE CONFIANZA */
    .v74-p-checks {
      border-top: 1px dashed var(--line);
      padding-top: 10px;
      display: flex;
      flex-direction: column;
      gap: 5px;
      margin-bottom: 12px;
      text-align: left;
    }

    .v74-p-check-item {
      font-size: 0.74rem;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .v74-p-check-item i { color: var(--cl-emerald); font-size: 0.7rem; }

    .v74-p-foot-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-top: 1px solid var(--line);
      padding-top: 10px;
      margin-top: auto;
    }

    .v74-p-price {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--cl-orange);
    }

    .v74-p-free-delivery {
      color: var(--cl-emerald);
      font-size: 0.74rem;
      font-weight: 700;
    }

    /* ============================================================
       COLUMNA DERECHA: "FORMA DE PAGO & INDICACIONES DE ENTREGA"
       REEMPLAZA A "DATOS DE CONFIRMACIÓN" DE FORMA MUY ORGANIZADA
       ============================================================ */
    .v74-preview-column {
      display: flex;
      flex-direction: column;
      gap: 16px;
      position: sticky;
      top: calc(var(--topbar-h) + 16px);
    }

    .v74-order-config-card {
      background: var(--cl-card-bg);
      border: 1px solid var(--cl-card-border);
      border-radius: 16px;
      padding: 16px;
    }

    .v74-config-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      border-bottom: 1px solid var(--line);
      padding-bottom: 8px;
    }

    .v74-config-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.88rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--cl-orange);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* DESTINO RÁPIDO */
    .v74-dest-select-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 12px;
      background: var(--surface2, rgba(255,255,255,0.03));
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 6px 10px;
    }

    .v74-dest-select-row label {
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--muted);
      display: flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
    }

    .v74-select-dir {
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      border-radius: 6px;
      color: var(--ink);
      font-size: 0.78rem;
      font-weight: 700;
      padding: 5px 8px;
      outline: none;
      cursor: pointer;
      flex: 1;
      max-width: 210px;
    }

    /* TABS DE MÉTODO DE PAGO */
    .v74-tabs-pago {
      display: flex;
      gap: 8px;
      margin-bottom: 8px;
    }

    .v74-btn-tab-pago {
      flex: 1;
      padding: 7px 10px;
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--muted);
      font-weight: 700;
      font-size: 0.78rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.16s;
    }

    .v74-btn-tab-pago.active {
      border-color: var(--cl-orange);
      color: var(--cl-orange);
      background: rgba(255, 102, 0, 0.1);
    }

    .v74-chips-vuelto {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 4px;
      margin-bottom: 6px;
    }

    .v74-chip-btn {
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      color: var(--ink);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.74rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.14s;
    }

    .v74-chip-btn:hover { border-color: var(--cl-orange); }
    .v74-chip-btn.active {
      background: var(--cl-orange);
      color: #fff;
      border-color: var(--cl-orange);
    }

    .v74-vuelto-calc-box {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(16, 185, 129, 0.08);
      border: 1px solid rgba(16, 185, 129, 0.2);
      border-radius: 6px;
      padding: 5px 10px;
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--cl-emerald);
      margin-top: 6px;
    }

    .v74-quick-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 10px;
      margin-bottom: 6px;
    }

    .v74-quick-tag {
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      color: var(--muted);
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 0.7rem;
      font-weight: 600;
      cursor: pointer;
    }
    .v74-quick-tag:hover { color: var(--cl-orange); border-color: var(--cl-orange); }

    .v74-notes-textarea {
      width: 100%;
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--ink);
      padding: 8px 10px;
      font-size: 0.78rem;
      resize: vertical;
      min-height: 48px;
      outline: none;
      margin-top: 4px;
    }
    .v74-notes-textarea:focus { border-color: var(--cl-orange); }

    /* MOCKUP WHATSAPP */
    .v74-wa-card {
      background: var(--cl-card-bg);
      border: 1px solid var(--cl-card-border);
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    .v74-wa-header {
      background: #008069;
      color: #fff;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .v74-wa-header-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .v74-wa-avatar {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #fff;
      object-fit: contain;
      padding: 3px;
    }

    .v74-wa-header-info strong {
      font-size: 0.85rem;
      display: block;
      line-height: 1.15;
    }
    .v74-wa-header-info small {
      font-size: 0.68rem;
      opacity: 0.9;
    }

    .v74-wa-body {
      background: #efeae2;
      padding: 14px 12px;
      min-height: 220px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    html[data-theme="futuro"] .v74-wa-body {
      background: #0b141a;
    }

    .v74-bubble-in {
      background: #fff;
      color: #111b21;
      border-radius: 8px 8px 8px 2px;
      padding: 8px 10px;
      font-size: 0.78rem;
      max-width: 88%;
      box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }
    html[data-theme="futuro"] .v74-bubble-in {
      background: #202c33;
      color: #e9edef;
    }

    .v74-bubble-out {
      background: #d9fdd3;
      color: #111b21;
      border-radius: 8px 8px 2px 8px;
      padding: 10px 12px;
      font-size: 0.8rem;
      max-width: 92%;
      margin-left: auto;
      white-space: pre-line;
      line-height: 1.4;
      box-shadow: 0 1px 2px rgba(0,0,0,0.08);
    }
    html[data-theme="futuro"] .v74-bubble-out {
      background: #005c4b;
      color: #e9edef;
    }

    .v74-wa-time {
      font-size: 0.62rem;
      opacity: 0.65;
      text-align: right;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 3px;
      margin-top: 3px;
    }

    /* RESUMEN PRECIO Y PRODUCTO */
    .v74-summary-box {
      padding: 12px 14px;
      border-top: 1px solid var(--line);
      background: var(--surface);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .v74-summary-prod {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--ink);
    }
    .v74-summary-sub {
      font-size: 0.72rem;
      color: var(--muted);
    }

    .v74-summary-price {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--cl-orange);
    }

    .v74-actions-row {
      padding: 12px 14px;
      background: var(--surface);
      border-top: 1px solid var(--line);
      display: flex;
      gap: 8px;
    }

    .v74-btn-call {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: rgba(2, 132, 199, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(2, 132, 199, 0.3);
      display: grid;
      place-items: center;
      font-size: 1rem;
      text-decoration: none;
      transition: all 0.18s;
      flex-shrink: 0;
    }
    .v74-btn-call:hover { background: #0284c7; color: #fff; }

    .v74-btn-wa-order {
      flex: 1;
      background: var(--cl-wa);
      color: #fff;
      border: none;
      border-radius: 10px;
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.95rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.18s;
      box-shadow: 0 4px 14px rgba(37, 211, 102, 0.3);
    }
    .v74-btn-wa-order:hover {
      background: var(--cl-wa-hover);
      transform: translateY(-1px);
    }

    /* MÓDULO MI CUENTA */
    .v74-cuenta-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 18px;
    }

    .v74-cuenta-header h2 {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--ink);
      margin: 0;
    }
    .v74-cuenta-header p {
      font-size: 0.8rem;
      color: var(--muted);
      margin: 2px 0 0;
    }

    .v74-btn-save-primary {
      background: var(--cl-orange);
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 9px 18px;
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.88rem;
      font-weight: 800;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.18s;
    }
    .v74-btn-save-primary:hover {
      background: var(--cl-orange-hover);
      transform: translateY(-1px);
    }

    .v74-subtabs-bar {
      display: flex;
      gap: 6px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 10px;
      padding: 4px;
      margin-bottom: 20px;
      overflow-x: auto;
    }

    .v74-subtab-btn {
      padding: 7px 16px;
      background: transparent;
      border: none;
      border-radius: 7px;
      color: var(--muted);
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.16s;
      white-space: nowrap;
    }

    .v74-subtab-btn:hover { color: var(--ink); }
    .v74-subtab-btn.active {
      background: var(--cl-orange);
      color: #fff;
    }

    .v74-subpanel { display: none; }
    .v74-subpanel.active { display: block; animation: v74Fade 0.2s ease-out; }

    .v74-form-card {
      background: var(--cl-card-bg);
      border: 1px solid var(--cl-card-border);
      border-radius: 14px;
      padding: 20px;
      margin-bottom: 16px;
    }

    .v74-form-card-title {
      font-family: var(--ff_O, 'Outfit', sans-serif);
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--cl-orange);
      margin-bottom: 4px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .v74-form-card-sub {
      font-size: 0.74rem;
      color: var(--muted);
      margin-bottom: 16px;
    }

    .v74-form-grid-2 {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    @media (max-width: 640px) {
      .v74-form-grid-2 { grid-template-columns: 1fr; }
    }

    .v74-form-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .v74-form-group label {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--ink);
    }

    .v74-form-input {
      width: 100%;
      background: var(--cl-input-bg);
      border: 1px solid var(--line);
      border-radius: 8px;
      color: var(--ink);
      padding: 9px 12px;
      font-size: 0.82rem;
      outline: none;
    }
    .v74-form-input:focus { border-color: var(--cl-orange); }

    /* TOAST */
    #v74Toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: var(--ink);
      color: var(--bg);
      padding: 8px 16px;
      border-radius: 8px;
      font-size: 0.82rem;
      font-weight: 700;
      display: none;
      z-index: 100;
      box-shadow: 0 4px 14px rgba(0,0,0,0.3);
    }
  </style>
</head>
<body>

  <!-- ============================================================
       1. HEADER (62PX CONFORTABLE)
       ============================================================ -->
  <header class="v74-topbar">
    <a href="/view74" class="v74-brand">
      <img src="/imgwii/logo.webp" alt="Solgas" class="v74-logo" />
      <div class="v74-brand-text">
        <span class="v74-brand-title">SOLGAS <span>SURQUILLO</span></span>
        <span class="v74-brand-sede">
          <span class="v74-live-dot"></span> Sede Jr. Dante 260 · Despacho Activo
        </span>
      </div>
    </a>

    <div class="v74-topbar-right">
      <button class="v74-btn-icon" id="btnTheme74" title="Alternar modo claro / oscuro">
        <i class="fa-solid fa-moon"></i>
      </button>

      <div class="v74-user-chip">
        <div class="v74-avatar-sm">{avatar(cliente.nombre)}</div>
        <span class="v74-user-name">{cliente.nombre} · VIP</span>
      </div>
    </div>
  </header>

  <!-- ============================================================
       2. SIDEBAR DEL CLIENTE ("SOPORTE" EXACTO)
       ============================================================ -->
  <aside class="v74-sidebar">
    <nav class="v74-nav">
      <button class="v74-nav-item active" data-target="pedir-gas">
        <i class="fa-solid fa-bolt"></i>
        <span class="v74-nav-text">Pedir gas</span>
      </button>

      <button class="v74-nav-item" data-target="direcciones">
        <i class="fa-solid fa-map-location-dot"></i>
        <span class="v74-nav-text">Direcciones</span>
        <span class="v74-nav-badge">{cliente.direcciones.length}</span>
      </button>

      <button class="v74-nav-item" data-target="soporte">
        <i class="fa-solid fa-headset"></i>
        <span class="v74-nav-text">Soporte</span>
      </button>

      <button class="v74-nav-item" data-target="mi-cuenta">
        <i class="fa-solid fa-user-gear"></i>
        <span class="v74-nav-text">Mi cuenta</span>
      </button>
    </nav>

    <div class="v74-sidebar-foot">
      <button class="v74-btn-collapse" id="btnCollapse74">
        <i class="fa-solid fa-arrow-left-long"></i>
        <span id="lblCollapse74">Colapsar</span>
      </button>
    </div>
  </aside>

  <!-- ============================================================
       3. CONTENEDOR PRINCIPAL
       ============================================================ -->
  <main class="v74-main">

    <!-- ========================================================
         PANEL 1: PEDIR GAS (PRODUCTOS PROTAGONISTAS)
         ======================================================== -->
    <section class="v74-panel active" id="panel-pedir-gas">
      <div class="v74-hero-banner">
        <h1>¡Buenas noches {cliente.nombre}! 🔥 <span>Realiza tu Pedido Hoy</span></h1>
        <button type="button" class="v74-btn-manage-ficha" id="btnGoFicha74">
          <i class="fa-solid fa-address-card"></i> Gestionar Ficha & Direcciones
        </button>
      </div>

      <!-- GRID PRINCIPAL: 1.2fr (PRODUCTOS GRANDES) / 0.8fr (CONFIGURACIÓN + PREVIEW) -->
      <div class="v74-grid-pedir">
        <!-- COLUMNA IZQUIERDA: PRODUCTOS CON IMÁGENES GRANDES Y TÍTULOS CENTRADOS -->
        <div>
          <div class="v74-sec-title">
            <span>Selecciona tu Producto de Hoy</span>
            <span class="v74-sec-tag-green">
              <i class="fa-solid fa-truck-fast"></i> Delivery y Pesaje Incluido
            </span>
          </div>

          <!-- 4 CARDS CON IMÁGENES GRANDES (~115PX) Y TÍTULOS CENTRADOS -->
          <div class="v74-cards-prods">
            {productos.map((prod, idx) => (
              <div 
                class={`v74-card-p ${idx === 0 ? 'active' : ''}`}
                data-id={prod.id}
                data-nombre={prod.nombre}
                data-nombrecorto={prod.nombreCorto}
                data-precio={prod.precioPEN}
              >
                <div class="v74-card-top-row">
                  <span class={`v74-p-badge ${prod.tagClase}`}>{prod.badge}</span>
                  <span class="v74-p-uso">{prod.tipoUso}</span>
                </div>

                <!-- IMAGEN GRANDE Y PROTAGONISTA -->
                <div class="v74-p-img-box">
                  <img src={prod.imagen} alt={prod.nombre} class="v74-p-img" />
                  <span class="v74-p-pill-weight">{prod.capacidad}</span>
                </div>

                <!-- TÍTULO DE PRODUCTO CENTRADO -->
                <div class="v74-p-name">{prod.nombre}</div>

                <!-- 2 CHECKS TÉCNICOS DE CONFIANZA -->
                <div class="v74-p-checks">
                  {prod.checks.map(c => (
                    <div class="v74-p-check-item">
                      <i class="fa-solid fa-check"></i>
                      <span><strong>{c.label}:</strong> {c.valor}</span>
                    </div>
                  ))}
                </div>

                <div class="v74-p-foot-row">
                  <span class="v74-p-price">S/ {prod.precioPEN.toFixed(2)}</span>
                  <span class="v74-p-free-delivery">Entrega Gratis</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- COLUMNA DERECHA: FORMA DE PAGO & INDICACIONES DE ENTREGA + WHATSAPP PREVIEW -->
        <aside class="v74-preview-column">
          
          <!-- BLOQUE DE CONFIGURACIÓN DEL PEDIDO (FORMA DE PAGO & INDICACIONES) -->
          <div class="v74-order-config-card">
            <div class="v74-config-header">
              <span class="v74-config-title">
                <i class="fa-solid fa-wallet"></i> Forma de Pago & Entrega
              </span>
              <span style="font-size:0.72rem; color:var(--cl-emerald); font-weight:700;">
                <i class="fa-solid fa-shield-check"></i> Balanza Inacal
              </span>
            </div>

            <!-- DESTINO RÁPIDO -->
            <div class="v74-dest-select-row">
              <label><i class="fa-solid fa-location-dot" style="color:var(--cl-orange);"></i> Destino:</label>
              <select class="v74-select-dir" id="selectDirConfig74">
                {cliente.direcciones.map(d => (
                  <option 
                    value={d.id} 
                    data-calle={d.calle} 
                    data-distrito={d.distrito} 
                    data-ref={d.referencia} 
                    data-eta={d.eta} 
                    data-alias={d.alias}
                    selected={d.esPrincipal}
                  >
                    {d.alias} ({d.eta})
                  </option>
                ))}
              </select>
            </div>

            <!-- TABS MÉTODO DE PAGO -->
            <div class="v74-tabs-pago">
              <button type="button" class="v74-btn-tab-pago active" data-metodo="efectivo">
                <i class="fa-solid fa-money-bill-wave"></i> Efectivo
              </button>
              <button type="button" class="v74-btn-tab-pago" data-metodo="yape-plin">
                <i class="fa-solid fa-mobile-screen-button"></i> Yape / Plin
              </button>
            </div>

            <!-- VUELTO (SI ES EFECTIVO) -->
            <div id="boxVuelto74">
              <div style="font-size:0.72rem; color:var(--muted); font-weight:600;">¿Con cuánto pagarás? (Vuelto)</div>
              <div class="v74-chips-vuelto" id="chipsVuelto74">
                <button type="button" class="v74-chip-btn" data-vuelto="exacto">Exacto</button>
                <button type="button" class="v74-chip-btn" data-vuelto="20">S/ 20</button>
                <button type="button" class="v74-chip-btn" data-vuelto="50">S/ 50</button>
                <button type="button" class="v74-chip-btn active" data-vuelto="100">S/ 100</button>
                <button type="button" class="v74-chip-btn" data-vuelto="otro">Otro</button>
              </div>

              <div class="v74-vuelto-calc-box" id="calcVueltoRow74">
                <span>Vuelto estimado:</span>
                <span id="valVueltoCalculado74">S/ 35.00</span>
              </div>
            </div>

            <!-- INDICACIONES RÁPIDAS -->
            <div class="v74-quick-tags" id="tagsNotas74">
              <button type="button" class="v74-quick-tag" data-tag="Tocar timbre">🔔 Timbre</button>
              <button type="button" class="v74-quick-tag" data-tag="Llamar al llegar">📞 Llamar</button>
              <button type="button" class="v74-quick-tag" data-tag="Dejar en recepción">🏢 Recepción</button>
              <button type="button" class="v74-quick-tag" data-tag="Piso 3 sin ascensor">🚪 Piso 3</button>
            </div>

            <textarea class="v74-notes-textarea" id="txtNotas74" placeholder="Indicaciones para el repartidor...">{cliente.notas}</textarea>
          </div>

          <!-- MOCKUP WHATSAPP EN VIVO -->
          <div class="v74-wa-card">
            <div class="v74-wa-header">
              <div class="v74-wa-header-left">
                <i class="fa-solid fa-arrow-left" style="font-size:0.8rem; cursor:pointer;"></i>
                <img src="/imgwii/logo.webp" alt="Solgas" class="v74-wa-avatar" />
                <div class="v74-wa-header-info">
                  <strong>Solgas Surquillo Oficial</strong>
                  <small>en línea · Respuesta inmediata</small>
                </div>
              </div>
              <div style="display:flex; gap:10px; font-size:0.88rem;">
                <i class="fa-solid fa-phone"></i>
                <i class="fa-solid fa-ellipsis-vertical"></i>
              </div>
            </div>

            <div class="v74-wa-body">
              <div class="v74-bubble-in">
                ¡Hola Valeria! 👋 En Solgas Surquillo tenemos unidades en Jr. Dante 260 listas con balanza digital Inacal.
                <div class="v74-wa-time">10:30 a. m.</div>
              </div>

              <div class="v74-bubble-out" id="bubbleWaText74">
¡Hola Solgas Surquillo! Deseo pedir mi recarga con mis datos guardados:

👤 Nombre: Valeria
📦 Producto: Balón SOLGAS Premium 10 kg (S/ 65.00)
📍 Entrega: Jr. Dante 260, Dpto 301, Surquillo
🧭 Ref: Frente al parque, portón marrón
💳 Pago: Efectivo (Llevar vuelto de S/ 100.00)
📝 Nota: Piso 3, timbre no suena fuerte.
⏱️ Llegada estimada: 12–15 min
                <div class="v74-wa-time">
                  <span>10:32 a. m.</span>
                  <i class="fa-solid fa-check-double" style="color:#53bdeb;"></i>
                </div>
              </div>
            </div>

            <!-- RESUMEN PRECIO Y PRODUCTO -->
            <div class="v74-summary-box">
              <div>
                <div class="v74-summary-prod" id="sumNombreProd74">Solgas 10 kg</div>
                <div class="v74-summary-sub" id="sumDistritoEta74">Surquillo · 12–15 min</div>
              </div>
              <div class="v74-summary-price" id="sumPrecioTotal74">S/ 65.00</div>
            </div>

            <!-- BOTONES DE ACCIÓN (LLAMAR + WHATSAPP) -->
            <div class="v74-actions-row">
              <a href="tel:936369384" class="v74-btn-call" title="Llamar a Solgas Surquillo">
                <i class="fa-solid fa-phone"></i>
              </a>
              <a href="https://wa.me/51936369384" target="_blank" rel="noopener noreferrer" class="v74-btn-wa-order" id="btnWaAction74">
                <i class="fa-brands fa-whatsapp" style="font-size:1.15rem;"></i>
                <span id="lblBtnWa74">Pedir por WhatsApp (S/ 65.00)</span>
              </a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- ========================================================
         PANEL 2: DIRECCIONES (LIBRETA DE SEDES)
         ======================================================== -->
    <section class="v74-panel" id="panel-direcciones">
      <div class="v74-cuenta-header">
        <div>
          <h2>Libreta de Direcciones ({cliente.direcciones.length})</h2>
          <p>Gestiona tus domicilios y sedes de entrega express desde Jr. Dante 260.</p>
        </div>
        <button type="button" class="v74-btn-save-primary" onclick="alert('Formulario de nueva dirección disponible')">
          <i class="fa-solid fa-plus"></i> Nueva Dirección
        </button>
      </div>

      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:14px;">
        {cliente.direcciones.map(d => (
          <div class="v74-form-card" style="margin-bottom:0;">
            <div style="display:flex; justify-content:space-between; align-items:flex-start;">
              <div style="display:flex; align-items:center; gap:10px;">
                <div style="width:38px; height:38px; border-radius:10px; background:rgba(255,102,0,0.12); color:var(--cl-orange); display:grid; place-items:center; font-size:1.1rem;">
                  <i class={`fa-solid ${d.icono}`}></i>
                </div>
                <div>
                  <strong style="font-size:0.95rem; color:var(--ink);">{d.alias}</strong>
                  <div style="font-size:0.72rem; color:var(--muted);">{d.distrito}</div>
                </div>
              </div>
              {d.esPrincipal && (
                <span style="font-size:0.68rem; font-weight:800; background:rgba(16,185,129,0.15); color:#10b981; padding:3px 9px; border-radius:12px;">
                  PRINCIPAL
                </span>
              )}
            </div>

            <div style="margin:14px 0; font-size:0.84rem;">
              <div style="font-weight:700; color:var(--ink);">{d.calle}</div>
              <div style="color:var(--muted); font-size:0.76rem; margin-top:2px;">Ref: {d.referencia}</div>
              <div style="color:var(--cl-emerald); font-weight:700; margin-top:6px;">⏱️ Llegada estimada: {d.eta}</div>
            </div>

            <div style="display:flex; gap:8px; border-top:1px solid var(--line); padding-top:12px;">
              <button type="button" class="v74-chip-btn" style="flex:1;" onclick="alert('Dirección seleccionada para tu siguiente pedido')">
                Seleccionar para Pedir
              </button>
              {!d.esPrincipal && (
                <button type="button" class="v74-chip-btn" onclick="alert('Establecida como predeterminada')">
                  Hacer Principal
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ========================================================
         PANEL 3: SOPORTE (NOMBRE CORTO EXACTO)
         ======================================================== -->
    <section class="v74-panel" id="panel-soporte">
      <div class="v74-cuenta-header">
        <div>
          <h2>Soporte al Cliente & Comprobantes</h2>
          <p>Solicita tus Boletas o Facturas electrónicas y comunícate directamente con la central.</p>
        </div>
      </div>

      <div class="v74-form-card">
        <div class="v74-form-card-title">
          <i class="fa-solid fa-file-invoice-dollar"></i> Solicitud de Factura o Boleta Electrónica
        </div>
        <div class="v74-form-card-sub">
          Emisión rápida de comprobante fiscal SUNAT para tus recargas en Solgas Surquillo.
        </div>

        <div class="v74-form-grid-2">
          <div class="v74-form-group">
            <label>Tipo de Comprobante</label>
            <select class="v74-form-input">
              <option value="boleta">Boleta Electrónica (DNI)</option>
              <option value="factura">Factura Electrónica (RUC 20)</option>
            </select>
          </div>

          <div class="v74-form-group">
            <label>DNI o RUC</label>
            <input type="text" class="v74-form-input" placeholder="Ej: 20601234567" value={cliente.dni} />
          </div>

          <div class="v74-form-group">
            <label>Razón Social o Nombre Completo</label>
            <input type="text" class="v74-form-input" placeholder="Nombre que figurará en el comprobante" value={cliente.nombreCompleto} />
          </div>

          <div class="v74-form-group">
            <label>Correo para Envío de PDF / XML</label>
            <input type="email" class="v74-form-input" value={cliente.email} />
          </div>
        </div>

        <div style="margin-top:16px; text-align:right;">
          <button type="button" class="v74-btn-save-primary" onclick="alert('Solicitud enviada a facturación Solgas Surquillo.')">
            <i class="fa-solid fa-paper-plane"></i> Enviar Solicitud
          </button>
        </div>
      </div>

      <div class="v74-form-card">
        <div class="v74-form-card-title">
          <i class="fa-solid fa-headset"></i> Canales de Atención Directa
        </div>
        <div class="v74-form-card-sub">
          ¿Tienes alguna duda sobre tu pedido en ruta o la verificación de balanza Inacal?
        </div>

        <div style="display:flex; flex-wrap:wrap; gap:12px;">
          <a href="https://wa.me/51936369384?text=Hola%20Solgas%20Surquillo,%20necesito%20ayuda%20con%20mi%20pedido" target="_blank" class="v74-btn-save-primary" style="background:#25d366; text-decoration:none;">
            <i class="fa-brands fa-whatsapp"></i> WhatsApp de Soporte
          </a>
          <a href="tel:936369384" class="v74-btn-save-primary" style="background:#0284c7; text-decoration:none;">
            <i class="fa-solid fa-phone"></i> Central Telefónica (936 369 384)
          </a>
        </div>
      </div>
    </section>

    <!-- ========================================================
         PANEL 4: MI CUENTA (SUB-PESTAÑAS SEGMENTADAS IMAGEN 2)
         ======================================================== -->
    <section class="v74-panel" id="panel-mi-cuenta">
      <div class="v74-cuenta-header">
        <div>
          <h2>Ficha de Mi Cuenta · Cliente VIP</h2>
          <p>Configuración de datos personales, facturación SUNAT, preferencias de recarga y seguridad.</p>
        </div>
        <button type="button" class="v74-btn-save-primary" id="btnSaveMiCuenta74">
          <i class="fa-solid fa-floppy-disk"></i> Guardar Cambios
        </button>
      </div>

      <div class="v74-subtabs-bar">
        <button type="button" class="v74-subtab-btn active" data-sub="identidad">
          <i class="fa-solid fa-id-card"></i> Identidad & Perfil
        </button>
        <button type="button" class="v74-subtab-btn" data-sub="facturacion">
          <i class="fa-solid fa-building"></i> Facturación & SUNAT
        </button>
        <button type="button" class="v74-subtab-btn" data-sub="preferencias">
          <i class="fa-solid fa-sliders"></i> Preferencias de Gas
        </button>
        <button type="button" class="v74-subtab-btn" data-sub="seguridad">
          <i class="fa-solid fa-shield-halved"></i> Seguridad & Notificaciones
        </button>
      </div>

      <!-- SUBPANEL 1: IDENTIDAD -->
      <div class="v74-subpanel active" id="subpanel-identidad">
        <div class="v74-form-card">
          <div class="v74-form-card-title">
            <i class="fa-solid fa-user-check"></i> Datos Personales del Titular
          </div>
          <div class="v74-form-card-sub">
            Información de contacto para confirmación de pedidos y despachos en puerta.
          </div>

          <div class="v74-form-grid-2">
            <div class="v74-form-group">
              <label>Primer Nombre (Nombre de Pila)</label>
              <input type="text" class="v74-form-input" id="inNombrePila74" value={cliente.nombre} />
            </div>

            <div class="v74-form-group">
              <label>Apellidos Completos</label>
              <input type="text" class="v74-form-input" value={cliente.apellido} />
            </div>

            <div class="v74-form-group">
              <label>DNI / Documento de Identidad</label>
              <input type="text" class="v74-form-input" value={cliente.dni} />
            </div>

            <div class="v74-form-group">
              <label>WhatsApp de Confirmación</label>
              <input type="tel" class="v74-form-input" id="inTelefono74" value={cliente.telefono} />
            </div>

            <div class="v74-form-group">
              <label>Correo Electrónico</label>
              <input type="email" class="v74-form-input" value={cliente.email} />
            </div>

            <div class="v74-form-group">
              <label>Usuario</label>
              <input type="text" class="v74-form-input" value={cliente.usuario} readonly style="opacity:0.7;" />
            </div>
          </div>
        </div>
      </div>

      <!-- SUBPANEL 2: FACTURACIÓN -->
      <div class="v74-subpanel" id="subpanel-facturacion">
        <div class="v74-form-card">
          <div class="v74-form-card-title">
            <i class="fa-solid fa-building-columns"></i> Información Tributaria & Facturación SUNAT
          </div>
          <div class="v74-form-card-sub">
            Datos fiscales para emisión de Facturas con RUC 20 para empresas o restaurantes.
          </div>

          <div class="v74-form-grid-2">
            <div class="v74-form-group">
              <label>Comprobante Predeterminado</label>
              <select class="v74-form-input">
                <option value="boleta" selected>Boleta de Venta</option>
                <option value="factura">Factura RUC</option>
              </select>
            </div>

            <div class="v74-form-group">
              <label>RUC (11 dígitos)</label>
              <input type="text" class="v74-form-input" placeholder="Ej: 20601234567" />
            </div>

            <div class="v74-form-group">
              <label>Razón Social</label>
              <input type="text" class="v74-form-input" placeholder="Ej: Dante Gastronomía SAC" />
            </div>

            <div class="v74-form-group">
              <label>Domicilio Fiscal</label>
              <input type="text" class="v74-form-input" value={cliente.direccionFiscal} />
            </div>
          </div>
        </div>
      </div>

      <!-- SUBPANEL 3: PREFERENCIAS -->
      <div class="v74-subpanel" id="subpanel-preferencias">
        <div class="v74-form-card">
          <div class="v74-form-card-title">
            <i class="fa-solid fa-fire"></i> Preferencias de Cilindro y Válvula
          </div>
          <div class="v74-form-card-sub">
            Tus opciones predeterminadas al cargar la vista de pedido express.
          </div>

          <div class="v74-form-grid-2">
            <div class="v74-form-group">
              <label>Cilindro Habitual</label>
              <select class="v74-form-input">
                <option value="solgas-10kg" selected>Balón SOLGAS Premium 10 kg</option>
                <option value="masgas-10kg">Balón MASGAS 10 kg</option>
                <option value="solgas-45kg">Balón SOLGAS 45 kg</option>
              </select>
            </div>

            <div class="v74-form-group">
              <label>Tipo de Válvula</label>
              <select class="v74-form-input">
                <option value="click-on" selected>Click-On (Acople Rápido)</option>
                <option value="rosca">Rosca Estándar</option>
              </select>
            </div>

            <div class="v74-form-group">
              <label>Método de Pago Habitual</label>
              <select class="v74-form-input">
                <option value="efectivo" selected>Efectivo con vuelto</option>
                <option value="yape">Yape / Plin</option>
              </select>
            </div>

            <div class="v74-form-group">
              <label>Pesaje Obligatorio</label>
              <select class="v74-form-input">
                <option value="si" selected>Sí, verificar siempre en balanza digital Inacal</option>
                <option value="opcional">Solo si tengo dudas</option>
              </select>
            </div>
          </div>
        </div>
      </div>

      <!-- SUBPANEL 4: SEGURIDAD -->
      <div class="v74-subpanel" id="subpanel-seguridad">
        <div class="v74-form-card">
          <div class="v74-form-card-title">
            <i class="fa-solid fa-shield"></i> Preferencias de Visualización y Alertas
          </div>
          <div class="v74-form-card-sub">
            Personaliza el tema visual y avisos de recarga preventiva.
          </div>

          <div class="v74-form-grid-2">
            <div class="v74-form-group">
              <label>Tema Predeterminado</label>
              <select class="v74-form-input" id="selTemaCuenta74">
                <option value="futuro" selected>Modo Oscuro (Futuro)</option>
                <option value="luz">Modo Claro (Luz)</option>
              </select>
            </div>

            <div class="v74-form-group">
              <label>Aviso Preventivo de Recarga</label>
              <select class="v74-form-input">
                <option value="si" selected>Avisarme a los 26 días (~2 días antes de acabarse)</option>
                <option value="no">No avisar</option>
              </select>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <div id="v74Toast">Datos actualizados</div>

  <!-- ============================================================
       4. CONTROLADOR JAVASCRIPT REACTIVO (0MS OVERHEAD)
       ============================================================ */ -->
  <script is:inline>
    (function() {
      // ESTADO REACTIVO DEL PEDIDO
      const state = {
        nombre: 'Valeria',
        telefono: '+51 987 654 321',
        producto: 'Balón SOLGAS Premium 10 kg',
        productoCorto: 'Solgas 10 kg',
        precio: 65.00,
        alias: 'Casa Principal',
        calle: 'Jr. Dante 260, Dpto 301',
        distrito: 'Surquillo',
        ref: 'Frente al parque, portón marrón',
        eta: '12–15 min',
        metodoPago: 'efectivo',
        vueltoSeleccionado: '100',
        pagoTexto: 'Efectivo (Llevar vuelto de S/ 100.00)',
        nota: 'Piso 3, timbre no suena fuerte. Dejar con vigilancia si no contesto.'
      };

      const bubbleWa = document.getElementById('bubbleWaText74');
      const sumProd = document.getElementById('sumNombreProd74');
      const sumEta = document.getElementById('sumDistritoEta74');
      const sumPrecio = document.getElementById('sumPrecioTotal74');
      const btnWa = document.getElementById('btnWaAction74');
      const lblBtnWa = document.getElementById('lblBtnWa74');
      const toast = document.getElementById('v74Toast');
      const calcVueltoRow = document.getElementById('calcVueltoRow74');
      const valVuelto = document.getElementById('valVueltoCalculado74');

      function showToast(msg) {
        if (!toast) return;
        toast.textContent = msg;
        toast.style.display = 'block';
        clearTimeout(window._t74Id);
        window._t74Id = setTimeout(() => { toast.style.display = 'none'; }, 1600);
      }

      function updateWA() {
        // Cálculo de vuelto dinámico
        if (state.metodoPago === 'efectivo') {
          if (state.vueltoSeleccionado === 'exacto') {
            state.pagoTexto = `Efectivo (Monto Exacto: S/ ${state.precio.toFixed(2)})`;
            if (calcVueltoRow) calcVueltoRow.style.display = 'none';
          } else if (state.vueltoSeleccionado === 'otro') {
            state.pagoTexto = 'Efectivo (Coordinar vuelto)';
            if (calcVueltoRow) calcVueltoRow.style.display = 'none';
          } else {
            const billete = parseFloat(state.vueltoSeleccionado) || 100;
            const diff = billete - state.precio;
            state.pagoTexto = `Efectivo (Paga con S/ ${billete.toFixed(2)}, Llevar vuelto de S/ ${diff > 0 ? diff.toFixed(2) : '0.00'})`;
            if (calcVueltoRow && valVuelto) {
              calcVueltoRow.style.display = 'flex';
              valVuelto.textContent = diff > 0 ? `S/ ${diff.toFixed(2)}` : 'S/ 0.00';
            }
          }
        } else {
          state.pagoTexto = 'Yape / Plin (Contraentrega con QR)';
          if (calcVueltoRow) calcVueltoRow.style.display = 'none';
        }

        const msg = 
`¡Hola Solgas Surquillo! Deseo pedir mi recarga con mis datos guardados:

👤 Nombre: ${state.nombre}
📦 Producto: ${state.producto} (S/ ${state.precio.toFixed(2)})
📍 Entrega: ${state.calle}, ${state.distrito}
🧭 Ref: ${state.ref}
💳 Pago: ${state.pagoTexto}
📝 Nota: ${state.nota}
⏱️ Llegada estimada: ${state.eta}`;

        if (bubbleWa) {
          bubbleWa.innerHTML = msg.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>') +
            `<div class="v74-wa-time"><span>10:32 a. m.</span> <i class="fa-solid fa-check-double" style="color:#53bdeb;"></i></div>`;
        }

        if (sumProd) sumProd.textContent = state.productoCorto;
        if (sumEta) sumEta.textContent = `${state.distrito} · ${state.eta}`;
        if (sumPrecio) sumPrecio.textContent = `S/ ${state.precio.toFixed(2)}`;

        if (lblBtnWa) lblBtnWa.textContent = `Pedir por WhatsApp (S/ ${state.precio.toFixed(2)})`;
        if (btnWa) btnWa.href = `https://wa.me/51936369384?text=${encodeURIComponent(msg)}`;
      }

      // CAMBIO DE MÓDULOS DEL SIDEBAR
      document.querySelectorAll('.v74-nav-item').forEach(btn => {
        btn.addEventListener('click', () => {
          const targetId = btn.dataset.target;
          document.querySelectorAll('.v74-nav-item').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          document.querySelectorAll('.v74-panel').forEach(p => p.classList.remove('active'));
          const targetPanel = document.getElementById(`panel-${targetId}`);
          if (targetPanel) targetPanel.classList.add('active');
        });
      });

      // BOTÓN "GESTIONAR FICHA & DIRECCIONES"
      document.getElementById('btnGoFicha74')?.addEventListener('click', () => {
        const cuentaNavBtn = document.querySelector('.v74-nav-item[data-target="mi-cuenta"]');
        cuentaNavBtn?.click();
      });

      // SUB-PESTAÑAS EN MI CUENTA
      document.querySelectorAll('.v74-subtab-btn').forEach(tab => {
        tab.addEventListener('click', () => {
          const subId = tab.dataset.sub;
          document.querySelectorAll('.v74-subtab-btn').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');

          document.querySelectorAll('.v74-subpanel').forEach(sp => sp.classList.remove('active'));
          const targetSub = document.getElementById(`subpanel-${subId}`);
          if (targetSub) targetSub.classList.add('active');
        });
      });

      // SELECCIÓN DE PRODUCTOS (4 CARDS CON TÍTULOS CENTRADOS)
      document.querySelectorAll('.v74-card-p').forEach(card => {
        card.addEventListener('click', () => {
          document.querySelectorAll('.v74-card-p').forEach(c => c.classList.remove('active'));
          card.classList.add('active');
          state.producto = card.dataset.nombre;
          state.productoCorto = card.dataset.nombrecorto;
          state.precio = parseFloat(card.dataset.precio);
          updateWA();
          showToast(`Balón: ${state.productoCorto}`);
        });
      });

      // SELECTOR DE DIRECCIÓN UNIFICADO
      const selDirConfig = document.getElementById('selectDirConfig74');
      selDirConfig?.addEventListener('change', () => {
        const opt = selDirConfig.options[selDirConfig.selectedIndex];
        state.alias = opt.dataset.alias;
        state.calle = opt.dataset.calle;
        state.distrito = opt.dataset.distrito;
        state.ref = opt.dataset.ref;
        state.eta = opt.dataset.eta;
        updateWA();
        showToast(`Destino: ${state.alias} (${state.eta})`);
      });

      // MÉTODOS DE PAGO (EFECTIVO VS YAPE/PLIN)
      document.querySelectorAll('.v74-btn-tab-pago').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.v74-btn-tab-pago').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          state.metodoPago = tab.dataset.metodo;
          const boxVuelto = document.getElementById('boxVuelto74');
          if (boxVuelto) {
            boxVuelto.style.display = state.metodoPago === 'efectivo' ? 'block' : 'none';
          }
          updateWA();
        });
      });

      // CHIPS DE VUELTO
      document.querySelectorAll('#chipsVuelto74 .v74-chip-btn').forEach(chip => {
        chip.addEventListener('click', () => {
          document.querySelectorAll('#chipsVuelto74 .v74-chip-btn').forEach(c => c.classList.remove('active'));
          chip.classList.add('active');
          state.vueltoSeleccionado = chip.dataset.vuelto;
          updateWA();
        });
      });

      // NOTAS RÁPIDAS
      const txtNotas = document.getElementById('txtNotas74');
      document.querySelectorAll('#tagsNotas74 .v74-quick-tag').forEach(tag => {
        tag.addEventListener('click', () => {
          const tVal = tag.dataset.tag;
          if (txtNotas) {
            txtNotas.value = txtNotas.value ? `${txtNotas.value}, ${tVal}` : tVal;
            state.nota = txtNotas.value;
            updateWA();
          }
        });
      });

      txtNotas?.addEventListener('input', () => {
        state.nota = txtNotas.value.trim();
        updateWA();
      });

      // GUARDAR CAMBIOS DE MI CUENTA
      document.getElementById('btnSaveMiCuenta74')?.addEventListener('click', () => {
        const nuevoNombre = document.getElementById('inNombrePila74')?.value.trim();
        const nuevoTel = document.getElementById('inTelefono74')?.value.trim();
        if (nuevoNombre) state.nombre = nuevoNombre;
        if (nuevoTel) state.telefono = nuevoTel;
        updateWA();
        showToast('¡Ficha de cliente guardada con éxito!');
      });

      // COLAPSAR SIDEBAR
      document.getElementById('btnCollapse74')?.addEventListener('click', () => {
        const isCollapsed = document.documentElement.classList.toggle('is-collapsed');
        localStorage.setItem('gaswii_sidebar_v74', isCollapsed ? 'true' : 'false');
      });

      // CAMBIAR TEMA
      document.getElementById('btnTheme74')?.addEventListener('click', () => {
        const cur = document.documentElement.dataset.theme;
        const next = cur === 'luz' ? 'futuro' : 'luz';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('gaswii_theme_cliente', next);
      });

      // INICIALIZACIÓN
      updateWA();
    })();
  </script>
</body>
</html>
